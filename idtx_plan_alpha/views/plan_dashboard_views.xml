<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         SEARCH COMPARTIDO — pedidos (reutilizado en dashboard y tablas)
    ============================================================ -->
    <record id="plan_alpha_pedido_search" model="ir.ui.view">
        <field name="name">plan.alpha.pedido.search</field>
        <field name="model">control.pedido</field>
        <field name="arch" type="xml">
            <search string="Buscar Pedidos">
                <field name="numordped" string="N° Pedido"/>
                <field name="customer"  string="Cliente"/>
                <field name="area"      string="Area"/>
                <field name="process"   string="Proceso"/>
                <separator/>
                <filter name="filter_on"  string="A Tiempo"   domain="[('state','=','on')]"/>
                <filter name="filter_de"  string="Retrasados"  domain="[('state','=','de')]"/>
                <filter name="filter_do"  string="Terminados"  domain="[('state','=','do')]"/>
                <filter name="filter_se"  string="Liquidados"  domain="[('state','=','se')]"/>
                <separator/>
                <filter name="filter_activos" string="Activos"
                        domain="[('state','in',['on','de'])]"/>
                <group>
                    <filter name="group_state"    string="Estado"    context="{'group_by': 'state'}"/>
                    <filter name="group_customer" string="Cliente"   context="{'group_by': 'customer'}"/>
                    <filter name="group_area"     string="Area"      context="{'group_by': 'area'}"/>
                    <filter name="group_process"  string="Proceso"   context="{'group_by': 'process'}"/>
                    <filter name="group_fecha"    string="Fecha"     context="{'group_by': 'fecha:week'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================
         DASHBOARD 1: ESTADOS — pie por state (igual al donut del Plan General)
    ============================================================ -->
    <record id="plan_alpha_dash_graph_estados" model="ir.ui.view">
        <field name="name">plan.alpha.dash.graph.estados</field>
        <field name="model">control.pedido</field>
        <field name="arch" type="xml">
            <graph string="Estados de Pedidos" type="pie" sample="1">
                <field name="state"/>
                <field name="total_weight" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="plan_alpha_dash_pivot_estados" model="ir.ui.view">
        <field name="name">plan.alpha.dash.pivot.estados</field>
        <field name="model">control.pedido</field>
        <field name="arch" type="xml">
            <pivot string="Resumen por Estado" sample="1">
                <field name="state" type="row"/>
                <field name="total_weight" type="measure"/>
                <field name="num_days"     type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_plan_alpha_dash_estados" model="ir.actions.act_window">
        <field name="name">Estados de Pedidos</field>
        <field name="res_model">control.pedido</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="view_id" ref="plan_alpha_dash_graph_estados"/>
        <field name="search_view_id" ref="plan_alpha_pedido_search"/>
        <field name="context">{'search_default_filter_activos': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Sin pedidos registrados.</p>
        </field>
    </record>

    <!-- ============================================================
         DASHBOARD 2: CLIENTES — bar por cliente (igual al HBar del Plan General)
    ============================================================ -->
    <record id="plan_alpha_dash_graph_clientes" model="ir.ui.view">
        <field name="name">plan.alpha.dash.graph.clientes</field>
        <field name="model">control.pedido</field>
        <field name="arch" type="xml">
            <graph string="Top Clientes (kg)" type="bar" order="DESC" sample="1">
                <field name="customer"/>
                <field name="total_weight" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="plan_alpha_dash_pivot_clientes" model="ir.ui.view">
        <field name="name">plan.alpha.dash.pivot.clientes</field>
        <field name="model">control.pedido</field>
        <field name="arch" type="xml">
            <pivot string="Kilos por Cliente" sample="1">
                <field name="customer"     type="row"/>
                <field name="state"        type="col"/>
                <field name="total_weight" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_plan_alpha_dash_clientes" model="ir.actions.act_window">
        <field name="name">Clientes</field>
        <field name="res_model">control.pedido</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="view_id" ref="plan_alpha_dash_graph_clientes"/>
        <field name="search_view_id" ref="plan_alpha_pedido_search"/>
        <field name="context">{'search_default_filter_activos': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Sin pedidos registrados.</p>
        </field>
    </record>

    <!-- ============================================================
         DASHBOARD 3: POR AREA — bar por area en partidas
    ============================================================ -->
    <record id="plan_alpha_line_search" model="ir.ui.view">
        <field name="name">plan.alpha.line.search</field>
        <field name="model">control.pedido.line</field>
        <field name="arch" type="xml">
            <search string="Buscar Partidas">
                <field name="customer"  string="Cliente"/>
                <field name="area"      string="Area"/>
                <field name="process"   string="Proceso"/>
                <field name="product_id" string="Producto"/>
                <separator/>
                <filter name="filter_active" string="Activas"
                        domain="[('state','=','active')]"/>
                <group>
                    <filter name="group_area"    string="Area"    context="{'group_by': 'area'}"/>
                    <filter name="group_process" string="Proceso" context="{'group_by': 'process'}"/>
                    <filter name="group_customer" string="Cliente" context="{'group_by': 'customer'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="plan_alpha_dash_graph_area" model="ir.ui.view">
        <field name="name">plan.alpha.dash.graph.area</field>
        <field name="model">control.pedido.line</field>
        <field name="arch" type="xml">
            <graph string="Partidas por Area (kg)" type="bar" order="DESC" sample="1">
                <field name="area"/>
                <field name="kilograms" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="plan_alpha_dash_pivot_area" model="ir.ui.view">
        <field name="name">plan.alpha.dash.pivot.area</field>
        <field name="model">control.pedido.line</field>
        <field name="arch" type="xml">
            <pivot string="Kilos por Area" sample="1">
                <field name="area"       type="row"/>
                <field name="kilograms"  type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_plan_alpha_dash_area" model="ir.actions.act_window">
        <field name="name">Por Area</field>
        <field name="res_model">control.pedido.line</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="view_id" ref="plan_alpha_dash_graph_area"/>
        <field name="search_view_id" ref="plan_alpha_line_search"/>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Sin partidas registradas.</p>
        </field>
    </record>

    <!-- ============================================================
         DASHBOARD 4: POR PROCESO — bar por proceso en partidas
    ============================================================ -->
    <record id="plan_alpha_dash_graph_proceso" model="ir.ui.view">
        <field name="name">plan.alpha.dash.graph.proceso</field>
        <field name="model">control.pedido.line</field>
        <field name="arch" type="xml">
            <graph string="Partidas por Proceso" type="bar" order="DESC" sample="1">
                <field name="process"/>
                <field name="kilograms" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="plan_alpha_dash_pivot_proceso" model="ir.ui.view">
        <field name="name">plan.alpha.dash.pivot.proceso</field>
        <field name="model">control.pedido.line</field>
        <field name="arch" type="xml">
            <pivot string="Kilos por Proceso" sample="1">
                <field name="process"    type="row"/>
                <field name="area"       type="col"/>
                <field name="kilograms"  type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_plan_alpha_dash_proceso" model="ir.actions.act_window">
        <field name="name">Por Proceso</field>
        <field name="res_model">control.pedido.line</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="view_id" ref="plan_alpha_dash_graph_proceso"/>
        <field name="search_view_id" ref="plan_alpha_line_search"/>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Sin partidas registradas.</p>
        </field>
    </record>


    <!-- ============================================================
         DASHBOARD CLIENT ACTION: componente OWL moderno
    ============================================================ -->
    <record id="action_plan_alpha_dashboard_client" model="ir.actions.client">
        <field name="name">Dashboard de Planeamiento</field>
        <field name="tag">plan_alpha_dashboard</field>
    </record>

    <!-- ============================================================
         DASHBOARD BOARD: vista unificada con los 4 graficos
         (el arch se rellena con IDs reales via post_init_hook)
    ============================================================ -->
    <data noupdate="1">
        <record id="view_plan_alpha_dashboard_board" model="ir.ui.view">
            <field name="name">plan.alpha.dashboard.board</field>
            <field name="model">board.board</field>
            <field name="arch" type="xml">
                <form string="Dashboard de Planeamiento">
                    <board style="1-1">
                        <column/>
                        <column/>
                    </board>
                </form>
            </field>
        </record>

        <record id="action_plan_alpha_dashboard_board" model="ir.actions.act_window">
            <field name="name">Dashboard</field>
            <field name="res_model">board.board</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_plan_alpha_dashboard_board"/>
            <field name="context">{'disable_toolbar': True}</field>
        </record>
    </data>

</odoo>
