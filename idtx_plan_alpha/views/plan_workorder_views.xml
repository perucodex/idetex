<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- SEARCH: operaciones / workorders -->
    <record id="plan_alpha_workorder_search" model="ir.ui.view">
        <field name="name">plan.alpha.workorder.search</field>
        <field name="model">mrp.workorder</field>
        <field name="arch" type="xml">
            <search string="Buscar Operaciones">
                <field name="name" string="Operacion"/>
                <field name="production_id" string="Orden de produccion"/>
                <field name="workcenter_id" string="Centro de trabajo"/>
                <field name="product_id" string="Producto"/>
                <separator/>
                <filter name="filter_ready"     string="Lista"
                        domain="[('state','=','ready')]"/>
                <filter name="filter_progress"  string="En progreso"
                        domain="[('state','=','progress')]"/>
                <filter name="filter_pending"   string="Pendiente"
                        domain="[('state','=','pending')]"/>
                <filter name="filter_done"      string="Hecha"
                        domain="[('state','=','done')]"/>
                <separator/>
                <filter name="filter_late" string="Atrasadas"
                        domain="[('date_finished','&lt;', context_today().strftime('%Y-%m-%d')),('state','not in',['done','cancel'])]"/>
                <separator/>
                <group>
                    <filter name="group_workcenter" string="Centro de trabajo"
                            context="{'group_by': 'workcenter_id'}"/>
                    <filter name="group_state"      string="Estado"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_production" string="Orden de produccion"
                            context="{'group_by': 'production_id'}"/>
                    <filter name="group_date"       string="Fecha planificada"
                            context="{'group_by': 'date_start:week'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- LIST: lista de operaciones por centro de trabajo -->
    <record id="plan_alpha_workorder_list" model="ir.ui.view">
        <field name="name">plan.alpha.workorder.list</field>
        <field name="model">mrp.workorder</field>
        <field name="arch" type="xml">
            <list string="Operaciones"
                  decoration-info="state == 'pending'"
                  decoration-warning="state == 'ready'"
                  decoration-success="state == 'done'"
                  decoration-primary="state == 'progress'"
                  sample="1">
                <field name="name" decoration-bf="1"/>
                <field name="production_id"/>
                <field name="product_id" optional="show"/>
                <field name="workcenter_id"/>
                <field name="date_start" string="Inicio plan." optional="show"/>
                <field name="date_finished" string="Fin plan." optional="show"/>
                <field name="duration_expected" string="Duracion (min)" optional="hide"/>
                <field name="duration" string="Real (min)" optional="hide"/>
                <field name="qty_production" string="Cant. prod." optional="show"/>
                <field name="qty_produced" string="Cant. hecha" optional="show"/>
                <field name="state"
                       widget="badge"
                       decoration-info="state == 'pending'"
                       decoration-warning="state == 'ready'"
                       decoration-primary="state == 'progress'"
                       decoration-success="state == 'done'"
                       decoration-danger="state == 'cancel'"/>
            </list>
        </field>
    </record>

    <!-- KANBAN: operaciones por centro de trabajo -->
    <record id="plan_alpha_workorder_kanban" model="ir.ui.view">
        <field name="name">plan.alpha.workorder.kanban</field>
        <field name="model">mrp.workorder</field>
        <field name="arch" type="xml">
            <kanban default_group_by="workcenter_id" sample="1">
                <field name="name"/>
                <field name="state"/>
                <field name="production_id"/>
                <field name="product_id"/>
                <field name="workcenter_id"/>
                <field name="date_start"/>
                <field name="date_finished"/>
                <field name="qty_production"/>
                <field name="qty_produced"/>
                <templates>
                    <t t-name="card">
                        <div class="o_kanban_record_top mb-0">
                            <div class="o_kanban_record_headings">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                            </div>
                        </div>
                        <div class="o_kanban_record_body">
                            <field name="production_id"/>
                            <br/>
                            <span class="text-muted small">
                                <field name="product_id"/>
                            </span>
                        </div>
                        <div class="o_kanban_record_bottom">
                            <div class="oe_kanban_bottom_left text-muted small">
                                <i class="fa fa-clock-o me-1" title="Fecha"/>
                                <field name="date_start" widget="date"/>
                            </div>
                            <div class="oe_kanban_bottom_right">
                                <field name="state"
                                       widget="badge"
                                       decoration-info="state == 'pending'"
                                       decoration-warning="state == 'ready'"
                                       decoration-primary="state == 'progress'"
                                       decoration-success="state == 'done'"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ACTION: Operaciones / Workorders -->
    <record id="action_plan_alpha_workorders" model="ir.actions.act_window">
        <field name="name">Operaciones</field>
        <field name="res_model">mrp.workorder</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="plan_alpha_workorder_search"/>
        <field name="context">{'search_default_group_workcenter': 1}</field>
        <field name="domain">[('state', 'not in', ['cancel'])]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Sin operaciones registradas.
            </p>
            <p>
                Las operaciones aparecen al confirmar ordenes de produccion
                con rutas de trabajo definidas.
            </p>
        </field>
    </record>

</odoo>
