<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         TABLAS: LIST de control.pedido
    ============================================================ -->
    <record id="plan_alpha_pedido_list" model="ir.ui.view">
        <field name="name">plan.alpha.pedido.list</field>
        <field name="model">control.pedido</field>
        <field name="arch" type="xml">
            <list string="Pedidos"
                  decoration-success="state == 'on'"
                  decoration-danger="state == 'de'"
                  decoration-info="state == 'do'"
                  decoration-muted="state == 'se'"
                  sample="1">
                <field name="numordped" decoration-bf="1"/>
                <field name="fecha"     optional="show"/>
                <field name="customer"/>
                <field name="area"      optional="show"/>
                <field name="process"   optional="show"/>
                <field name="total_weight"    string="Total kg"     optional="show"/>
                <field name="produced_weight" string="Producido kg" optional="hide"/>
                <field name="wish_date"  string="F. Deseada" optional="show"/>
                <field name="num_days"   string="Dias retraso" optional="show"/>
                <field name="user_id"    widget="many2one_avatar_user" optional="hide"/>
                <field name="state"
                       widget="badge"
                       decoration-success="state == 'on'"
                       decoration-danger="state == 'de'"
                       decoration-info="state == 'do'"
                       decoration-muted="state == 'se'"/>
            </list>
        </field>
    </record>

    <record id="action_plan_alpha_pedidos_lista" model="ir.actions.act_window">
        <field name="name">Pedidos</field>
        <field name="res_model">control.pedido</field>
        <field name="view_mode">list,graph,pivot</field>
        <field name="view_id" ref="plan_alpha_pedido_list"/>
        <field name="search_view_id" ref="plan_alpha_pedido_search"/>
        <field name="context">{'search_default_filter_activos': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Sin pedidos registrados.
            </p>
            <p>
                Los pedidos se importan desde FASPRO/SITPRO
                y aparecen aqui para su seguimiento.
            </p>
        </field>
    </record>

    <!-- ============================================================
         TABLAS: LIST de control.pedido.line (partidas)
    ============================================================ -->
    <record id="plan_alpha_line_list" model="ir.ui.view">
        <field name="name">plan.alpha.line.list</field>
        <field name="model">control.pedido.line</field>
        <field name="arch" type="xml">
            <list string="Partidas" sample="1">
                <field name="pedido_id"  decoration-bf="1"/>
                <field name="customer"   optional="show"/>
                <field name="area"       optional="show"/>
                <field name="process"    string="Proceso actual" optional="show"/>
                <field name="next_process" string="Sig. proceso" optional="show"/>
                <field name="description" string="Articulo"      optional="show"/>
                <field name="rollos"      string="Rollos"        optional="show"/>
                <field name="kilograms"   string="Kg"            optional="show"/>
                <field name="colorcode"   string="Cod. Color"    optional="hide"/>
                <field name="colorname"   string="Color"         optional="show"/>
                <field name="num_days"    string="Dias"          optional="show"/>
                <field name="start_date"  string="Inicio"        optional="hide"/>
                <field name="end_date"    string="Fin"           optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_plan_alpha_partidas_lista" model="ir.actions.act_window">
        <field name="name">Partidas</field>
        <field name="res_model">control.pedido.line</field>
        <field name="view_mode">list,graph,pivot</field>
        <field name="view_id" ref="plan_alpha_line_list"/>
        <field name="search_view_id" ref="plan_alpha_line_search"/>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Sin partidas registradas.
            </p>
        </field>
    </record>

</odoo>
