<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pdf_password_wizard_form" model="ir.ui.view">
        <field name="name">idtx_ocr_gemini.pdf_password_wizard.form</field>
        <field name="model">idtx_ocr_gemini.pdf_password_wizard</field>
        <field name="arch" type="xml">
            <form string="PDF protegido con contrasena">
                <p>
                    El o los siguientes archivos PDF estan protegidos con
                    contrasena. Ingresa la clave para desbloquearlos antes
                    de mandarlos a Gemini.
                </p>
                <field name="attachment_ids" readonly="1">
                    <list create="false" delete="false">
                        <field name="name"/>
                    </list>
                </field>
                <group>
                    <field name="password" password="True" required="1"/>
                </group>
                <field name="other_attachment_ids" invisible="1"/>
                <field name="journal_id" invisible="1"/>
                <footer>
                    <button string="Desbloquear y procesar"
                            name="action_unlock_and_import"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
