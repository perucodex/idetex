<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="idtx_pos_payment_term.PaymentScreenPaymentLines"
       t-inherit="point_of_sale.PaymentScreenPaymentLines"
       t-inherit-mode="extension">
        <xpath expr="//t[@t-foreach='props.paymentLines']" position="inside">
            <t t-if="line.payment_method_id?.use_payment_terms">
                <div class="payment-term-row d-flex align-items-center justify-content-between bg-view border rounded-3 px-3 py-2 cursor-pointer"
                     role="button"
                     t-on-click="() => this.selectPaymentTerm(line)">
                    <span class="text-muted small">Termino de pago</span>
                    <span class="fw-bold">
                        <t t-if="line.pos_order_id.invoice_payment_term_id">
                            <t t-esc="line.pos_order_id.invoice_payment_term_id.name"/>
                        </t>
                        <t t-else="">
                            <span class="text-danger">Seleccionar...</span>
                        </t>
                    </span>
                </div>
            </t>
        </xpath>
    </t>

</templates>
