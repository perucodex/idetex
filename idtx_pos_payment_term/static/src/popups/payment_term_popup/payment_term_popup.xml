<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="idtx_pos_payment_term.PaymentTermPopup">
        <Dialog title="props.title" footer="false" size="'lg'" contentClass="'pb-3'">
            <div class="mb-3">
                <input type="text"
                       class="form-control form-control-lg"
                       placeholder="Buscar termino de pago..."
                       t-ref="search"
                       t-model="state.query"/>
            </div>
            <div class="d-flex flex-column gap-2 border-bottom pb-3"
                 style="max-height: 50vh; overflow-y: auto;">
                <t t-if="filteredTerms.length">
                    <button t-foreach="filteredTerms" t-as="term" t-key="term.id"
                            class="selection-item d-flex align-items-center justify-content-between btn btn-lg btn-outline-secondary w-100 p-3 text-start"
                            t-att-class="{ 'selected active': term.id === props.selectedId }"
                            t-on-click="() => this.selectTerm(term)">
                        <span t-esc="term.name"/>
                        <i t-attf-class="{{ term.id === props.selectedId ? 'fa fa-check text-action' : 'oi oi-chevron-right' }}"/>
                    </button>
                </t>
                <t t-else="">
                    <div class="text-center text-muted p-3">
                        Sin resultados
                    </div>
                </t>
            </div>
        </Dialog>
    </t>

</templates>
