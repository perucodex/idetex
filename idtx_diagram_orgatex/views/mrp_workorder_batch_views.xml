<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_workorder_batch_form_diagram_orgatex" model="ir.ui.view">
        <field name="name">mrp.workorder.batch.form.diagram.orgatex</field>
        <field name="model">mrp.workorder.batch</field>
        <field name="inherit_id" ref="idtx_mrp.mrp_workorder_batch_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Diagrama ORGATEX" name="diagram_tab" invisible="state == 'draft'">
                    <header>
                        <button name="action_create_diagram"
                                string="Actualizar Diagramas"
                                type="object"
                                class="btn-primary"
                                icon="fa-refresh"/>
                    </header>
                    <field name="diagram_ids">
                        <list create="0" delete="0" edit="0">
                            <field name="dyelot"/>
                            <field name="ref_no"/>
                            <field name="diagram_image" widget="image" options="{'size': [0, 50]}"/>
                        </list>
                        <form>
                            <sheet>
                                <group>
                                    <field name="dyelot" readonly="1"/>
                                    <field name="ref_no" readonly="1"/>
                                </group>
                                <field name="diagram_image" widget="image" readonly="1"/>
                            </sheet>
                        </form>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
