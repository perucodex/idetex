<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_control_pedido_line_form_inherit_diagram" model="ir.ui.view">
        <field name="name">control.pedido.line.form.inherit.diagram</field>
        <field name="model">control.pedido.line</field>
        <field name="inherit_id" ref="idtx_batch_control.view_control_pedido_line_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[field[@name='proceso_ids']]" position="after">
                <page string="Diagrama" name="diagram_tab">
                    <header>
                        <button name="action_create_diagram" 
                                string="Actualizar Diagramas" 
                                type="object" 
                                class="btn-primary"
                                icon="fa-refresh"/>
                    </header>
                    <field name="diagram_ids">
                        <list create="0" delete="0" edit="0">
                            <field name="dyelot"/>
                            <field name="ref_no"/>
                            <field name="diagram_image" widget="image" options="{'size': [0, 50]}"/>
                        </list>
                        <form>
                            <sheet>
                                <group>
                                    <field name="dyelot" readonly="1"/>
                                    <field name="ref_no" readonly="1"/>
                                </group>
                                <field name="diagram_image" widget="image" readonly="1"/>
                            </sheet>
                        </form>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
