    <!-- ===== 2ª confirmación de borrado: alerta roja + botón rojo ===== -->
    <record id="thread_catalog_delete_wizard_form" model="ir.ui.view">
        <field name="name">idtx.thread.catalog.delete.wizard.form</field>
        <field name="model">idtx.thread.catalog.delete.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirmar borrado definitivo">
                <field name="res_model" invisible="1"/>
                <field name="res_ids" invisible="1"/>
                <div class="alert alert-danger" role="alert">
                    <strong>¡Atención!</strong> Vas a eliminar <field name="count" readonly="1" class="oe_inline"/>
                    valor(es) de catálogo. Esta acción es <b>definitiva</b> y no se puede deshacer.
                </div>
                <p>¿Confirmas el borrado definitivo?</p>
                <footer>
                    <button name="action_confirm" type="object" string="Eliminar definitivamente"
                            class="btn-danger"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

