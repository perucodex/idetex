    <!-- ===== Búsqueda: por código o descripción (la barra usa el _rec_name=name
             si no hay search view; por eso hace falta declarar 'code') ===== -->
    <record id="product_thread_titulo_view_search" model="ir.ui.view">
        <field name="name">product.thread.titulo.search</field>
        <field name="model">product.thread.titulo</field>
        <field name="arch" type="xml">
            <search>
                <field name="code" string="Código / Descripción" filter_domain="['|', ('code', 'ilike', self), ('name', 'ilike', self)]"/>
            </search>
        </field>
    </record>
