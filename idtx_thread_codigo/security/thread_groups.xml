<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Perfil "Manager de Hilado": hereda TODOS los permisos del manager
             de Desarrollo de Producto (implied_ids) y, además, habilita editar
             la descripción de un hilado ya creado (state == 'created'). -->
        <record id="group_thread_manager" model="res.groups">
            <field name="name">Thread Manager</field>
            <field name="privilege_id" ref="idtx_product_development.module_product_development_user"/>
            <field name="implied_ids" eval="[(4, ref('idtx_product_development.group_module_product_development_manager'))]"/>
        </record>

    </data>
</odoo>
