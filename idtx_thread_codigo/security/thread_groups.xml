<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Complemento como CASILLA en el usuario (sin privilege_id ni herencia
             de Manager): habilita gestionar los catálogos de hilado (permisos
             propios en ir.model.access) y editar la descripción de un hilado ya
             creado. Se otorga a un usuario que ya tiene un nivel de Desarrollo de
             Producto. Sin herencia, NO compite en el selector Usuario/Administrador. -->
        <record id="group_thread_manager" model="res.groups">
            <field name="name">Gestor de Hilado</field>
        </record>

    </data>
</odoo>
