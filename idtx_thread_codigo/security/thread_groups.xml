<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Perfil "Gestor de Hilado" como CASILLA en el usuario (sin
             privilege_id, para que NO compita en el selector User/Manager de
             Desarrollo de Producto). Al marcarlo hereda ese Manager
             (implied_ids) y habilita editar la descripción de un hilado ya
             creado (state == 'created'). Mismos permisos que antes, solo
             cambia la presentación. -->
        <record id="group_thread_manager" model="res.groups">
            <field name="name">Gestor de Hilado</field>
            <field name="implied_ids" eval="[(4, ref('idtx_product_development.group_module_product_development_manager'))]"/>
        </record>

    </data>
</odoo>
