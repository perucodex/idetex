<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_invoice_document_inherit_lot" inherit_id="account.report_invoice_document">
        <!-- Condición de visibilidad de las columnas Lote/Color:
             - is_company_produce: la compañía es de producción textil (Idetex)
             - is_sale_document(): SOLO documentos de venta a cliente (factura / boleta / nota de crédito).
               Excluye facturas de proveedor (in_invoice / in_refund) donde estos datos no aplican.
             - any(weaving): al menos una línea es de producto textil (tejido).
             Definimos la condición como variable t-set para evitar duplicarla en cada th/td. -->
        <xpath expr="//thead/tr/th[@name='th_description']" position="after">
            <t t-set="show_lot_cols" t-value="o.company_id.is_company_produce and o.is_sale_document() and any(l.product_id.product_tmpl_id.is_weaving for l in o.invoice_line_ids)"/>
            <!-- Columnas LOT y COLOR CODE removidas por requerimiento.
                 Solo se muestra Color Name (más legible para el cliente).
                 La info técnica (lotes, código de color) se conserva en account.move.line
                 (campos idtx_grouped_lot_ids, idtx_get_color_code) para trazabilidad interna. -->
            <th t-if="show_lot_cols" name="th_color_name" class="text-start">
                <span>Color Name</span>
            </th>
        </xpath>

        <!-- Celda Color Name por línea -->
        <xpath expr="//td[@name='account_invoice_line_name']" position="after">
            <t t-set="show_lot_cols" t-value="o.company_id.is_company_produce and o.is_sale_document() and any(l.product_id.product_tmpl_id.is_weaving for l in o.invoice_line_ids)"/>
            <td t-if="show_lot_cols" name="td_color_name" class="text-start">
                <span t-esc="line.idtx_get_color_name()"/>
            </td>
        </xpath>
    </template>

    <!-- Quitamos la tabla de lotes -->
    <template id="hide_stock_account_lot_table" inherit_id="stock_account.stock_account_report_invoice_document">
        <xpath expr="//table[@name='invoice_snln_table']" position="replace"/>
    </template>

</odoo>