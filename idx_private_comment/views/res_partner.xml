<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_partner_form_private_comment" model="ir.ui.view">
        <field name="name">res.partner.form.private.comment</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref='base.view_partner_form'/> <!--heredas de la vista = 'ID externo' -->
        <field name="arch" type='xml'>
            <xpath expr="//sheet/notebook" position="inside">
                <page name="name" string="Comentario Privado" groups='base.group_user'>
                    <field name="private_comment" placeholder='Escriba un comentario privado'></field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
