#. module: idtx_stock_request
#: model:ir.model.fields,help:idtx_stock_request.field_res_company__stock_request_direct_transfer
#: model:ir.model.fields,help:idtx_stock_request.field_res_config_settings__stock_request_direct_transfer
#: model_terms:ir.ui.view,arch_db:idtx_stock_request.res_config_settings_view_form
msgid ""
"When no route is selected and the requested location is not the stock "
"location of the warehouse, the request creates an internal transfer from the"
" warehouse stock instead of running the product routes (buy / manufacture)."
msgstr ""
"Si no se elige ruta y la ubicación solicitada no es Existencias del almacén,"
" el requerimiento crea un traslado interno desde Existencias en lugar de "
"ejecutar las rutas del producto (comprar / fabricar)."

#. module: idtx_stock_request
#. odoo-python
#: code:addons/idtx_stock_request/models/stock_location.py:0
msgid ""
"You cannot change the company of the location, as it is already assigned to "
"stock request orders that belong to another company."
msgstr ""
"No puede cambiar la compañía de la localización, ya que tiene asignados "
"pedidos de existencias que pertenecen a otras compañías."

#. module: idtx_stock_request
#. odoo-python
#: code:addons/idtx_stock_request/models/stock_location.py:0
