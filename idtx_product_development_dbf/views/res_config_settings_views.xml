<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_config_settings_view_form_inherit_product_development_dbf" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.product.development.dbf</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="idtx_product_development.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//block[@name='default_dev_categories_setting_container']" position="after">
                    <block title="FoxPro DBF Export" name="foxpro_dbf_export_setting_container">
                        <setting id="foxpro_dbf_path" string="FoxPro DBF path" company_dependent="1" help="Ruta al directorio donde estan las tablas DBF de FoxPro.">
                            <field name="foxpro_dbf_path" placeholder="/mnt/fox/sit06/dbf"/>
                        </setting>
                    </block>
                </xpath>
            </field>
        </record>
    </data>
</odoo>