<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="technical_sheet_form_view_inherit_product_development_dbf" model="ir.ui.view">
            <field name="name">technical.sheet.form.inherit.product.development.dbf</field>
            <field name="model">technical.sheet</field>
            <field name="inherit_id" ref="idtx_product_development.technical_sheet_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//header" position="inside">
                    <button name="action_export_to_foxpro" type="object" string="Export DBF" invisible="state == 'draft'" groups="idtx_product_development.group_module_product_development_manager"/>
                </xpath>
                <xpath expr="//field[@name='sitpro_sheet']" position="after">
                    <field name="foxpro_article_prefix" placeholder="P" groups="idtx_product_development.group_module_product_development_manager"/>
                    <field name="foxpro_article_code" groups="idtx_product_development.group_module_product_development_manager"/>
                    <field name="foxpro_export_state" widget="badge" readonly="1" decoration-success="foxpro_export_state == 'done'" decoration-danger="foxpro_export_state == 'error'" decoration-muted="foxpro_export_state == 'draft'" groups="idtx_product_development.group_module_product_development_manager"/>
                </xpath>
                <xpath expr="//field[@name='notes']" position="after">
                    <field name="foxpro_export_message" readonly="1" invisible="not foxpro_export_message" groups="idtx_product_development.group_module_product_development_manager"/>
                </xpath>
                <xpath expr="//field[@name='description']" position="replace">
                    <label for="description"/>
                    <div class="o_row">
                        <field name="description" readonly="1" nolabel="1"/>
                        <field name="clipboard_summary" widget="CopyClipboardButton" nolabel="1" string="" options="{'btn_class': 'secondary'}"/>
                    </div>
                </xpath>
            </field>
        </record>

        <record id="technical_sheet_tree_view_inherit_product_development_dbf" model="ir.ui.view">
            <field name="name">technical.sheet.tree.inherit.product.development.dbf</field>
            <field name="model">technical.sheet</field>
            <field name="inherit_id" ref="idtx_product_development.technical_sheet_tree_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="foxpro_article_code"/>
                    <field name="description"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>