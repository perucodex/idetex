<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="technical_sheet_form_view_inherit_product_development_dbf" model="ir.ui.view">
            <field name="name">technical.sheet.form.inherit.product.development.dbf</field>
            <field name="model">technical.sheet</field>
            <field name="inherit_id" ref="idtx_product_development.technical_sheet_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//header" position="inside">
                    <button name="action_export_to_foxpro" type="object" string="Export DBF" invisible="state == 'draft'"/>
                </xpath>
                <xpath expr="//field[@name='sitpro_sheet']" position="after">
                    <field name="foxpro_article_prefix" placeholder="P"/>
                    <field name="foxpro_export_state" widget="badge" readonly="1" decoration-success="foxpro_export_state == 'done'" decoration-danger="foxpro_export_state == 'error'" decoration-muted="foxpro_export_state == 'draft'"/>
                </xpath>
                <xpath expr="//field[@name='notes']" position="after">
                    <field name="foxpro_export_message" readonly="1" invisible="not foxpro_export_message"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>