<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extiende la list view de mrp.base.process para mostrar el memo
         abreviado que se graba en sys_proceso.dbf. Util para verificar
         de un vistazo que la sincronizacion al DBF refleja lo que el
         usuario espera. -->
    <record id="mrp_base_process_tree_view_sysproceso" model="ir.ui.view">
        <field name="name">mrp.base.process.list.sysproceso</field>
        <field name="model">mrp.base.process</field>
        <field name="inherit_id" ref="idtx_product_development.mrp_base_process_tree_view"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="sysproceso_memo" string="Proceso (DBF)" optional="show"/>
            </field>
        </field>
    </record>

    <!-- Tambien en el form, en modo readonly, para que el usuario vea
         exactamente que se grabaria sin tener que abrir el DBF. -->
    <record id="mrp_base_process_form_view_sysproceso" model="ir.ui.view">
        <field name="name">mrp.base.process.form.sysproceso</field>
        <field name="model">mrp.base.process</field>
        <field name="inherit_id" ref="idtx_product_development.mrp_base_process_form_view"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="sysproceso_memo" string="Proceso (DBF)" readonly="1"/>
            </field>
        </field>
    </record>
</odoo>
