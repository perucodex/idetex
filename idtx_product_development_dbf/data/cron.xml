<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_sync_texplus_tipart" model="ir.cron">
        <field name="name">TEXPLUS: Sincronizar catalogo TIPART</field>
        <field name="model_id" ref="model_texplus_tipart"/>
        <field name="state">code</field>
        <field name="code">model._cron_sync_tipart()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(minutes=5)).strftime('%Y-%m-%d %H:%M:%S')"/>
    </record>
</odoo>
