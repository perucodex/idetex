<odoo>

    <!-- Vista formulario -->
    <record id="view_stock_quant_import_form" model="ir.ui.view">
        <field name="name">stock.quant.import.form</field>
        <field name="model">stock.quant.import</field>
        <field name="arch" type="xml">
            <form string="Stock Quant Import">
                <header>
                    <button name="action_validate" type="object" string="Done" class="oe_highlight" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="filename" invisible="1"/>
                            <field name="file" filename="filename" readonly="state != 'draft'" accept=".xlsx"/>
                            <field name="location_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Imported Quants">
                            <field name="line_ids" readonly="1">
                                <list>
                                    <field name="location_id"/>
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="quant_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista lista -->
    <record id="view_stock_quant_import_tree" model="ir.ui.view">
        <field name="name">stock.quant.import.tree</field>
        <field name="model">stock.quant.import</field>
        <field name="arch" type="xml">
            <list string="Stock Quant Imports">
                <field name="name"/>
                <field name="date"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- Acción de ventana -->
    <record id="action_stock_quant_import" model="ir.actions.act_window">
        <field name="name">Stock Quant Imports</field>
        <field name="res_model">stock.quant.import</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menú -->
    <menuitem id="menu_stock_quant_import_root"
              name="Quant Imports"
              parent="stock.menu_stock_root"
              action="action_stock_quant_import"
              sequence="100"/>
</odoo>