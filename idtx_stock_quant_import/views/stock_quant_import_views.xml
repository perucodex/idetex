<odoo>

    <!-- Vista formulario -->
    <record id="view_stock_quant_import_form" model="ir.ui.view">
        <field name="name">stock.quant.import.form</field>
        <field name="model">stock.quant.import</field>
        <field name="arch" type="xml">
            <form string="Stock Quant Import" duplicate="0" delete="0">
                <header>
                    <button name="action_process" type="object" string="Process" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_validate" confirm="Are you sure you want to apply this inventory ?" type="object" string="Done" class="oe_highlight" invisible="state != 'process'"/>
                    <button name="action_clean" type="object" string="Clean" invisible="state != 'process'"/>
                    <button name="action_delete_import" type="object" string="Delete Import Xls" class="btn-danger" confirm="This will reverse all quantities and delete the generated rolls. Are you sure?" invisible="state != 'done'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="date" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="filename" invisible="1"/>
                            <field name="file" filename="filename" readonly="state != 'draft'" accept=".xlsx" required="1"/>
                            <field name="location_id" required="1" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Imported Quants">
                            <field name="line_ids">
                                <list decoration-danger="red_flag" editable="top">
                                    <field name="product_code" readonly="1"/>
                                    <field name="product_name" readonly="1"/>
                                    <field name="color_id"/>
                                    <button name="action_sync_color" type="object" icon="fa-refresh" title="Sincronizar Color por Partida" invisible="not color_id"/>
                                    <field name="recipe_color_code" readonly="1" force_save="1" decoration-success="recipe_color_code == color_code" decoration-danger="recipe_color_code != color_code"/>
                                    <field name="recipe_color_name" readonly="1" force_save="1" decoration-success="recipe_color_name == color_name" decoration-danger="recipe_color_name != color_name"/>
                                    <field name="color_code" readonly="1"/>
                                    <field name="color_name" readonly="1"/>
                                    <field name="ref" readonly="1"/>
                                    <field name="lot_name" readonly="1"/>
                                    <field name="location_id" readonly="1"/>
                                    <field name="quantity" sum="Total" readonly="1"/>
                                    <!-- Atributos físicos opcionales leídos del Excel.
                                         Se muestran junto a la cantidad para revisión previa. -->
                                    <field name="width" readonly="1"/>
                                    <field name="density" readonly="1"/>
                                </list>


                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista lista -->
    <record id="view_stock_quant_import_tree" model="ir.ui.view">
        <field name="name">stock.quant.import.tree</field>
        <field name="model">stock.quant.import</field>
        <field name="arch" type="xml">
            <list string="Stock Quant Imports" duplicate="0" delete="0">
                <field name="name"/>
                <field name="create_date" string="Time"/>
                <field name="create_uid" string="User" widget="many2one_avatar_user"/>
                <field name="item_count"/>
                <field name="total_weight"/>
                <field name="location_id"/>
                <field name="state"/>
                <field name="write_date" string="Modificación"/>
            </list>
        </field>
    </record>

    <!-- Acción de ventana -->
    <record id="action_stock_quant_import" model="ir.actions.act_window">
        <field name="name">Stock Quant Imports</field>
        <field name="res_model">stock.quant.import</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menú -->
    <menuitem id="menu_stock_quant_import_root"
              name="Quant Imports"
              parent="stock.menu_stock_warehouse_mgmt"
              action="action_stock_quant_import"
              groups="group_stock_quant_import_menu"
              sequence="900"/>
</odoo>