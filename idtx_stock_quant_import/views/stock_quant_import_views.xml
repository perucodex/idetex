<odoo>

    <!-- Vista formulario -->
    <record id="view_stock_quant_import_form" model="ir.ui.view">
        <field name="name">stock.quant.import.form</field>
        <field name="model">stock.quant.import</field>
        <field name="arch" type="xml">
            <form string="Stock Quant Import">
                <header>
                    <button name="action_process" type="object" string="Process" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_validate" confirm="Are you sure you want to apply this inventory ?" type="object" string="Done" class="oe_highlight" invisible="state != 'process'"/>
                    <button name="action_clean" type="object" string="Clean" invisible="state != 'process'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="date" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="filename" invisible="1"/>
                            <field name="file" filename="filename" readonly="state != 'draft'" accept=".xlsx" required="1"/>
                            <field name="location_id" required="1" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Imported Quants">
                            <field name="line_ids" readonly="1">
                                <list decoration-danger="red_flag">
                                    <field name="product_code"/>
                                    <field name="product_name"/>
                                    <field name="color_code"/>
                                    <field name="color_name"/>
                                    <field name="ref"/>
                                    <field name="lot_name"/>
                                    <field name="location_id"/>
                                    <field name="quantity" sum="Total"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista lista -->
    <record id="view_stock_quant_import_tree" model="ir.ui.view">
        <field name="name">stock.quant.import.tree</field>
        <field name="model">stock.quant.import</field>
        <field name="arch" type="xml">
            <list string="Stock Quant Imports">
                <field name="name"/>
                <field name="date"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- Acción de ventana -->
    <record id="action_stock_quant_import" model="ir.actions.act_window">
        <field name="name">Stock Quant Imports</field>
        <field name="res_model">stock.quant.import</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menú -->
    <menuitem id="menu_stock_quant_import_root"
              name="Quant Imports"
              parent="stock.menu_stock_warehouse_mgmt"
              action="action_stock_quant_import"
              groups="group_stock_quant_import_menu"
              sequence="900"/>
</odoo>