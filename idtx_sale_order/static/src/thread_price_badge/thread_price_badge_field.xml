<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="idtx_sale_order.ThreadPriceBadgeField">
        <span t-if="count" class="badge rounded-pill text-bg-info o_thread_price_badge"
              role="button" tabindex="0" t-att-title="title" t-on-click.prevent="onClick">
            <i class="fa fa-tags me-1" role="img" aria-label="Hilos"/>
            <t t-esc="label"/>
        </span>
    </t>

    <t t-name="idtx_sale_order.ThreadPriceBadgePopover">
        <div class="o_thread_price_badge_popover p-2">
            <div class="fw-bold mb-2">Precios de hilado en la lista de precios</div>
            <table class="table table-sm mb-0">
                <thead>
                    <tr>
                        <th class="text-start">Código</th>
                        <th class="text-start">Nombre</th>
                        <th class="text-start">Fecha</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="props.rows" t-as="row" t-key="row_index"
                        t-att-class="row.has_rule ? '' : 'text-danger'">
                        <td class="text-nowrap" t-esc="row.code"/>
                        <td t-esc="row.name"/>
                        <td class="text-nowrap" t-esc="row.date_display"/>
                    </tr>
                </tbody>
            </table>
        </div>
    </t>

</templates>
