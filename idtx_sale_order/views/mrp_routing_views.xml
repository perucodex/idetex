<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="mrp_routing_workcenter_operation_form_view_inherit" model="ir.ui.view">
            <field name="name">mrp.routing.workcenter.form.inherit</field>
            <field name="model">mrp.routing.workcenter.operation</field>
            <field name="inherit_id" ref="idtx_mrp.mrp_routing_workcenter_operation_form_view"/>
            <field name="arch" type="xml">
                <field name="company_id" position="before">
                    <field name="type_prices" invisible="operation_type == 'weaving'" groups="idtx_product_development.group_module_product_development_manager"/>
                    <field name="per_title" invisible="operation_type == 'weaving' or type_prices == 'pp'" widget="boolean_toggle" groups="idtx_product_development.group_module_product_development_manager"/>
                    <field name="currency_id" invisible="operation_type == 'weaving'" groups="idtx_product_development.group_module_product_development_manager"/>
                    <field name="unit_price" invisible = "type_prices == 'col' or operation_type == 'weaving'" groups="idtx_product_development.group_module_product_development_manager"/>
                </field>
                <page name="parameter_page" position="before">
                    <page name="prices_page" string="Prices" invisible="type_prices == 'pp' or per_title or operation_type == 'weaving'" groups="idtx_product_development.group_module_product_development_manager">
                        <field name="product_color_price_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                <field name="product_color_id"/>
                                <field name="unit_price"/>
                                <field name="currency_id" column_invisible="1"/>
                            </list> 
                        </field>
                    </page>
                    <page name="title_prices_page" string="Title Prices" invisible="type_prices == 'pp' or not per_title or operation_type == 'weaving'" groups="idtx_product_development.group_module_product_development_manager">
                        <field name="product_color_price_ids">
                            <list editable="bottom" open_form_view="True">
                                <field name="sequence" widget="handle"/>
                                <field name="product_color_id"/>
                                <field name="currency_id" column_invisible="1"/>
                            </list> 
                        </field>
                    </page>
                </page>
            </field>
        </record>


        <record id="product_color_price_form_view_inherit" model="ir.ui.view">
            <field name="name">product.color.price.form</field>
            <field name="model">product.color.price</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="product_color_id" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <notebook>
                            <page name="title_prices_page" string="Prices" groups="idtx_product_development.group_module_product_development_manager">
                                <field name="color_title_price_ids">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="title_ids" widget="many2many_tags"/>
                                        <field name="unit_price"/>
                                        <field name="currency_id" column_invisible="1"/>
                                    </list> 
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="mrp_routing_workcenter_operation_tree_view_inherit" model="ir.ui.view">
            <field name="name">mrp.routing.workcenter.list.inherit</field>
            <field name="model">mrp.routing.workcenter.operation</field>
            <field name="inherit_id" ref="idtx_mrp.mrp_routing_workcenter_operation_tree_view"/>
            <field name="arch" type="xml">
                <field name="workcenter_id" position="after">
                    <field name="currency_id"/>
                    <field name="unit_price"/>
                </field>
            </field>
        </record>

        <record id="mrp_routing_workcenter_operation_view_search_inherit" model="ir.ui.view">
            <field name="name">mrp.routing.workcenter.operation.view.search.inherit</field>
            <field name="model">mrp.routing.workcenter.operation</field>
            <field name="inherit_id" ref="idtx_mrp.mrp_routing_workcenter_operation_view_search"/>
            <field name="arch" type="xml">
                <field name="workcenter_id" position="after">
                    <field name="currency_id"/>
                </field>
            </field>
        </record>

    </data>
</odoo>
