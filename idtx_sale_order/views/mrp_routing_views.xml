<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="mrp_routing_workcenter_operation_form_view_inherit" model="ir.ui.view">
            <field name="name">mrp.routing.workcenter.form.inherit</field>
            <field name="model">mrp.routing.workcenter.operation</field>
            <field name="inherit_id" ref="idtx_mrp.mrp_routing_workcenter_operation_form_view"/>
            <field name="arch" type="xml">
                <field name="company_id" position="before">
                    <field name="currency_id" groups="idtx_product_development.group_module_product_development_manager"/>
                    <field name="type_prices" groups="idtx_product_development.group_module_product_development_manager"/>
                    <field name="unit_price" invisible = "type_prices == 'col'" groups="idtx_product_development.group_module_product_development_manager"/>
                </field>
                <notebook position="inside">
                    <page name="prices_page" string="Prices" invisible = "type_prices == 'pp'" groups="idtx_product_development.group_module_product_development_manager">
                        <field name="product_color_price_ids">
                            <list editable="bottom">
                                <field name="product_color_id" />
                                <field name="unit_price" />
                                <field name="currency_id" column_invisible="1"/>
                            </list> 
                        </field>
                    </page>
                </notebook>
            </field>
        </record>

        <record id="mrp_routing_workcenter_operation_tree_view_inherit" model="ir.ui.view">
            <field name="name">mrp.routing.workcenter.list.inherit</field>
            <field name="model">mrp.routing.workcenter.operation</field>
            <field name="inherit_id" ref="idtx_mrp.mrp_routing_workcenter_operation_tree_view"/>
            <field name="arch" type="xml">
                <field name="workcenter_id" position="after">
                    <field name="currency_id"/>
                    <field name="unit_price"/>
                </field>
            </field>
        </record>

        <record id="mrp_routing_workcenter_operation_view_search_inherit" model="ir.ui.view">
            <field name="name">mrp.routing.workcenter.operation.view.search.inherit</field>
            <field name="model">mrp.routing.workcenter.operation</field>
            <field name="inherit_id" ref="idtx_mrp.mrp_routing_workcenter_operation_view_search"/>
            <field name="arch" type="xml">
                <field name="workcenter_id" position="after">
                    <field name="currency_id"/>
                </field>
            </field>
        </record>

    </data>
</odoo>
