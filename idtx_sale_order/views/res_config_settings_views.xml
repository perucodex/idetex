<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="res_config_settings_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.product.development</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="40"/>
            <field name="inherit_id" ref="base.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <block id="connectors_setting_container" position="after">
                    <block title="Idetex Settings" name="default_idetex_setting_container">
                        <setting id="default_max_discount" string="Maximum Settings" company_dependent="1" help="Maximum discount authorized for salesmans without approval.">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label string="Maximum Discount" for="max_discount" class="col-lg-3 o_light_label"/>
                                    <field name="max_discount" widget="percentage"/>
                                </div>
                            </div>
                        </setting>
                        <setting id="default_sales_pricelist" string="Sales Pricelist" company_dependent="1" help="Pricelist used as the pricing source for all sales orders.">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label string="Pricelist" for="sales_pricelist_id" class="col-lg-3 o_light_label"/>
                                    <field name="sales_pricelist_id" options="{'no_create': True}"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                </block>
            </field>
        </record>

    </data>
</odoo>
