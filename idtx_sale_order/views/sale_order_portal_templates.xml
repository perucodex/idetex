<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="sale_portal_hide_amounts_when_quote" inherit_id="sale.sale_order_portal_content">

        <xpath expr="//div[@id='total' and @name='total']" position="attributes">
            <attribute name="t-if">not sale_order.is_quote</attribute>
        </xpath>

        <!-- Esconder el subtotal en cotizaciones -->

        <!-- <xpath expr="//td[@name='td_product_subtotal']" position="attributes">
            <attribute name="t-if">not sale_order.is_quote</attribute>
        </xpath>

        <xpath expr="//th[@id='subtotal_header']" position="attributes">
            <attribute name="t-if">not sale_order.is_quote</attribute>
        </xpath> -->

        <xpath expr="//table[@id='sales_order_table']//th[@id='product_qty_header']" position="before">
            <t t-set="display_taxes" t-value="not hide_taxes_details and not sale_order.is_quote and any(line._has_taxes() for line in lines_to_report)"/>
            <t t-set="display_design" t-value="any(line.printing_design_id for line in lines_to_report)"/>
            <t t-set="display_color" t-value="any((line.product_color_id if sale_order.is_quote else line.lab_dev_line_id) for line in lines_to_report)"/>
            <th t-if="display_design" class="text-start" id="product_design_header">
                Design
            </th>
            <th t-if="display_color" class="text-start" id="product_color_header">
                Color
            </th>
        </xpath>

        <xpath expr="//table[@id='sales_order_table']//th[@id='product_qty_header']" position="after">
            <th t-if="sale_order.is_quote" class="text-end" id="product_min_qty_header">
                Min Qty
            </th>
        </xpath>

        <xpath expr="//table[@id='sales_order_table']//td[@name='td_product_quantity']" position="before">
            <td t-if="display_design" name="td_product_min_qty" class="text-start">
                <span t-field="line.printing_design_id"/>
            </td>
            <td t-if="sale_order.is_quote and display_color" name="td_product_min_qty" class="text-start">
                <span t-field="line.product_color_id"/>
            </td>
            <td t-if="not sale_order.is_quote and display_color" name="td_product_min_qty" class="text-start">
                <span t-field="line.lab_dev_line_id"/>
            </td>
        </xpath>

        <xpath expr="//table[@id='sales_order_table']//td[@name='td_product_quantity']" position="after">
            <td t-if="sale_order.is_quote" name="td_product_min_qty" class="text-end">
                <span t-field="line.min_qty"/>
            </td>
        </xpath>

        <xpath expr="//t[@t-set='section_name_colspan']" position="replace">
            <t t-set="section_name_colspan" t-value="(3 + (1 if sale_order.is_quote else 0)) + (1 if display_discount else 0) + (1 if display_taxes else 0)"/>
        </xpath>

    </template>


    <template id="sale_portal_sign_modal_remove_amount_sentence" inherit_id="sale.sale_order_portal_sign_modal">
        <xpath expr="//main[@id='sign-dialog']/span" position="replace">
            <span t-if="sale_order.is_quote">
                By signing, you confirm acceptance on behalf of
                <b t-field="sale_order.partner_id.commercial_partner_id"/>.
            </span>
            <span t-else="">
                By signing, you confirm acceptance on behalf of
                <b t-field="sale_order.partner_id.commercial_partner_id"/>
                for the <b data-id="total_amount" t-field="sale_order.amount_total"/> quote.
            </span>
        </xpath>
        <xpath expr="//t[@t-call='portal.signature_form']" position="inside">
            <t t-set="mode" t-value="'draw'"/>
        </xpath>
    </template>

    <template id="sale_portal_my_home_sale_buttons" inherit_id="sale.portal_my_home_sale">
        <xpath expr="//div[@id='portal_client_category']/t[@t-call='portal.portal_docs_entry'][.//t[@t-set='url' and @t-value=&quot;'/my/orders'&quot;]]" position="before">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/sale_subscription/static/src/img/subscription.svg'"/>
                <t t-set="title">Sus Cotizaciones</t>
                <t t-set="url" t-value="'/my/signed_quotes'"/>
                <t t-set="text">Revisa tus cotizaciones</t>
                <t t-set="placeholder_count" t-value="'quotation_signed_count'"/>
            </t>
        </xpath>
    </template>

    <template id="sale_portal_sign_ok_quote_message" inherit_id="sale.sale_order_portal_template">
        <xpath expr="//div[hasclass('alert-success')]/t[@t-else='']" position="replace">
            <t t-elif="sale_order.is_quote">Se firmó su cotización.</t>
            <t t-else="">Your order has been signed.</t>
        </xpath>
    </template>

    <template id="sale_portal_breadcrumb_signed_quotes" inherit_id="sale.portal_my_home_menu_sale">
        <xpath expr="//li[@id='portal_breadcrumbs_sale']" position="replace">
            <li id="portal_breadcrumbs_sale" t-if="page_name in ('quote', 'signed_quote') or sale_order and sale_order.state in ('sent', 'cancel')" t-attf-class="breadcrumb-item #{'active ' if not sale_order else ''}">
                <a t-if="sale_order and sale_order.signed_on" t-attf-href="/my/signed_quotes?{{ keep_query() }}">Sus Cotizaciones</a>
                <a t-elif="sale_order" t-attf-href="/my/quotes?{{ keep_query() }}">Cotizaciones</a>
                <t t-elif="page_name == 'signed_quote'">Sus Cotizaciones</t>
                <t t-else="">Cotizaciones</t>
            </li>
        </xpath>
    </template>

</odoo>
