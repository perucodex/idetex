<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sitpro_sale_type_view_list" model="ir.ui.view">
        <field name="name">sitpro.sale.type.list</field>
        <field name="model">sitpro.sale.type</field>
        <field name="arch" type="xml">
            <list string="Tipos de proceso" editable="bottom">
                <field name="code"/>
                <field name="name"/>
                <field name="order_kind"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="sitpro_sale_type_view_form" model="ir.ui.view">
        <field name="name">sitpro.sale.type.form</field>
        <field name="model">sitpro.sale.type</field>
        <field name="arch" type="xml">
            <form string="Tipo de proceso">
                <sheet>
                    <widget name="web_ribbon" title="Archivado" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="order_kind"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sitpro_sale_type_view_search" model="ir.ui.view">
        <field name="name">sitpro.sale.type.search</field>
        <field name="model">sitpro.sale.type</field>
        <field name="arch" type="xml">
            <search string="Tipos de proceso">
                <field name="name"/>
                <field name="code"/>
                <filter name="service" string="Servicio" domain="[('order_kind', '=', 'S')]"/>
                <filter name="sale" string="Venta" domain="[('order_kind', '=', 'V')]"/>
                <filter name="stock" string="Venta de stock" domain="[('order_kind', '=', 'F')]"/>
                <separator/>
                <filter name="inactive" string="Archivados" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_order_kind" string="Orden" context="{'group_by': 'order_kind'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="sitpro_sale_type_action" model="ir.actions.act_window">
        <field name="name">Tipos de proceso</field>
        <field name="res_model">sitpro.sale.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Crea un tipo de proceso</p>
            <p>Maestro de tipos de proceso de la venta (heredado de SITPRO). Se elige en la orden de venta, pestaña Otra información.</p>
        </field>
    </record>

    <menuitem id="menu_sitpro_sale_type" name="Tipos de proceso"
              parent="sale.menu_sales_config" action="sitpro_sale_type_action" sequence="20"/>

</odoo>
