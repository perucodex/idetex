<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sale_order_view_form_inherit_sale" model="ir.ui.view">
        <field name="name">sale.order.view.form.inherit.sale.order</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Botón Confirm con id="action_confirm" -->
            <xpath expr="//button[@id='action_confirm']" position="attributes">
                <attribute name="invisible">state != 'sent' or is_quote and is_company_produce</attribute>
            </xpath>
            <!-- Botón Confirm sin id (el otro) -->
            <xpath expr="//button[@name='action_confirm'][@type='object'][not(@id)]" position="attributes">
                <attribute name="invisible">state != 'draft' or is_quote and is_company_produce</attribute>
            </xpath>
            <xpath expr="//button[@id='quotation_send_primary']" position="attributes">
                <attribute name="invisible">state != 'draft' or need_approval and is_company_produce</attribute>
            </xpath>
            <xpath expr="//button[@id='quotation_send']" position="attributes">
                <attribute name="invisible">state not in ('sent', 'sale') or need_approval and is_company_produce</attribute>
            </xpath>
            <field name="state" position="attributes">
                <attribute name="statusbar_visible">draft,sent,sale</attribute>
            </field>
            <xpath expr="//div[@name='button_box']/button[@name='action_view_invoice']" position="after">
                <button name="open_labdev"
                        class="oe_stat_button"
                        icon="fa-eyedropper"
                        type="object"
                        invisible="lab_dev_count == 0 or not is_company_produce">
                        <field name="lab_dev_count" widget="statinfo" string="Lab Dev's"/>
                </button>
                <button name="open_productions"
                        class="oe_stat_button"
                        icon="fa-gear"
                        type="object"
                        invisible="production_count == 0 or not is_company_produce">
                        <field name="production_count" string="Productions" widget="statinfo"/>
                </button>
                <button name="open_sales"
                        class="oe_stat_button"
                        icon="fa-money"
                        type="object"
                        invisible="sale_count == 0 or not is_company_produce">
                        <field name="sale_count" string="Sales" widget="statinfo"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="domain">[('is_company','=', True)]</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="applicant_id" required="is_company_produce and not is_subscription" invisible="not partner_id or not is_company_produce or is_subscription" readonly="state == 'sale'" domain="[('parent_id','=',partner_id)]" context="{'default_parent_id': partner_id}"/>
            </xpath>
            <xpath expr="//field[@name='payment_term_id']" position="before">
                <field name="sale_type" required="is_company_produce or not is_subscription" options="{'no_create': True, 'no_open': True}" invisible="not is_company_produce or is_subscription"/>
            </xpath>
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="lab_dev_ids" widget="many2many_tags" required="state == 'sale'" options="{'no_create': True, 'no_open': True}" invisible="is_quote or not is_company_produce or not need_labdev" readonly="state == 'sale'" force_save="1"/>
            </xpath>
            <xpath expr="//header/button[@name='action_confirm'][1]" position="after">
                <button name="create_labdev" class="btn-primary" string="Create LabDev" type="object" invisible="is_quote or not is_company_produce or not has_pending_labdev_lines"/>
                <!-- <button name="manual_labdev" class="btn-secondary" string="Manual LabDev" type="object" invisible="lab_dev_ids or is_quote"/> -->
                <button name="action_create_sale_order" type="object" string="Sale Order" class="btn-primary" groups="base.group_user" invisible="state != 'sent' or not is_quote or not is_company_produce or need_approval"/>
                <button name="action_request_approval" type="object" string="Request Approval" class="btn-primary" invisible="not need_approval or state == 'for_app' or not is_company_produce"/>
                <button name="action_approve" type="object" string="Approve Discount" class="btn-primary" groups="sales_team.group_sale_salesman_all_leads" invisible="state != 'for_app' or not is_company_produce"/>
                <button name="action_price_preview" type="object" string="Prices" class="btn-secondary" groups="sales_team.group_sale_salesman_all_leads" invisible="not is_quote or not is_company_produce or is_subscription"/>
            </xpath>
            <xpath expr="//header" position="after">
                <div class="alert alert-warning d-flex justify-content-between align-items-center" role="alert" invisible="not weaving_warning or not is_company_produce">
                    <div>
                        <field name="weaving_warning" class="w-auto"/>
                        <button name="refresh_warnings" type="object" class="oe_link py-0 text-decoration-underline" string="Update warnings"/>
                    </div>
                    <field name="color_name_warning" invisible="1"/>
                    <button name="update_color_names" type="object" class="oe_link py-0 text-decoration-underline" string="Update name" invisible="not color_name_warning"/>
                </div>
                <field name="is_company_produce" invisible="1"/>
                <field name="need_approval" invisible="1"/>
                <field name="has_pending_labdev_lines" invisible="1"/>
            </xpath>
            <xpath expr="//notebook/page/field[@name='order_line']/list/field[@name='product_template_id']" position="after">
                <field name="available_operation_ids" column_invisible="1"/>
                <field name="product_color_id" options="{'no_create': True}" required="is_weaving and not color_name and not parent.lab_dev_ids" readonly="not is_weaving" column_invisible="not parent.is_company_produce"/>
                 <!-- column_invisible="not parent.is_quote"/> -->
                <field name="has_approved_lab_line" column_invisible="1"/>
                <field name="diff_days" column_invisible="1"/>
                <field name="color_name" required="is_weaving and not parent.lab_dev_ids and parent.is_company_produce and is_lab_color" readonly="not is_weaving or not is_lab_color" column_invisible="parent.is_quote or parent.lab_dev_ids or not parent.is_company_produce"/>
                <field name="color_name" required="is_weaving and not parent.lab_dev_ids and parent.is_company_produce and is_lab_color" readonly="not is_weaving or not is_lab_color" column_invisible="parent.is_quote or not parent.lab_dev_ids or not parent.is_company_produce" widget="badge" decoration-success="has_approved_lab_line" decoration-danger="not has_approved_lab_line" force_save="1"/>
                <field name="lab_dev_line_id" required="is_weaving and parent.is_company_produce and not parent.is_quote and is_lab_color" readonly="not is_weaving" column_invisible="parent.is_quote or not parent.is_company_produce" options="{'no_create': True}"/>
                <field name="is_printing" column_invisible="1"/>
                <field name="printing_design_id" options="{'no_create': True}" required="is_printing" readonly="not is_printing" column_invisible="not parent.is_company_produce" optional="hide" domain="[('partner_id','=', order_partner_id)]"/>
                <field name="printing_design_name" column_invisible="not parent.is_company_produce" optional="hide"/>
                <field name="bom_id" options="{'no_create': True}" required="is_weaving and parent.is_company_produce and not parent.is_quote" readonly="not is_weaving" domain="[('product_tmpl_id','=',product_template_id)]" optional="hide" column_invisible="not parent.is_quote or not parent.is_company_produce"/>
                <field name="operation_ids" options="{'no_create': True}" required="parent.sale_type == 'service' and parent.is_company_produce and is_weaving" readonly="not is_weaving or parent.sale_type != 'service'" domain="[('id','in',available_operation_ids)]" widget="many2many_tags" force_save="1" optional="hide" column_invisible="not parent.is_quote or not parent.is_company_produce"/>
                <field name="weaving_loss" readonly="not is_weaving" optional="hide" widget="percentage" column_invisible="not parent.is_quote or not parent.is_company_produce"/>
                <field name="production_loss" readonly="not is_weaving" optional="hide" widget="percentage" column_invisible="not parent.is_quote or not parent.is_company_produce"/>
                <field name="min_qty" readonly="not is_weaving" optional="hide" column_invisible="not parent.is_quote or not parent.is_company_produce"/>
                <field name="dis_app" column_invisible="1"/>
                <field name="is_rect" column_invisible="1"/>
                <button name="action_open_size_qty_wizard" type="object" icon="fa-sort-amount-desc" class="btn-link" title="Edit Sizes Qty Rectilinear" invisible="not is_rect or parent.is_quote"/>
            </xpath>

            <xpath expr="//notebook/page/field[@name='order_line']/list/field[@name='price_unit']" position="after">
                <field name="parent_is_quote" column_invisible="1"/>
                <field name="price_items" column_invisible="1"/>
                <field name="is_salesman" column_invisible="1"/>
                <widget name="price_items_widget" column_invisible="is_salesman or not parent.is_company_produce" width="20px"/>
            </xpath>

            <xpath expr="//notebook/page/field[@name='order_line']/list/field[@name='price_unit']" position="attributes">
                <attribute name="readonly">qty_invoiced &gt; 0 or is_salesman and parent.is_company_produce and is_weaving</attribute>
                <attribute name="force_save">1</attribute>
            </xpath>

            <xpath expr="//notebook/page/field[@name='order_line']/list/field[@name='discount']" position="attributes">
                <attribute name="readonly">not parent.is_quote and is_salesman and parent.is_company_produce and is_weaving</attribute>
                <attribute name="force_save">1</attribute>
            </xpath>

        </field>
    </record>

    <record id="sale_order_tree_inherit_sale" model="ir.ui.view">
        <field name="name">sale.order.view.form.inherit.sale.order</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_tree"/>
        <field name="arch" type="xml">
            <field name="state" position="attributes">
                <attribute name="decoration-warning">state == 'for_app'</attribute>
            </field>
        </field>
    </record>

</odoo>