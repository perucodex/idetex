<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Ficha de cotización de estampado (JP, 22-sep-2026): formulario reducido
         para VENDEDORES, replica la ficha Excel. El diseño nace en borrador y
         desarrollo lo completa después en el formulario completo. -->
    <record id="view_printing_design_form_quote" model="ir.ui.view">
        <field name="name">printing.design.form.quote</field>
        <field name="model">printing.design</field>
        <field name="priority" eval="50"/>
        <field name="arch" type="xml">
            <form string="Ficha de cotización de estampado">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,development,done" readonly="1"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="alert" invisible="state != 'draft'">
                        Llena los datos que conoces del arte y la tela. Desarrollo completará el resto y fijará los precios.
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="state == 'draft'">
                        Esta ficha ya está en manos de desarrollo: solo lectura.
                    </div>
                    <div class="oe_title">
                        <label for="file_desc" string="Arte"/>
                        <h1><field name="file_desc" placeholder="Nombre del arte / diseño" readonly="state != 'draft'" required="1"/></h1>
                    </div>
                    <group>
                        <group string="Datos generales">
                            <field name="code" string="Código de arte" readonly="1" force_save="1"/>
                            <field name="printing_date" string="Fecha" readonly="state != 'draft'" required="1"/>
                            <field name="partner_id" string="Cliente" readonly="state != 'draft'" required="1" options="{'no_quick_create': True, 'no_create_edit': True}"/>
                            <field name="quotation_id" readonly="1" invisible="not quotation_id"/>
                            <field name="salesperson_id" readonly="1"/>
                            <field name="cylinder_qty" string="Cantidad de colores" readonly="state != 'draft'" required="printing_type == 'rotary'"/>
                        </group>
                        <group string="Tela">
                            <field name="fabric_base" string="Tipo de tela" readonly="state != 'draft'"/>
                            <field name="width" readonly="state != 'draft'"/>
                            <field name="density" readonly="state != 'draft'"/>
                            <label for="yield_meter" string="Rendimiento"/>
                            <div name="yield_meter" class="o_row">
                                <field name="yield_meter" readonly="state != 'draft'"/>
                                <span class="ms-1 oe_inline">m/kg</span>
                            </div>
                        </group>
                    </group>
                    <group>
                        <group string="Tipo de estampado">
                            <field name="printing_type" widget="radio" options="{'horizontal': true}" readonly="state != 'draft'" required="1"/>
                            <field name="process_type_digital" string="Proceso" widget="radio" options="{'horizontal': true}" invisible="printing_type != 'digital'" required="printing_type == 'digital'" readonly="state != 'draft'"/>
                            <field name="process_type_rotary" string="Proceso" widget="radio" options="{'horizontal': true}" invisible="printing_type != 'rotary'" required="printing_type == 'rotary'" readonly="state != 'draft'"/>
                        </group>
                        <group string="Arte">
                            <field name="design_image" string="Imagen del arte" filename="file_name" widget="binary" readonly="state != 'draft'"/>
                            <field name="file_name" invisible="1"/>
                            <field name="preview_image" nolabel="1" colspan="2" readonly="1" widget="image" options="{'preview_image': 'preview_image', 'size': [200, 200]}" invisible="not preview_image"/>
                        </group>
                    </group>
                    <group>
                        <group string="Porcentaje de cobertura">
                            <field name="coverage" nolabel="1" colspan="2" widget="radio" readonly="state != 'draft'"/>
                        </group>
                        <group string="Porcentaje de color">
                            <field name="color_depth" nolabel="1" colspan="2" widget="radio" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <group>
                        <group string="Cuidados base de la tela">
                            <field name="thiotan" widget="boolean_toggle" readonly="state != 'draft'"/>
                            <field name="discharge_prepared" widget="boolean_toggle" readonly="state != 'draft'"/>
                        </group>
                        <group string="Productos adicionales antes de estampar">
                            <field name="pasting" widget="boolean_toggle" readonly="state != 'draft'"/>
                            <field name="rotary_bonding" widget="boolean_toggle" readonly="state != 'draft'" invisible="printing_type != 'rotary'"/>
                            <field name="digital_defuzzing" widget="boolean_toggle" readonly="state != 'draft'" invisible="printing_type != 'digital'"/>
                        </group>
                        <group string="Solidez a ofrecer">
                            <field name="fastness_dry_rub" readonly="state != 'draft'"/>
                            <field name="fastness_wet_rub" readonly="state != 'draft'"/>
                            <field name="fastness_wash" readonly="state != 'draft'"/>
                        </group>
                        <group string="Productos adicionales después de estampar">
                            <field name="polyurethane" widget="boolean_toggle" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <group string="Observaciones">
                        <field name="quote_notes" nolabel="1" colspan="2" readonly="state != 'draft'" placeholder="Observaciones para desarrollo..."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Lista de diseños: columna con la cotización de origen. -->
    <record id="view_printing_design_list_inherit_quote" model="ir.ui.view">
        <field name="name">printing.design.list.inherit.quote</field>
        <field name="model">printing.design</field>
        <field name="inherit_id" ref="idtx_printing.view_printing_design_list"/>
        <field name="arch" type="xml">
            <field name="fabric_base" position="after">
                <field name="quotation_id" optional="show"/>
                <field name="salesperson_id" optional="show"/>
            </field>
        </field>
    </record>

    <!-- Formulario completo (desarrollo): cotización de origen y vendedor que
         creó la ficha, junto al cliente. -->
    <record id="view_printing_design_form_inherit_quote" model="ir.ui.view">
        <field name="name">printing.design.form.inherit.quote</field>
        <field name="model">printing.design</field>
        <field name="inherit_id" ref="idtx_printing.view_printing_design_form"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="quotation_id" readonly="1"/>
                <field name="salesperson_id" readonly="1"/>
            </field>
        </field>
    </record>

    <!-- Fichas de estampado de una cotización (botón inteligente). -->
    <record id="action_printing_design_from_quote" model="ir.actions.act_window">
        <field name="name">Fichas de estampado</field>
        <field name="res_model">printing.design</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'form_view_ref': 'idtx_sale_order.view_printing_design_form_quote'}</field>
    </record>

</odoo>
