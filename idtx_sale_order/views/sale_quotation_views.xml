<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- La pantalla de entrada de la app Ventas (ícono / `/odoo/sales`) la
         decide `ir.actions.act_window.path='sales'`, que pertenece a la
         acción CORE `action_quotations_with_onboarding`. `path` tiene unique
         constraint en BD: un fix anterior le quitaba el path a esta acción
         core para dárselo a `sale_quotation_action` (propia), pero eso rompe
         en cada `-u all`/`-u sale` posterior — el módulo `sale` vuelve a
         escribir `path='sales'` en SU PROPIA acción ANTES de que este
         archivo corra (core siempre carga antes que los módulos que
         dependen de él), y choca con el valor que dejó la acción propia en
         la corrida anterior (UniqueViolation, tumba el registro completo).
         Fix robusto: filtrar la acción core IN SITU (mismo id, mismo path,
         nunca compite con nadie por el valor) en vez de robarle el path. -->
    <record id="sale.action_quotations_with_onboarding" model="ir.actions.act_window">
        <field name="domain">[('is_quote', '=', True)]</field>
        <field name="context">{'search_default_my_quotation': 1, 'default_is_quote': True}</field>
    </record>

    <record id="sale_quotation_action" model="ir.actions.act_window">
        <field name="name">Quotations</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,kanban,form,calendar,pivot,graph,activity</field>
        <field name="search_view_id" ref="sale.sale_order_view_search_inherit_quotation"/>
        <field name="context">{'search_default_my_quotation': 1, 'default_is_quote': True}</field>
        <field name="domain">[('is_quote','=', True)]</field>
    </record>

    <record id="sale_order_action" model="ir.actions.act_window">
        <field name="name">Sales Orders</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,kanban,form,calendar,pivot,graph,activity</field>
        <field name="search_view_id" ref="sale.sale_order_view_search_inherit_sale"/>
        <field name="context">{'search_default_my_quotation': 1, 'default_is_quote': False}</field>
        <field name="domain">[('is_quote','=', False)]</field>
    </record>

    <data noupdate="0">
        <menuitem id="idtx_quotation_menu" name="Quotations" action="sale_quotation_action" sequence="10" parent="sale.sale_order_menu"/>
        <menuitem id="idtx_sale_order_menu" name="Sales Orders" action="sale_order_action" sequence="20" parent="sale.sale_order_menu"/>
        <menuitem id="sale_product_color_menu" name="Product Color" action="product_color_action" sequence="30" parent="sale.sale_order_menu" groups="sales_team.group_sale_salesman_all_leads"/>
        <menuitem id="sale_quality_tone_pending_menu" name="Evaluaciones Tono Pendientes" action="idtx_batch_quality.action_quality_tone_pending_list" sequence="50" parent="sale.sale_order_menu" groups="sales_team.group_sale_salesman"/>
        
        <!-- `active=False` solo los oculta del árbol de menús; se eliminan
             del todo para que no queden alcanzables por ninguna otra vía
             (búsqueda, breadcrumbs, etc). El fix real de la pantalla de
             entrada de la app está arriba (dominio de la acción core).
             Se usa una función IDEMPOTENTE en vez de <delete>: el delete
             borra el xmlid junto con el menú y en cada -u posterior fallaba
             con "External ID not found: sale.menu_sale_quotations". -->
        <function model="sale.order" name="_idtx_remove_core_sale_menus" eval="[[]]"/>
    </data>

</odoo>
