        <record id="lab_dev_form_view_inherit" model="ir.ui.view">
            <field name="name">lab.dev.form.inherit</field>
            <field name="model">lab.dev</field>
            <field name="inherit_id" ref="idtx_laboratory.lab_dev_form_view"/>
