        <record id="mrp_production_workorder_tree_view_sale_readonly" model="ir.ui.view">
            <field name="name">mrp.production.work.order.list.sale.readonly</field>
            <field name="model">mrp.workorder</field>
            <field name="arch" type="xml">
                <list create="0" edit="0" delete="0">
                    <field name="name" string="Operation"/>
                    <field name="workcenter_id"/>
                    <field name="product_id" optional="show"/>
                    <field name="qty_remaining" string="Quantity" optional="show"/>
                    <field name="date_start" optional="hide"/>
                    <field name="date_finished" optional="hide"/>
                    <field name="duration_expected" widget="float_time" optional="hide"/>
                    <field name="duration" widget="float_time" optional="hide"/>
                    <field name="state" widget="badge" decoration-info="state == 'progress'" decoration-success="state == 'done'" decoration-danger="state == 'cancel'" decoration-warning="state == 'blocked'" decoration-muted="state == 'ready'"/>
                </list>
            </field>
        </record>

        <record id="mrp_production_workorder_form_view_sale_readonly" model="ir.ui.view">
            <field name="name">mrp.production.work.order.form.sale.readonly</field>
            <field name="model">mrp.workorder</field>
            <field name="arch" type="xml">
                <form string="Work Order" create="0" edit="0" delete="0">
                    <sheet>
                        <group>
                            <group>
                                <field name="name" readonly="1"/>
                                <field name="production_id" readonly="1"/>
                                <field name="workcenter_id" readonly="1"/>
                                <field name="product_id" readonly="1"/>
                            </group>
                            <group>
                                <field name="qty_remaining" readonly="1"/>
                                <field name="date_start" readonly="1"/>
                                <field name="date_finished" readonly="1"/>
                                <field name="state" readonly="1"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="mrp_production_form_view_inherit" model="ir.ui.view">
            <field name="name">mrp.production.form.inherit</field>
            <field name="model">mrp.production</field>
            <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
            <field name="arch" type="xml">
                <div name="bom_div" position="after">
                    <field name="sale_type" readonly="state != 'draft'"/>
                    <field name="order_id" readonly="1" invisible="not order_id"/>
                    <field name="partner_id" readonly="1" invisible="not partner_id"/>
                    <field name="color_code" readonly="1" invisible="not color_code"/>
                    <field name="color_name" readonly="1" invisible="not color_name"/>
                </div>
            </field>
        </record>

        <record id="mrp_production_sale_order_tree_view" model="ir.ui.view">
            <field name="name">mrp.production.sale.order.list</field>
            <field name="model">mrp.production</field>
            <field name="inherit_id" ref="mrp.mrp_production_tree_view" />
            <field name="arch" type="xml">
                <field name="product_id" position="after">
                    <field name="order_id" string="Order Reference" readonly="1" optional="show"/>
                    <field name="partner_id" string="Client" readonly="1" optional="show"/>
                    <field name="color_name" string="Color" readonly="1"/>
                </field>
            </field>
        </record>

        <record id="mrp_production_view_search_inherit_sale_order" model="ir.ui.view">
            <field name="name">mrp.production.search.view.inherit.sale.order</field>
            <field name="model">mrp.production</field>
            <field name="inherit_id" ref="mrp.view_mrp_production_filter"/>
            <field name="arch" type="xml">
                <filter name="date" position="after">
                    <filter string="Order" name="order" domain="[]" context="{'group_by': 'order_id'}"/>
                    <filter string="Client" name="partner" domain="[]" context="{'group_by': 'partner_id'}"/>
                </filter>
            </field>
        </record>

    </data>
</odoo>