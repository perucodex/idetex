<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="mrp_production_form_view_inherit" model="ir.ui.view">
            <field name="name">mrp.production.form.inherit</field>
            <field name="model">mrp.production</field>
            <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
            <field name="arch" type="xml">
                <button name="action_confirm" position="after">
                    <field name="manual_recipe" invisible="1"/>
                    <button name="action_manual" invisible="manual_recipe or state != 'draft' or not bom_id or manual_color_recipe_id" string="Manual Recipe" type="object" class="oe_highlight" data-hotkey="q"/>
                    <button name="action_manual" invisible="not manual_recipe or state != 'draft' or not bom_id or manual_color_recipe_id" string="Labdev Recipe" type="object" class="oe_highlight" data-hotkey="q"/>
                </button>
                <div name="bom_div" position="after">
                    <field name="color_recipe_id" readonly="1" invisible="manual_recipe"/>
                    <field name="manual_color_recipe_id" invisible="not manual_recipe or state != 'draft'" domain="[('product_id','=', product_id),('state','=','approved')]" options="{'no_create': True, 'no_edit': True}"/>
                </div>
            </field>
        </record>

    </data>
</odoo>