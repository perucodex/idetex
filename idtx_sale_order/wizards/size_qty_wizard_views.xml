<!-- views/rectilineo_wizard_views.xml -->
<odoo>

    <record id="view_sizq_qty_wizard_form" model="ir.ui.view">
        <field name="name">size.qty.wizard.form</field>
        <field name="model">size.qty.wizard</field>
        <field name="arch" type="xml">
            <form string="Size Qty (Rectilinear)">
                <sheet>
                    <field name="locked" invisible="1"/>
                    <field name="technical_sheet_id" invisible="1"/>
                    <group>
                        <field name="line_ids" nolabel="1" invisible="locked">
                            <list editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="size" column_invisible="1"/>
                                <field name="size_line_id"/>
                                <field name="length" readonly="1"/>
                                <field name="width" readonly="1"/>
                                <field name="product_qty"/>
                            </list>
                        </field>
                        <field name="line_ids" nolabel="1" invisible="not locked" readonly="1">
                            <list create="0" delete="0" edit="0">
                                <field name="sequence"/>
                                <field name="size_line_id" options="{'no_create': True}"/>
                                <field name="length"/>
                                <field name="width"/>
                                <field name="product_qty"/>
                            </list>
                        </field>
                    </group>
                </sheet>
                <footer>
                    <button string="Aplicar" type="object" name="action_apply" class="btn-primary" invisible="locked"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
