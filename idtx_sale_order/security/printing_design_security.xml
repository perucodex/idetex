<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Vendedores: crean fichas de estampado desde la cotización y solo
             pueden modificar las que siguen en borrador (JP, 22-sep-2026). -->
        <record id="printing_design_salesman_write_draft_rule" model="ir.rule">
            <field name="name">Ficha de estampado: vendedor edita solo borradores</field>
            <field name="model_id" ref="idtx_printing.model_printing_design"/>
            <field name="domain_force">[('state', '=', 'draft')]</field>
            <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <!-- Los responsables de estampado no quedan limitados por la regla anterior. -->
        <record id="printing_design_manager_write_all_rule" model="ir.rule">
            <field name="name">Ficha de estampado: responsable edita todo</field>
            <field name="model_id" ref="idtx_printing.model_printing_design"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('idtx_printing.group_module_print_manager'))]"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
