<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <function model="ir.model.data" name="write">
            <function model="ir.model.data" name="search">
                <value eval="[('module', '=', 'idtx_sale_order'), ('name', '=', 'group_sale_mrp_readonly')]"/>
            </function>
            <value eval="{'noupdate': False}"/>
        </function>

        <record id="group_sale_mrp_readonly" model="res.groups">
            <field name="name">User: Own Documents + Manufacturing Read Only</field>
            <field name="sequence">15</field>
            <field name="privilege_id" ref="sales_team.res_groups_privilege_sales"/>
            <field name="implied_ids" eval="[(6, 0, [ref('sales_team.group_sale_salesman')])]"/>
            <field name="comment">Allows viewing manufacturing orders linked to sale orders without operational manufacturing rights.</field>
        </record>

        <function model="res.groups" name="write">
            <function model="res.groups" name="search">
                <value eval="[('id', '=', ref('idtx_sale_order.group_sale_mrp_readonly'))]"/>
            </function>
            <value eval="{
                'name': 'User: Own Documents + Manufacturing Read Only',
                'sequence': 15,
                'privilege_id': ref('sales_team.res_groups_privilege_sales'),
                'implied_ids': [(6, 0, [ref('sales_team.group_sale_salesman')])],
                'comment': 'Allows viewing manufacturing orders linked to sale orders without operational manufacturing rights.',
            }"/>
        </function>

        <record id="mrp_production_sale_salesman_rule" model="ir.rule">
            <field name="name">MRP Production from Own Sales Orders</field>
            <field name="model_id" ref="mrp.model_mrp_production"/>
            <field name="domain_force">[('sale_order_line_id.order_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('idtx_sale_order.group_sale_mrp_readonly'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <record id="mrp_production_sale_salesman_all_rule" model="ir.rule">
            <field name="name">MRP Production from All Sales Orders</field>
            <field name="model_id" ref="mrp.model_mrp_production"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman_all_leads'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <record id="mrp_workorder_sale_salesman_rule" model="ir.rule">
            <field name="name">MRP Work Orders from Own Sales Orders</field>
            <field name="model_id" ref="mrp.model_mrp_workorder"/>
            <field name="domain_force">[('production_id.sale_order_line_id.order_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('idtx_sale_order.group_sale_mrp_readonly'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <record id="mrp_workorder_sale_salesman_all_rule" model="ir.rule">
            <field name="name">MRP Work Orders from All Sales Orders</field>
            <field name="model_id" ref="mrp.model_mrp_workorder"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman_all_leads'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>
        
    </data>
</odoo>