<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_saleorder_add_color" inherit_id="sale.report_saleorder_document">
        <xpath expr="//div[hasclass('page')]" position="inside">
            <t t-if="doc.weaving_warning">
                 <div class="idtx_quote_warning_watermark">
                    <span class="idtx_quote_warning_watermark_text">
                        COTIZACION REFERENCIAL SUJETA A VALIDACION TECNICA Y COMERCIAL
                    </span>
                </div>
            </t>
        </xpath>

        <!-- Inserta color -->
        <xpath expr="//th[@name='th_description']" position="after">
            <th name="th_color" class="text-start">Color</th>
            <th name="th_min_qty" class="text-start">Min. Qty.</th>
            <th t-if="doc.is_quote" name="th_customer_lead" class="text-start">Customer Lead</th>
        </xpath>
        <xpath expr="//td[@name='td_product_name']" position="after">
            <td name="td_product_color" class="text-start">
                <span t-if="line.product_color_id" t-field="line.product_color_id.name"/>
            </td>
            <td name="td_min_qty" class="text-end">
                <span t-field="line.min_qty"/>
            </td>
            <td t-if="doc.is_quote" name="td_customer_lead" class="text-end">
                <span t-field="line.customer_lead"/>
            </td>
        </xpath>
        <!-- Inserta estampado -->
        <xpath expr="//th[@name='th_description']" position="after">
            <!-- <th t-if="doc.is_printing" name="th_printing_image" class="text-start">Sample</th> -->
            <th t-if="doc.is_printing" name="th_printing_design_id" class="text-start">Design</th>
        </xpath>
        <xpath expr="//td[@name='td_product_name']" position="after">
            <!-- <td t-if="doc.is_printing" name="td_printing_image" class="text-start">
                <t t-if="line.printing_design_id.preview_image">
                    <span t-field="line.printing_design_name"/>
                </t>
            </td> -->
            <td t-if="doc.is_printing" name="td_printing_design_id" class="text-start">
                <span t-field="line.printing_design_id"/>
            </td>
        </xpath>
        <xpath expr="//div[@id='informations']" position="inside">
            <div t-if="doc.applicant_id.name" class="col">
                <strong>Applicant</strong>
                <div t-field="doc.applicant_id.name">Mitchell Admin</div>
            </div>
        </xpath>
        <!-- Mover la firma del cliente al final del reporte (despues de todas las tablas) -->
        <xpath expr="//div[@name='signature']" position="replace">
            <t/>
        </xpath>
        <xpath expr="//div[span[@name='order_note']]" position="after">
            <div t-if="doc.signature"
                 class="mt-4 ml64 mr4" name="signature">
                <div class="offset-8">
                    <strong>Firma</strong>
                </div>
                <div class="offset-8">
                    <img t-att-src="image_data_uri(doc.signature)" style="max-height: 4cm; max-width: 8cm;"/>
                </div>
                <div class="offset-8 text-center">
                    <span t-field="doc.signed_by"/>
                </div>
            </div>
        </xpath>
        <xpath expr="//div[@name='so_total_summary']" position="attributes">
            <attribute name="t-if">not doc.is_quote</attribute>
        </xpath>
        <xpath expr="//td[@name='td_product_taxes']" position="attributes">
            <attribute name="t-if">display_taxes and not doc.is_quote</attribute>
        </xpath>
        <xpath expr="//th[@name='th_taxes']" position="attributes">
            <attribute name="t-if">display_taxes and not doc.is_quote</attribute>
        </xpath>
        <!-- Tabla de detalle de servicio de estampado digital -->
        <xpath expr="//div[span[@name='order_note']]" position="before">
            <t t-if="doc.is_digital">
                <div class="o_ps_pagebreak"/>
                <h3 class="o_ps_title">Digital Printing Design Service Price Summary</h3>
                <table class="table table-sm o_main_table o_ps_grid o_ignore_layout_styling" style="font-size:11px;">
                    <thead>
                        <tr>
                            <th class="text-start">Producto</th>
                            <th class="text-start">Diseño</th>
                            <th class="text-start">Fondo de tela</th>
                            <th class="text-end">Ancho</th>
                            <th class="text-end">Densidad</th>
                            <th class="text-end">Rendimiento</th>
                            <th class="text-start">Rango</th>
                            <th class="text-end">Precio/mt</th>
                            <th class="text-end">Precio / strike off</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="doc.order_line.filtered(lambda l: l.printing_design_id and l.printing_design_id.printing_type == 'digital')" t-as="line">
                            <t t-set="design" t-value="line.printing_design_id"/>
                            <t t-set="prices" t-value="(design.digital_unit_price_ids.sorted('sequence') or [])[:6]"/>
                            <t t-set="nrows" t-value="len(prices) or 1"/>
                            <t t-foreach="range(nrows)" t-as="ri">
                                <t t-set="price" t-value="prices[ri] if ri &lt; len(prices) else None"/>
                                <tr>
                                    <t t-if="ri == 0">
                                        <td t-att-class="'text-start align-middle' + (' o_ps_bl' if line_last else '')" t-att-rowspan="nrows">
                                            <strong t-field="line.name"/>
                                        </td>
                                        <td class="text-start align-middle" t-att-rowspan="nrows">
                                            <div><strong t-field="design.code"/></div>
                                            <div t-if="design.file_desc" class="text-muted"><span t-field="design.file_desc"/></div>
                                            <div class="text-muted"><span t-field="design.printing_type"/><span t-if="design.process_type_digital"> · <span t-field="design.process_type_digital"/></span></div>
                                            <img t-if="design.preview_image" t-att-src="image_data_uri(design.preview_image)" style="height:1.8cm; margin-top:3px;"/>
                                        </td>
                                        <td class="text-start align-middle" t-att-rowspan="nrows"><span t-field="design.fabric_base"/></td>
                                        <td class="text-end align-middle" t-att-rowspan="nrows"><span t-field="line.bom_id.technical_sheet_id.width"/></td>
                                        <td class="text-end align-middle" t-att-rowspan="nrows"><span t-field="line.bom_id.technical_sheet_id.density"/></td>
                                        <td class="text-end align-middle" t-att-rowspan="nrows"><span t-esc="'%.2f' % (line.bom_id.technical_sheet_id.yield_meter or 0.0)"/></td>
                                    </t>
                                    <td class="text-start"><span t-if="price" t-field="price.range"/></td>
                                    <td class="text-end"><span t-if="price" t-field="price.unit_price" t-options="{'widget':'monetary','display_currency':price.currency_id}"/></td>
                                    <t t-if="ri == 0">
                                        <td t-att-class="'text-end align-middle' + (' o_ps_br' if line_last else '')" t-att-rowspan="nrows"><span t-out="doc.company_id.strike_off or 0.0" t-options="{'widget': 'monetary', 'display_currency': design.currency_id}"/></td>
                                    </t>
                                </tr>
                            </t>
                        </t>
                    </tbody>
                </table>
                <p class="text-muted" style="font-size:10px; margin-top:2px;">Precio por strike off: <span t-out="doc.company_id.strike_off or 0.0" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></p>
            </t>
        </xpath>
        <!-- Tabla de detalle de servicio de estampado rotativo -->
        <xpath expr="//div[span[@name='order_note']]" position="before">
            <t t-if="doc.is_rotary">
                <div class="o_ps_pagebreak"/>
                <h3 class="o_ps_title">Rotary Printing Design Service Price Summary</h3>
                <table class="table table-sm o_main_table o_ps_grid o_ignore_layout_styling" style="font-size:11px;">
                    <thead>
                        <tr>
                            <th class="text-start" rowspan="2">Producto</th>
                            <th class="text-start" rowspan="2">Diseño</th>
                            <th class="text-start" rowspan="2">Fondo de tela</th>
                            <th class="text-center" rowspan="2">Colores</th>
                            <th class="text-center" colspan="5">Producción</th>
                            <th class="text-center" colspan="3">Muestra</th>
                        </tr>
                        <tr>
                            <th class="text-end">Precio/mt</th>
                            <th class="text-end">Bondeo/mt</th>
                            <th class="text-center">Raport</th>
                            <th class="text-end">Precio cilindro</th>
                            <th class="text-center">Cant. colores</th>
                            <th class="text-end">Precio / strike off</th>
                            <th class="text-center">Cant. mín.</th>
                            <th class="text-end">Precio muestra</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="doc.order_line.filtered(lambda l: l.printing_design_id and l.printing_design_id.printing_type == 'rotary')" t-as="line">
                            <t t-set="design" t-value="line.printing_design_id"/>
                            <t t-set="prices" t-value="(design.rotary_unit_price_ids.sorted('sequence') or [])[:3]"/>
                            <t t-set="nrows" t-value="len(prices) or 1"/>
                            <t t-foreach="range(nrows)" t-as="ri">
                                <t t-set="price" t-value="prices[ri] if ri &lt; len(prices) else None"/>
                                <tr>
                                    <t t-if="ri == 0">
                                        <td t-att-class="'text-start align-middle' + (' o_ps_bl' if line_last else '')" t-att-rowspan="nrows">
                                            <strong t-field="line.name"/>
                                        </td>
                                        <td class="text-start align-middle" t-att-rowspan="nrows">
                                            <div><strong t-field="design.code"/></div>
                                            <div t-if="design.file_desc" class="text-muted"><span t-field="design.file_desc"/></div>
                                            <div class="text-muted"><span t-field="design.printing_type"/><span t-if="design.process_type_rotary"> · <span t-field="design.process_type_rotary"/></span></div>
                                            <img t-if="design.preview_image" t-att-src="image_data_uri(design.preview_image)" style="height:1.8cm; margin-top:3px;"/>
                                        </td>
                                        <td class="text-start align-middle" t-att-rowspan="nrows"><span t-field="design.fabric_base"/></td>
                                        <td class="text-center align-middle" t-att-rowspan="nrows"><span t-field="design.cylinder_qty"/></td>
                                        <td class="text-end align-middle" t-att-rowspan="nrows"><span t-field="design.unit_price" t-options="{'widget':'monetary','display_currency':design.currency_id}"/></td>
                                        <td class="text-end align-middle" t-att-rowspan="nrows"><span t-field="design.bonding_price" t-options="{'widget':'monetary','display_currency':design.currency_id}"/></td>
                                    </t>
                                    <td class="text-center"><span t-if="price" t-field="price.raport"/></td>
                                    <td class="text-end"><span t-if="price" t-field="price.unit_price" t-options="{'widget':'monetary','display_currency':price.currency_id}"/></td>
                                    <td class="text-center"><span t-if="price" t-field="price.color_qty"/></td>
                                    <t t-if="ri == 0">
                                        <td class="text-end align-middle" t-att-rowspan="nrows"><span t-out="doc.company_id.strike_off or 0.0" t-options="{'widget': 'monetary', 'display_currency': design.currency_id}"/></td>
                                    </t>
                                    <td class="text-center"><span t-if="price" t-field="price.sample_min_qty"/></td>
                                    <td t-att-class="'text-end' + (' o_ps_br' if (line_last and ri_last) else '')"><span t-if="price" t-field="price.sample_price" t-options="{'widget':'monetary','display_currency':price.currency_id}"/></td>
                                </tr>
                            </t>
                        </t>
                    </tbody>
                </table>
            </t>
        </xpath>

        <!-- Tabla adicional para cotizaciones: resumen tecnico por analysis_id sin duplicados.
             Se inserta ANTES del bloque de estampado digital para que las tablas de
             estampado (digital y rotativo) queden DESPUÉS de "Datos Proyectados". -->
        <xpath expr="//t[@t-if='doc.is_digital']" position="before">
            <t t-if="doc.is_quote">
                <t t-set="quote_weaving_lines" t-value="doc.order_line.filtered(lambda l: l.product_template_id.is_weaving and l.analysis_id)"/>
                <t t-set="quote_analyses" t-value="quote_weaving_lines.mapped('analysis_id')"/>
                <t t-if="quote_analyses">
                    <!-- <h3 class="o_ps_title">Resumen Tecnico de Productos Tejido (Cotizacion)</h3> -->
                    <table class="table table-sm o_main_table">
                        <thead>
                            <tr>
                                <th class="text-start">Descripcion</th>
                                <th class="text-end">Ancho</th>
                                <th class="text-end">Densidad</th>
                                <th class="text-end">Rendimiento</th>
                                <th class="text-end">Encogimiento Max.</th>
                                <th class="text-end">Revirado Max.</th>
                                <th class="text-start">Composicion</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="quote_analyses" t-as="analysis">
                                <t t-set="line" t-value="quote_weaving_lines.filtered(lambda l: l.analysis_id == analysis)[:1]"/>
                                <t t-set="dst" t-value="analysis.density_stability_twisting_id"/>
                                <t t-set="shrink_max" t-value="max(abs(dst.width_shrinkage_from or 0.0), abs(dst.width_shrinkage_to or 0.0), abs(dst.length_shrinkage_from or 0.0), abs(dst.length_shrinkage_to or 0.0)) if dst else 0.0"/>
                                <t t-set="target_partner" t-value="line.bom_id.technical_sheet_id.partner_id or doc.partner_id"/>
                                <t t-set="weaving_data" t-value="analysis.weaving_data_ids.filtered(lambda w: w.partner_id == target_partner)[:1] or analysis.weaving_data_ids[:1]"/>
                                <t t-set="fabric_composition" t-value="'\n'.join(['{}% {}'.format(round((f.percentage or 0.0) * 100), f.product_template_id.name) for f in weaving_data.fiber_ids if f.product_template_id]).strip()"/>
                                <tr>
                                    <td class="text-start">
                                        <span t-esc="analysis.product_description or line.product_template_id.name"/>
                                    </td>
                                    <td class="text-end">
                                        <span t-esc="'{:.2f}'.format(analysis.standard_width or 0.0)"/>
                                    </td>
                                    <td class="text-end">
                                        <span t-esc="'{:.2f}'.format(analysis.density or 0.0)"/>
                                    </td>
                                    <td class="text-end">
                                        <span t-esc="'{:.2f}'.format(analysis.yield_meter or 0.0)"/>
                                    </td>
                                    <td class="text-end">
                                        <span t-esc="'{:.2f}'.format(abs(shrink_max * 100 or 0.0) if shrink_max else 0.0) + '%'"/>
                                    </td>
                                    <td class="text-end">
                                        <span t-esc="'{:.2f}'.format(abs(dst.twist * 100 or 0.0) if dst else 0.0) + '%'"/>
                                    </td>
                                    <td class="text-start">
                                        <span t-esc="fabric_composition" style="white-space: pre-line;"/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </t>
                <t t-if="doc.is_quote">
                    <t t-set="projected_lines" t-value="doc.order_line.filtered(lambda l: not l.bom_id or not l.bom_id.technical_sheet_id.production_state or l.bom_id.technical_sheet_id.production_state == 'Sample')"/>
                        <t t-set="projected_products" t-value="projected_lines.mapped('product_template_id')"/>
                        <t t-if="projected_products">
                        <div style="margin-top: 12px;">
                            <table class="table table-sm" style="width: auto; display: inline-table;">
                                <thead>
                                    <tr>
                                        <th class="text-start" style="white-space: nowrap;">Datos Proyectados</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="projected_products" t-as="product_template">
                                        <tr>
                                            <td class="text-start" style="white-space: nowrap;">
                                                <span t-esc="product_template.name"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </t>
                </t>
            </t>
        </xpath>
    </template>
    
</odoo>
