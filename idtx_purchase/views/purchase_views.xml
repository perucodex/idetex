<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_purchase_order_form_date_order_visible" model="ir.ui.view">
        <field name="name">purchase.order.form.date_order.visible</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date_order']" position="attributes">
                <attribute name="invisible">0</attribute>
            </xpath>
        </field>
    </record>

    <menuitem id="menu_payment_terms_purchase"
            name="Payment Terms"
            parent="purchase.menu_purchase_config"
            action="account.action_payment_term_form"
            groups="purchase.group_purchase_manager"/>

</odoo>