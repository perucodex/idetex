<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_purchaseorder_document_inherit" inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//div[@t-if=&quot;o.state == 'purchase' and o.date_approve&quot;]" position="before">
            <div t-if="o.state == 'purchase' and o.date_order" class="col-2 bm-2">
                <strong>Order Date:</strong>
                <p t-field="o.date_order" t-options="{'date_only': 'true'}" class="m-0"/>
            </div>
        </xpath>
        <xpath expr="//div[@t-if=&quot;o.state == 'purchase' and o.date_approve&quot;]" position="attributes">
            <attribute name="style">display:none !important;</attribute>
            <attribute name="class">d-print-none col-3 bm-2</attribute>
        </xpath>
        <xpath expr="//div[@id='informations']" position="attributes">
            <attribute name="class">row mb-4 o_info_small</attribute>
        </xpath>
        <!-- 1) ELIMINAMOS todo lo que está después del total -->
        <xpath expr="//div[@id='total']/following-sibling::*" position="replace"/>
        <xpath expr="//div[hasclass('oe_structure')][2]/following-sibling::*" position="replace"/>
        <xpath expr="//span[@t-field='o.payment_term_id']" position="replace"/>

        <!-- 2) INSERTAMOS nuestro bloque compacto -->
        <xpath expr="//div[@id='total']" position="after">
            <div class="row mt-4 purchase-order">
                <!-- Columna izquierda: Notes + Payment Terms -->
                <div class="col-8 d-flex flex-column o_small_text">
                    <div>
                        <strong>Notas:</strong>
                        <p t-field="o.note" class="row mb-4 o_info_small"/>
                    </div>
                    <div class="mt-2">
                        <strong>Términos de Pago: </strong>
                        <span t-field="o.payment_term_id" class="ms-1 o_info_small"/>
                    </div>
                    <div class="mt-2">
                        <strong>Tipo de Cambio (USD): </strong>
                        <span t-esc="o.currency_rate_usd" t-options='{"widget": "float", "precision": 3}' class="ms-1 o_info_small"/>
                    </div>
                </div>

                <!-- Columna derecha: firma -->
                <div class="col-4 align-self-start">
                    <div t-if="o.user_id.signature_image" class="text-center" name="signature">
                        <img t-att-src="image_data_uri(o.user_id.signature_image)"
                            style="max-height: 4cm; max-width: 8cm;"/>
                    </div>
                </div>
            </div>
        </xpath>
        <!-- Agregar el encabezado antes de la columna Description -->
        <xpath expr="//th[@name='th_description']" position="before">
            <th name="th_item" class="text-start"><strong>Item</strong></th>
        </xpath>

        <!-- Agregar la celda correspondiente antes de la descripción -->
        <xpath expr="//td[@id='product']" position="before">
            <td class="text-start">
                <t t-if="not line.display_type">
                    <span t-esc="o.order_line.filtered(lambda l: l.display_type or l.product_qty != 0).filtered(lambda l: not l.display_type).ids.index(line.id) + 1"/>
                </t>
            </td>
        </xpath>
        
        <!-- 1. Agregar columna en el encabezado -->
        <xpath expr="//th[@name='th_discount']" position="after">
            <th name="th_price_unit_discounted" class="text-end" t-if="any(line.discount for line in o.order_line if not line.display_type)">
                <strong>Precio Desc.</strong>
            </th>
        </xpath>

        <!-- Crear la columna correspondiente en el tbody -->
        <xpath expr="//table[hasclass('o_main_table')]//tbody//tr[not(hasclass('o_line_section')) and not(hasclass('o_line_note'))]//td[position()=5]" position="after">
            <td class="text-end" t-if="any(line.discount for line in o.order_line if not line.display_type)">
                <span t-out="line.format_num_custom(line.price_unit_discounted)"/>
            </td>
        </xpath>

        <!-- Asegurar 4 dígitos en el precio unitario estándar -->
        <xpath expr="//span[@t-field='line.price_unit']" position="replace">
            <span t-out="line.format_num_custom(line.price_unit)"/>
        </xpath>

        <!-- Modificar ancho y titulo de cantidad y precio -->
        <xpath expr="//th[@name='th_quantity']" position="attributes">
            <attribute name="style">width: 15%;</attribute>
        </xpath>
        <xpath expr="//th[@name='th_price_unit']" position="replace">
            <th name="th_price_unit" class="text-end" style="width: 15%;"><strong>Precio Unit.</strong></th>
        </xpath>

        <!-- Asegurar 4 dígitos en la cantidad -->
        <xpath expr="//span[@t-field='line.product_qty']" position="replace">
            <span t-out="line.format_num_custom(line.product_qty)"/>
        </xpath>

        <xpath expr="//th[@name='th_description']" position="after">
            <th name="th_price_unit_discounted" t-if="any(line.analytic_distribution for line in o.order_line if not line.display_type)">
                <strong>Distr.</strong>
            </th>
        </xpath>

        <xpath expr="//table[hasclass('o_main_table')]//tbody//tr[not(hasclass('o_line_section')) and not(hasclass('o_line_note'))]//td[position()=2]" position="after">
            <t t-if="line.analytic_distribution and not line.display_type">
                <td>
                    <span t-foreach="line.analytic_distribution" t-as="distribution">
                        <span t-out="', '.join(line.env['account.analytic.account'].browse([int(x) for x in str(distribution).split(',') if x]).mapped('code'))"/>:
                        <span t-out="'%.2f' % (line.analytic_distribution.get(distribution))"/>%
                        <br/>
                    </span>
                </td>
            </t>
        </xpath>

        <!-- Crear la columna correspondiente en el tbody -->
        <!-- <xpath expr="//td[@id='product']/span[1]" position="before">
            <span t-field="line.product_id"/>
            </xpath> -->

    </template>
    
</odoo>