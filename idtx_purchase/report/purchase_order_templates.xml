<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_purchaseorder_document_inherit" inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//div[@t-if=&quot;o.state == 'purchase' and o.date_approve&quot;]" position="before">
            <div t-if="o.state == 'purchase' and o.date_order" class="col-2 bm-2">
                <strong>Order Date:</strong>
                <p t-field="o.date_order" t-options="{'date_only': 'true'}" class="m-0"/>
            </div>
        </xpath>
        <xpath expr="//div[@t-if=&quot;o.state == 'purchase' and o.date_approve&quot;]" position="attributes">
            <attribute name="style">display:none !important;</attribute>
            <attribute name="class">d-print-none col-3 bm-2</attribute>
        </xpath>
        <xpath expr="//div[@id='informations']" position="attributes">
            <attribute name="class">row mb-4 o_info_small</attribute>
        </xpath>
        <!-- 1) ELIMINAMOS todo lo que está después del total -->
        <xpath expr="//div[@id='total']/following-sibling::*" position="replace"/>
        <xpath expr="//div[hasclass('oe_structure')][2]/following-sibling::*" position="replace"/>
        <xpath expr="//span[@t-field='o.payment_term_id']" position="replace"/>

        <!-- 2) INSERTAMOS nuestro bloque compacto -->
        <xpath expr="//div[@id='total']" position="after">
            <div class="row mt-4 purchase-order">
                <!-- Columna izquierda: Notes + Payment Terms -->
                <div class="col-8 d-flex flex-column o_small_text">
                    <div>
                        <strong>Notas:</strong>
                        <p t-field="o.note" class="row mb-4 o_info_small"/>
                    </div>
                    <div class="mt-2">
                        <strong>Términos de Pago: </strong>
                        <span t-field="o.payment_term_id" class="ms-1 o_info_small"/>
                    </div>
                </div>

                <!-- Columna derecha: firma -->
                <div class="col-4 align-self-start">
                    <div t-if="o.user_id.signature_image" class="text-center" name="signature">
                        <img t-att-src="image_data_uri(o.user_id.signature_image)"
                            style="max-height: 4cm; max-width: 8cm;"/>
                    </div>
                </div>
            </div>
        </xpath>
    </template>
    
</odoo>