<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_purchaseorder_document_inherit" inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//div[@t-if=&quot;o.state == 'purchase' and o.date_approve&quot;]" position="before">
            <div t-if="o.state == 'purchase' and o.date_order" class="col-2 bm-2">
                <strong>Order Date:</strong>
                <p t-field="o.date_order" t-options="{'date_only': 'true'}" class="m-0"/>
            </div>
        </xpath>
        <xpath expr="//div[@t-if=&quot;o.state == 'purchase' and o.date_approve&quot;]/strong[1]" position="replace">
            <strong>Approved Date:</strong>
        </xpath>
    </template>

</odoo>