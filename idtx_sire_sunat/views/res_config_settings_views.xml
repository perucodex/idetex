<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_form_inherit_sire_sunat" model="ir.ui.view">
        <field name="name">res.config.settings.form.inherit.sire.sunat</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='invoicing_settings']" position="after">
                <block title="Sire Sunat Settings" name="default_sire sunat_setting_container" invisible="country_code != 'PE' or l10n_pe_edi_provider == 'sunat'">
                    <setting id="sire_sunat_settings" string="Sire Sunat" company_dependent="1" help="Sunat credentials for SIRE." invisible="country_code != 'PE' or l10n_pe_edi_provider == 'sunat'">
                        <span class="o_form_label mt16">SIRE Credentials</span>
                        <div class="text-muted">
                            This client id and client secret is created by the user in SUNAT SOL
                            <b>"Gestión de Credenciales API SUNAT"</b><br/>
                            How do you get it?: <a href="https://www.youtube.com/watch?v=_FUgCwX84Oo">here</a><br/>
                        </div>
                        <div class="content-group">
                            <div class="row mt32">
                                <label for="client_id" class="col-md-5 o_light_label"/>
                                <field name="client_id" />
                                <label for="client_secret" class="col-md-5 o_light_label"/>
                                <field name="client_secret"/>
                                <label for="l10n_pe_edi_provider_username" class="col-md-5 o_light_label"/>
                                <field name="l10n_pe_edi_provider_username"/>
                                <label for="l10n_pe_edi_provider_password" class="col-md-5 o_light_label"/>
                                <field name="l10n_pe_edi_provider_password" password="True"/>
                            </div>
                        </div>
                        <span class="o_form_label mt16">SIRE</span>
                        <div class="text-muted">
                            Partner Anulado que se omitira en el sire
                        </div>
                        <div class="content-group">
                            <div class="row mt32">
                                <label for="partner_annulled_id" class="col-md-5 o_light_label"/>
                                <field name="partner_annulled_id"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
