<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Laboratorio -->
        <record model="res.groups.privilege" id="module_orga_user">
            <field name="name">Orgatex</field>
            <field name="description">Set up Orgatex</field>
            <field name="sequence">19</field>
        </record>
        <record id="group_module_orga_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="module_orga_user"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="group_module_orga_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="module_orga_user"/>
            <field name="implied_ids" eval="[(4, ref('group_module_orga_user'))]"/>
        </record>
        
        <record id="base.user_admin" model="res.users">
            <field name="group_ids" eval="[Command.link(ref('group_module_orga_manager'))]"/>
        </record>
        
