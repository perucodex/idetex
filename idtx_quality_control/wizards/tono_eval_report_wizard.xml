<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_qc_tone_eval_report_wizard_form" model="ir.ui.view">
        <field name="name">qc.tone.eval.report.wizard.form</field>
        <field name="model">qc.tone.eval.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Evaluación de Tono en Producción">
                <group>
                    <label for="date_from" string="Turno"/>
                    <div class="o_row">
                        <field name="date_from" widget="daterange"
                               options="{'end_date_field': 'date_to'}" nolabel="1"/>
                        <field name="date_to" invisible="1"/>
                        <button name="action_next_shift" type="object"
                                string="Siguiente turno" icon="fa-forward"
                                class="btn-link"
                                title="Avanza 12 horas ambas fechas"/>
                    </div>
                    <field name="formato" widget="radio" options="{'horizontal': true}"/>
                </group>
                <footer>
                    <button name="action_print" type="object" string="Imprimir"
                            class="btn-primary" data-hotkey="q"/>
                    <button string="Cancelar" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_qc_tone_eval_report_wizard" model="ir.actions.act_window">
        <field name="name">Evaluación de Tono en Producción</field>
        <field name="res_model">qc.tone.eval.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- El menú Reportes de Calidad es SOLO manager en el core: se abre a
         los USUARIOS de calidad para que vean la Evaluación de Tono, y los
         dos reportes del core se fijan explícitamente a manager para que
         conserven su visibilidad de siempre. -->
    <record id="quality_control.menu_quality_reporting" model="ir.ui.menu">
        <field name="group_ids" eval="[(4, ref('quality.group_quality_user'))]"/>
    </record>
    <record id="quality_control.menu_quality_check_report" model="ir.ui.menu">
        <field name="group_ids" eval="[(4, ref('quality.group_quality_manager'))]"/>
    </record>
    <record id="quality_control.menu_quality_alert_report" model="ir.ui.menu">
        <field name="group_ids" eval="[(4, ref('quality.group_quality_manager'))]"/>
    </record>

    <menuitem id="menu_control_tono_eval_report"
              name="Evaluación de Tono en Producción (Partidas Odoo)"
              parent="quality_control.menu_quality_reporting"
              action="action_qc_tone_eval_report_wizard"
              groups="quality.group_quality_user"
              sequence="50"/>

</odoo>
