<odoo>
    <record id="view_qc_tone_wizard_form" model="ir.ui.view">
        <field name="name">qc.tone.wizard.form</field>
        <field name="model">qc.tone.wizard</field>
        <field name="arch" type="xml">
            <form string="Evaluar Tono">
                <sheet>
                    <field name="batch_id" invisible="1"/>
                    <field name="eval_mode" invisible="1"/>
                    <field name="is_concesionado" invisible="1"/>
                    <field name="has_motivos_selected" invisible="1"/>
                    <field name="can_show_decision_buttons" invisible="1"/>
                    <field name="show_motivos" invisible="1"/>

                    <group>
                        <group>
                            <field name="eval_mode" readonly="1"/>
                            <field name="cliente" readonly="1"/>
                            <field name="articulo" readonly="1"/>
                            <field name="pedido" readonly="1"/>
                            <field name="partida" readonly="1"/>
                        </group>
                        <group>
                            <field name="hdr" readonly="1"/>
                            <field name="color_code" readonly="1"/>
                            <field name="color_name" readonly="1"/>
                            <field name="kilos" readonly="1"/>
                        </group>
                    </group>

                    <group invisible="eval_mode != 'tacho'">
                        <group>
                            <field name="receta" string="Receta Laboratorio"/>
                        </group>
                        <group>
                            <field name="receta_tono" string="Receta Tacho"/>
                        </group>
                    </group>

                    <group invisible="eval_mode == 'tacho'">
                        <group>
                            <field name="receta" string="Receta Proceso"/>
                        </group>
                        <group>
                            <field name="receta_tono" string="Receta Tacho" readonly="1"/>
                        </group>
                    </group>

                    <group invisible="not show_motivos">
                        <group string="Motivo">
                            <field name="motivo_tono"/>
                            <field name="motivo_tacto"/>
                            <field name="motivo_apariencia"/>
                        </group>
                    </group>
                </sheet>

                <footer>
                    <button string="Aprobar"
                            name="action_aprobar"
                            type="object"
                            class="btn-primary"
                            invisible="not can_show_decision_buttons or (eval_mode == 'acabado' and has_motivos_selected)"/>

                    <button string="Concesionado"
                            name="action_concesionar"
                            type="object"
                            class="btn-primary"
                            invisible="not can_show_decision_buttons or (eval_mode == 'acabado' and not has_motivos_selected)"/>

                    <button string="Rechazar"
                            name="action_rechazar"
                            type="object"
                            class="btn-danger"
                            invisible="not can_show_decision_buttons"/>

                    <button string="Cancelar" special="cancel" class="btn-secondary ms-auto"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>