<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_production_lot_tree_inherit_grade" model="ir.ui.view">
            <field name="name">stock.lot.list.inherit.quality.grade</field>
            <field name="model">stock.lot</field>
            <field name="inherit_id" ref="idtx_mrp.view_production_lot_tree_inherit_batch"/>
            <field name="arch" type="xml">
                <field name="batch_id" position="after">
                    <field name="quality_grade" optional="show"/>
                </field>
            </field>
        </record>

        <record id="search_product_lot_filter_inherit_grade" model="ir.ui.view">
            <field name="name">stock.lot.search.inherit.quality.grade</field>
            <field name="model">stock.lot</field>
            <field name="inherit_id" ref="idtx_mrp.search_product_lot_filter_inherit_batch"/>
            <field name="arch" type="xml">
                <filter name="group_by_batch" position="after">
                    <filter name="group_by_quality_grade" string="Grado" domain="[]" context="{'group_by': 'quality_grade'}"/>
                </filter>
            </field>
        </record>

        <record id="view_stock_quant_tree_editable_inherit_grade" model="ir.ui.view">
            <field name="name">stock.quant.list.editable.inherit.quality.grade</field>
            <field name="model">stock.quant</field>
            <field name="inherit_id" ref="idtx_mrp.view_stock_quant_tree_editable_inherit"/>
            <field name="arch" type="xml">
                <field name="batch_id" position="after">
                    <field name="quality_grade" optional="show" readonly="1"/>
                </field>
            </field>
        </record>

        <record id="view_stock_quant_tree_simple_inherit_grade" model="ir.ui.view">
            <field name="name">stock.quant.list.simple.inherit.quality.grade</field>
            <field name="model">stock.quant</field>
            <field name="inherit_id" ref="idtx_mrp.view_stock_quant_tree_simple_inherit_batch"/>
            <field name="arch" type="xml">
                <field name="batch_id" position="after">
                    <field name="quality_grade" optional="show" readonly="1"/>
                </field>
            </field>
        </record>

        <record id="view_stock_quant_tree_inventory_editable_inherit_grade" model="ir.ui.view">
            <field name="name">stock.quant.list.inventory.editable.inherit.quality.grade</field>
            <field name="model">stock.quant</field>
            <field name="inherit_id" ref="idtx_mrp.view_stock_quant_tree_inventory_editable_inherit_batch"/>
            <field name="arch" type="xml">
                <field name="batch_id" position="after">
                    <field name="quality_grade" optional="show" readonly="1"/>
                </field>
            </field>
        </record>

        <record id="quant_search_view_inherit_grade" model="ir.ui.view">
            <field name="name">stock.quant.search.inherit.quality.grade</field>
            <field name="model">stock.quant</field>
            <field name="inherit_id" ref="idtx_mrp.quant_search_view_inherit_batch"/>
            <field name="arch" type="xml">
                <filter name="groupby_batch" position="after">
                    <filter name="groupby_quality_grade" string="Grado" domain="[]" context="{'group_by': 'quality_grade'}"/>
                </filter>
            </field>
        </record>

    </data>
</odoo>
