<odoo>
    <record id="view_qc_appearance_tree" model="ir.ui.view">
        <field name="name">qc.appearance.tree</field>
        <field name="model">qc.appearance</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="mrp_workcenter_id"/>
                <!-- <field name="is_active" widget="boolean_toggle"/> -->
            </list>
        </field>
    </record>

    <record id="view_qc_appearance_form" model="ir.ui.view">
        <field name="name">qc.appearance.form</field>
        <field name="model">qc.appearance</field>
        <field name="arch" type="xml">
            <form string="Defecto Apariencia">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <field name="mrp_workcenter_id"/>
                    </group>
                    <notebook>
                        <page name="defects" string="Defects">
                            <field name="is_printing" invisible="1"/>
                            <field name="defect_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="is_hueco" widget="boolean_toggle"/>
                                    <field name="is_active" widget="boolean_toggle"/>
                                    <field name="type_printing" column_invisible="parent.is_printing != 'printing'"/>
                                </list>
                            </field>                            
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_qc_appearance" model="ir.actions.act_window">
        <field name="name">Defectos Apariencia</field>
        <field name="res_model">qc.appearance</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>