<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Partida (idtx_mrp): botones y pestañas de control de calidad -->
    <record id="mrp_workorder_batch_form_inherit_qc" model="ir.ui.view">
        <field name="name">mrp.workorder.batch.form.inherit.quality.control</field>
        <field name="model">mrp.workorder.batch</field>
        <field name="inherit_id" ref="idtx_mrp.mrp_workorder_batch_form"/>
        <field name="priority">100</field>
        <field name="arch" type="xml">

            <xpath expr="//form/header" position="inside">
                <button name="action_print_laboratorio_summary_report"
                        type="object"
                        string="Enviar Resumen Lab."
                        class="btn-secondary"
                        invisible="state not in ('batch', 'split')"/>

                <button name="action_view_laboratorio_public"
                        type="object"
                        string="Ver Informe Público"
                        class="btn-secondary"
                        invisible="state not in ('batch', 'split')"/>

                <button name="action_sample_reception_screen"
                        type="object"
                        string="Recepción de Muestras"
                        class="btn-secondary"
                        invisible="state != 'batch'"/>

                <button name="action_evaluar_tono"
                        type="object"
                        string="Evaluar Tono Tacho"
                        class="btn-primary"
                        invisible="state != 'batch' or not can_eval_tono"/>

                <button name="action_evaluar_tono_secado"
                        type="object"
                        string="Evaluar Tono Secado"
                        class="btn-primary"
                        invisible="state != 'batch' or not can_eval_tono_secado"/>

                <button name="action_evaluar_tono_acabado"
                        type="object"
                        string="Evaluar Tono Acabado"
                        class="btn-primary"
                        invisible="state != 'batch' or not can_eval_tono_acabado"/>
            </xpath>

            <xpath expr="//group[@name='batch_info']" position="after">
                <group name="qc_info" string="Calidad">
                    <field name="qc_customer"/>
                    <field name="qc_order_ref"/>
                    <field name="qc_product_id"/>
                    <field name="qc_product_ids" widget="many2many_tags"
                           invisible="not qc_product_ids or len(qc_product_ids) &lt; 2"/>
                    <field name="lab_dev_line_id"/>
                    <field name="kilograms"/>
                    <field name="roll_count"/>
                    <field name="reprocess_cycle"/>
                    <field name="user_id" widget="many2one_avatar_user"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                </group>
            </xpath>

            <xpath expr="//notebook" position="inside">

                <page string="Evaluaciones de Tono" name="qc_tone_page" invisible="not has_tono_eval_logs">
                    <field name="tono_eval_log_ids" nolabel="1"
                           context="{'form_view_ref': 'idtx_quality_control.view_control_tono_log_form'}">
                        <list delete="1" edit="0" create="0">
                            <field name="fecha_eval"/>
                            <field name="user_id"/>
                            <field name="motivo_tono"/>
                            <field name="motivo_tacto"/>
                            <field name="motivo_apariencia"/>
                            <field name="tono"/>
                            <field name="resultado" widget="badge"
                                   decoration-success="resultado == 'aprobado'"
                                   decoration-danger="resultado == 'rechazado'"
                                   decoration-warning="resultado == 'concesionado'"/>
                        </list>
                    </field>
                </page>

                <page string="Auditoría de Apariencia" name="qc_audit_page"
                      invisible="not (can_apariencia or has_apariencia_lines)">
                    <field name="apariencia_eval_ids" nolabel="1"
                           context="{'default_batch_id': id}"
                           mode="list,form">
                        <list>
                            <field name="name"/>
                            <field name="create_date" string="Fecha"/>
                            <field name="create_uid" string="Usuario"/>
                            <field name="apariencia_id" string="Apariencia"/>
                            <field name="sample_type" string="Tipo"/>
                            <field name="line_count" string="Rollos"/>
                            <field name="quality_point" string="Quality Point"/>
                        </list>
                    </field>
                </page>

                <page string="Laboratorio" name="qc_lab_page" invisible="not has_laboratorio_records">
                    <field name="laboratorio_record_ids" nolabel="1" context="{'default_batch_id': id}" mode="list,form">
                        <list>
                            <field name="eval_number" string="Nro Evaluación"/>
                            <field name="fecha_eval"/>
                            <field name="user_ids" widget="many2many_tags"/>
                            <field name="numero_lavado"/>
                            <field name="sample_type" string="Tipo de Muestra"/>
                            <field name="test_type" string="Tipo de Prueba"/>
                            <field name="result_state" string="Estado" widget="badge"
                                   decoration-success="result_state == 'pasa'"
                                   decoration-warning="result_state == 'uncomplete'"
                                   decoration-danger="result_state == 'falla'"/>
                        </list>
                        <form string="Registro de Laboratorio">
                            <header>
                                <button name="action_print_report"
                                        type="object"
                                        string="Imprimir"
                                        class="btn-secondary"
                                        invisible="test_type not in ('solidez_lavado', 'dimrev')"/>
                                <field name="result_state" widget="statusbar"
                                       decoration-success="result_state == 'pasa'"
                                       decoration-warning="result_state == 'uncomplete'"
                                       decoration-danger="result_state == 'falla'"/>
                            </header>
                            <sheet>
                                <group>
                                    <group>
                                        <field name="eval_number" readonly="1"/>
                                        <field name="fecha_eval" readonly="1"/>
                                        <field name="user_ids" widget="many2many_tags" readonly="1"/>
                                    </group>
                                    <group>
                                        <field name="batch_id" readonly="1"/>
                                        <field name="test_type" readonly="1"/>
                                        <field name="sample_type" readonly="1"/>
                                        <field name="numero_lavado" readonly="1"/>
                                    </group>
                                </group>
                                <group string="Detalle Dimensional/Revirado" invisible="test_type != 'dimrev'">
                                    <field name="est_revirado_eval_id" readonly="1"/>
                                </group>
                                <group string="Detalle Solidez del Color al Lavado" invisible="test_type != 'solidez_lavado'">
                                    <field name="solidez_lavado_eval_id" readonly="1"/>
                                </group>
                                <notebook>
                                    <page string="Resultados">
                                        <field name="result_line_ids" nolabel="1" readonly="0">
                                            <list default_order="sequence asc">
                                                <field name="tipo"/>
                                                <field name="resultado"/>
                                            </list>
                                        </field>
                                    </page>
                                </notebook>
                            </sheet>
                        </form>
                    </field>
                </page>

                <page string="Recepción de Muestras" name="qc_sample_page" invisible="not sample_reception_ids">
                    <field name="sample_reception_ids" nolabel="1" context="{'default_batch_id': id}" mode="list,form">
                        <list>
                            <field name="name"/>
                            <field name="reception_datetime"/>
                            <field name="customer"/>
                            <field name="product_id"/>
                            <field name="color_name"/>
                            <field name="kilograms"/>
                            <field name="sample_type"/>
                            <field name="dni"/>
                            <field name="delivery_name"/>
                            <field name="user_id"/>
                        </list>
                        <form string="Recepción de Muestras">
                            <sheet>
                                <group>
                                    <group>
                                        <field name="name" readonly="1"/>
                                        <field name="reception_datetime" readonly="1"/>
                                        <field name="batch_id" readonly="1"/>
                                        <field name="sample_type" readonly="1"/>
                                        <field name="dni" readonly="1"/>
                                        <field name="delivery_name" readonly="1"/>
                                        <field name="user_id" readonly="1"/>
                                    </group>
                                    <group>
                                        <field name="customer" readonly="1"/>
                                        <field name="product_id" readonly="1"/>
                                        <field name="article" readonly="1"/>
                                        <field name="color_name" readonly="1"/>
                                        <field name="color_code" readonly="1"/>
                                        <field name="kilograms" readonly="1"/>
                                    </group>
                                </group>
                                <group string="Firma">
                                    <field name="signature"
                                           widget="image"
                                           readonly="1"
                                           nolabel="1"
                                           options="{'size': [420, 140]}"/>
                                </group>
                            </sheet>
                        </form>
                    </field>
                </page>

            </xpath>
        </field>
    </record>

    <!-- Lista de partidas: columnas de calidad -->
    <record id="wo_batch_tree_view_inherit_qc" model="ir.ui.view">
        <field name="name">mrp.workorder.batch.list.inherit.quality.control</field>
        <field name="model">mrp.workorder.batch</field>
        <field name="inherit_id" ref="idtx_mrp.wo_batch_tree_view"/>
        <field name="arch" type="xml">
            <field name="batch_date" position="after">
                <field name="qc_customer" optional="show"/>
                <field name="qc_product_id" optional="show"/>
                <field name="color_name" optional="show"/>
                <field name="kilograms" optional="hide" sum="Total"/>
            </field>
        </field>
    </record>

    <record id="mrp_workorder_batch_view_search_inherit_qc" model="ir.ui.view">
        <field name="name">mrp.workorder.batch.search.inherit.quality.control</field>
        <field name="model">mrp.workorder.batch</field>
        <field name="inherit_id" ref="idtx_mrp.mrp_workorder_batch_view_search"/>
        <field name="arch" type="xml">
            <field name="mrwo_id" position="after">
                <field name="qc_customer"/>
                <field name="qc_product_id"/>
                <field name="qc_order_ref"/>
                <field name="color_name"/>
            </field>
        </field>
    </record>

    <record id="action_quality_partida" model="ir.actions.act_window">
        <field name="name">Partidas</field>
        <field name="res_model">mrp.workorder.batch</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', 'in', ('batch', 'split'))]</field>
    </record>

</odoo>
