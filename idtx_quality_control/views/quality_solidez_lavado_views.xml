<odoo>
    <record id="action_quality_solidez_lavado_screen" model="ir.actions.client">
        <field name="name">Evaluar Solidez del Color al Lavado</field>
        <field name="tag">idtx_quality_control.solidez_lavado_screen</field>
        <field name="target">fullscreen</field>
    </record>

    <record id="view_qc_wash_fastness_eval_list" model="ir.ui.view">
        <field name="name">qc.wash.fastness.eval.list</field>
        <field name="model">qc.wash.fastness.eval</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="name"/>
                <field name="fecha_eval"/>
                <field name="user_id"/>
                <field name="batch_id"/>
                <field name="cambio_color_grado"/>
                <field name="frote_seco"/>
                <field name="frote_humedo"/>
                <field name="state" widget="badge" decoration-danger="state=='fail'" decoration-success="state=='pass'"/>
            </list>
        </field>
    </record>

    <record id="view_qc_wash_fastness_eval_form" model="ir.ui.view">
        <field name="name">qc.wash.fastness.eval.form</field>
        <field name="model">qc.wash.fastness.eval</field>
        <field name="arch" type="xml">
            <form string="Evaluacion Solidez del Color al Lavado" create="0" edit="0" delete="0">
                <header>
                    <button name="action_print_report" type="object" string="Imprimir" class="btn-primary" invisible="not id"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="fecha_eval" readonly="1"/>
                        </group>
                        <group>
                            <field name="user_id" readonly="1"/>
                            <field name="batch_id" readonly="1"/>
                        </group>
                    </group>

                    <group string="Solidez al Lavado">
                        <div class="o_td_label">
                            <label for="cambio_color_grado" string="Cambio de Color (Grado)"/>
                        </div>
                        <div class="d-inline-flex align-items-center">
                            <field name="cambio_color_grado"/>
                            <span title="Cumple" class="fa fa-circle text-success" style="margin-left:5mm;" invisible="not bool_cambio_color_grado"/>
                            <span title="No Cumple" class="fa fa-circle text-danger" style="margin-left:5mm;" invisible="bool_cambio_color_grado"/>
                        </div>
                    </group>

                    <group string="Migracion">
                        <group>
                            <div class="o_td_label">
                                <label for="mig_acetato" string="Migracion Acetato"/>
                            </div>
                            <div class="d-inline-flex align-items-center">
                                <field name="mig_acetato"/>
                                <span title="Cumple" class="fa fa-circle text-success" style="margin-left:5mm;" invisible="not bool_mig_acetato"/>
                                <span title="No Cumple" class="fa fa-circle text-danger" style="margin-left:5mm;" invisible="bool_mig_acetato"/>
                            </div>
                            <div class="o_td_label">
                                <label for="mig_algodon" string="Migracion Algodon"/>
                            </div>
                            <div class="d-inline-flex align-items-center">
                                <field name="mig_algodon"/>
                                <span title="Cumple" class="fa fa-circle text-success" style="margin-left:5mm;" invisible="not bool_mig_algodon"/>
                                <span title="No Cumple" class="fa fa-circle text-danger" style="margin-left:5mm;" invisible="bool_mig_algodon"/>
                            </div>
                            <div class="o_td_label">
                                <label for="mig_nylon" string="Migracion Nylon"/>
                            </div>
                            <div class="d-inline-flex align-items-center">
                                <field name="mig_nylon"/>
                                <span title="Cumple" class="fa fa-circle text-success" style="margin-left:5mm;" invisible="not bool_mig_nylon"/>
                                <span title="No Cumple" class="fa fa-circle text-danger" style="margin-left:5mm;" invisible="bool_mig_nylon"/>
                            </div>
                        </group>
                        <group>
                            <div class="o_td_label">
                                <label for="mig_poliester" string="Migracion Poliester"/>
                            </div>
                            <div class="d-inline-flex align-items-center">
                                <field name="mig_poliester"/>
                                <span title="Cumple" class="fa fa-circle text-success" style="margin-left:5mm;" invisible="not bool_mig_poliester"/>
                                <span title="No Cumple" class="fa fa-circle text-danger" style="margin-left:5mm;" invisible="bool_mig_poliester"/>
                            </div>
                            <div class="o_td_label">
                                <label for="mig_acrilico" string="Migracion Acrilico"/>
                            </div>
                            <div class="d-inline-flex align-items-center">
                                <field name="mig_acrilico"/>
                                <span title="Cumple" class="fa fa-circle text-success" style="margin-left:5mm;" invisible="not bool_mig_acrilico"/>
                                <span title="No Cumple" class="fa fa-circle text-danger" style="margin-left:5mm;" invisible="bool_mig_acrilico"/>
                            </div>
                            <div class="o_td_label">
                                <label for="mig_lana" string="Migracion Lana"/>
                            </div>
                            <div class="d-inline-flex align-items-center">
                                <field name="mig_lana"/>
                                <span title="Cumple" class="fa fa-circle text-success" style="margin-left:5mm;" invisible="not bool_mig_lana"/>
                                <span title="No Cumple" class="fa fa-circle text-danger" style="margin-left:5mm;" invisible="bool_mig_lana"/>
                            </div>
                        </group>
                    </group>

                    <group string="Solidez al Frote">
                        <group>
                            <div class="o_td_label">
                                <label for="frote_seco" string="Frote Seco"/>
                            </div>
                            <div class="d-inline-flex align-items-center">
                                <field name="frote_seco"/>
                                <span title="Cumple" class="fa fa-circle text-success" style="margin-left:5mm;" invisible="not bool_frote_seco"/>
                                <span title="No Cumple" class="fa fa-circle text-danger" style="margin-left:5mm;" invisible="bool_frote_seco"/>
                            </div>
                        </group>
                        <group>
                            <div class="o_td_label">
                                <label for="frote_humedo" string="Frote Humedo"/>
                            </div>
                            <div class="d-inline-flex align-items-center">
                                <field name="frote_humedo"/>
                                <span title="Cumple" class="fa fa-circle text-success" style="margin-left:5mm;" invisible="not bool_frote_humedo"/>
                                <span title="No Cumple" class="fa fa-circle text-danger" style="margin-left:5mm;" invisible="bool_frote_humedo"/>
                            </div>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_qc_wash_fastness_eval_search" model="ir.ui.view">
        <field name="name">qc.wash.fastness.eval.search</field>
        <field name="model">qc.wash.fastness.eval</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Referencia"/>
                <field name="batch_id" string="Partida"/>
                <field name="user_id" string="Usuario"/>
                <field name="fecha_eval" string="Fecha"/>
                <separator/>
                <filter name="group_by_fecha_dia" string="Fecha (Dia)" context="{'group_by': 'fecha_eval:day'}"/>
                <filter name="group_by_usuario" string="Usuario" context="{'group_by': 'user_id'}"/>
                <filter name="group_by_partida" string="Partida" context="{'group_by': 'batch_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_qc_wash_fastness_eval" model="ir.actions.act_window">
        <field name="name">Evaluaciones Solidez al Lavado</field>
        <field name="res_model">qc.wash.fastness.eval</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_qc_wash_fastness_eval_search"/>
    </record>
</odoo>
