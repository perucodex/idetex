<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_form_view_prodev" model="ir.ui.view">
        <field name="name">product.template.form.view.prodev</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <field name="is_weaving" invisible="1"/>
                <page string="Weaving Information" name="weaving_information" invisible="not is_weaving">
                    <group>
                        <group>
                            <field name="density"/>
                            <field name="width"/>
                            <field name="gauge"/>
                            <field name="first_wash_shrinkage"/>
                            <field name="first_wash_twist"/>
                        </group>
                        <group>
                            <field name="yield_meter"/>
                            <field name="scrap" widget="percentage"/>
                            <field name="weave_type"/>
                            <field name="batch"/>
                        </group>
                        <field name="memo" nolabel="0"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
    
    <record id="product_product_action_weaving" model="ir.actions.act_window">
        <field name="name">Products</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">kanban,list,form,activity</field>
        <field name="context">{'search_default_filter_weaving': 1}</field>
        <field name="view_id" ref="product.product_template_tree_view"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new weaving product
            </p>
        </field>
    </record>

    <record id="product_template_search_view_inherit" model="ir.ui.view">
        <field name="name">product.template.search.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <filter name="filter_to_sell" position="after">
                <filter string="Weaving" name="filter_weaving" domain="[('is_weaving','=',True)]"/>
            </filter>
        </field>
    </record>

</odoo>

