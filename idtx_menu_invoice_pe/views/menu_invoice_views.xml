<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_menu_invoice_tree" model="ir.ui.view">
            <field name="name">menu.invoice.list</field>
            <field name="model">menu.invoice</field>
            <field name="arch" type="xml">
                <list>
                    <field name="company_id" column_invisible="1"/>
                    <field name="name"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                </list>
            </field>
        </record>

        <record id="view_menu_invoice_form" model="ir.ui.view">
            <field name="name">menu.invoice.form</field>
            <field name="model">menu.invoice</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_process" type="object" string="Get Data" class="oe_highlight" invisible="state != 'draft'"/>
                        <button name="action_create_invoices" type="object" string="Create Invoices" class="oe_highlight" invisible="state != 'data'" confirm="Are you sure you want to create the invoices ?"/> -->
                        <button name="action_return" type="object" string="Return" invisible="state == 'draft'"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div name="button_box" class="oe_button_box">
                            <button name="open_invoices"
                                    class="oe_stat_button"
                                    icon="fa-microchip"
                                    type="object"
                                    invisible="invoice_count == 0">
                                    <field name="invoice_count" widget="statinfo" string="Invoices"/>
                            </button>
                        </div>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <label for="start_date" string="Dates"/>
                                <div class="d-flex align-items-center">
                                    <field name="end_date" invisible="1"/>
                                    <field name="start_date" nolabel="1" style="width: 40%" widget="daterange" options="{'end_date_field': 'end_date'}" readonly="state != 'draft'"/>
                                </div>
                                <field name="tax_id" domain="[('type_tax_use','=','sale')]" readonly="state != 'draft'" options="{'no_create': 1,'no_edit': 1,'no_open':1}"/>
                            </group>
                            <group>
                                <field name="company_ids" widget="many2many_tags" readonly="state != 'draft'" domain="[('is_company','=',True)]"/>
                                <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page name="lines" string="Detail">
                                <field name="line_ids" readonly="1"/>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter reload_on_attachment="True"/>
                </form>
            </field>
        </record>

        <record id="view_menu_invoice_line_tree" model="ir.ui.view">
            <field name="name">menu.invoice.line.list</field>
            <field name="model">menu.invoice.line</field>
            <field name="arch" type="xml">
                <list>
                    <field name="partner_id"/>
                    <field name="menu_type"/>
                    <field name="line_description"/>
                    <!-- <field name="description"/> -->
                    <field name="qty"/>
                    <field name="price"/>
                </list>
            </field>
        </record>

        <record id="view_menu_invoice_line_filter" model="ir.ui.view">
            <field name="name">menu.invoice.line.search</field>
            <field name="model">menu.invoice.line</field>
            <field eval="16" name="priority"/>
            <field name="arch" type="xml">
                <search string="Search Menu Items">
                    <field name="menu_type"/>
                    <separator/>
                    <filter string="Breakfast" name="breakfast" domain="[('menu_type', '=', '10')]"/>
                    <filter string="Menu" name="menu" domain="[('menu_type', '=', '1')]"/>
                    <filter string="Dinner" name="dinner" domain="[('menu_type', '=', '11')]"/>
                    <filter string="Dessert" name="dessert" domain="[('menu_type', '=', '20')]"/>
                    <group>
                        <filter string="Menu Invoice" name="group_by_menu_invoice" domain="[]" context="{'group_by': 'menu_invoice_id'}"/>
                        <filter string="Partner" name="group_by_partner" domain="[]" context="{'group_by': 'partner_id'}"/>
                        <filter string="Menu Type" name="group_by_menu_type" domain="[]" context="{'group_by': 'menu_type'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="menu_invoice_action" model="ir.actions.act_window">
            <field name="name">Menu Invoice</field>
            <field name="res_model">menu.invoice</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="view_menu_invoice_tree"/>
        </record>

        <record id="menu_invoice_line_action" model="ir.actions.act_window">
            <field name="name">Menu Invoice Line</field>
            <field name="res_model">menu.invoice.line</field>
            <field name="view_mode">list</field>
            <field name="view_id" ref="view_menu_invoice_line_tree"/>
            <field name="search_view_id" ref="view_menu_invoice_line_filter"/>
            <field name="context">{'search_default_group_by_menu_invoice': 1}</field>
        </record>

    </data>
</odoo>
