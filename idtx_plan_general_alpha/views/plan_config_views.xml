<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         CONFIGURACION: Centros de Trabajo (mrp.workcenter)
    ============================================================ -->
    <record id="action_plan_alpha_workcenter" model="ir.actions.act_window">
        <field name="name">Centros de Trabajo</field>
        <field name="res_model">mrp.workcenter</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Sin centros de trabajo configurados.
            </p>
            <p>
                Define los centros de trabajo (maquinas, lineas)
                que ejecutan las operaciones de produccion.
            </p>
        </field>
    </record>

    <!-- ============================================================
         CONFIGURACION: Equipos / Maquinas (maintenance.equipment)
    ============================================================ -->
    <record id="action_plan_alpha_equipment" model="ir.actions.act_window">
        <field name="name">Equipos y Maquinas</field>
        <field name="res_model">maintenance.equipment</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Sin equipos registrados.
            </p>
            <p>
                Registra las maquinas y equipos de cada area
                para asignarlos al planeamiento de produccion.
            </p>
        </field>
    </record>

</odoo>
