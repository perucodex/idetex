<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- SEARCH: filtros y agrupaciones para planeamiento -->
    <record id="plan_alpha_production_search" model="ir.ui.view">
        <field name="name">plan.alpha.production.search</field>
        <field name="model">mrp.production</field>
        <field name="arch" type="xml">
            <search string="Buscar Ordenes">
                <field name="name" string="Referencia"/>
                <field name="product_id" string="Producto"/>
                <field name="origin" string="Pedido origen"/>
                <field name="workcenter_id" string="Centro de trabajo"/>
                <separator/>
                <filter name="filter_draft"     string="Borrador"
                        domain="[('state','=','draft')]"/>
                <filter name="filter_confirmed" string="Confirmado"
                        domain="[('state','=','confirmed')]"/>
                <filter name="filter_progress"  string="En progreso"
                        domain="[('state','=','progress')]"/>
                <filter name="filter_to_close"  string="Por cerrar"
                        domain="[('state','=','to_close')]"/>
                <filter name="filter_done"      string="Hecho"
                        domain="[('state','=','done')]"/>
                <separator/>
                <filter name="filter_late" string="Atrasadas"
                        domain="[('date_deadline','&lt;', context_today().strftime('%Y-%m-%d')),('state','not in',['done','cancel'])]"/>
                <filter name="filter_today" string="Hoy"
                        domain="[('date_start','&lt;=', context_today().strftime('%Y-%m-%d 23:59:59')),('date_start','&gt;=', context_today().strftime('%Y-%m-%d 00:00:00'))]"/>
                <separator/>
                <group>
                    <filter name="group_state"      string="Estado"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_product"    string="Producto"
                            context="{'group_by': 'product_id'}"/>
                    <filter name="group_workcenter" string="Centro de trabajo"
                            context="{'group_by': 'workcenter_id'}"/>
                    <filter name="group_date_start" string="Fecha inicio"
                            context="{'group_by': 'date_start:week'}"/>
                    <filter name="group_user"       string="Responsable"
                            context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- KANBAN: tablero visual de ordenes agrupadas por estado -->
    <record id="plan_alpha_production_kanban" model="ir.ui.view">
        <field name="name">plan.alpha.production.kanban</field>
        <field name="model">mrp.production</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column" sample="1">
                <progressbar field="activity_state"
                             colors='{"planned": "success", "today": "warning", "overdue": "danger"}'/>
                <field name="name"/>
                <field name="state"/>
                <field name="product_id"/>
                <field name="product_qty"/>
                <field name="product_uom_id"/>
                <field name="date_start"/>
                <field name="date_deadline"/>
                <field name="user_id"/>
                <field name="activity_ids"/>
                <field name="activity_state"/>
                <field name="origin"/>
                <field name="workcenter_id"/>
                <templates>
                    <t t-name="card">
                        <div class="o_kanban_record_top mb-0">
                            <div class="o_kanban_record_headings">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                            </div>
                            <field name="activity_ids" widget="kanban_activity" class="ms-1"/>
                        </div>
                        <div class="o_kanban_record_body">
                            <field name="product_id"/>
                            <span class="text-muted ms-1">
                                <field name="product_qty"/>
                                <field name="product_uom_id"/>
                            </span>
                        </div>
                        <div class="o_kanban_record_bottom">
                            <div class="oe_kanban_bottom_left text-muted small">
                                <i class="fa fa-clock-o me-1" title="Fecha"/>
                                <field name="date_start" widget="date"/>
                            </div>
                            <div class="oe_kanban_bottom_right">
                                <field name="user_id" widget="many2one_avatar_user"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- LIST: lista detallada para planeamiento -->
    <record id="plan_alpha_production_list" model="ir.ui.view">
        <field name="name">plan.alpha.production.list</field>
        <field name="model">mrp.production</field>
        <field name="arch" type="xml">
            <list string="Ordenes de Produccion"
                  decoration-info="state == 'draft'"
                  decoration-warning="state == 'confirmed'"
                  decoration-success="state in ('done','to_close')"
                  decoration-danger="state == 'cancel'"
                  multi_edit="1" sample="1">
                <field name="name" decoration-bf="1"/>
                <field name="origin" optional="show"/>
                <field name="product_id"/>
                <field name="product_qty"/>
                <field name="product_uom_id" string="Unidad" optional="hide"/>
                <field name="workcenter_id" optional="show"/>
                <field name="date_start" widget="remaining_days" optional="show"/>
                <field name="date_deadline" optional="show"/>
                <field name="date_finished" optional="hide"/>
                <field name="user_id" widget="many2one_avatar_user" optional="show"/>
                <field name="activity_ids" widget="list_activity" optional="show"/>
                <field name="state"
                       widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'confirmed'"
                       decoration-primary="state == 'progress'"
                       decoration-success="state in ('done','to_close')"
                       decoration-danger="state == 'cancel'"/>
            </list>
        </field>
    </record>

    <!-- CALENDAR: calendario de ordenes por fecha de inicio -->
    <record id="plan_alpha_production_calendar" model="ir.ui.view">
        <field name="name">plan.alpha.production.calendar</field>
        <field name="model">mrp.production</field>
        <field name="arch" type="xml">
            <calendar string="Calendario de Produccion"
                      date_start="date_start"
                      date_stop="date_finished"
                      color="workcenter_id"
                      mode="month"
                      quick_create="false">
                <field name="name"/>
                <field name="product_id"/>
                <field name="workcenter_id" filters="1"/>
                <field name="user_id" avatar_field="image_128"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <!-- ACTION: Tablero Kanban (vista principal) -->
    <record id="action_plan_alpha_kanban" model="ir.actions.act_window">
        <field name="name">Tablero de Produccion</field>
        <field name="res_model">mrp.production</field>
        <field name="view_mode">kanban,list,calendar,activity</field>
        <field name="search_view_id" ref="plan_alpha_production_search"/>
        <field name="context">{'search_default_filter_confirmed': 1, 'search_default_filter_progress': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay ordenes de produccion activas.
            </p>
            <p>
                Las ordenes confirmadas y en progreso apareceran aqui
                para planificar y hacer seguimiento.
            </p>
        </field>
    </record>

    <!-- ACTION: Lista detallada (Planeamiento) -->
    <record id="action_plan_alpha_list" model="ir.actions.act_window">
        <field name="name">Ordenes de Produccion</field>
        <field name="res_model">mrp.production</field>
        <field name="view_mode">list,kanban,form,calendar,activity</field>
        <field name="search_view_id" ref="plan_alpha_production_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Sin ordenes de produccion.
            </p>
            <p>
                Crea una nueva orden desde el modulo de Manufactura
                o confirma los pedidos de venta pendientes.
            </p>
        </field>
    </record>

    <!-- ACTION: Calendario -->
    <record id="action_plan_alpha_calendar" model="ir.actions.act_window">
        <field name="name">Calendario de Produccion</field>
        <field name="res_model">mrp.production</field>
        <field name="view_mode">calendar,list,kanban</field>
        <field name="search_view_id" ref="plan_alpha_production_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay ordenes programadas en este periodo.
            </p>
        </field>
    </record>

</odoo>
