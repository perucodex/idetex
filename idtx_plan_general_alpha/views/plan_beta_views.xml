<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         PLAN BETA: list view — pla_general_planta (SITPRO)
    ============================================================ -->
    <record id="plan_beta_list_view" model="ir.ui.view">
        <field name="name">plan.beta.list</field>
        <field name="model">plan.beta</field>
        <field name="arch" type="xml">
            <list string="Plan Beta" create="false" edit="false" delete="false">
                <!-- Columnas siempre visibles -->
                <field name="nro"          string="Nro"/>
                <field name="fecha"        string="Fecha"/>
                <field name="numordped"    string="Orden Pedido"/>
                <field name="occ"          string="OCC"/>
                <field name="razsoc"       string="Razón Social"/>
                <field name="descrip"      string="Artículo"/>
                <field name="descol"       string="Color"/>
                <field name="kilos"        string="Kilos"        digits="[12,3]"/>
                <field name="activo"       string="Activo"       widget="boolean_toggle"/>

                <!-- Producción y tejido -->
                <field name="talm"         string="T.Alm"        optional="show"/>
                <field name="item"         string="Item"          optional="show"/>
                <field name="talm_b"       string="T.Alm B"      optional="show"/>
                <field name="orden"        string="Orden"         optional="show"/>
                <field name="correl"       string="Correlativo"   optional="show"/>
                <field name="numot"        string="N.OT"          optional="show"/>
                <field name="partida"      string="Partida"       optional="show"/>
                <field name="tiptej"       string="Tip.Tej."      optional="show"/>
                <field name="calidad"      string="Calidad"       optional="show"/>
                <field name="maq"          string="Máquina"       optional="show"/>
                <field name="prio"         string="Prioridad"     optional="show"/>
                <field name="receta"       string="Receta"        optional="show"/>
                <field name="lote"         string="Lote"          optional="show"/>

                <!-- Cantidades y pesos -->
                <field name="pescl"        string="Peso Cl."      digits="[12,3]" optional="show"/>
                <field name="kneto"        string="K.Neto"        digits="[12,3]" optional="show"/>
                <field name="kbruto"       string="K.Bruto"       digits="[12,3]" optional="show"/>
                <field name="ktejido"      string="K.Tejido"      digits="[12,3]" optional="show"/>
                <field name="metrosf"      string="Metros F."     digits="[12,3]" optional="show"/>
                <field name="ancho"        string="Ancho"         digits="[12,3]" optional="show"/>
                <field name="densid"       string="Densidad"      digits="[12,3]" optional="show"/>
                <field name="preuni"       string="P.Unitario"    digits="[12,2]" optional="show"/>
                <field name="dia"          string="Días"          optional="show"/>

                <!-- Fechas principales -->
                <field name="fecdesp"      string="F.Despacho"    optional="show"/>
                <field name="fing"         string="F.Ingreso"     optional="show"/>
                <field name="fecinitej"    string="F.Ini.Tej."    optional="show"/>
                <field name="fecfin"       string="F.Fin"         optional="show"/>
                <field name="fectenido"    string="F.Tenido"      optional="show"/>
                <field name="fecacabado"   string="F.Acabado"     optional="show"/>
                <field name="fecoc"        string="F.OC"          optional="show"/>
                <field name="fecvouc"      string="F.Voucher"     optional="show"/>

                <!-- Cliente y comercial -->
                <field name="cdgclie"      string="Cód.Cliente"   optional="show"/>
                <field name="cdgart"       string="Cód.Art."      optional="show"/>
                <field name="cdgcol"       string="Cód.Color"     optional="show"/>
                <field name="grem"         string="Grem."         optional="show"/>
                <field name="vend1"        string="Vendedor"      optional="show"/>
                <field name="cdgven"       string="Cód.Vend."     optional="show"/>
                <field name="mercado"      string="Mercado"       optional="show"/>
                <field name="moneda"       string="Moneda"        optional="show"/>
                <field name="incoterms"    string="Incoterms"     optional="show"/>
                <field name="tipoventa1"   string="Tipo Venta"    optional="show"/>
                <field name="expo"         string="Expo"          widget="boolean_toggle" optional="show"/>

                <!-- Estados / flags -->
                <field name="repos"        string="Repos."        widget="boolean_toggle" optional="show"/>
                <field name="liqdes"       string="Liq.Des."      widget="boolean_toggle" optional="show"/>
                <field name="gvtas"        string="G.Vtas"        widget="boolean_toggle" optional="show"/>
                <field name="cc"           string="CC"            widget="boolean_toggle" optional="show"/>
                <field name="pcpi"         string="PCPI"          widget="boolean_toggle" optional="show"/>
                <field name="keyes"        string="Keyes"         widget="boolean_toggle" optional="show"/>
                <field name="keyes1"       string="Keyes1"        widget="boolean_toggle" optional="show"/>
                <field name="estampado1"   string="Estampado"     widget="boolean_toggle" optional="show"/>
                <field name="tj"           string="TJ"            widget="boolean_toggle" optional="show"/>

                <!-- Fechas secundarias -->
                <field name="fechadespa"   string="F.Despa."      optional="hide"/>
                <field name="fecini"       string="F.Inicio"      optional="hide"/>
                <field name="fechadespacho" string="F.Despazo"    optional="hide"/>
                <field name="fechil"       string="F.Hilo"        optional="hide"/>
                <field name="fectej"       string="F.Tejido"      optional="hide"/>
                <field name="fecactualiza" string="F.Actualiza"   optional="hide"/>
                <field name="fechaplan"    string="F.Plan"        optional="hide"/>
                <field name="feccc"        string="F.CC"          optional="hide"/>
                <field name="fecgvtas"     string="F.G.Vtas"      optional="hide"/>
                <field name="fechamod"     string="F.Mod."        optional="hide"/>
                <field name="fecalm"       string="F.Alm.Tex"     optional="hide"/>
                <field name="fectemo"      string="F.Termof."     optional="hide"/>
                <field name="fecteni"      string="F.Tenido2"     optional="hide"/>
                <field name="fecaca"       string="F.Acab.2"      optional="hide"/>
                <field name="fecreceta"    string="F.Receta"      optional="hide"/>

                <!-- Barcode / diseño -->
                <field name="barcod"       string="Barcode"       optional="hide"/>
                <field name="barcodreo"    string="Barcode Reo."  optional="hide"/>
                <field name="barcodpar"    string="Barcode Par."  optional="hide"/>
                <field name="coddiseno"    string="Cód.Diseño"    optional="hide"/>
                <field name="diseno"       string="Diseño"        optional="hide"/>
                <field name="ficha"        string="Ficha"         optional="hide"/>
                <field name="partiorig"    string="Part.Orig."    optional="hide"/>

                <!-- Hilos -->
                <field name="codigohilo"   string="Cód.Hilo"      optional="hide"/>
                <field name="galga"        string="Galga"         optional="hide"/>
                <field name="hilo1"        string="Hilo 1"        optional="hide"/>
                <field name="hilo2"        string="Hilo 2"        optional="hide"/>
                <field name="hilo3"        string="Hilo 3"        optional="hide"/>
                <field name="hilo4"        string="Hilo 4"        optional="hide"/>
                <field name="hilo5"        string="Hilo 5"        optional="hide"/>
                <field name="hilo6"        string="Hilo 6"        optional="hide"/>
                <field name="hilo7"        string="Hilo 7"        optional="hide"/>
                <field name="hilo8"        string="Hilo 8"        optional="hide"/>
                <field name="hilo9"        string="Hilo 9"        optional="hide"/>
                <field name="hilo10"       string="Hilo 10"       optional="hide"/>
                <field name="hiloc1"       string="Hilo C1"       optional="hide"/>
                <field name="hiloc2"       string="Hilo C2"       optional="hide"/>
                <field name="hiloc3"       string="Hilo C3"       optional="hide"/>
                <field name="hiloc4"       string="Hilo C4"       optional="hide"/>
                <field name="hiloc5"       string="Hilo C5"       optional="hide"/>
                <field name="hiloc6"       string="Hilo C6"       optional="hide"/>
                <field name="hiloc7"       string="Hilo C7"       optional="hide"/>
                <field name="hiloc8"       string="Hilo C8"       optional="hide"/>
                <field name="hiloc9"       string="Hilo C9"       optional="hide"/>
                <field name="hiloc10"      string="Hilo C10"      optional="hide"/>

                <!-- Proceso y otros -->
                <field name="procsigui"    string="Proc.Sig."     optional="hide"/>
                <field name="procod"       string="Proc.Cod."     optional="hide"/>
                <field name="maq_proce"    string="Maq.Proc."     optional="hide"/>
                <field name="hdr"          string="HDR"           optional="hide"/>
                <field name="xtf"          string="XTF"           optional="hide"/>
                <field name="htf"          string="HTF"           optional="hide"/>
                <field name="t"            string="T"             optional="hide"/>
                <field name="ctrl"         string="Ctrl"          optional="hide"/>
                <field name="testado"      string="Testado"       optional="hide"/>
                <field name="voucher"      string="Voucher"       optional="hide"/>
                <field name="unid"         string="Unidad"        optional="hide"/>
                <field name="descri"       string="Cond.Pago"     optional="hide"/>
                <field name="telefono"     string="Teléfono"      optional="hide"/>
                <field name="observ"       string="Observ."       optional="hide"/>
                <field name="rutafin"      string="Ruta Fin"      optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_plan_beta_lista" model="ir.actions.act_window">
        <field name="name">Plan Beta</field>
        <field name="res_model">plan.beta</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="plan_beta_list_view"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Sin datos disponibles desde SITPRO.
            </p>
            <p>
                Los registros se leen en tiempo real desde
                la tabla <strong>pla_general_planta</strong> de SITPRO.
            </p>
        </field>
    </record>

</odoo>
