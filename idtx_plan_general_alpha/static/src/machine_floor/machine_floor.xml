<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

<t t-name="idtx_plan_alpha.MachineFloor">
<div class="mf-root">

    <!-- ── HEADER ──────────────────────────────────────────────────────────── -->
    <div class="mf-header" t-att-style="headerStyle">
        <div class="mf-header-stats" t-if="!state.loading and !state.wcLoading">
            <div class="mf-stat mf-stat--operativa">
                <span class="mf-stat-num" t-esc="stats.operativa"/>
                <span class="mf-stat-lbl">Operativa</span>
            </div>
            <div class="mf-stat mf-stat--ejecutando">
                <span class="mf-stat-num" t-esc="stats.ejecutando"/>
                <span class="mf-stat-lbl">Ejecutando</span>
            </div>
            <div class="mf-stat mf-stat--malograda">
                <span class="mf-stat-num" t-esc="stats.malograda"/>
                <span class="mf-stat-lbl">Malograda</span>
            </div>
            <div class="mf-stat mf-stat--mantenimiento">
                <span class="mf-stat-num" t-esc="stats.mantenimiento"/>
                <span class="mf-stat-lbl">Mantenim.</span>
            </div>
            <div class="mf-stat mf-stat--apagada">
                <span class="mf-stat-num" t-esc="stats.apagada"/>
                <span class="mf-stat-lbl">Apagada</span>
            </div>
            <div class="mf-stat mf-stat--total">
                <span class="mf-stat-num" t-esc="stats.total"/>
                <span class="mf-stat-lbl">Total</span>
            </div>
        </div>
        <button class="mf-btn-edit" t-on-click="resetFactoryOrder"
                title="Ordenar de fábrica (todas las máquinas, todos los centros de trabajo)">
            <i class="fa fa-sort-numeric-asc"/>
        </button>
        <button class="mf-btn-edit" t-att-class="state.editMode ? 'mf-btn-edit--active' : ''"
                t-on-click="toggleEditMode" title="Combinar cuadros de máquinas">
            <i class="fa fa-object-group"/>
        </button>
        <button class="mf-btn-refresh" t-on-click="onRefresh" title="Actualizar">
            <i class="fa fa-refresh"/>
        </button>
    </div>

    <!-- ── INITIAL LOAD ─────────────────────────────────────────────────────── -->
    <div class="mf-loading" t-if="state.loading">
        <i class="fa fa-circle-o-notch fa-spin fa-2x"/>
        <span>Cargando centros de trabajo…</span>
    </div>

    <t t-if="!state.loading">

        <!-- ── WORKCENTER TABS ──────────────────────────────────────────────── -->
        <div class="mf-wc-tabs">
            <t t-foreach="state.workcenters" t-as="wc" t-key="wc.name">
                <button class="mf-wc-tab"
                        t-att-class="state.activeWc === wc.name ? 'mf-wc-tab--active' : ''"
                        t-att-data-wc="wc.name"
                        t-on-click="onWcTabClick">
                    <i class="fa fa-th-large"/>
                    <span t-esc="wc.name"/>
                    <span class="mf-wc-badge" t-esc="wc.count"/>
                </button>
            </t>
            <div class="mf-wc-tabs-spacer"/>
        </div>

        <!-- ── FILTER BAR ───────────────────────────────────────────────────── -->
        <div class="mf-filters">
            <div class="mf-filter-group">
                <span class="mf-filter-lbl">Estado:</span>
                <t t-foreach="statusFilters" t-as="f" t-key="f.key">
                    <button class="mf-chip"
                            t-att-class="state.filterStatus === f.key ? 'mf-chip--active' : ''"
                            t-att-data-status="f.key"
                            t-on-click="onFilterStatus"
                            t-esc="f.label"/>
                </t>
            </div>
            <div class="mf-filter-sep" t-if="machineTypes.length > 1"/>
            <div class="mf-filter-group" t-if="machineTypes.length > 1">
                <span class="mf-filter-lbl">Tipo:</span>
                <button class="mf-chip"
                        t-att-class="state.filterType === 'all' ? 'mf-chip--active' : ''"
                        data-type="all"
                        t-on-click="onFilterType">Todas</button>
                <t t-foreach="machineTypes" t-as="mtype" t-key="mtype">
                    <button class="mf-chip"
                            t-att-class="state.filterType === mtype ? 'mf-chip--active' : ''"
                            t-att-data-type="mtype"
                            t-on-click="onFilterType"
                            t-esc="mtype"/>
                </t>
            </div>
            <button class="mf-btn-clear" t-if="isFiltered" t-on-click="onClearFilters">
                <i class="fa fa-times"/> Limpiar
                <span class="mf-filter-count">(<t t-esc="filteredMachines.length"/>/<t t-esc="stats.total"/>)</span>
            </button>
        </div>

        <!-- ── WC LOADING ───────────────────────────────────────────────────── -->
        <div class="mf-loading mf-loading--sm" t-if="state.wcLoading">
            <i class="fa fa-circle-o-notch fa-spin"/>
            <span>Cargando máquinas…</span>
        </div>

        <!-- ── COMPACT GRID (filter active) ─────────────────────────────────── -->
        <div class="mf-compact-grid" t-elif="isFiltered">
            <t t-foreach="filteredMachines" t-as="m" t-key="m.id">
                <div class="mf-card"
                     t-att-class="'mf-card--' + m.status"
                     t-att-style="'--tc:' + m.tcfg.color"
                     t-att-title="m.name"
                     t-att-data-machine-id="m.id"
                     t-on-click="onMachineCardClick">
                    <div class="mf-card-row1">
                        <span class="mf-card-num">#<t t-esc="m.num"/></span>
                        <span class="mf-card-dot" t-att-class="'mf-card-dot--' + m.status"/>
                    </div>
                    <div class="mf-card-ico">
                        <i t-att-class="'fa ' + m.tcfg.icon"/>
                    </div>
                    <div class="mf-card-type" t-esc="m.type"/>
                </div>
            </t>
            <div class="mf-empty" t-if="filteredMachines.length === 0">
                <i class="fa fa-search"/>
                <span>Sin resultados</span>
            </div>
        </div>

        <!-- ── SLOT GRID (no filter — drag-and-drop) ────────────────────────── -->
        <div class="mf-slot-grid" t-else="">
            <div class="mf-dnd-hint" t-if="!state.editMode">
                <i class="fa fa-hand-grab-o"/>
                Arrastra las tarjetas para reorganizar · Haz clic para ver detalles ·
                <i class="fa fa-object-group"/> combina hasta 8 cuadros para agrandar una máquina
            </div>
            <div class="mf-dnd-hint mf-dnd-hint--edit" t-if="state.editMode">
                <i class="fa fa-object-group"/>
                Modo combinar: elige 2, 4, 6 u 8 cuadros en fila o en columna, luego confirma
                <span class="mf-edit-count" t-if="state.selection.length" t-esc="state.selection.length + '/8 seleccionados'"/>
            </div>
            <div class="mf-grid-inner">
                <t t-foreach="gridSlots" t-as="slot" t-key="slot.index">
                    <div class="mf-slot"
                         t-att-class="(slot.machine ? 'mf-slot--filled' : 'mf-slot--empty') + (slot.span > 1 ? ' mf-slot--big' : '') + (slot.selected ? ' mf-slot--selected' : '') + (state.editMode ? ' mf-slot--editable' : '')"
                         t-att-style="slot.gridStyle"
                         t-att-data-slot="slot.index"
                         t-on-click="onSlotContainerClick"
                         t-on-dragover="onSlotDragOver"
                         t-on-dragleave="onSlotDragLeave"
                         t-on-drop="onSlotDrop">

                        <!-- Machine card — compact (span 1) -->
                        <div t-if="slot.machine and slot.span === 1"
                             class="mf-card"
                             t-att-class="'mf-card--' + slot.machine.status + (slot.machine.status === 'ejecutando' ? ' mf-card--locked' : '')"
                             t-att-style="'--tc:' + slot.machine.tcfg.color"
                             t-att-draggable="slot.machine.status === 'ejecutando' ? 'false' : 'true'"
                             t-att-data-status="slot.machine.status"
                             t-att-data-span="slot.span"
                             t-att-data-machine-id="slot.machine.id"
                             t-att-data-slot="slot.index"
                             t-att-title="slot.machine.status === 'ejecutando' ? slot.machine.name + ' — Ejecutando (no se puede mover)' : slot.machine.name"
                             t-on-dragstart="onMachineDragStart"
                             t-on-dragend="onMachineDragEnd"
                             t-on-click="onMachineCardClick">

                            <div class="mf-card-row1">
                                <span class="mf-card-num">#<t t-esc="slot.machine.num"/></span>
                                <i t-if="slot.machine.status === 'ejecutando'" class="fa fa-lock mf-card-lock"/>
                                <span class="mf-card-dot"
                                      t-att-class="'mf-card-dot--' + slot.machine.status"/>
                            </div>
                            <div class="mf-card-ico">
                                <i t-att-class="'fa ' + slot.machine.tcfg.icon"/>
                            </div>
                            <div class="mf-card-type" t-esc="slot.machine.type"/>
                        </div>

                        <!-- Machine card — combinada/agrandada (span 2 o 4) -->
                        <div t-if="slot.machine and slot.span > 1"
                             class="mf-card mf-card--big"
                             t-att-class="'mf-card--' + slot.machine.status + (slot.machine.status === 'ejecutando' ? ' mf-card--locked' : '')"
                             t-att-style="'--tc:' + slot.machine.tcfg.color"
                             draggable="false"
                             t-att-data-status="slot.machine.status"
                             t-att-data-span="slot.span"
                             t-att-data-span-rows="slot.spanRows"
                             t-att-data-orientation="slot.orientation"
                             t-att-data-machine-id="slot.machine.id"
                             t-att-data-slot="slot.index"
                             t-att-title="slot.machine.name"
                             t-on-click="onMachineCardClick">

                            <button t-if="state.editMode" class="mf-card-unmerge"
                                    t-on-click.stop="() => this.unmergeMachine(slot.machine)" title="Deshacer combinación">
                                <i class="fa fa-compress"/>
                            </button>

                            <span t-att-class="'mf-card-big-status-dot mf-card-dot mf-card-dot--' + slot.machine.status"
                                  t-att-title="panelStateLabel(slot.machine.status)"/>

                            <div class="mf-card-big-headrow">
                                <div class="mf-card-big-top">
                                    <span class="mf-card-big-icon">
                                        <i t-att-class="'fa ' + slot.machine.tcfg.icon"/>
                                    </span>
                                    <div class="mf-card-big-id">
                                        <span class="mf-card-big-num">#<t t-esc="slot.machine.num"/></span>
                                        <span class="mf-card-big-type" t-esc="slot.machine.type"/>
                                    </div>
                                </div>
                            </div>

                            <t t-if="slot.machine.current_job">
                                <div class="mf-card-big-job">
                                    <div class="mf-card-big-job-prod" t-esc="slot.machine.current_job.production"/>
                                    <div class="mf-card-big-job-prod2" t-esc="slot.machine.current_job.product"/>
                                    <div class="mf-card-big-progress">
                                        <div class="mf-card-big-progress-bar" t-attf-style="width:#{Math.round(slot.machine.current_job.progress)}%;"/>
                                    </div>
                                    <div class="mf-card-big-progress-lbl">Avance: <t t-esc="Math.round(slot.machine.current_job.progress)"/>%</div>
                                </div>
                            </t>
                            <t t-else="">
                                <div class="mf-card-big-empty">
                                    <i class="fa fa-moon-o"/> <span>Sin OT en progreso</span>
                                </div>
                            </t>
                        </div>

                    </div>
                </t>
            </div>

            <!-- Barra flotante de acción del modo edición -->
            <div class="mf-edit-bar" t-if="state.editMode and editAction">
                <span t-if="editAction.type === 'invalid'" class="mf-edit-bar-msg mf-edit-bar-msg--error" t-esc="editAction.message"/>
                <t t-if="editAction.type === 'combine'">
                    <span class="mf-edit-bar-msg">Combinar <t t-esc="editAction.spanCols + 'x' + editAction.spanRows"/> para <t t-esc="editAction.machine.name"/></span>
                    <button class="mf-edit-bar-btn" t-on-click="combineSelection">
                        <i class="fa fa-object-group"/> Combinar
                    </button>
                </t>
                <t t-if="editAction.type === 'unmerge'">
                    <span class="mf-edit-bar-msg">Deshacer combinación de <t t-esc="editAction.machine.name"/></span>
                    <button class="mf-edit-bar-btn" t-on-click="unmergeSelection">
                        <i class="fa fa-compress"/> Deshacer
                    </button>
                </t>
            </div>
        </div>

    </t>

    <!-- ── SIDE PANEL ───────────────────────────────────────────────────────── -->
    <t t-if="state.panel.open">
        <div class="mf-panel-overlay" t-on-click="onCloseSidePanel"/>
        <div class="mf-panel">

            <!-- Header del panel -->
            <div class="mf-panel-header">
                <div class="mf-panel-header-left">
                    <i class="fa fa-cog mf-panel-header-icon"/>
                    <span class="mf-panel-header-title">Detalle de Máquina</span>
                </div>
                <button class="mf-panel-close" t-on-click="onCloseSidePanel">
                    <i class="fa fa-times"/>
                </button>
            </div>

            <!-- Loading -->
            <div class="mf-panel-loading" t-if="state.panel.loading">
                <i class="fa fa-circle-o-notch fa-spin fa-2x"/>
                <span>Cargando datos…</span>
            </div>

            <!-- Contenido -->
            <div class="mf-panel-body" t-elif="state.panel.machine">
                <t t-set="m" t-value="state.panel.machine"/>

                <!-- Nombre y estado -->
                <div class="mf-panel-hero">
                    <div class="mf-panel-hero-name" t-esc="m.name"/>
                    <div t-att-class="'mf-panel-status mf-panel-status--' + (m.machine_state or 'apagada')">
                        <span class="mf-panel-status-dot"/>
                        <span t-esc="panelStateLabel(m.machine_state)"/>
                    </div>
                </div>

                <!-- Ficha técnica -->
                <div class="mf-panel-section">
                    <div class="mf-panel-section-title">
                        <i class="fa fa-info-circle"/> Ficha Técnica
                    </div>
                    <div class="mf-panel-grid">
                        <div class="mf-panel-field" t-if="m.model">
                            <span class="mf-panel-field-lbl">Fabricante</span>
                            <span class="mf-panel-field-val" t-esc="m.model"/>
                        </div>
                        <div class="mf-panel-field" t-if="m.serial">
                            <span class="mf-panel-field-lbl">Serial / Código</span>
                            <span class="mf-panel-field-val" t-esc="m.serial"/>
                        </div>
                        <div class="mf-panel-field" t-if="m.year">
                            <span class="mf-panel-field-lbl">Año fabricación</span>
                            <span class="mf-panel-field-val" t-esc="m.year"/>
                        </div>
                        <div class="mf-panel-field" t-if="m.capacity">
                            <span class="mf-panel-field-lbl">Capacidad / Potencia</span>
                            <span class="mf-panel-field-val" t-esc="m.capacity"/>
                        </div>
                        <div class="mf-panel-field" t-if="m.workcenter">
                            <span class="mf-panel-field-lbl">Centro de trabajo</span>
                            <span class="mf-panel-field-val" t-esc="m.workcenter"/>
                        </div>
                        <div class="mf-panel-field" t-if="m.department">
                            <span class="mf-panel-field-lbl">Departamento</span>
                            <span class="mf-panel-field-val" t-esc="m.department"/>
                        </div>
                        <div class="mf-panel-field" t-if="m.technician">
                            <span class="mf-panel-field-lbl">Técnico responsable</span>
                            <span class="mf-panel-field-val" t-esc="m.technician"/>
                        </div>
                        <div class="mf-panel-field" t-if="m.purchase_date">
                            <span class="mf-panel-field-lbl">Fecha compra</span>
                            <span class="mf-panel-field-val" t-esc="m.purchase_date"/>
                        </div>
                        <div class="mf-panel-field" t-if="m.warranty_date">
                            <span class="mf-panel-field-lbl">Garantía hasta</span>
                            <span class="mf-panel-field-val" t-esc="m.warranty_date"/>
                        </div>
                    </div>
                    <div class="mf-panel-note" t-if="m.note">
                        <i class="fa fa-sticky-note-o"/> <t t-esc="m.note"/>
                    </div>
                </div>

                <!-- Tejiendo ahora (órdenes de trabajo en progreso en esta máquina) -->
                <div class="mf-panel-section" t-if="state.panel.tejiendo.length">
                    <div class="mf-panel-section-title">
                        <i class="fa fa-cogs"/> Tejiendo ahora
                        <span class="mf-panel-badge" t-esc="state.panel.tejiendo.length"/>
                    </div>
                    <t t-foreach="state.panel.tejiendo" t-as="job" t-key="job.id">
                        <div class="mf-panel-job">
                            <div class="mf-panel-job-top">
                                <span class="mf-panel-job-prod" t-esc="job.product or '—'"/>
                                <span class="mf-panel-job-qty" t-if="job.qty">
                                    <i class="fa fa-balance-scale"/>
                                    <t t-esc="job.produced"/>/<t t-esc="job.qty"/> <t t-esc="job.uom"/>
                                </span>
                            </div>
                            <div class="mf-panel-job-wo" t-if="job.workorder" t-esc="job.workorder"/>
                            <div class="mf-panel-job-meta">
                                <span t-if="job.rate">
                                    <i class="fa fa-tachometer"/> <t t-esc="job.rate"/> kg/h
                                </span>
                                <span t-if="job.date_start">
                                    <i class="fa fa-clock-o"/> Inicio: <t t-esc="job.date_start"/>
                                </span>
                            </div>
                        </div>
                    </t>
                </div>

                <!-- Historial: órdenes de trabajo ya terminadas en esta máquina -->
                <div class="mf-panel-section" t-if="state.panel.historial.length">
                    <div class="mf-panel-section-title">
                        <i class="fa fa-history"/> Historial de tejido
                        <span class="mf-panel-badge" t-esc="state.panel.historial.length"/>
                    </div>
                    <t t-foreach="state.panel.historial" t-as="h" t-key="h.id">
                        <div class="mf-panel-job mf-panel-job--done">
                            <div class="mf-panel-job-top">
                                <span class="mf-panel-job-prod" t-esc="h.product or '—'"/>
                                <span class="mf-panel-job-qty" t-if="h.produced">
                                    <i class="fa fa-balance-scale"/>
                                    <t t-esc="h.produced"/>/<t t-esc="h.qty"/> <t t-esc="h.uom"/>
                                </span>
                            </div>
                            <div class="mf-panel-job-wo" t-if="h.workorder">
                                <t t-esc="h.workorder"/>
                                <t t-if="h.production"> · <t t-esc="h.production"/></t>
                            </div>
                            <div class="mf-panel-job-meta">
                                <span t-if="h.date_start">
                                    <i class="fa fa-play-circle-o"/> Inicio: <t t-esc="h.date_start"/>
                                </span>
                                <span t-if="h.date_finished">
                                    <i class="fa fa-check-circle-o"/> Fin: <t t-esc="h.date_finished"/>
                                </span>
                                <span t-if="h.duration">
                                    <i class="fa fa-hourglass-half"/> <t t-esc="h.duration"/> min
                                </span>
                            </div>
                        </div>
                    </t>
                </div>
            </div>

            <!-- Error -->
            <div class="mf-panel-loading" t-elif="!state.panel.loading">
                <i class="fa fa-exclamation-circle"/>
                <span>No se pudo cargar el detalle</span>
            </div>

        </div>
    </t>

</div>
</t>

</templates>
