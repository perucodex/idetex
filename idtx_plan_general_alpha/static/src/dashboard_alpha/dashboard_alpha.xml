<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

<t t-name="idtx_plan_general_alpha.DashboardAlpha">
<div class="pad">
    <div class="pad__scroll" t-ref="scroll">

        <!-- ── Loading ──────────────────────────────────────────────────── -->
        <t t-if="state.loading">
            <div class="pad__state">
                <span class="pad__spinner"><i class="fa fa-circle-o-notch fa-spin"/></span>
                <p>Cargando dashboard…</p>
            </div>
        </t>

        <!-- ── Error ────────────────────────────────────────────────────── -->
        <t t-elif="state.error">
            <div class="pad__state pad__state--error">
                <i class="fa fa-exclamation-triangle fa-2x"/>
                <p t-esc="state.error"/>
            </div>
        </t>

        <!-- ── Contenido ────────────────────────────────────────────────── -->
        <t t-else="">

            <!-- Header -->
            <header class="pad__header">
                <div class="pad__header-left">
                    <div class="pad__header-icon">
                        <i class="fa fa-bar-chart"/>
                    </div>
                    <div>
                        <h1 class="pad__header-title">Dashboard de Planeamiento</h1>
                        <p class="pad__header-sub">Producción Textil · IDETEX S.A.C.</p>
                    </div>
                </div>
                <div class="pad__header-right">
                    <span class="pad__badge pad__badge--live">
                        <i class="fa fa-circle"/> En vivo
                    </span>
                </div>
            </header>

            <!-- ── KPIs ─────────────────────────────────────────────────── -->
            <section class="pad__kpis">
                <t t-foreach="kpis" t-as="k" t-key="k.lbl">
                    <div class="pad__kpi" t-attf-style="--c:#{k.c};--bg:#{k.bg};--bgdk:#{k.bgdk}">
                        <div class="pad__kpi-left">
                            <span class="pad__kpi-lbl" t-esc="k.lbl"/>
                            <span class="pad__kpi-num"
                                  t-att-data-cnt="k.raw"
                                  t-att-data-kg="k.isKg ? '1' : '0'"
                                  t-esc="k.fmt(k.raw)"/>
                            <span t-if="k.sub" class="pad__kpi-sub" t-esc="k.sub"/>
                        </div>
                        <div class="pad__kpi-ico">
                            <i t-attf-class="fa #{k.icon}"/>
                        </div>
                    </div>
                </t>
            </section>

            <!-- ── KPIs Máquinas TEXPLUS (si disponible) ─────────────────── -->
            <t t-if="kpiMaquinas">
                <section class="pad__kpis pad__kpis--maq">
                    <div class="pad__kpi pad__kpi--maq" style="--c:#3b82f6;--bg:#eff6ff;--bgdk:#1e3a5f">
                        <div class="pad__kpi-left">
                            <span class="pad__kpi-lbl">Cargas Hoy (TEXPLUS)</span>
                            <span class="pad__kpi-num" t-esc="kpiMaquinas.totalHoy.toLocaleString('es-PE')"/>
                            <span class="pad__kpi-sub">cargas procesadas hoy</span>
                        </div>
                        <div class="pad__kpi-ico"><i class="fa fa-industry"/></div>
                    </div>
                    <div class="pad__kpi pad__kpi--maq" style="--c:#14b8a6;--bg:#f0fdfa;--bgdk:#134e4a">
                        <div class="pad__kpi-left">
                            <span class="pad__kpi-lbl">Cargas Esta Semana</span>
                            <span class="pad__kpi-num" t-esc="kpiMaquinas.totalSem.toLocaleString('es-PE')"/>
                            <span class="pad__kpi-sub">últimos 7 días</span>
                        </div>
                        <div class="pad__kpi-ico"><i class="fa fa-calendar-check-o"/></div>
                    </div>
                    <div class="pad__kpi pad__kpi--maq" style="--c:#f59e0b;--bg:#fffbeb;--bgdk:#451a03">
                        <div class="pad__kpi-left">
                            <span class="pad__kpi-lbl">Máquinas Activas Hoy</span>
                            <span class="pad__kpi-num" t-esc="kpiMaquinas.actHoy.toLocaleString('es-PE')"/>
                            <span class="pad__kpi-sub">de <t t-esc="state.data.maquinas.top_maquinas.length"/> en seguimiento</span>
                        </div>
                        <div class="pad__kpi-ico"><i class="fa fa-cog"/></div>
                    </div>
                </section>
            </t>

            <!-- ── Sección: Pedidos por Vendedor ─────────────────────────── -->
            <!-- Los KPIs de arriba suman TODOS los vendedores. La vista
                 "Cotizaciones" de Ventas filtra por defecto a "Mis Cotizaciones"
                 (solo el vendedor logueado), por eso esta tabla puede no
                 coincidir con lo que ves ahí a simple vista — usa esta tabla
                 para reconciliar por vendedor. -->
            <section class="pad__section" t-if="state.data.pedidos.por_vendedor and state.data.pedidos.por_vendedor.length">
                <h2 class="pad__section-title">Pedidos por Vendedor</h2>
                <div class="pad__card">
                    <div class="pad__card-hd">
                        <i class="fa fa-user-o pad__ic--indigo"/>
                        Cotizaciones y Pedidos de Venta, por vendedor
                        <span class="pad__pill">Total arriba = suma de todos</span>
                    </div>
                    <div class="pad__table-wrap">
                        <table class="pad__table">
                            <thead>
                                <tr>
                                    <th>Vendedor</th>
                                    <th style="text-align:right">Cotizaciones</th>
                                    <th style="text-align:right">Kg Cotizado</th>
                                    <th style="text-align:right">Pedidos de Venta</th>
                                    <th style="text-align:right">Kg Confirmado</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="state.data.pedidos.por_vendedor" t-as="v" t-key="v.vendedor">
                                    <tr>
                                        <td t-esc="v.vendedor"/>
                                        <td style="text-align:right" t-esc="v.cotizaciones"/>
                                        <td style="text-align:right" t-esc="v.kg_cotizado.toLocaleString('es-PE') + ' kg'"/>
                                        <td style="text-align:right" t-esc="v.confirmados"/>
                                        <td style="text-align:right" t-esc="v.kg_confirmado.toLocaleString('es-PE') + ' kg'"/>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>

            <!-- ── Sección 1: Visión General ────────────────────────────── -->
            <section class="pad__section">
                <h2 class="pad__section-title">Visión General</h2>
                <div class="pad__grid pad__grid--dgt">

                    <div class="pad__card">
                        <div class="pad__card-hd">
                            <i class="fa fa-pie-chart pad__ic--indigo"/>
                            Estado de Pedidos
                        </div>
                        <div class="pad__chart" style="height:280px">
                            <div t-ref="c1"/>
                        </div>
                    </div>

                    <div class="pad__card">
                        <div class="pad__card-hd">
                            <i class="fa fa-tachometer pad__ic--green"/>
                            % Confirmados
                        </div>
                        <div class="pad__chart" style="height:280px">
                            <div t-ref="c2"/>
                        </div>
                    </div>

                    <div class="pad__card">
                        <div class="pad__card-hd">
                            <i class="fa fa-area-chart pad__ic--blue"/>
                            Tendencia Mensual · Cotizaciones vs Confirmados
                        </div>
                        <div class="pad__chart" style="height:280px">
                            <div t-ref="c3"/>
                        </div>
                    </div>

                </div>
            </section>

            <!-- ── Sección 2: Análisis de Pedidos ───────────────────────── -->
            <section class="pad__section">
                <h2 class="pad__section-title">Análisis de Pedidos</h2>
                <div class="pad__grid pad__grid--1-1">

                    <div class="pad__card">
                        <div class="pad__card-hd">
                            <i class="fa fa-users pad__ic--cyan"/>
                            Top Clientes por Kg
                        </div>
                        <div class="pad__chart" style="height:320px">
                            <div t-ref="c4"/>
                        </div>
                    </div>

                    <div class="pad__card">
                        <div class="pad__card-hd">
                            <i class="fa fa-trophy pad__ic--amber"/>
                            Pedidos más Grandes (kg)
                        </div>
                        <div class="pad__chart" style="height:320px">
                            <div t-ref="c5"/>
                        </div>
                    </div>

                </div>
            </section>

            <!-- ── Sección 3: Producción por Área y Proceso ─────────────── -->
            <section class="pad__section">
                <h2 class="pad__section-title">Producción por Producto y Color</h2>
                <div class="pad__grid pad__grid--1-1">

                    <div class="pad__card">
                        <div class="pad__card-hd">
                            <i class="fa fa-cubes pad__ic--amber"/>
                            Kg por Producto
                        </div>
                        <div class="pad__chart" style="height:280px">
                            <div t-ref="c6"/>
                        </div>
                    </div>

                    <div class="pad__card">
                        <div class="pad__card-hd">
                            <i class="fa fa-tint pad__ic--indigo"/>
                            Kg por Color
                        </div>
                        <div class="pad__chart" style="height:340px">
                            <div t-ref="c7"/>
                        </div>
                    </div>

                </div>
            </section>

            <!-- ── Sección 4: Actividad de Máquinas (TEXPLUS) ───────────── -->
            <t t-if="state.data.maquinas and state.data.maquinas.disponible">
                <section class="pad__section">
                    <h2 class="pad__section-title">
                        Actividad de Máquinas · TEXPLUS
                        <span class="pad__pill pad__pill--live">En tiempo real</span>
                    </h2>
                    <div class="pad__grid pad__grid--1-1">

                        <div class="pad__card">
                            <div class="pad__card-hd">
                                <i class="fa fa-industry pad__ic--blue"/>
                                Máquinas más Activas Hoy
                            </div>
                            <div class="pad__chart" style="height:380px">
                                <div t-ref="c9"/>
                            </div>
                            <!-- Leyenda de tipos -->
                            <div class="pad__maq-legend">
                                <span class="pad__maq-badge" style="--mc:#3b82f6">Tintorería</span>
                                <span class="pad__maq-badge" style="--mc:#14b8a6">Acabados</span>
                                <span class="pad__maq-badge" style="--mc:#f59e0b">Preparado</span>
                                <span class="pad__maq-badge" style="--mc:#ec4899">Estampado</span>
                            </div>
                        </div>

                        <div class="pad__card">
                            <div class="pad__card-hd">
                                <i class="fa fa-line-chart pad__ic--teal"/>
                                Tendencia de Cargas por Área (últimos 7 días)
                            </div>
                            <div class="pad__chart" style="height:380px">
                                <div t-ref="c10"/>
                            </div>
                        </div>

                    </div>
                </section>
            </t>

            <!-- ── Sección 5: Cronograma Semanal ────────────────────────── -->
            <section class="pad__section">
                <h2 class="pad__section-title">Kilos por Estado</h2>
                <div class="pad__grid pad__grid--full">
                    <div class="pad__card">
                        <div class="pad__card-hd">
                            <i class="fa fa-balance-scale pad__ic--indigo"/>
                            Kilos por Estado (confirmado · cotizado · cancelado)
                        </div>
                        <div class="pad__chart" style="height:210px">
                            <div t-ref="c8"/>
                        </div>
                    </div>
                </div>
            </section>

            <!-- ── Sección 6: Tabla próximos a vencer ───────────────────── -->
            <section class="pad__section">
                <h2 class="pad__section-title">Detalle de Pedidos</h2>
                <div class="pad__card">
                    <div class="pad__card-hd">
                        <i class="fa fa-list-alt pad__ic--indigo"/>
                        Pedidos de venta y cotizaciones
                        <span class="pad__pill">
                            <t t-esc="state.data.pedidos.detalle.length"/> pedidos
                        </span>
                    </div>

                    <t t-if="state.data.pedidos.detalle.length">
                        <div class="pad__table-wrap">
                            <table class="pad__table">
                                <thead>
                                    <tr>
                                        <th>N° Pedido</th>
                                        <th>Cliente</th>
                                        <th style="text-align:right">Kg</th>
                                        <th style="text-align:right">Monto S/</th>
                                        <th style="text-align:center">Estado</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="state.data.pedidos.detalle" t-as="p" t-key="p.num">
                                        <tr>
                                            <td><span class="pad__num" t-esc="p.num"/></td>
                                            <td t-esc="p.customer"/>
                                            <td style="text-align:right" t-esc="p.kg.toLocaleString('es-PE') + ' kg'"/>
                                            <td style="text-align:right" t-esc="'S/ ' + p.monto.toLocaleString('es-PE')"/>
                                            <td style="text-align:center">
                                                <span t-attf-class="pad__chip #{p.state === 'sale' ? 'chip--green' : p.state === 'cancel' ? 'chip--red' : 'chip--amber'}">
                                                    <t t-esc="p.estado"/>
                                                </span>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </t>
                    <t t-else="">
                        <div class="pad__empty">
                            <i class="fa fa-inbox fa-lg"/>
                            <span>No hay pedidos de venta registrados.</span>
                        </div>
                    </t>
                </div>
            </section>

        </t><!-- /else data loaded -->
    </div><!-- /scroll -->
</div><!-- /pad -->
</t>

</templates>
