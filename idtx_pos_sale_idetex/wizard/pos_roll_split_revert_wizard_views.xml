<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Vista form del wizard "Revertir partición".

        Diseño:
          - Sección HIJO con datos del lote a eliminar (readonly)
          - Sección PADRE con el destino + vista previa de qty final
          - Footer con botones Cancelar / Confirmar reversión
    -->
    <record id="view_pos_roll_split_revert_wizard_form" model="ir.ui.view">
        <field name="name">pos.roll.split.revert.wizard.form</field>
        <field name="model">pos.roll.split.revert.wizard</field>
        <field name="arch" type="xml">
            <form string="Revertir partición">
                <sheet>
                    <!-- Aviso de operación destructiva al inicio -->
                    <div class="alert alert-danger" role="alert"
                         style="margin-bottom: 1rem;">
                        <i class="fa fa-exclamation-triangle me-2" title="Advertencia" role="img" aria-label="Advertencia"/>
                        <strong>Operación destructiva:</strong>
                        El rollo hijo será ELIMINADO completamente. Sus kilos
                        se devolverán al rollo padre. Esta acción no se puede
                        deshacer.
                    </div>

                    <!-- 1. Datos del hijo a eliminar -->
                    <group string="Rollo hijo (será eliminado)">
                        <group>
                            <field name="child_lot_id" options="{'no_open': True, 'no_create': True}"/>
                            <field name="child_product_id" options="{'no_open': True}"/>
                        </group>
                        <group>
                            <field name="child_qty" widget="float" digits="[16,2]"/>
                        </group>
                    </group>

                    <!-- 2. Datos del padre destino + preview -->
                    <group string="Rollo padre (destino)">
                        <group>
                            <field name="parent_lot_id" options="{'no_open': True, 'no_create': True}"/>
                            <field name="parent_qty_before" widget="float" digits="[16,2]"/>
                        </group>
                        <group>
                            <field name="parent_qty_after"
                                   widget="float"
                                   digits="[16,2]"
                                   readonly="1"/>
                        </group>
                    </group>
                </sheet>

                <footer>
                    <button name="action_confirm_revert"
                            string="Confirmar reversión"
                            type="object"
                            class="btn-danger"
                            confirm="¿Estás seguro de eliminar este rollo y devolver sus kilos al padre? Esta acción no se puede deshacer."/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!--
        ir.actions.act_window con binding al modelo idtx.pos.stock.report.
        Aparece como "Revertir partición" en el menú Acciones del list view
        de Existencias PdV, al lado de "Partir rollo".
    -->
    <record id="action_pos_roll_split_revert_wizard" model="ir.actions.act_window">
        <field name="name">Revertir partición</field>
        <field name="res_model">pos.roll.split.revert.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id"
               ref="idtx_pos_report_stock.model_idtx_pos_stock_report"/>
        <field name="binding_view_types">list</field>
    </record>
</odoo>
