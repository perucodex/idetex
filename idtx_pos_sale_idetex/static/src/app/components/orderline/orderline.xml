<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <!-- 
        Extensión del componente Orderline para mostrar el precio unitario 
        a la izquierda del total de la línea.
    -->
    <t t-name="idtx_pos_sale_idetex.Orderline" t-inherit="point_of_sale.Orderline" t-inherit-mode="extension" owl="1">
        
        <!-- 1. Insertamos el precio unitario con etiqueta P.U. -->
        <xpath expr="//div[hasclass('product-price')]" position="before">
            <div t-if="vals.displayPriceUnit and !vals.isReceipt" 
                 class="idtx-unit-price text-muted me-2 align-self-center" 
                 style="font-size: 0.85rem;">
                 <!-- Usamos line.currencyDisplayPriceUnit para evitar el sufijo / kg -->
                <t t-esc="line.currencyDisplayPriceUnit"/>
            </div>
        </xpath>

        <!-- 2. Ocultamos la visualización original en la info-list para no duplicar -->
        <xpath expr="//li[hasclass('price-per-unit')]" position="attributes">
            <attribute name="style">display: none !important;</attribute>
        </xpath>
    </t>
</templates>
