<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="idtx_pos_sale_idetex.OrderTabs" t-inherit="point_of_sale.OrderTabs" t-inherit-mode="extension">
        <xpath expr="//button" position="attributes">
            <attribute name="t-esc"></attribute>
            <attribute name="class" add="d-flex flex-column align-items-center justify-content-center py-1 px-2 mx-1" separator=" "/>
            <attribute name="style">min-width: 6.5rem; min-height: 3.5rem; line-height: 1.1;</attribute>
        </xpath>
        <xpath expr="//button" position="inside">
            <!-- Pedido por operación (2026-07-14): el NOMBRE DEL CLIENTE predomina
                 (arriba, en negrita) y el número del pedido pasa abajo en chico.
                 Si el pedido aún no tiene cliente, el número vuelve a ser el
                 texto principal para que la pestaña nunca quede vacía. -->
            <t t-set="idtxPartner" t-value="order.getPartnerName()"/>
            <div t-if="idtxPartner"
                 class="fw-bold w-100 text-truncate text-center"
                 t-esc="idtxPartner.slice(0, 14)" />
            <div t-attf-class="w-100 text-truncate text-center {{ idtxPartner ? 'mt-1' : 'fw-bold' }}"
                 t-attf-style="{{ idtxPartner ? 'font-size: 0.8rem; opacity: 0.9; font-weight: normal;' : '' }}"
                 t-esc="order.getName()" />
        </xpath>
    </t>
</templates>
