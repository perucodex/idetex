<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <!-- 
        Extensión optimizada de ProductScreen para Odoo 19.
    -->
    <t t-name="idtx_pos_sale_idetex.ProductScreen" t-inherit="point_of_sale.ProductScreen" t-inherit-mode="extension" owl="1">
        
        <!-- Reemplazamos el contenedor interno de la derecha para el Informe Técnico -->
        <xpath expr="//div[hasclass('rightpane')]//div[hasclass('position-relative')]" position="replace">
            <div class="position-relative d-flex flex-column flex-grow-1 overflow-hidden">
                <CategorySelector t-if="false" />
                <BarcodeVideoScanner t-if="pos.scanning" t-props="barcodeVideoScannerProps" />
                
                <div t-else="" class="idtx-stock-table-container d-flex flex-column h-100 bg-light">
                    <div class="idtx-action-bar p-3 bg-white border-bottom d-flex justify-content-between align-items-center shadow-sm">
                        <div class="d-flex flex-column">
                            <span class="fs-4 fw-bold text-primary">Existencias Técnicas</span>
                            <span class="text-muted small">
                                <i class="fa fa-check-square-o me-1"/>
                                <t t-esc="idtxState.selectedCount"/> rollos seleccionados
                            </span>
                        </div>
                        <button class="btn btn-primary btn-lg d-flex align-items-center gap-2 px-4 shadow-sm"
                                t-on-click="addSelectedQuants"
                                t-att-disabled="idtxState.selectedCount == 0">
                            <i class="fa fa-plus-circle"/>
                            <span class="fw-bold">AGREGAR AL PEDIDO</span>
                        </button>
                    </div>

                    <div class="flex-grow-1 overflow-y-auto px-3 py-2">
                        <table class="table table-hover idtx-stock-table text-nowrap rounded-3 overflow-hidden shadow-sm bg-white">
                            <thead class="bg-primary text-white sticky-top">
                                <tr>
                                    <th class="p-3 text-center" style="width: 50px;">Sel.</th>
                                    <th class="p-3" style="width: 12%;">Código</th>
                                    <th class="p-3" style="width: 25%;">Descripción</th>
                                    <th class="p-3" style="width: 15%;">Color</th>
                                    <th class="p-3" style="width: 18%;">Lote</th>
                                    <th class="p-3 text-center" style="width: 15%;">Referencia</th>
                                    <th class="p-3 text-end" style="width: 15%;">Stock (Kg)</th>
                                </tr>
                            </thead>
                            <tbody class="align-middle">
                                <t t-foreach="quantsToDisplay" t-as="quant" t-key="quant.id">
                                    <t t-set="inOrder" t-value="this.isQuantInOrder(quant)"/>
                                    <!-- isReserved: rollo bloqueado por OTRO pedido POS guardado (no se puede seleccionar/escanear) -->
                                    <t t-set="isReserved" t-value="this.isQuantReservedByOtherOrder(quant)"/>
                                    <tr t-att-class="{
                                            'idtx-row-disabled': inOrder,
                                            'idtx-row-reserved': isReserved,
                                            'cursor-pointer': !inOrder and !isReserved,
                                            'idtx-row-selected': idtxState.selectedQuants[quant.id]
                                        }"
                                        t-on-click="() => this.toggleQuantSelection(quant)">
                                        <td class="p-3 text-center">
                                            <!-- Si el rollo está bloqueado, mostrar candado en lugar del checkbox -->
                                            <i t-if="isReserved" class="fa fa-lock text-danger" title="Bloqueado por otro pedido"/>
                                            <div t-else="" class="form-check d-inline-block">
                                                <input type="checkbox"
                                                       t-att-checked="idtxState.selectedQuants[quant.id]"
                                                       t-att-disabled="inOrder"
                                                       class="form-check-input md-checkbox"
                                                       t-on-click.stop="() => this.toggleQuantSelection(quant)"/>
                                            </div>
                                        </td>
                                        <td class="p-3 fw-bold text-truncate"><t t-esc="quant.product_code"/></td>
                                        <td class="p-3 fw-bold text-truncate" title="quant.product_name"><t t-esc="quant.product_name"/></td>
                                        <td class="p-3 fw-bold text-truncate"><t t-esc="quant.color_name"/></td>
                                        <td class="p-3 fw-bold text-truncate">
                                            <t t-esc="quant.lot_name"/>
                                            <!-- Badge "BLOQUEADO" al lado del lote cuando aplica -->
                                            <span t-if="isReserved" class="badge bg-danger ms-2" style="font-size: 0.65rem;">BLOQUEADO</span>
                                        </td>
                                        <td class="p-3 idtx-col-ref text-center">
                                            <span class="idtx-ref-pill shadow-xs fw-bold"><t t-esc="quant.roll_name"/></span>
                                        </td>
                                        <td class="p-3 text-end fw-bold">
                                            <t t-esc="this.getFormattedStock(quant.quantity)"/>
                                        </td>
                                    </tr>
                                </t>
                                <t t-if="quantsToDisplay.length == 0">
                                    <tr>
                                        <td colspan="7" class="text-center py-5">
                                            <div class="d-flex flex-column align-items-center text-muted">
                                                <i class="fa fa-search fa-3x mb-3 opacity-25"/>
                                                <p class="fs-5">No se encontraron existencias con esa búsqueda.</p>
                                            </div>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </xpath>
    </t>

    <!-- [PATCH] ActionpadWidget: Reestructurar para incluir métricas y botones alineados al fondo -->
    <t t-name="idtx_pos_sale_idetex.ActionpadWidget" t-inherit="point_of_sale.ActionpadWidget" t-inherit-mode="extension" owl="1">
        <xpath expr="//div[hasclass('actionpad')]" position="replace">
            <div class="actionpad d-flex flex-column h-100">
                <!-- 1. Grid de Totales (currentOrder se resuelve a props.order si se pasa, sino a pos.getOrder()) -->
                <div t-if="currentOrder and !currentOrder.isEmpty()" class="idtx-actionpad-summary d-grid gap-1 p-2 bg-white rounded border mb-2" style="grid-template-columns: 1fr 1fr;">
                    <div class="summary-box d-flex justify-content-between border-bottom pb-1">
                        <span class="text-muted" style="font-size: 0.65rem;">Kilos:</span>
                        <span class="fw-bold" style="font-size: 0.75rem;" t-esc="totalKilos.toFixed(2)"/>
                    </div>
                    <div class="summary-box d-flex justify-content-between border-bottom pb-1 ms-2">
                        <span class="text-muted" style="font-size: 0.65rem;">Subtotal:</span>
                        <span class="fw-bold" style="font-size: 0.75rem;" t-esc="currentOrder.currencyDisplayPriceExcl"/>
                    </div>
                    <div class="summary-box d-flex justify-content-between border-bottom py-1">
                        <span class="text-muted" style="font-size: 0.65rem;">Rollos:</span>
                        <span class="fw-bold" style="font-size: 0.75rem;" t-esc="totalRolls"/>
                    </div>
                    <div class="summary-box d-flex justify-content-between border-bottom py-1 ms-2">
                        <span class="text-muted" style="font-size: 0.65rem;">Impuestos:</span>
                        <span class="fw-bold" style="font-size: 0.75rem;" t-esc="currentOrder.currencyAmountTaxes"/>
                    </div>
                    <div class="summary-box d-flex justify-content-between align-items-center pt-2" style="grid-column: span 2;">
                        <span class="text-primary fw-bold text-uppercase" style="font-size: 0.75rem;">Total:</span>
                        <span class="text-primary fw-bold fs-5" t-esc="currentOrder.currencyDisplayPriceIncl"/>
                    </div>
                </div>

                <!-- 2. Fila de Botones -->
                <div class="idtx-actionpad-buttons d-flex gap-1 mt-auto">
                     <SelectPartnerButton partner="props.partner"/>
                     
                     <button t-att-disabled="!currentOrder or currentOrder.isEmpty()" class="btn btn-secondary flex-grow-1 d-flex align-items-center justify-content-center" t-on-click="() => this.pos.clickSaveOrder()">
                        <i class="fa fa-upload"/>
                     </button>
                     
                     <button class="btn btn-secondary align-items-center justify-content-center" t-on-click="props.onClickMore">
                        <i class="oi oi-fw oi-ellipsis-v" />
                     </button>

                     <button t-if="props.showActionButton" class="btn btn-primary align-items-center justify-content-center" 
                             t-on-click="props.actionToTrigger" t-out="props.actionName" />
                </div>
            </div>
        </xpath>
    </t>
</templates>
