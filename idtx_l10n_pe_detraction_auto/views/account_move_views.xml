<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Totales de detracción en el pie del form de factura:
         Total (widget core) → Detracción (negativa, con %) → Cantidad por
         pagar NETA. En borrador con detracción se oculta la fila core de
         "Cantidad por pagar" (mostraría el total sin descontar); en
         publicado se conserva porque refleja los pagos reales. -->
    <record id="view_move_form_detraction_totals" model="ir.ui.view">
        <field name="name">account.move.form.detraction.totals</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount_residual']" position="before">
                <field name="l10n_pe_dt_percent" invisible="1"/>
                <!-- La moneda (PEN) debe estar en la vista: sin ella el
                     widget monetario no puede pintar el símbolo S/. -->
                <field name="l10n_pe_dt_currency_id" invisible="1"/>
                <div class="d-flex justify-content-between w-100" colspan="2"
                     invisible="not l10n_pe_dt_amount">
                    <span class="fw-bold text-nowrap">
                        Detracción (<field name="l10n_pe_dt_percent" nolabel="1"
                                           readonly="1" class="oe_inline"
                                           widget="integer"/>%)
                    </span>
                    <field name="l10n_pe_dt_amount" nolabel="1" readonly="1"
                           widget="monetary"
                           options="{'currency_field': 'l10n_pe_dt_currency_id'}"/>
                </div>
            </xpath>
            <xpath expr="//field[@name='amount_residual']" position="attributes">
                <attribute name="invisible">l10n_pe_dt_amount != 0 and state == 'draft'</attribute>
            </xpath>
            <xpath expr="//field[@name='amount_residual']" position="after">
                <field name="l10n_pe_dt_net_to_pay" string="Cantidad por pagar"
                       class="oe_subtotal_footer_separator"
                       invisible="not l10n_pe_dt_amount"/>
            </xpath>
        </field>
    </record>
</odoo>
