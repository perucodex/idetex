<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista List -->
    <record id="view_idtx_pos_stock_report_list" model="ir.ui.view">
        <field name="name">idtx.pos.stock.report.list</field>
        <field name="model">idtx.pos.stock.report</field>
        <field name="arch" type="xml">
            <list string="Existencias PdV" create="false" edit="false" delete="false">
                <field name="product_code"/>
                <field name="product_name"/>
                <field name="color_code"/>
                <field name="color_name"/>
                <field name="lot_name"/>
                <field name="roll_name"/>
                <field name="quantity" sum="Total"/>
                <field name="location_id"/>
                <field name="product_id" optional="hide"/>
                <field name="lot_id" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Vista Search -->
    <record id="view_idtx_pos_stock_report_search" model="ir.ui.view">
        <field name="name">idtx.pos.stock.report.search</field>
        <field name="model">idtx.pos.stock.report</field>
        <field name="arch" type="xml">
            <search string="Search Existencias">
                <field name="product_code"/>
                <field name="product_name"/>
                <field name="color_code"/>
                <field name="color_name"/>
                <field name="lot_name"/>
                <field name="roll_name"/>
                <field name="product_id"/>
                <field name="location_id"/>
                <group>
                    <filter string="Producto" name="group_product" domain="[]" context="{'group_by':'product_name'}"/>
                    <filter string="Color" name="group_color" domain="[]" context="{'group_by':'color_name'}"/>
                    <filter string="Lote" name="group_lot" domain="[]" context="{'group_by':'lot_name'}"/>
                    <filter string="Ubicación" name="group_location" domain="[]" context="{'group_by':'location_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Acción -->
    <record id="action_idtx_pos_stock_report" model="ir.actions.act_window">
        <field name="name">Existencias PdV</field>
        <field name="res_model">idtx.pos.stock.report</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay existencias registradas.
            </p>
        </field>
    </record>

    <!-- Menú -->
    <menuitem id="menu_idtx_pos_stock_report"
              name="Existencias PdV"
              action="action_idtx_pos_stock_report"
              parent="point_of_sale.menu_point_rep"
              sequence="10"/>
</odoo>
