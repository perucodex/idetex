<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="technical_sheet_form_voucher_ubic" model="ir.ui.view">
        <field name="name">technical.sheet.form.voucher.ubic</field>
        <field name="model">technical.sheet</field>
        <field name="inherit_id" ref="idtx_product_development.technical_sheet_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="weave_type" invisible="1"/>
                <button name="action_open_voucher_ubicacion" type="object"
                        string="Ubicar piezas (TEXPLUS)" class="btn-secondary"
                        invisible="weave_type != 'rect'"/>
            </xpath>
        </field>
    </record>
</odoo>
