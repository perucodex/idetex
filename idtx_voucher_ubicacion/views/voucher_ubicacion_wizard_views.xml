<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="voucher_ubicacion_wizard_form" model="ir.ui.view">
        <field name="name">voucher.ubicacion.wizard.form</field>
        <field name="model">voucher.ubicacion.wizard</field>
        <field name="arch" type="xml">
            <form string="Ubicar piezas por talla (TEXPLUS)">
                <group>
                    <field name="technical_sheet_id" invisible="1"/>
                    <field name="voucher_number" placeholder="p. ej. 3319242"/>
                </group>
                <div class="text-muted">
                    Se leen las piezas del voucher en TEXPLUS (BARPIE), se toma la
                    talla del prefijo del código de pieza (antes del «-»), y se
                    escribe «largo/ancho» (de la pestaña Tallas) en
                    <b>ALBDET.ALRPIELOC</b> de cada pieza de esa talla.
                </div>
                <footer>
                    <button name="action_apply" type="object" string="Aplicar"
                            class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
