<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_warehouse_roll_locations" model="ir.ui.view">
            <field name="name">stock.warehouse.form.inherit.roll.locations</field>
            <field name="model">stock.warehouse</field>
            <field name="inherit_id" ref="stock.view_warehouse"/>
            <field name="arch" type="xml">
                <xpath expr="//group[@name='group_resupply']" position="after">
                    <group string="Rollos terminados" name="group_roll_locations">
                        <field name="roll_weigh_location_id" options="{'no_create': True}"
                               placeholder="Se crea sola: Pesado"/>
                        <field name="roll_grade_a_location_id" options="{'no_create': True}"
                               placeholder="Vacío = Existencias del almacén"/>
                        <field name="roll_grade_b_location_id" options="{'no_create': True}"
                               placeholder="Se crea sola: Saldo"/>
                        <field name="roll_grade_m_location_id" options="{'no_create': True}"
                               placeholder="Se crea sola: Mermas"/>
                    </group>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
