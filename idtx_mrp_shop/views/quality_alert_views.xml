<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="quality_alert_view_tree_reprocess" model="ir.ui.view">
        <field name="name">quality.alert.list.reprocess.partida</field>
        <field name="model">quality.alert</field>
        <field name="inherit_id" ref="quality.quality_alert_view_tree"/>
        <field name="arch" type="xml">
            <field name="reason_id" position="after">
                <field name="tipo" optional="show"/>
                <field name="batch_id" optional="show"/>
                <field name="reprocess_from_workorder_id" optional="hide"/>
                <field name="reposition_production_id" optional="show"/>
                <field name="state" optional="show" widget="badge"
                       decoration-success="state == 'approved'"
                       decoration-warning="state == 'draft'"/>
            </field>
        </field>
    </record>

    <record id="quality_alert_view_form_reprocess" model="ir.ui.view">
        <field name="name">quality.alert.form.reprocess.partida</field>
        <field name="model">quality.alert</field>
        <field name="inherit_id" ref="quality_control.quality_alert_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <!-- Solo el grupo correspondiente (Permisos adicionales) ve
                     el botón; el guard de python vuelve a validar. -->
                <button name="action_approve" type="object"
                        string="Aprobar Reposición" class="oe_highlight"
                        groups="idtx_mrp_shop.group_quality_approve_reposition"
                        invisible="state != 'draft' or tipo != 'reposicion' or not batch_id"
                        confirm="Al aprobar se creará la OF de reposición. ¿Continuar?"/>
                <button name="action_approve" type="object"
                        string="Aprobar Reproceso" class="oe_highlight"
                        groups="idtx_mrp_shop.group_quality_approve_reprocess"
                        invisible="state != 'draft' or tipo != 'reproceso' or not batch_id"
                        confirm="Al aprobar se reabrirán la operación indicada en 'Reprocesar desde' y todas las posteriores que la partida ya procesó. ¿Continuar?"/>
                <field name="state" widget="statusbar"/>
            </xpath>
            <field name="reason_id" position="attributes">
                <attribute name="required">1</attribute>
            </field>
            <field name="reason_id" position="after">
                <field name="available_batch_ids" invisible="1" widget="many2many_tags"/>
                <field name="workorder_id" string="Operación (OT)" readonly="1" invisible="not workorder_id"/>
                <!-- Se muestran también cuando la alerta ya trae partida
                     (p.ej. reposición generada por el Control de cuellos,
                     cuya OT es de tejido y no tiene available_batch_ids). -->
                <field name="tipo" invisible="not available_batch_ids and not batch_id"/>
                <field name="batch_id"
                       invisible="not available_batch_ids and not batch_id"
                       readonly="not available_batch_ids"
                       domain="[('id', 'in', available_batch_ids)]"/>
                <!-- Punto de inicio del reproceso: solo operaciones de partida
                     de ESTA OF, hasta la OT de la alerta, que la partida ya
                     procesó. Por defecto la OT de la alerta. -->
                <field name="available_reprocess_workorder_ids" invisible="1" widget="many2many_tags"/>
                <field name="reprocess_from_workorder_id"
                       invisible="tipo != 'reproceso' or not batch_id or not available_reprocess_workorder_ids"
                       readonly="state != 'draft'"
                       required="tipo == 'reproceso' and batch_id and available_reprocess_workorder_ids"
                       domain="[('id', 'in', available_reprocess_workorder_ids)]"
                       options="{'no_create': True, 'no_open': True}"/>
                <field name="available_roll_ids" invisible="1"/>
                <field name="batch_qty" invisible="tipo != 'reposicion' or not available_batch_ids"/>
                <field name="production_qty" invisible="tipo != 'reposicion' or not available_batch_ids"/>
                <field name="reposition_qty"
                       invisible="tipo != 'reposicion' or not available_batch_ids"
                       required="tipo == 'reposicion' and available_batch_ids and batch_id"/>
                <field name="reposition_production_id"
                       invisible="not reposition_production_id"/>
            </field>
            <!-- Reproceso parcial: los rollos que van al reproceso, en la PRIMERA
                 pestaña como lista (una partida puede tener 50+ rollos). Por
                 defecto entran todos; se quitan los que no se reprocesan. -->
            <xpath expr="//notebook/page[@name='description']" position="before">
                <page name="reprocess_rolls" string="Rollos a reprocesar"
                      invisible="tipo != 'reproceso' or not batch_id">
                    <div class="alert alert-info mb-2" role="alert">
                        Por defecto se reprocesa toda la partida. Quita los rollos que NO van al
                        reproceso: al aprobar, los que queden aquí se separan a una partida nueva
                        con el mismo número (Reproceso N) y la alerta pasa a esa partida.
                    </div>
                    <field name="roll_ids" readonly="state != 'draft'"
                           domain="[('id', 'in', available_roll_ids)]">
                        <list create="0" edit="0">
                            <field name="name"/>
                            <field name="product_id"/>
                            <field name="production_id" optional="show"/>
                            <field name="gross_weight" sum="Total"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
