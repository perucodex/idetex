<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_picking_form_roll_release" model="ir.ui.view">
            <field name="name">stock.picking.form.inherit.roll.release</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <field name="arch" type="xml">
                <field name="origin" position="after">
                    <field name="roll_release_batch_id" invisible="not roll_release_batch_id"/>
                    <field name="roll_release_grade" invisible="not roll_release_batch_id"/>
                </field>
            </field>
        </record>

        <record id="view_picking_tree_roll_release" model="ir.ui.view">
            <field name="name">stock.picking.list.inherit.roll.release</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.vpicktree"/>
            <field name="arch" type="xml">
                <field name="origin" position="after">
                    <field name="roll_release_batch_id" optional="hide" string="Partida"/>
                    <field name="roll_release_grade" optional="hide" string="Grado"/>
                </field>
            </field>
        </record>

        <!-- Almacén: recepciones de rollos pendientes de validar -->
        <record id="action_roll_release_pickings" model="ir.actions.act_window">
            <field name="name">Recepción de rollos</field>
            <field name="res_model">stock.picking</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('roll_release_batch_id', '!=', False)]</field>
            <field name="context">{'search_default_available': 1, 'create': False}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Sin rollos por recibir</p>
                <p>Cuando la zona de pesado libera los rollos calificados de una partida, aquí aparece
                   el traslado desde Pesado hacia Existencias (grado A), Saldo (B) o Mermas (M).
                   Valídalo al recibir físicamente los rollos.</p>
            </field>
        </record>

        <menuitem id="menu_roll_release_pickings"
                  name="Recepción de rollos"
                  parent="stock.menu_stock_warehouse_mgmt"
                  action="action_roll_release_pickings"
                  sequence="3"/>

    </data>
</odoo>
