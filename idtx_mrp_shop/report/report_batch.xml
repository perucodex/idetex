<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Contenido: datos de la partida + listado de rollos. -->
    <template id="report_batch_partida_content">
        <t t-set="rolls" t-value="doc.origin_roll_ids"/>
        <t t-set="productions" t-value="rolls.production_id"/>
        <div class="page reporte-partida" style="font-size: 0.85rem;">
            <style>
                .reporte-partida table::before, .reporte-partida table::after {
                    display: none !important; content: none !important; border: 0 !important;
                }
                .reporte-partida table {
                    border-collapse: collapse !important; border-radius: 0 !important;
                    border: 0 !important; box-shadow: none !important; overflow: visible !important;
                    width: 100%;
                }
                .reporte-partida th, .reporte-partida td {
                    border: 1px solid #444 !important; border-radius: 0 !important;
                    box-shadow: none !important; font-family: inherit !important;
                    padding: 3px 6px !important; text-align: left;
                }
                .reporte-partida th.text-end, .reporte-partida td.text-end { text-align: right !important; }
                .reporte-partida th.text-center, .reporte-partida td.text-center { text-align: center !important; }
                /* Árbol de procesos: cajas anidadas (banda compartida + columnas por rama) */
                .reporte-partida .proc-tree table { border-collapse: collapse !important; width: 100%; margin: 0; }
                .reporte-partida .proc-of { font-weight: bold !important; text-align: center !important; background: #eee !important; }
                .reporte-partida .proc-op { text-align: center !important; }
                .reporte-partida .proc-branch { border: 0 !important; padding: 0 !important; vertical-align: top !important; }
                /* Rollos por producto: cabecera del producto + dos columnas de rollos */
                .reporte-partida .rolls-wrap { margin-bottom: 6px; }
                .reporte-partida .rolls-wrap table { border-collapse: collapse !important; width: 100%; margin: 0; }
                .reporte-partida .rolls-prod { font-weight: bold !important; background: #eee !important; }
                .reporte-partida .rolls-col { border: 0 !important; padding: 0 !important; vertical-align: top !important; width: 50%; }
                .reporte-partida .rolls-col-left { padding-right: 4px !important; }
                .reporte-partida .rolls-empty { border: 0 !important; background: transparent !important; }
                /* Sin quiebre de línea: el N° de rollo y la O.F. deben caber enteros en media hoja */
                .reporte-partida .rolls-wrap th, .reporte-partida .rolls-wrap td { white-space: nowrap; }
                .reporte-partida .rolls-wrap .rolls-data { font-size: 0.78rem; }
                .reporte-partida .rolls-wrap .rolls-data th, .reporte-partida .rolls-wrap .rolls-data td { padding: 2px 4px !important; }
            </style>

            <div class="row mb-2">
                <div class="col-6"><h3 class="mb-0">Reporte de Partida</h3></div>
                <div class="col-6 text-end">
                    <h4 class="mb-0"><t t-esc="doc.name"/></h4>
                    <div t-if="doc.dye_product_id" class="fw-bold"><t t-esc="doc.dye_product_id.name"/></div>
                    <div t-if="doc.reprocess_seq" class="fw-bold text-danger">Reproceso <t t-esc="doc.reprocess_seq"/></div>
                    <span t-esc="doc.batch_date" t-options="{'widget': 'date'}"/>
                </div>
            </div>

            <table class="table table-sm table-bordered o_ignore_layout_styling mb-2">
                <tbody>
                    <tr>
                        <td style="width:17%"><strong>Cliente</strong></td>
                        <td style="width:50%"><t t-esc="', '.join(doc.partner_ids.mapped('name'))"/></td>
                        <td style="width:15%"><strong>O.P.</strong></td>
                        <td style="width:18%"><t t-esc="', '.join(productions.mapped('name'))"/></td>
                    </tr>
                    <tr>
                        <td><strong>Color</strong></td>
                        <td><t t-esc="doc.color_code"/> - <t t-esc="doc.color_name"/></td>
                        <td><strong>Receta</strong></td>
                        <td><t t-esc="doc.color_recipe_id.recipe_color_code or doc.color_recipe_id.name or ''"/></td>
                    </tr>
                    <tr>
                        <td><strong>Sub-receta (Lotes)</strong></td>
                        <td><t t-esc="doc.recipe_lot_id.display_name if doc.recipe_lot_id else ''"/></td>
                        <td><strong>Última Operación</strong></td>
                        <td><t t-esc="doc.mrwo_id.name or ''"/></td>
                    </tr>
                    <tr>
                        <td><strong>Total (kg)</strong></td>
                        <td><t t-esc="'%.2f' % (doc.total_weight or 0)"/></td>
                        <td><strong>Piezas</strong></td>
                        <td><t t-esc="len(rolls)"/></td>
                    </tr>
                    <tr>
                        <td><strong>Reprocesos</strong></td>
                        <td><t t-esc="doc.reprocess_count"/></td>
                        <td><strong>Estado</strong></td>
                        <td><t t-esc="dict(doc._fields['state'].selection).get(doc.state, doc.state)"/></td>
                    </tr>
                    <tr t-if="doc.parent_batch_id and (not doc.dye_product_id or doc.reprocess_seq)">
                        <td><strong><t t-esc="'Reproceso de' if doc.reprocess_seq else 'Partida Origen'"/></strong></td>
                        <td colspan="3"><t t-esc="doc.parent_batch_id.display_name"/></td>
                    </tr>
                    <tr t-if="doc.transferred_roll_ids">
                        <td><strong>Transferidos a reproceso</strong></td>
                        <td colspan="3">
                            <t t-esc="', '.join(doc.transferred_roll_ids.mapped('name'))"/>
                            (<t t-esc="'%.2f' % sum(doc.transferred_roll_ids.mapped('gross_weight'))"/> kg) →
                            <t t-esc="', '.join(sorted(set(doc.transferred_roll_ids.mapped('reprocess_batch_id.display_name'))))"/>
                        </td>
                    </tr>
                    <!-- Partida por producto de un lote de teñido: va al mismo baño
                         que sus hermanas; la relación de baño es del total. -->
                    <tr t-if="doc.dye_sibling_ids" style="background: #fff3cd;">
                        <td colspan="4">
                            <strong>TEÑIDO CONJUNTO:</strong> se tiñe junto con
                            <t t-esc="', '.join(doc.dye_sibling_ids.mapped('display_name'))"/>.
                            Kilos totales del baño: <strong><t t-esc="'%.2f' % doc.dye_lot_weight"/> kg</strong>
                            (esta partida: <t t-esc="'%.2f' % doc.total_weight"/> kg). Deben entrar juntas a la máquina.
                        </td>
                    </tr>
                </tbody>
            </table>

            <h5 class="mb-1">Rollos</h5>
            <t t-set="roll_groups" t-value="doc._get_report_rolls_by_product()"/>
            <t t-set="any_rect" t-value="any(g['rect'] for g in roll_groups)"/>
            <p t-if="not roll_groups" class="text-center">Sin rollos.</p>
            <!-- Una tabla por PRODUCTO (cabecera con el producto y su
                 subtotal) y los rollos repartidos en dos columnas: se lee
                 hacia abajo la izquierda y sigue la derecha. -->
            <div t-foreach="roll_groups" t-as="grp" class="rolls-wrap">
                <table class="table table-sm table-bordered o_ignore_layout_styling">
                    <tr>
                        <td t-att-colspan="2 if grp['has_right'] else 1" class="rolls-prod">
                            <t t-esc="grp['product'].display_name or ''"/>
                            <span class="float-end">
                                <t t-esc="grp['count']"/> <t t-esc="'rollo' if grp['count'] == 1 else 'rollos'"/> ·
                                <t t-if="grp['rect']"><t t-esc="grp['quantity']"/> piezas · </t>
                                <t t-esc="'%.2f' % grp['weight']"/> kg
                            </span>
                        </td>
                    </tr>
                    <tr>
                        <t t-foreach="[0, 1] if grp['has_right'] else [0]" t-as="col">
                            <td t-attf-class="rolls-col #{'rolls-col-left' if col == 0 and grp['has_right'] else ''}"
                                t-attf-style="width: #{'50%' if grp['has_right'] else '100%'}">
                                <table class="table table-sm table-bordered o_ignore_layout_styling rolls-data">
                                    <thead>
                                        <tr>
                                            <!-- Rectilíneo: talla y piezas; tela: solo peso. -->
                                            <t t-if="grp['rect']">
                                                <th class="text-center" style="width:26%">N°</th>
                                                <th style="width:24%">O.F.</th>
                                                <th class="text-center" style="width:14%">Talla</th>
                                                <th class="text-end" style="width:12%">Cant</th>
                                                <th class="text-end" style="width:24%">Peso (kg)</th>
                                            </t>
                                            <t t-else="">
                                                <th class="text-center" style="width:36%">N°</th>
                                                <th style="width:34%">O.F.</th>
                                                <th class="text-end" style="width:30%">Peso (kg)</th>
                                            </t>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-foreach="grp['rows']" t-as="row">
                                            <t t-set="roll" t-value="row[col]"/>
                                            <t t-if="roll">
                                                <td class="text-center"><t t-esc="roll.name or ''"/></td>
                                                <td><t t-esc="roll.production_id.name or ''"/></td>
                                                <t t-if="grp['rect']">
                                                    <td class="text-center"><t t-esc="roll.size_id.size or ''"/></td>
                                                    <td class="text-end"><t t-esc="roll.quantity"/></td>
                                                </t>
                                                <td class="text-end"><t t-esc="'%.2f' % (roll.gross_weight or 0)"/></td>
                                            </t>
                                            <t t-else="">
                                                <td t-att-colspan="5 if grp['rect'] else 3" class="rolls-empty"/>
                                            </t>
                                        </tr>
                                    </tbody>
                                </table>
                            </td>
                        </t>
                    </tr>
                </table>
            </div>

            <table t-if="rolls" class="table table-sm table-bordered o_ignore_layout_styling">
                <tr>
                    <td class="text-end" style="width:58%"><strong>Totales</strong></td>
                    <!-- Piezas solo si hay algún producto rectilíneo en la partida. -->
                    <td t-if="any_rect" class="text-end" style="width:14%"><strong><t t-esc="sum(g['quantity'] for g in roll_groups if g['rect'])"/> piezas</strong></td>
                    <td class="text-end" style="width:28%"><strong><t t-esc="'%.2f' % sum(rolls.mapped('gross_weight'))"/> kg</strong></td>
                </tr>
            </table>

            <t t-set="tree" t-value="doc._get_process_tree()"/>
            <div t-if="tree and (tree.get('ops') or tree.get('branches'))" class="mt-2 proc-tree">
                <h5 class="mb-1">Procesos a realizar</h5>
                <t t-call="idtx_mrp_shop.report_batch_process_node">
                    <t t-set="node" t-value="tree"/>
                </t>
            </div>
        </div>
    </template>

    <!-- Nodo recursivo del árbol de procesos: banda de OFs + operaciones
         compartidas, y debajo una columna por cada rama (recursivo). -->
    <template id="report_batch_process_node">
        <t t-set="ncols" t-value="len(node['branches']) or 1"/>
        <table>
            <tr>
                <td t-att-colspan="ncols" class="proc-of"><t t-esc="' - '.join(node['ofs'])"/></td>
            </tr>
            <tr t-foreach="node['ops']" t-as="op">
                <td t-att-colspan="ncols" class="proc-op"><t t-esc="op"/></td>
            </tr>
            <tr t-if="node['branches']">
                <td t-foreach="node['branches']" t-as="br" class="proc-branch">
                    <t t-call="idtx_mrp_shop.report_batch_process_node">
                        <t t-set="node" t-value="br"/>
                    </t>
                </td>
            </tr>
        </table>
    </template>

    <template id="report_batch_partida_document">
        <t t-call="web.internal_layout">
            <t t-call="idtx_mrp_shop.report_batch_partida_content"/>
        </t>
    </template>

    <template id="report_batch_partida">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="idtx_mrp_shop.report_batch_partida_document"/>
            </t>
        </t>
    </template>

    <record id="action_report_batch_partida" model="ir.actions.report">
        <field name="name">Reporte de Partida</field>
        <field name="model">mrp.workorder.batch</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">idtx_mrp_shop.report_batch_partida</field>
        <field name="report_file">idtx_mrp_shop.report_batch_partida</field>
        <field name="print_report_name">'Partida_%s' % (object.name)</field>
        <field name="paperformat_id" ref="paperformat_dye_recipe"/>
        <field name="binding_model_id" ref="idtx_mrp.model_mrp_workorder_batch"/>
        <field name="binding_type">report</field>
    </record>

</odoo>
