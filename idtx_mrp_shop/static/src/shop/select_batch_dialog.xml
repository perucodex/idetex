<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="idtx_mrp_shop.SelectBatchDialog">
        <Dialog size="'lg'" title="props.title" modalRef="modalRef">
            <div class="o_batch_registry_wizard">

            <div class="d-flex align-items-center w-100 mb-4">
                <t t-foreach="steps" t-as="step" t-key="step">
                    <div class="d-flex align-items-center" style="flex: 1 1 auto;">
                        <button type="button"
                                class="btn rounded-circle d-flex align-items-center justify-content-center"
                                t-att-class="step_index === state.currentStep ? 'btn-primary' : (step_index &lt;= state.maxReachedStep ? 'btn-success' : 'btn-light border')"
                                style="width: 36px; height: 36px; padding: 0; font-weight: 700;"
                                t-on-click="() => this.goToStep(step_index)">
                            <t t-esc="step"/>
                        </button>
                        <div t-if="step_index &lt; steps.length - 1"
                             class="mx-2"
                             t-att-style="'height: 4px; border-radius: 8px; width: calc(100% - 52px); background-color: ' + (step_index &lt; state.maxReachedStep ? '#198754' : '#ced4da') + ';'"/>
                    </div>
                </t>
            </div>

            <!-- Step 1: General -->
            <div t-if="isStepVisible(0)">
                <div class="mt-3">
                    <h5 class="fw-bold">Employee</h5>
                    <select class="form-select fs-4"
                            t-model="state.selectedEmployee"
                            t-on-change="onEmployeeChange">
                        <option value="">Select an employee...</option>
                        <t t-foreach="employees" t-as="emp" t-key="emp.id">
                            <option t-att-value="'' + emp.id"
                                    t-att-selected="state.selectedEmployee == ('' + emp.id)"
                                    t-esc="emp.name"/>
                        </t>
                    </select>
                </div>

                <div class="mt-3">
                    <h5 class="fw-bold">Equipment</h5>
                    <select class="form-select fs-4"
                            t-model="state.selectedEquipment"
                            t-on-change="onEquipmentChange">
                        <option value="">Select an equipment...</option>
                        <t t-foreach="equipments" t-as="eqp" t-key="eqp.id">
                            <option t-att-value="'' + eqp.id"
                                    t-att-selected="state.selectedEquipment == ('' + eqp.id)"
                                    t-esc="eqp.name"/>
                        </t>
                    </select>
                </div>

                <div class="mt-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <h5 class="fw-bold mb-0">Batch</h5>
                        <button t-if="state.selectedBatchId"
                                class="btn btn-sm btn-outline-secondary"
                                t-on-click="clearSelectedBatch">
                            Clear
                        </button>
                    </div>

                    <input class="form-control fs-4 mt-2"
                           placeholder="Search by code, client, color..."
                           t-ref="batchSearchInput"
                           t-att-value="state.batchQuery"
                           t-on-input="onBatchQueryInput"
                           t-on-keydown="onBatchQueryKeyDown"/>

                    <div class="text-muted mt-1" t-if="state.isSearching">
                        Searching...
                    </div>

                    <div class="text-danger mt-1" t-if="state.searchError">
                        <t t-esc="state.searchError"/>
                    </div>

                    <div t-if="selectedBatch" class="alert alert-success mt-2">
                        <div class="fw-bold fs-5">
                            Selected: <t t-esc="selectedBatch.name"/>
                        </div>
                        <div class="d-flex flex-wrap gap-2 mt-1">
                            <span t-if="selectedBatch.partner_id" class="badge rounded-pill bg-light text-dark border">
                                Client: <t t-esc="selectedBatch.partner_id"/>
                            </span>
                            <span t-if="selectedBatch.color" class="badge rounded-pill bg-light text-dark border">
                                Color: <t t-esc="selectedBatch.color"/>
                            </span>
                            <span t-if="selectedBatch.batch_date" class="badge rounded-pill bg-light text-dark border">
                                Date: <t t-esc="selectedBatch.batch_date"/>
                            </span>
                            <span t-if="selectedBatch.total_weight !== null and selectedBatch.total_weight !== undefined" class="badge rounded-pill bg-light text-dark border">
                                Total: <t t-esc="selectedBatch.total_weight"/> kg
                            </span>
                        </div>
                        <div t-if="selectedBatch.warning" class="alert alert-warning mt-2 mb-0 py-2">
                            <i class="fa fa-exclamation-triangle me-1"/>
                            <t t-esc="selectedBatch.warning"/>
                        </div>
                    </div>

                    <div class="mt-3">
                        <div class="fw-bold mb-2">Results</div>
                        <div class="list-group">
                            <t t-foreach="state.results" t-as="b" t-key="b.id">
                                <button type="button"
                                        class="list-group-item list-group-item-action"
                                        t-att-class="state.selectedBatchId == ('' + b.id) ? 'active' : ''"
                                        t-on-click="() => this.selectBatch(b)">
                                    <div class="d-flex justify-content-between">
                                        <div class="fw-bold"><t t-esc="b.name"/></div>
                                        <div class="text-muted"><t t-esc="b.batch_date"/></div>
                                    </div>
                                    <div class="d-flex flex-wrap gap-2 mt-1">
                                        <span t-if="b.partner_id" class="badge rounded-pill bg-light text-dark border">Client: <t t-esc="b.partner_id"/></span>
                                        <span t-if="b.color" class="badge rounded-pill bg-light text-dark border">Color: <t t-esc="b.color"/></span>
                                        <span t-if="b.total_weight !== null and b.total_weight !== undefined" class="badge rounded-pill bg-light text-dark border">Total: <t t-esc="b.total_weight"/> kg</span>
                                        <span t-if="b.state_label" class="badge rounded-pill bg-secondary"><t t-esc="b.state_label"/></span>
                                        <span t-if="b.mrwo" class="badge rounded-pill bg-light text-dark border">Op: <t t-esc="b.mrwo"/></span>
                                    </div>
                                    <div t-if="b.warning" class="text-warning small mt-1">
                                        <i class="fa fa-exclamation-triangle me-1"/>
                                        <t t-esc="b.warning"/>
                                    </div>
                                </button>
                            </t>
                        </div>
                        <div class="text-muted mt-2" t-if="(!state.results || !state.results.length) and !state.isSearching">
                            No results.
                        </div>
                    </div>
                </div>
            </div>

            <!-- Step 2: Recipe Values -->
            <div t-if="isStepVisible(1)">
                <div class="row g-3 mt-1">
                    <div class="col-6">
                        <label class="form-label">Customer</label>
                        <input class="form-control" t-att-value="state.partnerName" readonly="1"/>
                    </div>
                    <div class="col-3">
                        <label class="form-label">Color</label>
                        <input class="form-control" t-att-value="state.colorName" readonly="1"/>
                    </div>
                    <div class="col-3">
                        <label class="form-label">Code</label>
                        <input class="form-control" t-att-value="state.colorCode" readonly="1"/>
                    </div>
                    <div class="col-4">
                        <label class="form-label">Weight</label>
                        <input class="form-control" t-att-value="state.weight" readonly="1"/>
                    </div>
                    <div class="col-4">
                        <label class="form-label">Bath Ratio</label>
                        <input class="form-control" t-att-value="state.bath_ratio" t-on-input="(ev) => this.onInputNumber(ev, 'bath_ratio')"/>
                    </div>
                    <div class="col-4">
                        <label class="form-label">Absorption Factor</label>
                        <input class="form-control" t-att-value="state.abs_factor" t-on-input="(ev) => this.onInputNumber(ev, 'abs_factor')"/>
                    </div>
                    <div class="col-4">
                        <label class="form-label">Recipe Salt</label>
                        <input class="form-control" t-att-value="state.recipe_salt" readonly="1"/>
                    </div>
                    <div class="col-4">
                        <label class="form-label">Recipe Carbonate</label>
                        <input class="form-control" t-att-value="state.recipe_carbonate" readonly="1"/>
                    </div>
                    <div class="col-4">
                        <label class="form-label">Recipe Soda</label>
                        <input class="form-control" t-att-value="state.recipe_soda" readonly="1"/>
                    </div>
                </div>
                <div class="row g-3 mt-1">
                    <div class="col-4">
                        <label class="form-label">Total Volume</label>
                        <input class="form-control" t-att-value="state.total_volume" readonly="1"/>
                    </div>
                    <div class="col-4">
                        <label class="form-label">Start Salt</label>
                        <input class="form-control" t-att-value="state.start_salt" readonly="1"/>
                    </div>
                    <div class="col-4">
                        <label class="form-label">Start Brine</label>
                        <input class="form-control" t-att-value="state.start_brine" readonly="1"/>
                    </div>
                    <div class="col-4">
                        <label class="form-label">Alkalis Volume</label>
                        <input class="form-control" t-att-value="state.alkalis_volume" readonly="1"/>
                    </div>
                    <div class="col-4">
                        <label class="form-label">Dyes Volume</label>
                        <input class="form-control" t-att-value="state.dyes_volume" readonly="1"/>
                    </div>
                    <div class="col-4">
                        <label class="form-label">Salt Qty</label>
                        <input class="form-control" t-att-value="state.salt_qty" readonly="1"/>
                    </div>
                </div>
            </div>

            <!-- Step 3: Measure Control -->
            <div t-if="isStepVisible(2)">
                <div class="row g-3 mt-1">
                    <div class="col-4">
                        <label class="form-label">Hydrophilicity</label>
                        <select class="form-select" t-model="state.hydrophilicity" t-on-change="(ev) => this.onSelectionChange(ev, 'hydrophilicity')">
                            <option value=""></option>
                            <option value="ok">Ok</option>
                            <option value="reg">Regular</option>
                            <option value="bad">Bad</option>
                        </select>
                    </div>
                    <div class="col-4">
                        <label class="form-label">Peroxide Residual</label>
                        <select class="form-select" t-model="state.peroxide_residual" t-on-change="(ev) => this.onSelectionChange(ev, 'peroxide_residual')">
                            <option value=""></option>
                            <option value="0">0</option>
                            <option value="0.5">0.5</option>
                            <option value="2">2</option>
                            <option value="5">5</option>
                            <option value="10">10</option>
                            <option value="25">25</option>
                        </select>
                    </div>
                    <div class="col-4">
                        <label class="form-label">Hardness Dyeing Water</label>
                        <input class="form-control" t-att-value="state.hardness_dyeing_water" t-on-input="(ev) => this.onInputNumber(ev, 'hardness_dyeing_water')"/>
                    </div>
                    <div class="col-3"><label class="form-label">Anti-pilling pH</label><input class="form-control" t-att-value="state.antipilling_ph" t-on-input="(ev) => this.onInputNumber(ev, 'antipilling_ph')"/></div>
                    <div class="col-3"><label class="form-label">Dye pH</label><input class="form-control" t-att-value="state.dye_ph" t-on-input="(ev) => this.onInputNumber(ev, 'dye_ph')"/></div>
                    <div class="col-3"><label class="form-label">Previous pH</label><input class="form-control" t-att-value="state.previous_ph" t-on-input="(ev) => this.onInputNumber(ev, 'previous_ph')"/></div>
                    <div class="col-3"><label class="form-label">Neutralized pH</label><input class="form-control" t-att-value="state.neutralized_ph" t-on-input="(ev) => this.onInputNumber(ev, 'neutralized_ph')"/></div>
                </div>
            </div>

            <!-- Step 4: Regulations -->
            <div t-if="isStepVisible(3)">
                <div class="row g-3 mt-1">
                    <div class="col-4">
                        <label class="form-label">Pump Speed</label>
                        <select class="form-select" t-model="state.pump_speed" t-on-change="(ev) => this.onSelectionChange(ev, 'pump_speed')">
                            <option value=""></option>
                            <option value="600">600</option><option value="700">700</option><option value="800">800</option>
                            <option value="900">900</option><option value="950">950</option><option value="1000">1000</option>
                            <option value="1050">1050</option><option value="1100">1100</option><option value="1150">1150</option>
                            <option value="1200">1200</option><option value="1250">1250</option><option value="1300">1300</option>
                            <option value="1350">1350</option><option value="1400">1400</option>
                            <option value="50%">50%</option><option value="55%">55%</option><option value="60%">60%</option>
                            <option value="65%">65%</option><option value="70%">70%</option><option value="75%">75%</option>
                            <option value="80%">80%</option><option value="85%">85%</option><option value="90%">90%</option>
                            <option value="95%">95%</option><option value="100%">100%</option>
                        </select>
                    </div>
                    <div class="col-4"><label class="form-label">Reel Speed</label><input class="form-control" t-att-value="state.reel_speed" t-on-input="(ev) => this.onInputNumber(ev, 'reel_speed')"/></div>
                    <div class="col-4">
                        <label class="form-label">Hydrovary</label>
                        <select class="form-select" t-model="state.hydrovary" t-on-change="(ev) => this.onSelectionChange(ev, 'hydrovary')">
                            <option value=""></option>
                            <option value="10">10</option><option value="20">20</option><option value="30">30</option>
                            <option value="40">40</option><option value="50">50</option><option value="60">60</option>
                            <option value="70">70</option><option value="80">80</option><option value="90">90</option>
                        </select>
                    </div>
                    <div class="col-2"><label class="form-label">Rope 1</label><input class="form-control" t-att-value="state.rope1" t-on-input="(ev) => this.onInputNumber(ev, 'rope1')"/></div>
                    <div class="col-2"><label class="form-label">Rope 2</label><input class="form-control" t-att-value="state.rope2" t-on-input="(ev) => this.onInputNumber(ev, 'rope2')"/></div>
                    <div class="col-2"><label class="form-label">Rope 3</label><input class="form-control" t-att-value="state.rope3" t-on-input="(ev) => this.onInputNumber(ev, 'rope3')"/></div>
                    <div class="col-2"><label class="form-label">Rope 4</label><input class="form-control" t-att-value="state.rope4" t-on-input="(ev) => this.onInputNumber(ev, 'rope4')"/></div>
                    <div class="col-2"><label class="form-label">Rope 5</label><input class="form-control" t-att-value="state.rope5" t-on-input="(ev) => this.onInputNumber(ev, 'rope5')"/></div>
                    <div class="col-2"><label class="form-label">Rope 6</label><input class="form-control" t-att-value="state.rope6" t-on-input="(ev) => this.onInputNumber(ev, 'rope6')"/></div>
                </div>
            </div>

            <!-- Step 5: Intensity -->
            <div t-if="isStepVisible(4)">
                <div class="row g-3 mt-1">
                    <div class="col-6"><label class="form-label">Salt Measurement</label><input class="form-control" t-att-value="state.salt_measurement" t-on-input="(ev) => this.onInputNumber(ev, 'salt_measurement')"/></div>
                    <div class="col-6">
                        <label class="form-label">Water Batches</label>
                        <select class="form-select" t-model="state.water_batches" t-on-change="(ev) => this.onSelectionChange(ev, 'water_batches')">
                            <option value=""></option>
                            <option value="wb1">3</option>
                            <option value="wb2">3 + 1</option>
                            <option value="wb3">2 + 1</option>
                        </select>
                    </div>
                    <div class="col-3"><label class="form-label">Actual Volume</label><input class="form-control" t-att-value="state.actual_volume" readonly="1"/></div>
                    <div class="col-3"><label class="form-label">Total Tank Volume</label><input class="form-control" t-att-value="state.total_tanq_volume" readonly="1"/></div>
                    <div class="col-3"><label class="form-label">Final Volume</label><input class="form-control" t-att-value="state.final_volume" readonly="1"/></div>
                    <div class="col-3"><label class="form-label">Volume Variation</label><input class="form-control" t-att-value="state.volume_variation" readonly="1"/></div>
                    <div class="col-12" t-if="state.ribbon_message === 1">
                        <div class="alert alert-danger mb-0">
                            <strong>Missing Water</strong>
                            <div t-if="state.message" class="mt-1"><t t-esc="state.message"/></div>
                        </div>
                    </div>
                    <div class="col-12" t-if="state.ribbon_message === 2">
                        <div class="alert alert-warning mb-0">
                            <strong>Add Salt and Alkali</strong>
                            <div t-if="state.message" class="mt-1"><t t-esc="state.message"/></div>
                        </div>
                    </div>
                    <div class="col-12" t-if="state.ribbon_message === 0 and state.message">
                        <div class="alert alert-info mb-0"><t t-esc="state.message"/></div>
                    </div>
                    <div class="col-4"><label class="form-label">Add Salt</label><input class="form-control" t-att-value="state.add_salt" readonly="1"/></div>
                    <div class="col-4"><label class="form-label">Add Carbonate</label><input class="form-control" t-att-value="state.add_carbonate" readonly="1"/></div>
                    <div class="col-4"><label class="form-label">Add Soda</label><input class="form-control" t-att-value="state.add_soda" readonly="1"/></div>
                </div>
            </div>

            <!-- Step 6: Dyeing Curve -->
            <div t-if="isStepVisible(5)">
                <div class="row g-3 mt-1">
                    <div class="col-6">
                        <label class="form-label">Tipo de Proceso</label>
                        <select class="form-select" t-model="state.tipo_proceso" t-on-change="(ev) => this.onSelectionChange(ev, 'tipo_proceso')">
                            <option value=""></option>
                            <option value="ISOTERMICA60">ISOTERMICA60</option>
                            <option value="MIGRACION40-60">MIGRACION40-60</option>
                            <option value="MIGRACION60-80-60">MIGRACION60-80-60</option>
                            <option value="MIGRACION80-90-60">MIGRACION80-90-60</option>
                            <option value="MIGRASALADE160-80-60">MIGRASALADE160-80-60</option>
                        </select>
                    </div>
                    <div class="col-6" t-if="state.tipo_proceso">
                        <label class="form-label">Imagen Proceso</label>
                        <div class="border rounded p-2 bg-light d-flex justify-content-center">
                            <img t-att-src="processImageUrl"
                                 t-att-alt="state.tipo_proceso"
                                 style="max-height: 250px; max-width: 100%; object-fit: contain;"/>
                        </div>
                    </div>
                    <div class="col-3"><label class="form-label">pH Poly</label><input class="form-control" t-att-value="state.ph_poly" t-on-input="(ev) => this.onInputNumber(ev, 'ph_poly')"/></div>
                    <div class="col-3"><label class="form-label">Red Wash</label><input class="form-control" t-att-value="state.red_wash" t-on-input="(ev) => this.onInputNumber(ev, 'red_wash')"/></div>
                    <div class="col-3"><label class="form-label">Before Carbonate</label><input class="form-control" t-att-value="state.before_carb" t-on-input="(ev) => this.onInputNumber(ev, 'before_carb')"/></div>
                    <div class="col-3"><label class="form-label">First Carbonate</label><input class="form-control" t-att-value="state.first_carb" t-on-input="(ev) => this.onInputNumber(ev, 'first_carb')"/></div>
                    <div class="col-3"><label class="form-label">Second Carbonate</label><input class="form-control" t-att-value="state.second_carb" t-on-input="(ev) => this.onInputNumber(ev, 'second_carb')"/></div>
                    <div class="col-3"><label class="form-label">Exhaustion</label><input class="form-control" t-att-value="state.exhaustion" t-on-input="(ev) => this.onInputNumber(ev, 'exhaustion')"/></div>
                    <div class="col-4"><label class="form-label">Neutralization</label><input class="form-control" t-att-value="state.neutralization" t-on-input="(ev) => this.onInputNumber(ev, 'neutralization')"/></div>
                    <div class="col-4"><label class="form-label">Soaping</label><input class="form-control" t-att-value="state.soaping" t-on-input="(ev) => this.onInputNumber(ev, 'soaping')"/></div>
                    <div class="col-4"><label class="form-label">Discharge</label><input class="form-control" t-att-value="state.discharge" t-on-input="(ev) => this.onInputNumber(ev, 'discharge')"/></div>
                    <div class="col-12">
                        <label class="form-label">Observations</label>
                        <textarea class="form-control" rows="3" t-att-value="state.notes" t-on-input="(ev) => this.onInputText(ev, 'notes')"/>
                    </div>
                <div class="mt-3">
                    <div class="alert alert-info mb-0">
                        The record will be created in state <strong>Done</strong> when you press Confirm.
                    </div>
                </div>
                </div>
            </div>

            <t t-set-slot="footer">
                <div class="d-flex justify-content-between w-100">
                    <button class="btn btn-secondary"
                            t-att-disabled="state.currentStep === 0"
                            t-on-click="prevStep">
                        Previous
                    </button>
                    <button class="btn btn-primary"
                            t-on-click="nextStepOrConfirm">
                        <t t-esc="nextButtonLabel"/>
                    </button>
                </div>
            </t>
            </div>
        </Dialog>
    </t>
</templates>
