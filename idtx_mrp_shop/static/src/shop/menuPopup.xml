<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-inherit="mrp_workorder.MrpDisplayMenuDialog" t-inherit-mode="extension">
        <xpath expr="//div[@name='block']" position="before">
            <div class="col-6 p-1" t-if="props.record.resModel === 'mrp.workorder'">
                <button t-if="props.record.data.state == 'progress' and props.record.data.operation_type == 'weaving' and props.record.data.weave_type !== 'rect'"
                        class="d-flex flex-column gap-1 btn btn-warning fs-3 w-100 h-100 py-3"
                        t-on-click="() => this.readScaleWithClientIP(props.record.resId)">
                        <i class="fa fa-battery me-2"/>Add Roll
                </button>
                <button t-if="props.record.data.state == 'progress' and props.record.data.operation_type == 'weaving' and props.record.data.weave_type === 'rect'"
                        class="d-flex flex-column gap-1 btn btn-warning fs-3 w-100 h-100 py-3"
                        t-on-click="() => this.createSizeRecord(props.record.resId)">
                        <i class="fa fa-plus-square me-2"/>Add Size
                </button>
                <button t-if="props.record.data.state == 'progress' and props.record.data.operation_type == 'dyeing' and props.record.data.use_lab_recipe"
                        class="d-flex flex-column gap-1 btn btn-warning fs-3 w-100 h-100 py-3"
                        t-on-click="() => this.registerDyeBatch(props.record.resId)">
                        <i class="fa fa-flask me-2"/>Dye Batch
                </button>
                <!-- Registro simple de partida: tintorería sin receta de
                     laboratorio (HABILITADO, HIDROEXTRACTORA...), ACABADO
                     (SECADO TUBULAR, RAMA...), ESTAMPADO y CALIDAD. -->
                <button t-if="props.record.data.state == 'progress' and !props.record.data.weighs_batch and (['finishing', 'printing', 'quality'].includes(props.record.data.operation_type) or (props.record.data.operation_type == 'dyeing' and !props.record.data.use_lab_recipe))"
                        class="d-flex flex-column gap-1 btn btn-warning fs-3 w-100 h-100 py-3"
                        t-on-click="() => this.registerBatchOperation(props.record.resId)">
                        <i class="fa fa-check-square-o me-2"/>Register Batch
                </button>
                <!-- Control de peso: la partida se pesa en la balanza y ese peso
                     queda en la partida y alimenta la receta (operación marcada
                     "Control de peso" en la ruta). -->
                <button t-if="props.record.data.state == 'progress' and props.record.data.weighs_batch"
                        class="d-flex flex-column gap-1 btn btn-warning fs-3 w-100 h-100 py-3"
                        t-on-click="() => this.registerBatchWeight(props.record.resId)">
                        <i class="fa fa-balance-scale me-2"/>Control de peso
                </button>
            </div>
        </xpath>
    </t>
</templates>
