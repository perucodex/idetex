<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="idtx_mrp_shop.SelectScaleDialog">
        <Dialog size="'md'" title="props.title" modalRef="modalRef">
            <div class="mt-4" t-if="options and options.length">
                <h5 class="fw-bold">Option</h5>
                <select class="form-select fs-4" t-model="state.selectedOption" t-on-change="onOptionChange">
                    <option value=""> </option>
                    <t t-foreach="options" t-as="opt" t-key="opt.id">
                        <option t-att-value="'' + opt.id"
                                t-att-selected="state.selectedOption == ('' + opt.id)"
                                t-esc="opt.name"/>
                    </t>
                </select>
            </div>
            <div class="mt-4">
                <h5 class="fw-bold">Employee</h5>
                <select class="form-select fs-4" t-model="state.selectedEmployee">
                    <t t-foreach="employees" t-as="emp" t-key="emp.id">
                        <option t-att-value="emp.id" t-esc="emp.name"/>
                    </t>
                </select>
            </div>
            <div class="mt-4">
                <h5 class="fw-bold">Equipment</h5>
                <select class="form-select fs-4" t-model="state.selectedEquipment">
                    <option value=""></option>
                    <t t-foreach="state.equipments" t-as="eqp" t-key="eqp.id">
                        <option t-att-value="'' + eqp.id" t-esc="eqp.name"/>
                    </t>
                </select>
            </div>
            <div class="o_select_scale_dialog w-100">
                <t t-foreach="scales" t-as="scale" t-key="scale.id">
                    <div class="form-check py-2 fs-3 pointer-cursor" t-on-click="() => this.selectScale(scale)">
                        <input t-att-type="props.radioMode ? 'radio' : 'checkbox'"
                               t-att-name="scale.equipment_name"
                               class="form-check-input"
                               t-att-checked="state.selectedMode === 'scale' and state.selectedScaleId === scale.id"/>
                        <label class="form-check-label">
                            <t t-out="scale.equipment_name"/>
                        </label>
                    </div>
                </t>

                <!-- Radio: Manual -->
                <div class="form-check py-2 fs-3 pointer-cursor" t-on-click="() => this.selectManual()">
                    <input type="radio" name="scaleChoice" class="form-check-input"
                           t-att-checked="state.selectedMode === 'manual'"/>
                    <label class="form-check-label">Manual</label>
                </div>

                <!-- Auth manual (solo si no autorizado) -->
                <div t-if="state.selectedMode === 'manual' and !state.isManualAuthorized" class="mt-3">
                    <div class="alert alert-warning">
                        Se requiere autorización para ingreso manual.
                    </div>

                    <div class="mb-2">
                        <label class="form-label fs-4">Usuario</label>
                        <input type="text" class="form-control fs-4"
                               t-model="state.authLogin"
                               t-on-keydown="onAuthKeyDown"
                               t-ref="authLogin"
                               autocomplete="username"/>
                    </div>

                    <div class="mb-2">
                        <label class="form-label fs-4">Contraseña</label>
                        <input type="password" class="form-control fs-4"
                               t-model="state.authPassword"
                               t-on-keydown="onAuthKeyDown"
                               t-ref="authPassword"
                               autocomplete="current-password"/>
                    </div>

                    <div t-if="state.authError" class="text-danger fs-5 mb-2">
                        <t t-esc="state.authError"/>
                    </div>

                    <button class="btn btn-primary fs-4"
                            t-att-disabled="state.isAuthChecking or !state.authLogin or !state.authPassword"
                            t-on-click="confirmManualAuth">
                        <t t-if="state.isAuthChecking">Verificando...</t>
                        <t t-else="">Verificar</t>
                    </button>
                </div>

                <!-- Manual autorizado -->
                <div t-if="state.selectedMode === 'manual' and state.isManualAuthorized" class="mt-3">
                    <div class="d-flex justify-content-end mb-2">
                        <button class="btn btn-outline-danger fs-5" t-on-click="deactivateManual">
                            Desactivar manual
                        </button>
                    </div>

                    <input type="text" class="form-control fs-4"
                           placeholder="Enter weight (kg)"
                           inputmode="decimal"
                           pattern="^[0-9]*\.?[0-9]+$"
                           t-on-input="onManualInput"
                           t-on-keydown="onInputKeyDown"
                           t-att-value="state.manualWeight"
                           t-ref="manualInput"/>
                </div>

                <t t-set-slot="footer">
                        <button class="btn btn-primary"
                            data-select-confirm="1"
                            t-att-disabled="!isConfirmEnabled"
                            t-att-style="!isConfirmEnabled ? 'pointer-events:none;opacity:0.6' : ''"
                            t-on-click="confirm">
                        Confirm
                    </button>
                    <!-- <button class="btn btn-primary" t-att-class="{'disabled': props.radioMode &amp;&amp; !state.activeScales.length}" t-on-click="confirm">Confirm</button> -->
                          <a t-if="!isDisplayStandalone &amp;&amp; !props.radioMode"
                              class="btn btn-secondary"
                              t-attf-href="/scoped_app?app_id=mrp_shop_floor&amp;path=scoped_app/shop-floor&amp;app_name={appName}"
                              target="_blank">Install App</a>
                </t>
            </div>
        </Dialog>
    </t>
</templates>
