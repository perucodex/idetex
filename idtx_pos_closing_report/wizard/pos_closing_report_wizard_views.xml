<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_closing_report_wizard_form" model="ir.ui.view">
        <field name="name">pos.closing.report.wizard.form</field>
        <field name="model">pos.closing.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Reporte de Cierre de Caja">
                <group>
                    <field name="session_id" options="{'no_create': True, 'no_open': True}"/>
                </group>
                <footer>
                    <button name="action_generate_report" string="Ver Tabla Detallada" type="object" class="btn-primary"/>
                    <button name="action_print_pdf" string="Imprimir PDF" type="object" class="btn-secondary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_pos_closing_report_wizard" model="ir.actions.act_window">
        <field name="name">Reporte Cierre y Control de Caja</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">pos.closing.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
