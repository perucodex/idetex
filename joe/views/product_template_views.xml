<?xml version="1.0" encoding="utf-8"?>
    <odoo>
        <record id="product_template_form_view_prodev" model="ir.ui.view">
            <field name="name">product.template.form.view.prodev</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_form_view" />
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page string="Weaving Information" name="weaving_information">
                        <group>
                            <group>
                                <field name="density"/>
                                <field name="width"/>
                                <field name="gauge"/>
                                <field name="first_wash_shrinkage"/>
                                <field name="first_wash_twist"/>
                            </group>
                            <group>
                                <field name="yield_meter"/>
                                <field name="scrap" widget="percentage"/>
                                <field name="weave_type"/>
                                <field name="batch"/>
                            </group>
                            <field name="memo" nolabel="0"/>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
    </odoo>