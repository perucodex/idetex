<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_integration_orgatex_list" model="ir.ui.view">
        <field name="name">integration.orgatex.list</field>
        <field name="model">integration.orgatex</field>
        <field name="arch" type= 'xml'>
            <list>
                <field name="product"/>
                <field name="color_name"/>
                <field name="code_color"/>
                <field name="color" widget='color'/>
                <field name="hexadecimal"/>
                <field name="recipes"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_integration_orgatex_form" model="ir.ui.view">
        <field name="name">integration.orgatex.form</field>
        <field name="model">integration.orgatex</field>
        <field name="arch" type="xml">
            <form string="Orgatex Integration">
                <header>
                    <button name="action_send_to_sql" type="object" string="Send to SQL Server" class="btn-primary"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="product"/>
                        <field name="color_name"/>
                        <field name="code_color"/>
                        <field name="color"/>
                        <field name="hexadecimal"/>
                        <field name="recipes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_integration_orgatex_menu" model="ir.actions.act_window">
        <field name="name">Orgatex Integration</field>
        <field name="res_model">integration.orgatex</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_orgatex_root" name="Orgatex Integration"/>
    <menuitem id="menu_orgatex_data" name="Data" parent="menu_orgatex_root" action="action_integration_orgatex_menu"/>

</odoo>
