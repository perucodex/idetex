<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sales_dbf_record_list_view" model="ir.ui.view">
        <field name="name">sales.dbf.record.list</field>
        <field name="model">sales.dbf.record</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" default_order="fecha desc">
                <field name="fecha"/>
                <field name="source" optional="show"/>
                <field name="doc_number"/>
                <field name="origin_doc" optional="show"/>
                <field name="client_name"/>
                <field name="vendor_name"/>
                <field name="partida" optional="show"/>
                <field name="desfamil" optional="hide"/>
                <field name="kilos" sum="Kilos"/>
                <field name="currency" optional="show"/>
                <field name="amount_usd" sum="Total USD"/>
                <field name="tc" optional="show"/>
                <field name="amount_pen" sum="Total S/"/>
            </list>
        </field>
    </record>

    <record id="sales_dbf_record_pivot_view" model="ir.ui.view">
        <field name="name">sales.dbf.record.pivot</field>
        <field name="model">sales.dbf.record</field>
        <field name="arch" type="xml">
            <pivot string="Ventas por Vendedor">
                <field name="vendor_name" type="row"/>
                <field name="fecha" interval="month" type="col"/>
                <field name="amount_pen" type="measure"/>
                <field name="kilos" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="sales_dbf_record_graph_view" model="ir.ui.view">
        <field name="name">sales.dbf.record.graph</field>
        <field name="model">sales.dbf.record</field>
        <field name="arch" type="xml">
            <graph string="Ventas por Mes" type="bar">
                <field name="fecha" interval="month"/>
                <field name="amount_pen" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="sales_dbf_record_search_view" model="ir.ui.view">
        <field name="name">sales.dbf.record.search</field>
        <field name="model">sales.dbf.record</field>
        <field name="arch" type="xml">
            <search>
                <field name="doc_number"/>
                <field name="client_name"/>
                <field name="vendor_name"/>
                <field name="partida"/>
                <field name="desfamil"/>
                <filter name="este_anio" string="Este año"
                        domain="[('fecha', '&gt;=', context_today().strftime('%Y-01-01'))]"/>
                <filter name="ventas" string="Ventas" domain="[('source', '=', 'venta')]"/>
                <filter name="ncs" string="Notas de Crédito" domain="[('source', '=', 'nc')]"/>
                <filter name="nds" string="Notas de Débito" domain="[('source', '=', 'nd')]"/>
                <group>
                    <filter name="group_vendor" string="Vendedor"
                            context="{'group_by': 'vendor_name'}"/>
                    <filter name="group_month" string="Mes"
                            context="{'group_by': 'fecha:month'}"/>
                    <filter name="group_client" string="Cliente"
                            context="{'group_by': 'client_name'}"/>
                    <filter name="group_famil" string="Familia"
                            context="{'group_by': 'desfamil'}"/>
                    <filter name="group_source" string="Tipo"
                            context="{'group_by': 'source'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Pivot por defecto (vendedor x mes); la lista queda como vista opcional.
         Sin group_by de mes en el contexto: en el pivot los meses ya son
         columnas y el arch define solo al vendedor como fila. -->
    <record id="action_sales_dbf_record" model="ir.actions.act_window">
        <field name="name">Ventas por Vendedor</field>
        <field name="res_model">sales.dbf.record</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="search_view_id" ref="sales_dbf_record_search_view"/>
        <field name="context">{'search_default_este_anio': 1}</field>
    </record>

    <menuitem id="menu_sales_dbf_records" name="Ventas por Vendedor"
              parent="sale.menu_sale_report" sequence="25"
              action="action_sales_dbf_record"/>

</odoo>
