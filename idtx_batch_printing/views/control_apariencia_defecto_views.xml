<odoo>
    <record id="view_control_apariencia_defecto_tree_inherit_printing" model="ir.ui.view">
        <field name="name">control.apariencia.defecto.tree.inherit</field>
        <field name="model">control.apariencia.defecto</field>
        <field name="inherit_id" ref="idtx_batch_quality.view_control_apariencia_defecto_tree"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="type_deffect"/>
                <field name="type_printing" column_invisible="context.get('default_type_deffect') != 'printing'"/>
            </field>
        </field>
    </record>

    <record id="view_control_apariencia_defecto_form_inherit_printing" model="ir.ui.view">
        <field name="name">control.apariencia.defecto.form.inherit</field>
        <field name="model">control.apariencia.defecto</field>
        <field name="inherit_id" ref="idtx_batch_quality.view_control_apariencia_defecto_form"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="type_deffect"/>
                <field name="type_printing" invisible="type_deffect != 'printing'"/>
            </field>
        </field>
    </record>

    <record id="action_control_apariencia_defecto_printing" model="ir.actions.act_window">
        <field name="name">Defectos Apariencia</field>
        <field name="res_model">control.apariencia.defecto</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'default_type_deffect': 'printing'}</field>
        <field name="domain">[('type_deffect', '=', 'printing')]</field>
    </record>

    <record id="idtx_batch_quality.action_control_apariencia_defecto" model="ir.actions.act_window">
        <field name="context">{'default_type_deffect': 'quality'}</field>
        <field name="domain">[('type_deffect', '=', 'quality')]</field>
    </record>

    <menuitem id="menu_control_apariencia_defecto_printing"
              name="Defectos Apariencia"
              parent="idtx_printing.print_settings_menu"
              action="action_control_apariencia_defecto_printing"
              sequence="10"/>
    
</odoo>