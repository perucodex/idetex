<odoo>
    <!-- client action that loads our javascript screen -->
    <record id="action_printing_defect_screen_printing" model="ir.actions.client">
        <field name="name">Evaluar Apariencia Estampado</field>
        <field name="tag">idtx_quality.defect_screen_printing</field>
        <field name="target">fullscreen</field>
    </record>

    <record id="action_printing_partida" model="ir.actions.act_window">
        <field name="name">Partidas</field>
        <field name="res_model">control.pedido.line</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'appearance_type': 'printing', 'default_type_deffect': 'printing'}</field>
    </record>

    <record id="idtx_batch_quality.action_quality_partida" model="ir.actions.act_window">
        <field name="context">{'appearance_type': 'quality', 'default_type_deffect': 'quality'}</field>
    </record>

    <menuitem id="menu_printing_partida"
              name="Partidas"
              parent="idtx_printing.print_operations_menu"
              action="action_printing_partida"
              sequence="20"/>

    <!-- menu entry under Printing / Print Operations -->
    <menuitem id="menu_printing_defect_screen_printing"
              name="Evaluar Apariencia Estampado"
              parent="idtx_printing.print_operations_menu"
              action="action_printing_defect_screen_printing"
              sequence="30"/>
              
</odoo>