<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="idtx_quality.QualityTonoBoard">
    <div class="o_qb_root">

        <!-- ── Carga ─────────────────────────────────────────── -->
        <t t-if="state.loading">
            <div class="o_qb_splash">
                <div class="spinner-border text-primary" style="width:2.5rem;height:2.5rem;" role="status"/>
                <p class="mt-3 text-muted fw-semibold">Cargando evaluaciones…</p>
            </div>
        </t>

        <!-- ── Error ─────────────────────────────────────────── -->
        <t t-elif="state.error">
            <div class="alert alert-danger m-4" role="alert">
                <i class="fa fa-exclamation-triangle me-2"/>
                <t t-esc="state.error"/>
            </div>
        </t>

        <!-- ── Contenido ─────────────────────────────────────── -->
        <t t-else="">

            <!-- Cabecera -->
            <div class="o_qb_header">
                <div>
                    <h2 class="o_qb_title"><t t-esc="title"/></h2>
                    <span class="o_qb_subtitle">
                        <t t-esc="state.grandTotal"/> registros ·
                        <t t-esc="state.months.length"/> mes(es)
                    </span>
                </div>
            </div>

            <!-- ── Tarjeta 1: Tabla Resultados ──────────────── -->
            <div class="o_qb_card">
                <div class="o_qb_card_header">
                    <i class="fa fa-table me-2 text-muted"/>
                    Distribución por Mes y Resultado
                </div>
                <div class="o_qb_table_wrap">
                    <table class="o_qb_table">
                        <thead>
                            <tr>
                                <th class="o_qb_th_label" rowspan="2">Resultado</th>
                                <t t-foreach="state.months" t-as="m" t-key="m">
                                    <th colspan="2" class="o_qb_th_month">
                                        <t t-esc="formatMonth(m)"/>
                                    </th>
                                </t>
                                <th colspan="2" class="o_qb_th_total_header" rowspan="1">TOTAL</th>
                            </tr>
                            <tr>
                                <t t-foreach="state.months" t-as="m" t-key="'sh_' + m">
                                    <th class="o_qb_th_sub"># Partidas</th>
                                    <th class="o_qb_th_sub o_qb_pct_col">%</th>
                                </t>
                                <th class="o_qb_th_sub o_qb_total_sub"># Partidas</th>
                                <th class="o_qb_th_sub o_qb_pct_col o_qb_total_sub">%</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="resultados" t-as="res" t-key="res">
                                <tr class="o_qb_tr_result">
                                    <td class="o_qb_td_label">
                                        <t t-esc="config[res].label"/>
                                    </td>
                                    <t t-foreach="state.months" t-as="m" t-key="'c_' + res + '_' + m">
                                        <t t-set="cell" t-value="getCell(res, m)"/>
                                        <td class="o_qb_td_count"><t t-esc="cell.count || 0"/></td>
                                        <td class="o_qb_td_pct o_qb_td_pct_red">
                                            <t t-esc="cell.pct || 0"/>%
                                        </td>
                                    </t>
                                    <td class="o_qb_td_count o_qb_td_row_total">
                                        <t t-esc="getRowTotal(res)"/>
                                    </td>
                                    <td class="o_qb_td_pct o_qb_td_pct_red o_qb_td_row_total">
                                        <t t-esc="getRowPct(res)"/>%
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                        <tfoot>
                            <tr class="o_qb_tfoot">
                                <td class="o_qb_td_label o_qb_td_total_label">Total</td>
                                <t t-foreach="state.months" t-as="m" t-key="'tf_' + m">
                                    <td colspan="2" class="o_qb_td_foot_count">
                                        <t t-esc="state.totals[m] || 0"/>
                                    </td>
                                </t>
                                <td colspan="2" class="o_qb_td_foot_count o_qb_td_grand">
                                    <t t-esc="state.grandTotal"/>
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>

            <!-- ── Tarjeta 2: Gráfico Resultados ────────────── -->
            <div class="o_qb_card">
                <div class="o_qb_card_header">
                    <i class="fa fa-bar-chart me-2 text-muted"/>
                    Evolución Mensual por Resultado
                </div>
                <div class="o_qb_chart_wrap">
                    <canvas t-ref="barChart"/>
                </div>
            </div>

            <!-- ── Sección Recetas (Tintorería y Acabado) ───────── -->
            <t t-if="tono === 'tacho' || tono === 'acabado'">

                <!-- Separador de sección -->
                <div class="o_qb_section_divider">
                    <i class="fa fa-flask me-2"/>
                    Análisis de Recetas
                </div>

                <!-- Leyenda de comparación -->
                <div class="o_qb_receta_legend">
                    <div class="o_qb_legend_item">
                        <span class="o_qb_legend_dot" style="background:#198754"/>
                        <span>
                            <strong>Receta Correcta</strong> —
                            Receta Tacho (<em>receta_tono</em>) coincide con
                            <t t-esc="recetaLabelRef"/> (<em>receta</em>)
                        </span>
                    </div>
                    <div class="o_qb_legend_item">
                        <span class="o_qb_legend_dot" style="background:#dc3545"/>
                        <span>
                            <strong>Cambio de Receta</strong> —
                            Receta Tacho difiere de <t t-esc="recetaLabelRef"/>
                        </span>
                    </div>
                </div>

                <!-- ── Tarjeta 3: Tabla Recetas ──────────────── -->
                <div class="o_qb_card">
                    <div class="o_qb_card_header">
                        <i class="fa fa-table me-2 text-muted"/>
                        Comparación de Recetas por Mes
                        <span class="o_qb_card_badge ms-2">
                            <t t-esc="state.recetaGrandTotal"/> evaluaciones
                        </span>
                    </div>
                    <div class="o_qb_table_wrap">
                        <table class="o_qb_table">
                            <thead>
                                <tr>
                                    <th class="o_qb_th_label" rowspan="2">Tipo</th>
                                    <t t-foreach="state.months" t-as="m" t-key="'rm_' + m">
                                        <th colspan="2" class="o_qb_th_month">
                                            <t t-esc="formatMonth(m)"/>
                                        </th>
                                    </t>
                                    <th colspan="2" class="o_qb_th_total_header" rowspan="1">TOTAL</th>
                                </tr>
                                <tr>
                                    <t t-foreach="state.months" t-as="m" t-key="'rsh_' + m">
                                        <th class="o_qb_th_sub"># Partidas</th>
                                        <th class="o_qb_th_sub o_qb_pct_col">%</th>
                                    </t>
                                    <th class="o_qb_th_sub o_qb_total_sub"># Partidas</th>
                                    <th class="o_qb_th_sub o_qb_pct_col o_qb_total_sub">%</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="recetaTipos" t-as="tipo" t-key="tipo">
                                    <tr class="o_qb_tr_result">
                                        <td class="o_qb_td_label">
                                            <t t-esc="recetaConfig[tipo].label"/>
                                        </td>
                                        <t t-foreach="state.months" t-as="m" t-key="'rc_' + tipo + '_' + m">
                                            <t t-set="rcell" t-value="getRecetaCell(tipo, m)"/>
                                            <td class="o_qb_td_count"><t t-esc="rcell.count || 0"/></td>
                                            <td class="o_qb_td_pct o_qb_td_pct_red">
                                                <t t-esc="rcell.pct || 0"/>%
                                            </td>
                                        </t>
                                        <td class="o_qb_td_count o_qb_td_row_total">
                                            <t t-esc="getRecetaRowTotal(tipo)"/>
                                        </td>
                                        <td class="o_qb_td_pct o_qb_td_pct_red o_qb_td_row_total">
                                            <t t-esc="getRecetaRowPct(tipo)"/>%
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                            <tfoot>
                                <tr class="o_qb_tfoot">
                                    <td class="o_qb_td_label o_qb_td_total_label">Total</td>
                                    <t t-foreach="state.months" t-as="m" t-key="'rtf_' + m">
                                        <td colspan="2" class="o_qb_td_foot_count">
                                            <t t-esc="state.recetaTotals[m] || 0"/>
                                        </td>
                                    </t>
                                    <td colspan="2" class="o_qb_td_foot_count o_qb_td_grand">
                                        <t t-esc="state.recetaGrandTotal"/>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>

                <!-- ── Tarjeta 4: Gráfico Recetas ────────────── -->
                <div class="o_qb_card">
                    <div class="o_qb_card_header">
                        <i class="fa fa-bar-chart me-2 text-muted"/>
                        Evolución Mensual de Recetas
                    </div>
                    <div class="o_qb_chart_wrap">
                        <canvas t-ref="barChartReceta"/>
                    </div>
                </div>

            </t>
            <!-- fin sección recetas -->

            <!-- ── Sección Motivos (solo Acabado) ───────────── -->
            <t t-if="tono === 'acabado'">

                <div class="o_qb_section_divider">
                    <i class="fa fa-exclamation-circle me-2"/>
                    Análisis de Motivos
                </div>

                <!-- ── Tarjeta 5: Tabla Motivos ──────────────── -->
                <div class="o_qb_card">
                    <div class="o_qb_card_header">
                        <i class="fa fa-table me-2 text-muted"/>
                        Distribución de Motivos por Mes
                        <span class="o_qb_card_badge ms-2">
                            <t t-esc="state.motivoGrandTotal"/> ocurrencias
                        </span>
                    </div>
                    <div class="o_qb_table_wrap">
                        <table class="o_qb_table">
                            <thead>
                                <tr>
                                    <th class="o_qb_th_label" rowspan="2">Motivo</th>
                                    <t t-foreach="state.months" t-as="m" t-key="'mm_' + m">
                                        <th colspan="2" class="o_qb_th_month">
                                            <t t-esc="formatMonth(m)"/>
                                        </th>
                                    </t>
                                    <th colspan="2" class="o_qb_th_total_header" rowspan="1">TOTAL</th>
                                </tr>
                                <tr>
                                    <t t-foreach="state.months" t-as="m" t-key="'msh_' + m">
                                        <th class="o_qb_th_sub"># Partidas</th>
                                        <th class="o_qb_th_sub o_qb_pct_col">%</th>
                                    </t>
                                    <th class="o_qb_th_sub o_qb_total_sub"># Partidas</th>
                                    <th class="o_qb_th_sub o_qb_pct_col o_qb_total_sub">%</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="motivoTipos" t-as="tipo" t-key="tipo">
                                    <tr class="o_qb_tr_result">
                                        <td class="o_qb_td_label">
                                            <t t-esc="motivoConfig[tipo].label"/>
                                        </td>
                                        <t t-foreach="state.months" t-as="m" t-key="'mc_' + tipo + '_' + m">
                                            <t t-set="mcell" t-value="getMotivoCell(tipo, m)"/>
                                            <td class="o_qb_td_count"><t t-esc="mcell.count || 0"/></td>
                                            <td class="o_qb_td_pct o_qb_td_pct_red">
                                                <t t-esc="mcell.pct || 0"/>%
                                            </td>
                                        </t>
                                        <td class="o_qb_td_count o_qb_td_row_total">
                                            <t t-esc="getMotivoRowTotal(tipo)"/>
                                        </td>
                                        <td class="o_qb_td_pct o_qb_td_pct_red o_qb_td_row_total">
                                            <t t-esc="getMotivoRowPct(tipo)"/>%
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                            <tfoot>
                                <tr class="o_qb_tfoot">
                                    <td class="o_qb_td_label o_qb_td_total_label">Total</td>
                                    <t t-foreach="state.months" t-as="m" t-key="'mtf_' + m">
                                        <td colspan="2" class="o_qb_td_foot_count">
                                            <t t-esc="state.motivoTotals[m] || 0"/>
                                        </td>
                                    </t>
                                    <td colspan="2" class="o_qb_td_foot_count o_qb_td_grand">
                                        <t t-esc="state.motivoGrandTotal"/>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>

                <!-- ── Tarjeta 6: Gráfico Motivos ────────────── -->
                <div class="o_qb_card">
                    <div class="o_qb_card_header">
                        <i class="fa fa-bar-chart me-2 text-muted"/>
                        Evolución Mensual de Motivos
                    </div>
                    <div class="o_qb_chart_wrap">
                        <canvas t-ref="barChartMotivo"/>
                    </div>
                </div>

            </t>
            <!-- fin sección motivos -->

        </t>
    </div><!-- .o_qb_root -->
</t>

</templates>
