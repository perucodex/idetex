<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sale_order_view_form_inherit_lab" model="ir.ui.view">
        <field name="name">sale.order.view.form.inherit.sale.order</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="sitpro_page" string="SITPRO" invisible="not is_company_produce or is_quote">
                    <group>
                        <group>
                            <field name="sale_domain" invisible="1"/>
                            <field name="sitpro_sale_type_id" required="is_company_produce and not is_quote" domain="[('orden','=', sale_domain)]"/>
                            <field name="telefono" required="is_company_produce and not is_quote"/>
                            <field name="grem" required="is_company_produce and not is_quote"/>
                            <field name="occ" required="is_company_produce and not is_quote"/>
                            <field name="fecoc" required="is_company_produce and not is_quote"/>
                            <field name="almacen" required="is_company_produce and not is_quote"/>
                            <field name="tipdesp" required="is_company_produce and not is_quote"/>
                            <field name="fechadespacho" required="is_company_produce and not is_quote"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>