<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_users_view_form_inherit" model="ir.ui.view">
        <field name="name">res.users.form.inherit</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <!-- OJO: NO usar `//field[@name='partner_id']`: el primer partner_id
                 del form está dentro del banner de alerta "Puede archivar el
                 contacto" (invisible salvo que el partner esté archivado), así
                 que el campo quedaba oculto. Se ancla al `email` (visible). -->
            <xpath expr="//field[@name='email']" position="after">
                <field name="vendor_code_sitpro"/>
            </xpath>
        </field>
    </record>

    <record id="view_users_simple_form_inherit" model="ir.ui.view">
        <field name="name">res.users.form.inherit</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_simple_form"/>
        <field name="arch" type="xml">
            <group name="access_groups" position="after">
                <group name="sitpro">
                    <field name="vendor_code_sitpro"/>
                </group>
            </group>
        </field>
    </record>

</odoo>
