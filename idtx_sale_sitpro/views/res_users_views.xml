<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_users_view_form_inherit" model="ir.ui.view">
        <field name="name">res.users.form.inherit</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <!-- OJO: NO usar `//field[@name='partner_id']` a secas: el PRIMER
                 partner_id del form está dentro del banner de alerta "Puede
                 archivar el contacto" (oculto salvo que el partner esté
                 archivado), por eso el campo quedaba invisible. Anclamos al
                 partner_id que es hijo DIRECTO de un <group> (el grupo debajo
                 del título, antes del notebook) → el campo queda visible y con
                 layout de grupo. -->
            <xpath expr="//group/field[@name='partner_id']" position="after">
                <field name="vendor_code_sitpro"/>
            </xpath>
        </field>
    </record>

    <record id="view_users_simple_form_inherit" model="ir.ui.view">
        <field name="name">res.users.form.inherit</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_simple_form"/>
        <field name="arch" type="xml">
            <group name="access_groups" position="after">
                <group name="sitpro">
                    <field name="vendor_code_sitpro"/>
                </group>
            </group>
        </field>
    </record>

</odoo>
