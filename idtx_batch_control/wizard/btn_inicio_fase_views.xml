<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_btn_inicio_fase_wizard_form" model="ir.ui.view">
        <field name="name">btn.inicio.fase.wizard.form</field>
        <field name="model">btn.inicio.fase.wizard</field>
        <field name="arch" type="xml">
            <form string="Iniciar Proceso">
                <sheet>
                    <group>
                        <field name="line_id" invisible="1"/>
                        <field name="fecha_inicio"/>
                    </group>
                    <p class="text-muted">
                        Seleccione la fecha y hora de inicio para esta partida.
                    </p>
                </sheet>
                <footer>
                    <button string="Confirmar Inicio" type="object" name="action_confirmar" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_btn_inicio_fase_wizard" model="ir.actions.act_window">
        <field name="name">Iniciar Proceso</field>
        <field name="res_model">btn.inicio.fase.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
