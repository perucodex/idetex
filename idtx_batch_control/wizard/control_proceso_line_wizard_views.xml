<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_control_proceso_line_wizard" model="ir.ui.view">
        <field name="name">control.proceso.line.wizard.form</field>
        <field name="model">control.proceso.line.wizard</field>
        <field name="arch" type="xml">
            <form string="Editar/Iniciar Proceso">
                <sheet>
                    <group>
                        <field name="line_id" invisible="1"/>
                        <group string="Valores Actuales (Anterior)">
                            <field name="fas_old_str" string="Proceso Anterior"/>
                            <field name="maq_old_str" string="Máquina Anterior"/>
                        </group>
                        <group string="Nuevos Valores (Lista de Selección)">
                            <field name="new_op_id" required="1" options="{'no_create': True}" string="Proceso Nuevo"/>
                            <field name="maq_id_new" readonly="1" force_save="1" string="Máquina Nueva"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button string="Aceptar" type="object" name="action_confirm" class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
