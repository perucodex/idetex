<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_control_faspro_definition_tree" model="ir.ui.view">
        <field name="name">control.faspro.definition.list</field>
        <field name="model">control.faspro.definition</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="default_maq_code"/>
            </list>
        </field>
    </record>

    <record id="action_control_faspro_definition" model="ir.actions.act_window">
        <field name="name">Definición de Procesos</field>
        <field name="res_model">control.faspro.definition</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
