<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_planning_op_tree" model="ir.ui.view">
        <field name="name">control.pedido.planning.list</field>
        <field name="model">control.pedido</field>
        <field name="arch" type="xml">
            <list string="Planning por OP" create="0" edit="0" default_order="feccc desc, numordped desc"
                  decoration-danger="plan_schedule_alert == 'danger'"
                  decoration-warning="plan_schedule_alert == 'warning'">
                <header>
                    <button name="action_plan_deactivate" type="object"
                            string="Desactivar del Planning"
                            confirm="¿Desactivar del Planning las OPs seleccionadas? Solo afecta este reporte (no toca SITPRO ni el estado)."/>
                    <button name="action_plan_activate" type="object"
                            string="Reactivar en Planning"/>
                </header>
                <field name="plan_schedule_alert" column_invisible="1"/>
                <field name="numordped"/>
                <field name="customer" optional="hide"/>
                <field name="feccc"/>
                <field name="plan_kilos_to_dye" string="Kilos de OP" sum="Total"/>
                <field name="plan_weaving_start"/>
                <field name="plan_weaving_end"/>
                <field name="produced_weight" string="Kilos Tejidos" sum="Total"/>
                <field name="plan_weave_progress" string="% Avance Tejido" widget="progressbar"/>
                <!-- <field name="plan_has_thermo" widget="boolean_toggle"/> -->
                <field name="plan_thermo_start"/>
                <field name="plan_thermo_end"/>
                <field name="plan_kilos_thermo" string="Kilos Termofijados" sum="Total" optional="show"/>
                <field name="plan_thermo_progress" string="% Avance Termofijado" widget="progressbar" optional="show"/>
                <field name="plan_dyeing_start"/>
                <field name="plan_dyeing_end"/>
                <field name="plan_kilos_dyed" string="Kilos Teñidos" sum="Total"/>
                <field name="plan_dye_progress" string="% Avance Teñido" widget="progressbar"/>
                <field name="plan_finishing_start"/>
                <field name="plan_finishing_end"/>
                <field name="plan_kilos_finished" string="Kilos Acabados" sum="Total"/>
                <field name="plan_finish_progress" string="% Avance Acabado" widget="progressbar"/>
                <field name="plan_active" widget="boolean_toggle" string="Activo Planning" optional="hide"/>
                <field name="state" widget="badge" optional="hide"
                       decoration-danger="state == 'de'"
                       decoration-info="state == 'on'"
                       decoration-success="state == 'do'"/>
            </list>
        </field>
    </record>

    <record id="view_planning_op_search" model="ir.ui.view">
        <field name="name">control.pedido.planning.search</field>
        <field name="model">control.pedido</field>
        <field name="arch" type="xml">
            <search>
                <field name="numordped"/>
                <field name="customer"/>
                <filter name="planning_pending" string="En proceso"
                        domain="[('state', 'in', ['on', 'de'])]"/>
                <separator/>
                <filter name="planning_has_feccc" string="Con Fecha Aprobación"
                        domain="[('feccc', '!=', False)]"/>
                <separator/>
                <filter name="planning_active" string="Activas (Planning)"
                        domain="[('plan_active', '=', True)]"/>
                <filter name="planning_inactive" string="Desactivadas (Planning)"
                        domain="[('plan_active', '=', False)]"/>
                <separator/>
                <filter name="planning_with_thermo" string="Con Termofijado"
                        domain="[('plan_has_thermo', '=', True)]"/>
                <group>
                    <filter name="group_by_customer" string="Cliente" domain="[]"
                            context="{'group_by': 'customer'}"/>
                    <filter name="group_by_weaving_start" string="Inicio Tejido" domain="[]"
                            context="{'group_by': 'plan_weaving_start:week'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_planning_op" model="ir.actions.act_window">
        <field name="name">Planning por OP</field>
        <field name="res_model">control.pedido</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_planning_op_tree"/>
        <field name="search_view_id" ref="view_planning_op_search"/>
        <field name="domain">[('state', '!=', 'se'), ('tipoventa', '!=', 'PRODUCCION HILANDERIA')]</field>
        <field name="context">{"search_default_planning_pending": 1, "search_default_planning_has_feccc": 1, "search_default_planning_active": 1}</field>
    </record>

    <!-- ================= Fechas por OP ================= -->
    <record id="view_fechas_op_tree" model="ir.ui.view">
        <field name="name">control.pedido.fechas.list</field>
        <field name="model">control.pedido</field>
        <field name="arch" type="xml">
            <list string="Fechas por OP" create="0" edit="0"
                  default_order="feccc desc, numordped desc">
                <field name="fecha"/>
                <field name="fecoc"/>
                <field name="fecgvtas"/>
                <field name="feccc"/>
                <field name="numordped"/>
                <field name="customer" string="Cliente"/>
                <field name="plan_days_oc_cc" string="Días OC→Aprob."/>
                <field name="user_id"/>
            </list>
        </field>
    </record>

    <record id="view_fechas_op_search" model="ir.ui.view">
        <field name="name">control.pedido.fechas.search</field>
        <field name="model">control.pedido</field>
        <field name="arch" type="xml">
            <search>
                <field name="numordped"/>
                <field name="customer"/>
                <field name="user_id"/>
                <group>
                    <filter name="group_by_customer" string="Cliente" domain="[]"
                            context="{'group_by': 'customer'}"/>
                    <filter name="group_by_user" string="Vendedor" domain="[]"
                            context="{'group_by': 'user_id'}"/>
                    <filter name="group_by_fecoc" string="Fecha OC" domain="[]"
                            context="{'group_by': 'fecoc:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_fechas_op" model="ir.actions.act_window">
        <field name="name">Fechas por OP</field>
        <field name="res_model">control.pedido</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_fechas_op_tree"/>
        <field name="search_view_id" ref="view_fechas_op_search"/>
        <field name="domain">[('plan_active', '=', True)]</field>
    </record>
</odoo>
