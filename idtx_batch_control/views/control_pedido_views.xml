<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_control_pedido_tree" model="ir.ui.view">
        <field name="name">control.pedido.list</field>
        <field name="model">control.pedido</field>
        <field name="arch" type="xml">
            <list decoration-danger="area == 'AREA NO CONOCIDA'" create="0">
                <field name="fecha"/>
                <field name="fecoc" optional="hide"/>
                <field name="fecgvtas" optional="hide"/>
                <field name="feccc"/>
                <field name="numordped"/>
                <field name="customer" optional="hide"/>
                <field name="user_id" optional="hide"/>
                <field name="tipoventa" optional="hide"/>
                <field name="num_days"/>
                <field name="area"/>
                <field name="process"/>
                <field name="state" widget="badge" decoration-danger="state == 'de'" decoration-info="state == 'on'" decoration-success="state == 'do'"/>
            </list>
        </field>
    </record>

    <record id="view_control_pedido_form" model="ir.ui.view">
        <field name="name">control.pedido.form</field>
        <field name="model">control.pedido</field>
        <field name="arch" type="xml">
            <form string="Pedido control">
                <header>
                    <button name="action_sync_from_dbf" type="object" string="Sincronizar desde DBF" class="btn-primary"/>
                    <button name="settle_order" type="object" string="Liquidar Orden" class="btn-primary" invisible="state == 'se'"/>
                    <button name="settle_order" type="object" string="Revertir Liquidación" class="btn-primary" invisible="state != 'se'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="numordped" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="fecha" readonly="1"/>
                            <field name="fecoc" readonly="1"/>
                            <field name="fecgvtas" readonly="1"/>
                            <field name="feccc" readonly="1"/>
                            <field name="customer" readonly="1"/>
                            <field name="user_id" readonly="1"/>
                            <field name="tipoventa" readonly="1"/>
                        </group>
                        <group>
                            <field name="num_days"/>
                            <field name="process"/>
                            <field name="area"/>
                            <div class="oe_button_box" name="button_box">

                            <!-- <button type="object" class="oe_stat_button" icon="fa-balance-scale">
                                <field name="total_weight" widget="statinfo" string="Kilos Totales"/>
                            </button>

                            <button type="object" class="oe_stat_button" icon="fa-industry">
                                <field name="produced_weight" widget="statinfo" string="Kilos Producidos"/>
                            </button> -->

                        </div>
                           <!-- <field name="total_weight" readonly="1"/>
                            <field name="produced_weight" readonly="1"/>-->
                        </group>
                    </group>
                    <notebook>
                        <page string="Detalle">
                            <field name="line_ids" readonly="1" create="0" edit="0">
                                <list decoration-danger="process == 'SIN AVANCE'">
                                    <field name="route"/>
                                    <field name="barcodreo"/>
                                    <field name="batch"/>
                                    <field name="kilograms" sum="Total"/>
                                    <field name="process"/>
                                    <field name="area"/>
                                    <field name="start_date" widget="datetime"/>
                                    <field name="end_date"/>
                                    <field name="colorcode"/>
                                    <field name="colorname"/>
                                    <button name="action_open_start_wizard" type="object" string="Iniciar" class="btn-primary" invisible="start_date"/>
                                    <button name="action_end_process" type="object" string="Finalizar" class="btn-success" invisible="not start_date or end_date"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="control_pedido_view_search" model="ir.ui.view">
        <field name="name">control.pedido.search</field>
        <field name="model">control.pedido</field>
        <field name="arch" type="xml">
            <search>
                <field name="numordped"/>
                <field name="customer"/>
                <filter name="not_done" string="En proceso" domain="[('state', 'in', ['on', 'de'])]"/>
                <filter name="done" string="Terminado" domain="[('state', '=', 'do')]"/>
            </search>
        </field>
    </record>

    <record id="action_control_pedido" model="ir.actions.act_window">
        <field name="name">Pedidos control</field>
        <field name="res_model">control.pedido</field>
        <field name="view_mode">list,form</field>
        <field name="context">{"search_default_not_done": 1}</field>
    </record>

</odoo>