<odoo>
  <!-- ============ Cabecera: Tree ============ -->
  <record id="view_control_pedido_tree" model="ir.ui.view">
    <field name="name">control.pedido.tree</field>
    <field name="model">control.pedido</field>
    <field name="arch" type="xml">
      <list decoration-danger="area == 'AREA NO CONOCIDA'" create="0">
        <field name="fecha"/>
        <field name="fecoc"/>
        <field name="numordped"/>
        <field name="num_days"/>
        <field name="area"/>
        <field name="process"/>
        <field name="state" widget="badge" decoration-danger="state == 'de'" decoration-info="state == 'on'" decoration-success="state == 'do'"/>
        <field name="tipoventa" optional="hide"/>
      </list>
    </field>
  </record>

  <!-- ============ Cabecera: Form (TODOS los campos) ============ -->
  <record id="view_control_pedido_form" model="ir.ui.view">
    <field name="name">control.pedido.form</field>
    <field name="model">control.pedido</field>
    <field name="arch" type="xml">
      <form string="Pedido control">
        <header>
          <!-- Se ejecuta con el cron pero dejo el boton por si se necesita hacer algo manualmente -->
          <!-- <button name="action_sync_from_dbf" type="object" string="Sincronizar desde DBF" class="btn-primary"/> -->
          <button name="settle_order" type="object" string="Liquidar Orden" class="btn-primary" invisible="state == 'se'"/>
          <button name="settle_order" type="object" string="Revertir Liquidación" class="btn-primary" invisible="state != 'se'"/>
          <field name="state" widget="statusbar"/>
        </header>

        <sheet>
          <div class="oe_title">
            <h1>
              <field name="numordped" readonly="1"/>
            </h1>
          </div>
          <group>
            <group>
              <field name="fecha" readonly="1"/>
              <field name="fecoc" readonly="1"/>
              <field name="customer" readonly="1" groups="sales_team.group_sale_manager"/>
              <field name="salesman" readonly="1" groups="sales_team.group_sale_manager"/>
              <field name="tipoventa" readonly="1"/>
            </group>
            <group>
              <field name="num_days"/>
              <field name="process"/>
              <field name="area"/>
              <field name="total_weight" readonly="1"/>
              <field name="produced_weight" readonly="1"/>
            </group>
          </group>

          <notebook>
            <page string="Detalle">
              <field name="line_ids" readonly="1">
                <list decoration-danger="process == 'SIN AVANCE'">
                  <field name="route"/>
                  <field name="barcodreo"/>
                  <field name="batch"/>
                  <field name="kilograms" sum="Total"/>
                  <field name="process"/>
                  <field name="area"/>
                  <field name="start_date"/>
                  <field name="end_date"/>
                  <field name="colorcode"/>
                  <field name="colorname"/>
                </list>
              </field>
            </page>

          </notebook>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="control_pedido_view_search" model="ir.ui.view">
      <field name="name">control.pedido.view.search</field>
      <field name="model">control.pedido</field>
      <field name="arch" type="xml">
          <search string="Search">
              <field name="numordped"/>
              <field name="area"/>
              <field name="process"/>
              <field name="state"/>
              <field name="line_ids" string="Color Code" filter_domain="[('line_ids.colorcode', 'ilike', self)]"/>
              <field name="line_ids" string="Color Name" filter_domain="[('line_ids.colorname', 'ilike', self)]"/>
              <filter name="not_done" string="Active" domain="[('state', 'in', ['de','on'])]"/>
              <filter name="done" string="Done" domain="[('state', '=', 'do')]"/>
              <filter name="settle" string="Settle" domain="[('state', '=', 'se')]"/>
              <group>
                  <filter string="Customer" name="group_by_customer" domain="[]" context="{'group_by': 'customer'}"/>
                  <filter string="Salesman" name="group_by_salesman" domain="[]" context="{'group_by': 'salesman'}"/>
                  <filter string="Area" name="group_by_area" domain="[]" context="{'group_by': 'area'}"/>
                  <filter string="Process" name="group_by_process" domain="[]" context="{'group_by': 'process'}"/>
                  <filter string="State" name="group_by_state" domain="[]" context="{'group_by': 'state'}"/>
              </group>
          </search>
      </field>
  </record>

  <!-- ============ Action / Menu ============ -->
  <record id="action_control_pedido" model="ir.actions.act_window">
    <field name="name">Pedidos control</field>
    <field name="res_model">control.pedido</field>
    <field name="view_mode">list,form</field>
    <field name="context">{"search_default_not_done":1}</field>
  </record>

  <menuitem id="menu_control_pedidos" name="Control de Pedidos" parent="sale.sale_order_menu" sequence="40" action="action_control_pedido"/>
</odoo>