<odoo>
  <!-- ============ Cabecera: Tree ============ -->
  <record id="view_control_pedido_tree" model="ir.ui.view">
    <field name="name">control.pedido.tree</field>
    <field name="model">control.pedido</field>
    <field name="arch" type="xml">
      <list decoration-danger="area == 'AREA NO CONOCIDA'" create="0">
        <field name="fecha"/>
        <field name="fecoc"/>
        <field name="numordped"/>
        <field name="customer" optional="hide"/>
        <field name="salesman" optional="hide"/>
        <field name="tipoventa" optional="hide"/>
        <field name="num_days"/>
        <field name="area"/>
        <field name="process"/>
        <field name="state" widget="badge" decoration-danger="state == 'de'" decoration-info="state == 'on'" decoration-success="state == 'do'"/>
      </list>
    </field>
  </record>
  <!-- ============ Cabecera: Tree ============ -->
  <record id="view_control_pedido_line_tree" model="ir.ui.view">
    <field name="name">control.pedido.line.tree</field>
    <field name="model">control.pedido.line</field>
    <field name="arch" type="xml">
      <list decoration-danger="area == 'AREA NO CONOCIDA'" create="0">
        <field name="batch"/>
        <field name="pedido_id"/>
        <field name="route"/>
        <field name="description"/>
        <field name="barcodreo"/>
        <field name="process"/>
        <field name="area"/>
        <field name="kilograms"/>
      </list>
    </field>
  </record>

  <!-- ============ Cabecera: Form (TODOS los campos) ============ -->
  <record id="view_control_pedido_form" model="ir.ui.view">
    <field name="name">control.pedido.form</field>
    <field name="model">control.pedido</field>
    <field name="arch" type="xml">
      <form string="Pedido control">
        <header>
          <!-- Se ejecuta con el cron pero dejo el boton por si se necesita hacer algo manualmente -->
          <button name="action_sync_from_dbf" type="object" string="Sincronizar desde DBF" class="btn-primary"/>
          <button name="settle_order" type="object" string="Liquidar Orden" class="btn-primary" invisible="state == 'se'"/>
          <button name="settle_order" type="object" string="Revertir Liquidación" class="btn-primary" invisible="state != 'se'"/>
          <field name="state" widget="statusbar"/>
        </header>

        <sheet>
          <div class="oe_title">
            <h1>
              <field name="numordped" readonly="1"/>
            </h1>
          </div>
          <group>
            <group>
              <field name="fecha" readonly="1"/>
              <field name="fecoc" readonly="1"/>
              <field name="customer" readonly="1"/>
              <field name="salesman" readonly="1"/>
              <field name="tipoventa" readonly="1"/>
            </group>
            <group>
              <field name="num_days"/>
              <field name="process"/>
              <field name="area"/>
              <field name="total_weight" readonly="1"/>
              <field name="produced_weight" readonly="1"/>
            </group>
          </group>

          <notebook>
            <page string="Detalle">
              <field name="line_ids" readonly="1">
                <list decoration-danger="process == 'SIN AVANCE'">
                  <field name="route"/>
                  <field name="barcodreo"/>
                  <field name="batch"/>
                  <field name="kilograms" sum="Total"/>
                  <field name="process"/>
                  <field name="area"/>
                  <field name="start_date"/>
                  <field name="end_date"/>
                  <field name="colorcode"/>
                  <field name="colorname"/>

                  <!-- BOTONES -->
                  <button name="action_start_process"
                          type="object"
                          string="Iniciar"
                          class="btn-primary"
                          invisible="start_date"/>

                  <button name="action_end_process"
                          type="object"
                          string="Finalizar"
                          class="btn-success"
                          invisible="not start_date or end_date"/>
                </list>
              </field>
            </page>

          </notebook>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <!-- ============ Cabecera: Form (TODOS los campos) ============ -->
  <record id="view_control_pedido_line_form" model="ir.ui.view">
    <field name="name">control.pedido.line.form</field>
    <field name="model">control.pedido.line</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <div class="oe_title">
            <h1>
              <field name="batch" readonly="1"/>
            </h1>
          </div>
          <group>
            <group>
              <field name="pedido_id" readonly="1"/>
              <field name="route" readonly="1"/>
              <field name="barcodreo" readonly="1"/>
              <field name="description" readonly="1"/>
              <field name="process" readonly="1"/>
              <field name="area" readonly="1"/>
            </group>
            <group>
              <field name="kilograms" readonly="1"/>
              <field name="start_date" readonly="1"/>
              <field name="end_date" readonly="1"/>
              <field name="colorcode" readonly="1"/>
              <field name="colorname" readonly="1"/>
            </group>
          </group>
          <notebook>
            <page string="Procesos">
              <field name="proceso_ids">
                <list decoration-success="barFasDTF" delete="0" editable="top" edit="0">

                  <field name="barcod"/>
                  <field name="barOrdLin"/>

                  <!-- Editable solo si no ha iniciado -->
                  <field name="fasCod"/>

                  <field name="maqCodBis"/>

                  <field name="barFasDTI"/>
                  <field name="barFasDTF"/>

                  <field name="previous_finished" column_invisible="1"/>

                  <!-- BOTON EDITAR -->
                  <button name="action_edit_process"
                          type="object"
                          string="Editar"
                          class="btn-secondary"
                          invisible="barFasDTI != False or barFasDTF != False or previous_finished == False"/>

                  <!-- BOTON INICIAR -->
                  <button name="action_start_with_wizard"
                          type="object"
                          string="Iniciar"
                          class="btn-primary"
                          invisible="barFasDTI != False or barFasDTF != False or previous_finished == False"/>

                  <!-- BOTON FINALIZAR -->
                  <button name="action_finish"
                          type="object"
                          string="Finalizar"
                          class="btn-success"
                          invisible="barFasDTI == False or barFasDTF != False"/>

                </list>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

