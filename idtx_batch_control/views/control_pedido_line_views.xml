<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_control_pedido_line_tree" model="ir.ui.view">
        <field name="name">control.pedido.line.tree</field>
        <field name="model">control.pedido.line</field>
        <field name="arch" type="xml">

        <list decoration-danger="process == 'SIN AVANCE'" create="0" edit="0" delete="0">
            <field name="pedido_id"/>
            <field name="route"/>
            <field name="batch"/>
            <field name="codpro"/>
            <field name="description"/>
            <field name="process"/>
            <field name="area"/>
            <field name="rollos"/>
            <field name="kilograms" sum="Total"/>
            <field name="start_date"/>
            <field name="end_date"/>
        </list>
    
            <!-- <list decoration-danger="area == 'AREA NO CONOCIDA'" create="0">
                <field name="batch"/>
                <field name="pedido_id"/>
                <field name="route"/>
                <field name="description"/>
                <field name="barcodreo"/>
                <field name="process"/>
                <field name="area"/>
                <field name="rollos"/>
                <field name="kilograms" sum="Total"/>
            </list> -->
        </field>
    </record>

    <record id="view_control_proceso_lines_tree" model="ir.ui.view">
        <field name="name">control.proceso.lines.tree</field>
        <field name="model">control.proceso.lines</field>
        <field name="arch" type="xml">
            <list create="0" delete="0">
                <field name="barOrdLin"/>
                <field name="pedido_line_id"/>
                <field name="fasCod"/>
                <field name="maqCodBis"/>
                <field name="state" widget="badge" 
                       decoration-success="state == 'done'" 
                       decoration-warning="state == 'in_progress'"
                       decoration-info="state == 'ready'"
                       decoration-muted="state == 'pending'"/>
                <field name="barFasDTI"/>
                <field name="barFasDTF"/>
                <field name="operator_name" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_control_pedido_line_form" model="ir.ui.view">
        <field name="name">control.pedido.line.form</field>
        <field name="model">control.pedido.line</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open_start_wizard" type="object" string="Iniciar Partida" class="btn-primary" invisible="start_date"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="batch" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="pedido_id" readonly="1"/>
                            <field name="route" readonly="1"/>
                            <field name="barcodreo" readonly="1"/>
                            <field name="codpro" readonly="1"/>
                            <field name="description" readonly="1"/>
                            <field name="process" readonly="1"/>
                            <field name="area" readonly="1"/>
                        </group>
                        <group>
                            <field name="rollos" readonly="1"/>
                            <field name="kilograms" readonly="1"/>
                            <field name="start_date" readonly="1"/>
                            <field name="end_date" readonly="1"/>
                            <field name="colorcode" readonly="1"/>
                            <field name="colorname" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Procesos">
                            <field name="proceso_ids">
                                <list delete="0" edit="0">
                                    <field name="barOrdLin"/>
                                    <field name="fasCod"/>
                                    <field name="maqCodBis"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'done'" 
                                           decoration-warning="state == 'in_progress'"
                                           decoration-info="state == 'ready'"
                                           decoration-muted="state == 'pending'"/>
                                    <field name="barFasDTI"/>
                                    <field name="barFasDTF"/>
                                    <field name="operator_name" widget="badge"/>
                                    <field name="previous_finished" column_invisible="1"/>
                                    
                                    <button name="action_edit_process" type="object" icon="fa-edit" class="btn-secondary" 
                                            invisible="state != 'ready'" title="edit"/>
                                    
                                    <button name="action_start_with_wizard" type="object" icon="fa-play" class="btn-primary" 
                                            invisible="state != 'ready'" title="play"/>
                                            
                                    <button name="action_finish" type="object" confirm="¿Estás seguro de finalizar el proceso?" icon="fa-check" class="btn-success" 
                                            invisible="state != 'in_progress'" title="finalizar"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="control_pedido_line_view_search" model="ir.ui.view">
        <field name="name">control.pedido.line.view.search</field>
        <field name="model">control.pedido.line</field>
        <field name="arch" type="xml">
            <search string="Search Control Pedido Line">
                <field name="batch"/>
                <field name="pedido_id"/>
                <field name="route"/>
                <field name="codpro"/>
                <field name="description"/>
                <field name="colorcode"/>
                <field name="colorname"/>
                <group>
                    <filter string="Pedido" name="group_by_pedido_id" domain="[]" context="{'group_by': 'pedido_id'}"/>
                    <filter string="Producto" name="group_by_codpro" domain="[]" context="{'group_by': 'codpro'}"/>
                    <filter string="Descripción" name="group_by_description" domain="[]" context="{'group_by': 'description'}"/>
                    <filter string="Batch" name="group_by_batch" domain="[]" context="{'group_by': 'batch'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_control_partida" model="ir.actions.act_window">
        <field name="name">Partidas</field>
        <field name="res_model">control.pedido.line</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
