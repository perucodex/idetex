<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_control_pedido_line_tree" model="ir.ui.view">
        <field name="name">control.pedido.line.tree</field>
        <field name="model">control.pedido.line</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="pedido_id"/>
                <field name="route"/>
                <field name="batch"/>
                <field name="codpro"/>
                <field name="description"/>
                <field name="num_days"/>
                <field name="process"/>
                <field name="next_process"/>
                <field name="area"/>
                <field name="rollos"/>
                <field name="kilograms" sum="Total"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="state" widget="badge" decoration-success="state == 'active'" decoration-danger="state == 'completed'"/>
            </list>
        </field>
    </record>

    <record id="view_control_pedido_line_tree_non_compliant" model="ir.ui.view">
        <field name="name">control.pedido.line.tree</field>
        <field name="model">control.pedido.line</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="batch"/>
                <field name="customer"/>
                <field name="description"/>
                <field name="colorname"/>
                <field name="to_reprocess" sum="Total"/>
                <field name="motivo1"/>
                <field name="area1"/>
                <field name="report_date"/>
                <field name="num_days"/>
                <field name="change_date"/>
                <field name="area_num_days"/>
                <field name="area"/>
                <field name="next_process"/>
                <field name="state" widget="badge" decoration-success="state == 'active'" decoration-danger="state == 'completed'"/>
            </list>
        </field>
    </record>

    <record id="view_control_proceso_lines_tree" model="ir.ui.view">
        <field name="name">control.proceso.lines.tree</field>
        <field name="model">control.proceso.lines</field>
        <field name="arch" type="xml">
            <list create="0" delete="0">
                <field name="barOrdLin"/>
                <field name="pedido_line_id"/>
                <field name="fasCod"/>
                <field name="maqCodBis"/>
                <field name="state" widget="badge" 
                       decoration-success="state == 'done'" 
                       decoration-warning="state == 'in_progress'"
                       decoration-info="state == 'ready'"
                       decoration-muted="state == 'pending'"/>
                <field name="barFasDTI"/>
                <field name="barFasDTF"/>
                <field name="operator_name" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_control_pedido_line_form" model="ir.ui.view">
        <field name="name">control.pedido.line.form</field>
        <field name="model">control.pedido.line</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open_start_wizard" type="object" string="Iniciar Partida" class="btn-primary" invisible="start_date"/>
                    <field name="state" widget="statusbar" statusbar_visible="active,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="batch" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="pedido_id" readonly="1"/>
                            <field name="route" readonly="1"/>
                            <field name="barcodreo" readonly="1"/>
                            <field name="codpro" readonly="1" invisible="product_id"/>
                            <field name="description" readonly="1" invisible="product_id"/>
                            <field name="product_id" readonly="1" invisible="not product_id"/>
                            <field name="process" readonly="1"/>
                            <field name="area" readonly="1"/>
                        </group>
                        <group>
                            <field name="rollos" readonly="1"/>
                            <field name="kilograms" readonly="1"/>
                            <field name="start_date" readonly="1"/>
                            <field name="end_date" readonly="1"/>
                            <field name="colorcode" readonly="1" invisible="lab_dev_line_id"/>
                            <field name="colorname" readonly="1" invisible="lab_dev_line_id"/>
                            <!-- <field name="lab_dev_line_id" readonly="1" invisible="not lab_dev_line_id"/> -->
                            <field name="colorfastness_id" readonly="1" invisible="not colorfastness_id"/>
                            <field name="density_stability_twisting_id" readonly="1" invisible="not density_stability_twisting_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Procesos">
                            <field name="proceso_ids">
                                <list delete="0" edit="0">
                                    <field name="barOrdLin"/>
                                    <field name="fasCod"/>
                                    <field name="maqCodBis"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'done'" 
                                           decoration-warning="state == 'in_progress'"
                                           decoration-info="state == 'ready'"
                                           decoration-muted="state == 'pending'"/>
                                    <field name="barFasDTI"/>
                                    <field name="barFasDTF"/>
                                    <field name="operator_name" widget="badge"/>
                                    <field name="previous_finished" column_invisible="1"/>
                                    
                                    <button name="action_edit_process" type="object" icon="fa-edit" class="btn-secondary" 
                                            invisible="state != 'ready'" title="edit" groups="mrp.group_mrp_manager"/>
                                    
                                    <button name="action_start_with_wizard" type="object" icon="fa-play" class="btn-primary" 
                                            invisible="state != 'ready'" title="play" groups="mrp.group_mrp_manager"/>
                                            
                                    <button name="action_finish" type="object" confirm="¿Estás seguro de finalizar el proceso?" icon="fa-check" class="btn-success" 
                                            invisible="state != 'in_progress'" title="finalizar" groups="mrp.group_mrp_manager"/>
                                </list>
                            </field>
                        </page>
                        <page string="Informe" invisible="not report_date and not obsctrl">
                            <group>
                                <field name="report_date" readonly="1"/>
                                <field name="motivo" readonly="1" invisible="not motivo"/>
                                <field name="area_num_days" readonly="1"/>
                                <field name="motivo1" readonly="1" invisible="not motivo1"/>
                                <field name="area1" readonly="1" invisible="not area1"/>
                            </group>
                            <field name="obsctrl" readonly="1" nolabel="1" widget="text" placeholder="Sin observaciones registradas en ctrl_info"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="control_pedido_line_view_search" model="ir.ui.view">
        <field name="name">control.pedido.line.view.search</field>
        <field name="model">control.pedido.line</field>
        <field name="arch" type="xml">
            <search string="Search Control Pedido Line">
                <field name="batch"/>
                <field name="pedido_id"/>
                <field name="route"/>
                <field name="codpro"/>
                <field name="description"/>
                <field name="colorcode"/>
                <field name="colorname"/>
                <filter string="Active" name="active" domain="[('state', '=', 'active')]"/>
                <filter string="Completed" name="completed" domain="[('state', '=', 'completed')]"/>
                <filter string="Reproceso" name="reproceso"
                        domain="[('motivo', '=', 'REPROCESO'), ('state', '=', 'active')]"/>
                <filter string="Reposición" name="reposicion" 
                        domain="[('motivo', '=', 'REPOSICION'), ('state', '=', 'active')]"/>
                <group>
                    <filter string="Pedido" name="group_by_pedido_id" domain="[]" context="{'group_by': 'pedido_id'}"/>
                    <filter string="Producto" name="group_by_codpro" domain="[]" context="{'group_by': 'codpro'}"/>
                    <filter string="Descripción" name="group_by_description" domain="[]" context="{'group_by': 'description'}"/>
                    <filter string="Batch" name="group_by_batch" domain="[]" context="{'group_by': 'batch'}"/>
                    <filter string="Area" name="group_by_area" domain="[]" context="{'group_by': 'area'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_control_pedido_line_set_completed" model="ir.actions.server">
        <field name="name">Marcar como Completada</field>
        <field name="model_id" ref="model_control_pedido_line"/>
        <field name="binding_model_id" ref="model_control_pedido_line"/>
        <field name="binding_view_types">form,list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_set_completed()</field>
    </record>

    <record id="action_control_pedido_line_set_active" model="ir.actions.server">
        <field name="name">Marcar como Activa</field>
        <field name="model_id" ref="model_control_pedido_line"/>
        <field name="binding_model_id" ref="model_control_pedido_line"/>
        <field name="binding_view_types">form,list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_set_active()</field>
    </record>

    <record id="action_control_partida" model="ir.actions.act_window">
        <field name="name">Partidas</field>
        <field name="res_model">control.pedido.line</field>
        <field name="view_mode">list,form</field>
        <field name="context">{"search_default_active": 1}</field>
    </record>

    <record id="action_control_partida_non_compliant" model="ir.actions.act_window">
        <field name="name">No conformes</field>
        <field name="res_model">control.pedido.line</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_control_pedido_line_tree_non_compliant"/>
        <field name="context">{"search_default_reproceso": 1, "search_default_group_by_area": 1}</field>
    </record>

</odoo>
