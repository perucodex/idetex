                </search>
            </field>
        </record> -->

        <record id="mrp_base_process_action" model="ir.actions.act_window">
            <field name="name">Mrp Base Operations</field>
            <field name="res_model">mrp.base.process</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="mrp_base_process_tree_view"/>
        </record>

        <!-- <record id="mrp_base_process_line_action" model="ir.actions.act_window">
