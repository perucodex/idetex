<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="mrp_base_process_form_view" model="ir.ui.view">
            <field name="name">mrp.base.process.form</field>
            <field name="model">mrp.base.process</field>
            <field name="arch" type="xml">
                <form string="Routing Work Centers Operations" duplicate="false">
                    <header>
                        <button name="action_open_duplicate_form" type="object"
                                string="Duplicar"
                                invisible="not id"
                                help="Abre un nuevo proceso prellenado con las lineas de este. Tienes que modificar al menos una linea para que pase el constraint de composicion unica."/>
                    </header>
                    <sheet>
                        <div name="button_box" class="oe_button_box">
                            <button name="action_view_products"
                                    type="object"
                                    class="oe_stat_button"
                                    icon="fa-dropbox"
                                    invisible="product_count == 0">
                                <field name="product_count" widget="statinfo" string="Productos"/>
                            </button>
                        </div>
                        <div class="oe_title">
                            <h1>
                                <field name="name"/>
                            </h1>
                        </div>
                        <notebook>
                            <page name="line_page" string="Process">
                                <field name="process_ids">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="operation_id"/>
                                        <field name="general_machine_id"/>
                                    </list> 
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="mrp_base_process_tree_view" model="ir.ui.view">
            <field name="name">mrp.base.process.list</field>
            <field name="model">mrp.base.process</field>
            <field name="arch" type="xml">
                <list string="Mrp Base Process" multi_edit="1">
                    <field name="name"/>
                    <field name="product_count" string="Productos" sum="Total"
                           optional="show"/>
                </list>
            </field>
        </record>

        <record id="mrp_base_process_view_search" model="ir.ui.view">
            <field name="name">mrp.base.process.view.search</field>
            <field name="model">mrp.base.process</field>
            <field name="arch" type="xml">
                <search string="">
                    <field name="name"/>
                    <!-- Picks a specific operation from the autocomplete dropdown. -->
                    <field name="operation_ids" string="Fase"/>
                    <!-- Free-text fallback: ilike on operation name or fas_code. -->
                    <field name="process_ids" string="Fase (texto)"
                           filter_domain="['|',
                                           ('process_ids.operation_id.name', 'ilike', self),
                                           ('process_ids.operation_id.fas_code', 'ilike', self)]"/>
                </search>
            </field>
        </record>

