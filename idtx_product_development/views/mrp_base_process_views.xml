            <field name="name">mrp.base.process.line.list</field>
            <field name="model">mrp.base.process.line</field>
            <field name="arch" type="xml">
                <list string="Mrp Base Process Line" editable="top">
                    <field name="operation_id"/>
                </list>
            </field>
        </record> -->

