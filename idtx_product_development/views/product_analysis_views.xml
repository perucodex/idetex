<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="product_analysis_form_view" model="ir.ui.view">
            <field name="name">product.analysis.form</field>
            <field name="model">product.analysis</field>
            <field name="arch" type="xml">
                <form string="Product Analysis">
                    <header>
                        <!-- <button name="action_done" type="object" string="Done" class="oe_highlight" invisible="state != 'test'"/> -->
                        <button name="action_create_technical_sheet" type="object" string="Create Technical Sheet" class="oe_highlight" invisible="state != 'prod'" confirm="Are you sure you want to create the technical sheet ?"/>
                        <button name="action_product" type="object" string="Create Product" class="oe_highlight" invisible="state != 'test' or product_id" confirm="Are you sure you want to create the product ?"/>
                        <button name="action_return" type="object" string="Return" invisible="state == 'test' or technical_sheet_ids"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div name="button_box" class="oe_button_box">
                            <button name="open_product"
                                    class="oe_stat_button"
                                    icon="fa-dropbox"
                                    type="object"
                                    invisible="not product_id" string="Product"/>
                            <button name="open_tech"
                                    class="oe_stat_button"
                                    icon="fa-microchip"
                                    type="object"
                                    invisible="technical_sheet_count == 0">
                                    <field name="technical_sheet_count" widget="statinfo" string="Technical Sheets"/>
                            </button>
                        </div>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="analysis_date" required="1" readonly="state != 'test'"/>
                                <field name="partner_id" required="1" readonly="state != 'test'"/>
                                <field name="product_description" required="1" readonly="state != 'test'"/>
                                <field name="product_family_id" required="1" options="{'no_create': True, 'no_open': True}" readonly="state != 'test'"/>
                                <field name="product_appearance_id" required="1" options="{'no_create': True, 'no_open': True}" readonly="state != 'test'"/>
                                <field name="product_fiber_id" required="1" options="{'no_create': True, 'no_open': True}" readonly="state != 'test'"/>
                                <field name="product_title_id" required="1" options="{'no_create': True, 'no_open': True}" readonly="state != 'test'"/>
                                <field name="weave_type" required="1" readonly="state != 'test'"/>
                            </group>
                            <group>
                                <field name="gauge_id" required="1" options="{'no_open': True}" readonly="state != 'test'"/>
                                <field name="needles" readonly="state != 'test'"/>
                                <field name="diameter" readonly="state != 'test'"/>
                                <field name="feeders" readonly="state != 'test'"/>
                                <label for="density"/>
                                <div name="density" class="o_row">
                                    <field name="density" required="1" readonly="state != 'test'"/>
                                    <span class="ms-1 oe_inline">g/m²</span>
                                </div>
                                <field name="column_qty" readonly="state != 'test'"/>
                                <label for="width"/>
                                <div name="width" class="o_row">
                                    <field name="width" readonly="1" force_save="1"/>
                                    <span class="ms-1 oe_inline">cm</span>
                                </div>
                                <label for="standard_width"/>
                                <div name="standard_width" class="o_row">
                                    <field name="standard_width" required="1" readonly="state != 'test'"/>
                                    <span class="ms-1 oe_inline">cm</span>
                                </div>
                                <field name="product_code" readonly="1" force_save="1"/>
                                <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                            </group>
                        </group>
                        <label for="notes"/>
                        <field name="notes"/>
                        <notebook>
                            <page name="weaving_data_page" string="Weaving Data">
                                <field name="weaving_data_ids" readonly="state != 'prod'"/>
                            </page>
                            <page name="routing_page" string="Routing" readonly="state != 'test'">
                                <group string="Routing Template">
                                    <field name="mrp_base_process_id" readonly="state != 'test'"/>
                                </group>
                                <field name="routing_ids" readonly="state != 'test'">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="operation_id"/>
                                        <field name="workcenter_id"/>
                                    </list>
                                </field>
                            </page>
                            <page name="ligament_page" string="Ligament Design Structure">
                                <group>
                                    <group>
                                        <field name="ligament_row" readonly="state != 'test'"/>
                                        <field name="ligament_column" readonly="state != 'test'"/>
                                        <field name="grid_data" invisible="1" force_save="1"/>
                                        <button string="Generate" name="action_generate" type="object" class="oe_highlight" invisible="state != 'test'"/>
                                    </group>                                    
                                </group>
                                <div class="o_grid_ligament_widget_container">
                                    <field name="ligament_join_row_column" widget="grid_ligament_widget" readonly="state != 'test'"/>
                                </div>
                            </page>
                            <page name="other_page" string="Other Information">
                                <group>
                                    <group>
                                        <field name="user_id" readonly="state != 'test'"/>
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="product_analysis_tree_view" model="ir.ui.view">
            <field name="name">product.analysis.list</field>
            <field name="model">product.analysis</field>
            <field name="arch" type="xml">
                <list string="Product Analysis">
                    <field name="name"/>
                    <field name="analysis_date"/>
                    <field name="partner_id"/>
                    <field name="product_description"/>
                    <field name="gauge_id"/>
                    <field name="width"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="state" widget="badge" decoration-success="state == 'prod'"/>
                </list>
            </field>
        </record>

        <record id="product_analysis_view_search" model="ir.ui.view">
            <field name="name">product.analysis.view.search</field>
            <field name="model">product.analysis</field>
            <field name="arch" type="xml">
                <search string="Search Product Analysis">
                    <field name="name"/>
                    <field name="product_id"/>
                    <field name="partner_id"/>
                    <field name="product_description"/>
                    <field name="analysis_date"/>
                    <field name="gauge_id"/>
                    <field name="density"/>
                    <filter name="test" string="Test" domain="[('state','=','test')]"/>
                    <filter name="prod" string="Product" domain="[('state','=','prod')]"/>
                    <!-- <filter name="tech" string="Technical Sheet" domain="[('state','=','tech')]"/> -->
                    <group>
                        <filter string="Analysis Date" name="group_by_analysis_date" domain="[]" context="{'group_by': 'analysis_date'}"/>
                        <filter string="Product" name="group_by_product" domain="[]" context="{'group_by': 'product_id'}"/>
                        <filter string="Customer" name="group_by_partner" domain="[]" context="{'group_by': 'partner_id'}"/>
                        <filter string="Product Description" name="group_by_product_description" domain="[]" context="{'group_by': 'product_description'}"/>
                        <filter string="Gauge" name="group_by_gauge_id" domain="[]" context="{'group_by': 'gauge_id'}"/>
                        <filter string="Density" name="group_by_density" domain="[]" context="{'group_by': 'density'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="analysis_weaving_data_view_form" model="ir.ui.view">
            <field name="name">analysis.weaving.data.view.form</field>
            <field name="model">analysis.weaving.data</field>
            <field name="arch" type="xml">
                <form string="Weaving Data">
                    <header>
                        <!-- <button name="action_create_technical_sheet" type="object" string="Create Technical Sheet" class="oe_highlight" invisible="technical_sheet_id"/> -->
                        <button name="open_tech" type="object" string="Open Technical Sheet" class="oe_highlight" invisible="not technical_sheet_id"/>
                        <button name="print_analysis_report" type="object" icon="fa-print" string="Print Analysis"/>
                    </header>
                    <sheet>
                        <group>    
                            <group>
                                <field name="partner_id"/>
                                <field name="stylo"/>
                            </group>
                            <group>
                                <field name="technical_sheet_id" readonly="1" invisible="not technical_sheet_id"/>
                            </group>
                            <label for="notes"/>
                            <field name="notes"/>
                        </group>
                        <notebook>
                            <page name="fibers_page" string="Fibers">
                                <field name="fiber_ids">
                                    <list>
                                        <field name="sequence" widget="handle"/>
                                        <field name="system_type"/>
                                        <field name="length"/>
                                        <field name="weight"/>
                                        <field name="thread_title"/>
                                        <field name="product_template_id"/>
                                        <field name="ligament_id"/>
                                        <field name="percentage" widget="percentage"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="analysis_weaving_data_view_tree" model="ir.ui.view">
            <field name="name">analysis.weaving.data.view.tree</field>
            <field name="model">analysis.weaving.data</field>
            <field name="arch" type="xml">
                <list>
                    <field name="partner_id"/>
                    <field name="stylo"/>
                    <field name="technical_sheet_id"/>
                </list>
            </field>
        </record>

        <record id="analysis_fibe_form_view" model="ir.ui.view">
            <field name="name">analysis.fiber.form</field>
            <field name="model">analysis.fiber</field>
            <field name="arch" type="xml">
                <form string="Analysis Fiber">
                    <sheet>
                        <group>
                            <group>
                                <field name="system_type"/>
                                <field name="length"/>
                                <field name="weight"/>
                                <field name="thread_qty"/>
                            </group>
                            <group>
                                <field name="thread_title"/>
                                <field name="product_template_id" options="{'no_create': True, 'no_open': True}"/>
                                <field name="ligament_id"/>
                            </group>
                        </group>
                        <notebook>
                            <page name="measurements_page" string="Measures">
                                <field name="line_ids">
                                    <list editable="bottom">
                                        <field name="length"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="analysis_fiber_tree_view" model="ir.ui.view">
            <field name="name">analysis.fiber.list</field>
            <field name="model">analysis.fiber</field>
            <field name="arch" type="xml">
                <list string="Fibers">
                    <field name="system_type"/>
                    <field name="length"/>
                    <field name="weight"/>
                    <field name="thread_title"/>
                    <field name="product_template_id"/>
                    <field name="ligament_id"/>
                    <field name="percentage" widget="percentage"/>
                </list>
            </field>
        </record>

        <record id="analysis_routing_line_tree_view" model="ir.ui.view">
            <field name="name">analysis.routing.line.list</field>
            <field name="model">analysis.routing.line</field>
            <field name="arch" type="xml">
                <list string="Routing Lines">
                    <field name="analysis_id"/>
                    <field name="operation_id"/>
                    <field name="workcenter_id"/>
                </list>
            </field>
        </record>

        <record id="product_analysis_action" model="ir.actions.act_window">
            <field name="name">Product Analysis</field>
            <field name="res_model">product.analysis</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="product_analysis_tree_view"/>
            <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                Create a new Product Analysis
              </p><p>
                Product Analysis define that need to be done to realize a Technical Sheet.
                Each analysis is done from customer samples.
              </p>
            </field>
        </record>

    </data>
</odoo>
