<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="technical_sheet_form_view" model="ir.ui.view">
            <field name="name">technical.sheet.form</field>
            <field name="model">technical.sheet</field>
            <field name="arch" type="xml">
                <form string="Technical Sheet">
                    <header>
                        <button name="action_done" type="object" string="Done" class="oe_highlight" invisible="state != 'draft'"/>
                        <!-- <button name="action_create_technical_sheet" type="object" string="Create Technical Sheet" class="oe_highlight" invisible="state != 'done'" confirm="Are you sure you want to create the technical sheet ?"/> -->
                        <!-- <button name="action_product" type="object" string="Create Product" class="oe_highlight" invisible="state != 'done'" confirm="Are you sure you want to create the product ?"/> -->
                        <button string="Print" name="idtx_product_development.action_report_technical_sheet" type="action" data-hotkey="i" invisible="state != 'done'"/>
                        <button name="action_return" type="object" string="Return" invisible="state == 'draft' or product_id"/>
                        <!-- <button name="action_fetch_from_mysql" type="object" string="Covatex" class="oe_highlight"/> -->
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <!-- <div name="button_box" class="oe_button_box">
                            <button name="open_product"
                                    class="oe_stat_button"
                                    icon="fa-dropbox"
                                    type="object"
                                    invisible="not product_id" string="Product"/>
                        </div> -->
                        <div class="float-end fs-6 border-0" invisible="not production_state">
                            <field name="production_state" widget="badge" readonly="1" decoration-success="production_state == 'Production'" decoration-info="production_state == 'Pilot'" decoration-warning="production_state == 'Sample'"/>
                        </div>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="technical_date" readonly="1"/>
                                <field name="analysis_id" readonly="1"/>
                                <field name="product_code" force_save="1"/>
                                <field name="description" readonly="1"/>
                            </group>
                            <group>
                                <field name="partner_id" readonly="1"/>
                                <field name="bom_id" readonly="1"/>
                            </group>
                        </group>
                        <label for="notes"/>
                        <field name="notes"/>
                        <notebook>
                            <page name="weaving_page" string="Weaving">
                                <group string="Product Data">
                                    <group>
                                        <field name="program" readonly="state != 'draft'" groups="!idtx_product_development.group_module_product_development_manager"/>
                                        <field name="program" groups="idtx_product_development.group_module_product_development_manager"/>
                                        <field name="stylo" readonly="1" force_save="1" groups="!idtx_product_development.group_module_product_development_manager"/>
                                        <field name="stylo" groups="idtx_product_development.group_module_product_development_manager"/>
                                        <field name="fabric_composition" readonly="state != 'draft'" groups="!idtx_product_development.group_module_product_development_manager"/>
                                        <field name="fabric_composition" groups="idtx_product_development.group_module_product_development_manager"/>
                                        <field name="atx" readonly="state != 'draft'" groups="!idtx_product_development.group_module_product_development_manager"/>
                                        <field name="atx" groups="idtx_product_development.group_module_product_development_manager"/>
                                    </group>
                                    <group>
                                        <!-- <field name="first_wash_shrinkage" readonly="state != 'draft'"/>
                                        <field name="first_wash_twist" readonly="state != 'draft'"/> -->
                                        <label for="yield_meter"/>
                                        <div name="yield_meter" class="o_row">
                                            <field name="yield_meter" readonly="state != 'draft'" groups="!idtx_product_development.group_module_product_development_manager"/>
                                            <field name="yield_meter" readonly="state != 'draft'" groups="idtx_product_development.group_module_product_development_manager"/>
                                            <span class="ms-1 oe_inline">m/kg</span>
                                        </div>
                                        <!-- <field name="yield_meter" readonly="state != 'draft'"/> -->
                                        <field name="scrap" widget="percentage" readonly="state != 'draft'"/>
                                        <!-- <field name="mesh_length" readonly="state != 'draft'"/> -->
                                    </group>
                                    <group>
                                        <label for="density"/>
                                        <div name="density" class="o_row">
                                            <field name="density" readonly="1"/>
                                            <span class="ms-1 oe_inline">g/m²</span>
                                        </div>
                                        <label for="width"/>
                                        <div name="width" class="o_row">
                                            <field name="width" readonly="1"/>
                                            <span class="ms-1 oe_inline">cm</span>
                                        </div>
                                    </group>
                                    <group>
                                        <field name="weave_type" readonly="1"/>
                                        <field name="gauge_id" readonly="1"/>
                                    </group>
                                    <group string="Raw Data">
                                        <field name="raw_width" readonly="state != 'draft'" groups="!idtx_product_development.group_module_product_development_manager"/>
                                        <field name="raw_density" readonly="state != 'draft'" groups="!idtx_product_development.group_module_product_development_manager"/>
                                        <field name="raw_widening" readonly="state != 'draft'" groups="!idtx_product_development.group_module_product_development_manager"/>
                                        <field name="raw_width" groups="idtx_product_development.group_module_product_development_manager"/>
                                        <field name="raw_density" groups="idtx_product_development.group_module_product_development_manager"/>
                                        <field name="raw_widening" groups="idtx_product_development.group_module_product_development_manager"/>
                                    </group>
                                    <group string="Finishing Data">
                                        <field name="finish_width" readonly="state != 'draft'" groups="!idtx_product_development.group_module_product_development_manager"/>
                                        <field name="finish_density" readonly="state != 'draft'" groups="!idtx_product_development.group_module_product_development_manager"/>
                                        <field name="finish_yield" readonly="state != 'draft'" groups="!idtx_product_development.group_module_product_development_manager"/>
                                        <field name="finish_width" groups="idtx_product_development.group_module_product_development_manager"/>
                                        <field name="finish_density" groups="idtx_product_development.group_module_product_development_manager"/>
                                        <field name="finish_yield" groups="idtx_product_development.group_module_product_development_manager"/>
                                    </group>
                                </group>
                            </page>
                            <page name="size_chart_page" string="Sizes" invisible="weave_type != 'rect'">
                                <field name="size_chart_ids" readonly="state != 'draft'">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="size"/>
                                        <field name="length"/>
                                        <field name="width"/>
                                        <field name="needles"/>
                                        <field name="ne"/>
                                        <field name="plies"/>
                                        <field name="tubular"/>
                                        <field name="body"/>
                                    </list>
                                </field>
                            </page>
                            <page name="route_page" string="Routing">
                                <field name="route_line_ids" readonly="state != 'draft'" groups="!idtx_product_development.group_module_product_development_manager">
                                    <list>
                                        <field name="sequence" widget="handle"/>
                                        <field name="operation_id"/>
                                        <field name="workcenter_id"/>
                                    </list>
                                    <form>
                                        <group>
                                            <group>
                                                <field name="operation_id" readonly="line_parameter_ids"/>
                                                <field name="workcenter_id"/>
                                            </group>
                                        </group>
                                        <notebook>
                                            <page name="param_page" string="Parameters">
                                                <field name="line_parameter_ids">
                                                    <list editable="bottom">
                                                        <field name="name"/>
                                                        <field name="value"/>
                                                        <field name="is_observation" widget="boolean_toggle"/>
                                                    </list>
                                                </field>
                                            </page>
                                        </notebook>
                                    </form>
                                </field>
                                <field name="route_line_ids" groups="idtx_product_development.group_module_product_development_manager">
                                    <list>
                                        <field name="sequence" widget="handle"/>
                                        <field name="operation_id"/>
                                        <field name="workcenter_id"/>
                                    </list>
                                    <form>
                                        <group>
                                            <group>
                                                <field name="operation_id" readonly="line_parameter_ids"/>
                                                <field name="workcenter_id"/>
                                            </group>
                                        </group>
                                        <notebook>
                                            <page name="param_page" string="Parameters">
                                                <field name="line_parameter_ids">
                                                    <list editable="bottom">
                                                        <field name="name"/>
                                                        <field name="value"/>
                                                        <field name="is_observation" widget="boolean_toggle"/>
                                                    </list>
                                                </field>
                                            </page>
                                        </notebook>
                                    </form>
                                </field>
                            </page>
                            <page name="other_page" string="Other Information">
                                <group>
                                    <group>
                                        <field name="user_id" readonly="state != 'draft'"/>
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="technical_sheet_tree_view" model="ir.ui.view">
            <field name="name">technical.sheet.list</field>
            <field name="model">technical.sheet</field>
            <field name="arch" type="xml">
                <list string="Technical Sheet" create="0">
                    <field name="name"/>
                    <field name="technical_date"/>
                    <field name="product_code"/>
                    <field name="partner_id"/>
                    <field name="program"/>
                    <field name="atx"/>
                    <field name="weave_type"/>
                    <field name="company_id" groups="base.group_multi_company" optional="hide" readonly="1"/>
                    <field name="production_state" widget="badge" decoration-success="production_state == 'Production'" decoration-info="production_state == 'Pilot'" decoration-warning="production_state == 'Sample'"/>
                </list>
            </field>
        </record>

        <record id="technical_sheet_search_view" model="ir.ui.view">
            <field name="name">technical.sheet.list.inherit</field>
            <field name="model">technical.sheet</field>
            <field name="arch" type="xml">
                <search string="Search Technical Sheets">
                    <field name="name"/>
                    <field name="description"/>
                    <field name="analysis_product_family_id"/>
                    <field name="analysis_product_fiber_id"/>
                    <field name="analysis_product_title_id"/>
                    <field name="density"/>
                    <field name="width"/>
                    <field name="production_state"/>
                </search>
            </field>
        </record>

        <record id="technical_sheet_action" model="ir.actions.act_window">
            <field name="name">Technical Sheet</field>
            <field name="res_model">technical.sheet</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="technical_sheet_tree_view"/>
            <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                Create a new Technical Sheet
              </p><p>
                Technical Sheet define that need to be done to realize a Product.
                Each sheet is done from customer samples.
              </p>
            </field>
        </record>

    </data>
</odoo>
