<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="hr_equipment_view_form_inherit" model="ir.ui.view">
            <field name="name">maintenance.equipment.form.inherit</field>
            <field name="model">maintenance.equipment</field>
            <field name="inherit_id" ref="maintenance.hr_equipment_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='warranty_date']" position="after">
                    <field name="maintenance_equipment_type_id"/>
                </xpath>
            </field>
        </record>

        <record id="hr_equipment_type_view_form" model="ir.ui.view">
            <field name="name">maintenance.equipment.type.form.inherit</field>
            <field name="model">maintenance.equipment.type</field>
            <field name="arch" type="xml">
                <list editable="top">
                    <field name="name"/>
                    <field name="needles"/>
                    <field name="gauge_id"/>
                    <field name="diameter"/>
                    <field name="feeders"/>
                </list>
            </field>
        </record>

        <record id="action_maintenance_equipment_type" model="ir.actions.act_window">
            <field name="name">Equipment Type</field>
            <field name="res_model">maintenance.equipment.type</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="hr_equipment_type_view_form"/>
        </record>

    </data>
</odoo>
