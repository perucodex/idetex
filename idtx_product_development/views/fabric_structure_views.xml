<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="view_fabric_structure_form" model="ir.ui.view">
            <field name="name">fabric.structure.form</field>
            <field name="model">fabric.structure</field>
            <field name="arch" type="xml">
                <form string="Fabric Structure">
                    <sheet>
                        <field name="image_palette_data" invisible="1"/>
                        <group>
                            <field name="ligament_ids">
                                <!-- <list>
                                    <field name="ligament_preview" widget="structure_editor" readonly="1"/>
                                    <field name="image_preview_html"/>
                                </list> -->
                                <form>
                                    <field name="ligament_preview" widget="structure_editor" readonly="1"/>
                                </form>
                            </field>
                        </group>
                    </sheet>
                    <field name="image_palette_ids" widget="gallery_palette"/>
                </form>
            </field>
        </record>

        <record id="action_fabric_structure" model="ir.actions.act_window">
            <field name="name">Fabric Structure</field>
            <field name="res_model">fabric.structure</field>
            <field name="view_mode">list,form</field>
        </record> 

    </data>
</odoo>
