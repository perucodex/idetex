<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_form_view_inherit_ld" model="ir.ui.view">
        <field name="name">product.template.form.inherit.ld</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="open_analysis"
                        class="oe_stat_button"
                        icon="fa-microchip"
                        type="object"
                        invisible="technical_sheet_count == 0">
                        <field name="technical_sheet_count" widget="statinfo" string="Technical Sheets"/>
                </button>
            </xpath>
        </field>
    </record>

    <record id="product_template_only_form_view_inherit_ld" model="ir.ui.view">
        <field name="name">product.template.form.inherit.ld</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="priority">10</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='default_code']" position="attributes">
                <attribute name="readonly">is_weaving</attribute>
            </xpath>
            <xpath expr="//field[@name='barcode']" position="attributes">
                <attribute name="readonly">is_weaving</attribute>
            </xpath>
            <field name="product_tooltip" position="after">
                <field name="analysis_id" readonly="1" invisible="not analysis_id"/>
            </field>
        </field>
    </record>
    
    <record id="product_product_action_weaving" model="ir.actions.act_window">
        <field name="name">Weaving</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">kanban,list,form,activity</field>
        <field name="context" eval="{'default_categ_id': ref('product_categ_1'), 'default_is_weaving': True}"/>
        <field name="domain">[('is_weaving', '=', True)]</field>
        <field name="view_id" ref="product.product_template_tree_view"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new weaving product
            </p>
        </field>
    </record>
    
    <record id="product_product_action_thread" model="ir.actions.act_window">
        <field name="name">Thread</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">kanban,list,form,activity</field>
        <field name="context" eval="{'default_categ_id': ref('product_categ_2'), 'default_is_thread': True}"/>
        <field name="domain">[('is_thread', '=', True)]</field>
        <field name="view_id" ref="product.product_template_tree_view"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new thread product
            </p>
        </field>
    </record>

    <record id="product_template_search_view_inherit_ld" model="ir.ui.view">
        <field name="name">product.template.search.inherit.ld</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <filter name="filter_to_sell" position="after">
                <filter string="Weaving" name="filter_weaving" domain="[('is_weaving','=',True)]"/>
                <filter string="Thread" name="filter_thread" domain="[('is_thread','=',True)]"/>
            </filter>
        </field>
    </record>

</odoo>

