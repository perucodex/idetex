<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mrp_workorder_batch_form_inherit" model="ir.ui.view">
        <field name="name">mrp.workorder.batch.form.inherit</field>
        <field name="model">mrp.workorder.batch</field>
        <field name="inherit_id" ref="idtx_mrp.mrp_workorder_batch_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook/page/field[@name='wo_roll_ids']/list/field[@name='uom_id']" position="after">
                <field name="size_id"/>
            </xpath>

            <xpath expr="//notebook/page/field[@name='wo_roll_ids']/form//field[@name='uom_id']" position="after">
                <field name="size_id"/>
            </xpath>
        </field>
    </record>
    
</odoo>