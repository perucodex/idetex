<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="res_config_settings_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.product.development</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="40"/>
            <field name="inherit_id" ref="base.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//form" position="inside">
                    <app data-string="Product Development" string="Product Development" name="idtx_product_development" groups="idtx_product_development.group_module_product_development_manager">
                        <block title="Categories" name="default_dev_categories_setting_container">
                            <setting id="default_categories" string="Default Categories" company_dependent="1" help="Default categories applied when selecting products.">
                                <div class="content-group">
                                    <div class="row mt16">
                                        <label string="Weaving Categories" for="weaving_category_ids" class="col-lg-3 o_light_label"/>
                                        <field name="weaving_category_ids" widget="many2many_tags"/>
                                    </div>
                                </div>
                                <div class="content-group">
                                    <div class="row mt16">
                                        <label string="Thread Categories" for="thread_category_ids" class="col-lg-3 o_light_label"/>
                                        <field name="thread_category_ids" widget="many2many_tags"/>
                                    </div>
                                </div>
                            </setting>
                        </block>
                    </app>
                </xpath>
            </field>
        </record>

        <record id="action_idtx_product_development_config" model="ir.actions.act_window">
            <field name="name">Settings</field>
            <field name="res_model">res.config.settings</field>
            <field name="view_mode">form</field>
            <field name="context">{'module' : 'idtx_product_development', 'bin_size': False}</field>
        </record>

    </data>
</odoo>
