<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="density_stability_twisting_form_view" model="ir.ui.view">
        <field name="name">density.stability.twisting.form</field>
        <field name="model">density.stability.twisting</field>
        <field name="arch" type="xml">
            <form string="Density Stability Twisting">
                <header>
                    <button name="mark_done" type="object" string="Done" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="mark_draft" type="object" string="Draft" class="oe_highlight" invisible="state != 'done'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group string="Stability &amp; Twisting" col="2">
                        <group>
                            <field name="width_shrinkage_from" widget="percentage"/>
                            <field name="width_shrinkage_to" widget="percentage"/>
                            <field name="length_shrinkage_from" widget="percentage"/>
                            <field name="length_shrinkage_to" widget="percentage"/>
                            <field name="twist" widget="percentage"/>
                        </group>
                    </group>
                    <group string="Density and Width" col="2">
                        <group>
                            <field name="density" widget="percentage"/>
                            <field name="width" widget="percentage"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
</odoo>
