<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="density_stability_twisting_form_view" model="ir.ui.view">
        <field name="name">density.stability.twisting.form</field>
        <field name="model">density.stability.twisting</field>
        <field name="arch" type="xml">
            <form string="Density Stability Twisting">
                <header>
                    <button name="mark_done" type="object" string="Done" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="mark_draft" type="object" string="Draft" class="oe_highlight" invisible="state != 'done'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group string="Stability &amp; Twisting" col="2">
                        <group>
                            <div class="o_td_label">
                                <label for="width_shrinkage_from"/>
                            </div>
                            <div class="d-flex">
                                <field name="width_shrinkage_from" widget="percentage"/>
                                <span class="o_form_label mx-3 oe_edit_only text-center" style="width: 6ch;">to</span>
                                <field name="width_shrinkage_to" widget="percentage"/>
                            </div>
                        </group>
                        <group>
                            <div class="o_td_label">
                                <label for="length_shrinkage_from"/>
                            </div>
                            <div class="d-flex">
                                <field name="length_shrinkage_from" widget="percentage"/>
                                <span class="o_form_label mx-3 oe_edit_only text-center" style="width: 6ch;">to</span>
                                <field name="length_shrinkage_to" widget="percentage"/>
                            </div>
                        </group>
                        <group>
                            <div class="o_td_label">
                                <label for="tilt_wash"/>
                            </div>
                            <div class="d-flex">
                                <field name="tilt_wash"/>
                                <span class="o_form_label mx-3 oe_edit_only text-center" style="width: 6ch;">°</span>
                            </div>
                        </group>
                        <group>
                            <field name="twist" widget="percentage"/>
                        </group>
                    </group>
                    <group string="Density and Width">
                        <group>
                            <field name="density" widget="percentage"/>
                        </group>
                        <group>
                            <field name="width" widget="percentage"/>
                        </group>
                    </group>

                    <group string="Washing Parameters (AATCC TM 135)">
                        <group>
                            <field name="wash_cycle_type"/>
                            <field name="wash_temperature_level" invisible="wash_cycle_type in ('hand', 'not_allowed')"/>
                            <field name="do_not_wring" widget="boolean_toggle" invisible="wash_cycle_type == 'not_allowed'"/>
                            <field name="bleaching"/>
                            <field name="drying_condition"/>
                            <field name="drying_heat" invisible="drying_condition in ('line_hang_dry', 'drip_dry', 'dry_flat','not_allowed')"/>
                            <field name="in_the_shade" widget="boolean_toggle" invisible="drying_condition not in ('line_hang_dry', 'drip_dry', 'dry_flat')"/>
                        </group>
                        <group>
                            <field name="ironing"/>
                            <field name="iron_steam" widget="boolean_toggle"/>
                            <field name="profesional_textile_care_dry"/>
                            <field name="profesional_textile_care_wet"/>
                            <field name="laundering_ballast_type"/>
                            <field name="separately" widget="boolean_toggle"/>
                            <field name="with_like_colors" widget="boolean_toggle"/>
                            <field name="wash_inside_out" widget="boolean_toggle"/>
                        </group>
                        <label for="care_icon_preview_html"/>
                        <field name="care_icon_preview_html" widget="html" nolabel="1" readonly="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
</odoo>
