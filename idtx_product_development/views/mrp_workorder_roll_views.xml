<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mrp_workorder_roll_form_inherit" model="ir.ui.view">
        <field name="name">mrp.workorder.roll.form.inherit</field>
        <field name="model">mrp.workorder.roll</field>
        <field name="inherit_id" ref="idtx_mrp.mrp_workorder_roll_form"/>
        <field name="arch" type="xml">
            <field name="uom_id" position="after">
                <!-- Solo los rollos rectilíneos manejan talla (mismo criterio
                     que Cantidad: se oculta cuando no aplica). -->
                <field name="size_id" readonly="1" invisible="not size_id"/>
            </field>
        </field>
    </record>

    <record id="mrp_workorder_roll_view_search_inherit" model="ir.ui.view">
        <field name="name">mrp.workorder.roll.view.search.inherit</field>
        <field name="model">mrp.workorder.roll</field>
        <field name="inherit_id" ref="idtx_mrp.mrp_workorder_roll_view_search"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <filter name='weaving' string="Weaving" domain="[('weave_type','!=','rect')]"/>
                <filter name='rect' string="Rectilinear" domain="[('weave_type','=','rect')]"/>
            </field>
        </field>
    </record>

    <record id="mrp_workorder_roll_view_tree_inherit" model="ir.ui.view">
        <field name="name">mrp.workorder.roll.view.tree.inherit</field>
        <field name="model">mrp.workorder.roll</field>
        <field name="inherit_id" ref="idtx_mrp.mrp_workorder_roll_view_tree"/>
        <field name="arch" type="xml">
            <field name="uom_id" position="after">
                <field name="size_id"/>
            </field>
        </field>
    </record>
    
</odoo>