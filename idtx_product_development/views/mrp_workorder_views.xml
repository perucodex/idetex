<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mrp_production_workorder_form_view_inherit_dev_form" model="ir.ui.view">
        <field name="name">mrp.work.order.form.dev</field>
        <field name="model">mrp.workorder</field>
        <field name="inherit_id" ref="idtx_mrp.mrp_production_workorder_form_view_inherit_mrp_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='qty_remaining']" position="after">
                <field name="roll_weight" invisible="1"/>
                <field name="progress" widget="progressbar"/>
                <field name="weave_type" invisible="1"/>
            </xpath>
            <xpath expr="//notebook/page/field[@name='roll_ids']/list/field[@name='uom_id']" position="after">
                <field name="technical_id" column_invisible="1"/>
                <field name="size_id" column_invisible="parent.weave_type != 'rect'" required="parent.weave_type == 'rect'" domain="[('technical_id','=', technical_id)]" options="{'no_create': True, 'no_open': True}"/>
            </xpath>
            <field name="quantity" position="attributes">
                <attribute name="column_invisible">parent.weave_type != 'rect'</attribute>
                <attribute name="required">parent.weave_type == 'rect'</attribute>
            </field>
            <field name="gross_weight" position="attributes">
                <attribute name="column_invisible">parent.weave_type == 'rect'</attribute>
            </field>
            <field name="net_weight" position="attributes">
                <attribute name="column_invisible">parent.weave_type == 'rect'</attribute>
            </field>
            <button id="unlink_button_weight" position="attributes">
                <attribute name="invisible">parent.weave_type == 'rect' or gross_weight</attribute>
            </button>
            <button id="unlink_button_quantity" position="attributes">
                <attribute name="invisible">parent.weave_type == 'rect' or quantity</attribute>
            </button>
        </field>
    </record>
    
</odoo>