<odoo>

  <!-- QWeb Template -->
  <template id="report_technical_sheet_document">
    <t t-call="web.internal_layout">
      <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)"/>
      <div class="page">
        <meta http-equiv="content-type" content="text/html; charset=utf-8"/>
        <!-- Header -->
        <div>
            <div class="row mb8">
                <div class="col-4">
                    <img t-if="doc.company_id.logo" class="o_company_logo_big" t-att-src="image_data_uri(doc.company_id.logo)" alt="Logo"/>
                </div>
                <div class="col-8 text-end mb4">
                    <div name="company_address" class="float-end mb4">
                        <ul class="list-unstyled" name="company_address_list">
                            <li>
                              <span>
                                <!-- <div class="bg-light border-1 rounded h-100 d-flex flex-column align-items-center justify-content-center p-4 w-100 opacity-75 text-muted text-center"> -->
                                  <h4>Product Technical Sheet</h4>
                                  <h6><t t-esc="doc.name"/></h6>
                                <!-- </div> -->
                              </span>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
        <!-- <span>Technical Sheet:</span> <t t-esc="doc.name"/> -->
        <table class="table o_main_table">
          <tbody style="font-size: 0.8rem">
            <tr>
              <td style="background-color: #c2c2c2;"><span>Technical Date:</span> <t t-esc="doc.technical_date.strftime('%m/%d/%Y')"/></td>
              <td style="background-color: #c2c2c2;"><span>Customer:</span> <t t-esc="doc.partner_id.name"/></td>
            </tr>
            <tr>
              <td style="background-color: #c2c2c2;"><span>Code:</span> <t t-esc="doc.product_id.default_code"/></td>
              <td style="background-color: #c2c2c2;"><span>Fabric:</span> <t t-esc="doc.product_id.name"/></td>
            </tr>
          </tbody>
        </table>
        <table class="table o_main_table">
          <tbody style="font-size: 0.7rem">
            <tr>
              <td style="padding: 2px;">Composition</td>
              <td colspan="5" style="
                padding: 2px 4px;
                white-space: pre-wrap;
                word-wrap: break-word;
                overflow-wrap: break-word;
                line-height: 1.1;
                vertical-align: top;
              "><t t-esc="doc.fabric_composition"/>
              </td>
            </tr>
            <tr>
              <td style="padding: 2px;">Program</td>
              <td style="padding: 2px;"><t t-esc="doc.program"/></td>
              <td style="padding: 2px;">ATX</td>
              <td style="padding: 2px;"><t t-esc="doc.atx"/></td>
              <td style="padding: 2px;"></td>
              <td style="padding: 2px;"></td>
            </tr>
            <tr>
              <td style="padding: 2px;">Density</td>
              <td style="padding: 2px;"><t t-esc="doc.density"/></td>
              <td style="padding: 2px;">Width</td>
              <td style="padding: 2px;"><t t-esc="'{:.2f}'.format(doc.width)"/></td>
              <td style="padding: 2px;">Gauge</td>
              <td style="padding: 2px;"><t t-esc="doc.gauge_id.name"/></td>
            </tr>
            <tr>
              <td style="padding: 2px;">First wash shrinkage</td>
              <td style="padding: 2px;"><t t-esc="doc.first_wash_shrinkage"/></td>
              <td style="padding: 2px;">First wash twist</td>
              <td style="padding: 2px;"><t t-esc="doc.first_wash_twist"/></td>
              <td style="padding: 2px;">Yield</td>
              <td style="padding: 2px;"><t t-raw="'{:.2f} m/kg'.format(doc.yield_meter)"/></td>
            </tr>
            <tr>
              <td style="padding: 2px;">Scrap</td>
              <td style="padding: 2px;"><t t-esc="'{:.2f} %'.format(doc.scrap * 100)"/></td>
              <td style="padding: 2px;">Weave type</td>
              <td style="padding: 2px;"><span t-field="doc.weave_type"/></td>
              <td style="padding: 2px;">Mesh Lenght</td>
              <td style="padding: 2px;"><t t-esc="doc.mesh_length"/></td>
            </tr>
          </tbody>
        </table>
        <table class="table o_main_table">
          <tbody style="font-size: 0.7rem">
            <tr> <td colspan="6" class="text-center" style="padding:4px;"><strong>Datos de Crudo</strong></td></tr>
            <tr>
              <td style="padding: 2px;">Width</td>
              <td style="padding: 2px;"><t t-esc="doc.raw_width"/></td>
              <td style="padding: 2px;">Density</td>
              <td style="padding: 2px;"><t t-esc="doc.raw_density"/></td>
              <td style="padding: 2px;">Widening</td>
              <td style="padding: 2px;"><t t-esc="doc.raw_widening"/></td>
            </tr>
          </tbody>
        </table>
        <table class="table o_main_table">
          <tbody style="font-size: 0.7rem">
            <tr> <td colspan="6" class="text-center" style="padding:4px;"><strong>Datos de Acabado</strong></td></tr>
            <tr>
              <td style="padding: 2px;">Width</td>
              <td style="padding: 2px;"><t t-esc="doc.finish_width"/></td>
              <td style="padding: 2px;">Density</td>
              <td style="padding: 2px;"><t t-esc="doc.finish_density"/></td>
              <td style="padding: 2px;">Yield</td>
              <td style="padding: 2px;"><t t-esc="doc.finish_yield"/></td>
            </tr>
          </tbody>
        </table>
        <!-- Imprime solo si es rutas -->
        <t t-if="doc.route_line_ids">
          <!-- Descripción del proceso -->
          <div class="row mb-4" id="informations">
            <div class="col text-center" name="process">
                <strong>Pocess</strong>
            </div>
          </div>
        </t>
<style>
  /* Bloque de proceso */
  .process-block {
    margin: 0 !important;
    padding: 0 !important;
    page-break-inside: avoid;
    break-inside: avoid;
  }

  /* Tabla de procesos */
  .process-block table {
    margin: 0 !important;
    border-collapse: collapse;
  }

  /* Título del proceso */
  .process-title td {
    padding: 4px 6px !important;
    line-height: 1.5;
  }

  /* Filas normales de parámetros */
  .process-block td {
    padding: 2px 4px !important;
    line-height: 1.5;
    vertical-align: top;
  }
</style>

        <!-- Tabla principal de procesos -->
  <t t-foreach="doc.route_line_ids" t-as="p" t-key="p.id">
  <div class="process-block">
 <table class="table o_main_table">
    <tbody style="
        font-size: 0.7rem;
        page-break-inside: avoid;
        break-inside: avoid;
    ">
      <tr>
        <td colspan="10" style="background-color: #c2c2c2;">
          <t t-esc="p.operation_id.name"/>
        </td>
      </tr>
      <t t-set="lines" t-value="p.line_parameter_ids"/>
      <t t-set="normal_lines" t-value="[l for l in lines if not l.is_observation]"/>
      <t t-set="obs_lines" t-value="[l for l in lines if l.is_observation]"/>

      <t t-foreach="range(0, len(normal_lines), 4)" t-as="i">
        <tr>
          <t t-foreach="normal_lines[i:i+4]" t-as="line">
            <td style="padding: 2px;"><strong><t t-esc="line.name"/></strong></td>
            <td style="padding: 2px;"><t t-esc="line.value"/></td>
          </t>
          <t t-set="faltan" t-value="4 - len(normal_lines[i:i+4])"/>
          <t t-if="faltan > 0">
            <t t-foreach="range(faltan)" t-as="j">
              <td></td><td></td>
            </t>
          </t>
        </tr>
      </t>
      <t t-foreach="obs_lines" t-as="obs">
        <tr>
          <td colspan="8" style="padding: 6px;">
            <strong><t t-esc="obs.name"/></strong>
          </td>
        </tr>
        <tr>
          <td colspan="8" style="
            padding: 2px 4px;
            white-space: pre-wrap;
            word-wrap: break-word;
            overflow-wrap: break-word;
            line-height: 1.1;
            vertical-align: top;
          "><t t-esc="obs.value"/>
          </td>
        </tr>
      </t>
    </tbody>
</table>
  </div>
  </t>

        
        <!-- Imprime solo si es rectilineo y tiene datos -->
        <t t-if="doc.weave_type == 'rect' and doc.size_chart_ids">
          <!-- Descripción del tallas -->
          <div class="row mb-4" id="informations">
            <div class="col text-center" name="process">
                <strong>Rectilinear Size Chart</strong>
            </div>
          </div>

          <!-- Tabla principal de rectilineos -->
          <table class="table o_main_table">
              <thead style="font-size: 0.7rem">
                  <tr>
                    <th style="background-color: #c2c2c2;">Size</th>
                    <th style="background-color: #c2c2c2;">Largo</th>
                    <th style="background-color: #c2c2c2;">Alto</th>
                    <th style="background-color: #c2c2c2;">Needles</th>
                    <th style="background-color: #c2c2c2;">NE</th>
                    <th style="background-color: #c2c2c2;">Plies</th>
                    <th style="background-color: #c2c2c2;">Tubular</th>
                    <th style="background-color: #c2c2c2;">Body</th>
                  </tr>
              </thead>
              <t t-foreach="doc.size_chart_ids" t-as="size_line" t-key="s.id">
                <tbody style="font-size: 0.7rem">
                    <tr>
                        <td style="padding: 2px;"><strong><t t-esc="size_line.size"/></strong></td>
                        <td style="padding: 2px;"><t t-esc="'{:.2f}'.format(size_line.length)"/></td>
                        <td style="padding: 2px;"><t t-esc="'{:.2f}'.format(size_line.width)"/></td>
                        <td style="padding: 2px;"><t t-esc="size_line.needles"/></td>
                        <td style="padding: 2px;"><t t-esc="size_line.ne"/></td>
                        <td style="padding: 2px;"><t t-esc="size_line.plies"/></td>
                        <td style="padding: 2px;"><t t-esc="'{:.2f}'.format(size_line.tubular)"/></td>
                        <td style="padding: 2px;"><t t-esc="'{:.2f}'.format(size_line.body)"/></td>
                    </tr>
                </tbody>
              </t>
          </table>
        </t>

        <div class="row" style="page-break-inside: avoid; break-inside: avoid;">
          <!-- Columna de Notas: ocupa todo el espacio sobrante y parte el texto -->
          <div class="col text-break pe-4">
            <h4>Notes</h4>
            <p t-esc="doc.notes"/>
          </div>
          <!-- Columna de Ligamentos: ancho automático -->
          <t t-set="grid" t-value="doc.analysis_id.get_svg_grid()"/>
          <t t-call="idtx_product_development.fabric_ligaments_table"/>
        </div>

        <br/>

        <p>
          <strong><t t-esc="doc.user_id.name"/></strong> -
          <t t-esc="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y %H:%M:%S')"/>
        </p>
      </div>
    </t>
  </template>

  <template id="report_technical_sheet_raw">
      <t t-call="web.html_container">
          <t t-foreach="docs" t-as="doc">
              <t t-call="idtx_product_development.report_technical_sheet_document" t-lang="doc.partner_id.lang"/>
          </t>
      </t>
  </template>

  <template id="report_technical_sheet">
      <t t-call="idtx_product_development.report_technical_sheet_raw"/>
  </template>

</odoo>
