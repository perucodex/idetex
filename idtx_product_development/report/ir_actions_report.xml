<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="paperformat_dev_report_paper" model="report.paperformat">
        <field name="name">Report Paper</field>
        <field name="default" eval="False" />
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">15</field>
        <field name="margin_bottom">30</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_line" eval="False" />
        <field name="header_spacing">15</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_product_analysis" model="ir.actions.report">
        <field name="name">Analysis Weaving Data</field>
        <field name="model">analysis.weaving.data</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">idtx_product_development.report_product_analysis</field>
        <field name="report_file">idtx_product_development.report_product_analysis</field>
        <field name="print_report_name">'Product Analysis - %s - %s' % (object.analysis_id.name, object.stylo)</field>
        <field name="paperformat_id" ref="paperformat_dev_report_paper"/>
        <field name="binding_model_id" ref="model_analysis_weaving_data"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_technical_sheet" model="ir.actions.report">
        <field name="name">Technical Sheet</field>
        <field name="model">technical.sheet</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">idtx_product_development.report_technical_sheet</field>
        <field name="report_file">idtx_product_development.report_technical_sheet</field>
        <field name="print_report_name">'Technical Sheet - %s - %s' % (object.name, object.stylo)</field>
        <field name="paperformat_id" ref="paperformat_dev_report_paper"/>
        <field name="binding_model_id" ref="model_technical_sheet"/>
        <field name="binding_type">report</field>
    </record>

</odoo>
