<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_sync_texplus_base_process" model="ir.cron">
        <field name="name">Sincronizar procesos base TEXPLUS</field>
        <field name="model_id" ref="model_mrp_base_process"/>
        <field name="state">code</field>
        <field name="code">model.cron_sync_from_texplus()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="nextcall" eval="(DateTime.now().replace(minute=0, second=0) + timedelta(hours=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="active">True</field>
    </record>
</odoo>