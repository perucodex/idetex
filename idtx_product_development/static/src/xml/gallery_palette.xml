<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="fabric_gallery.GalleryPalette">
        <div class="gallery-palette-container">
            <t t-foreach="state.images" t-as="img" t-key="img.id">
                <div class="gallery-item">
                    <img t-att-src="'data:image/png;base64,' + img.image" t-att-alt="img.name"/>
                    <span class="img-name"><t t-esc="img.name"/></span>
                </div>
            </t>
        </div>
    </t>
</templates>
