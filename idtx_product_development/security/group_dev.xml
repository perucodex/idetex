<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Desarrollo de Producto -->
        <record model="res.groups.privilege" id="module_product_development_user">
            <field name="name">Product Development</field>
            <field name="description">Set up product development</field>
            <field name="sequence">19</field>
        </record>
        <record id="group_module_product_development_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="module_product_development_user"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="group_module_product_development_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="module_product_development_user"/>
            <field name="implied_ids" eval="[(4, ref('group_module_product_development_user'))]"/>
        </record>
        <!-- Perfil adicional como CASILLA en el usuario (sin privilege_id, para
             que NO compita en el selector User/Manager). Al marcarlo hereda el
             Manager de Desarrollo de Producto (implied_ids): mismos permisos que
             antes, solo cambia la presentación. -->
        <record id="group_module_product_development_price_editor" model="res.groups">
            <field name="name">Editor de Precio</field>
            <field name="implied_ids" eval="[(4, ref('group_module_product_development_manager'))]"/>
        </record>
        
        <record id="base.user_admin" model="res.users">
            <field name="group_ids" eval="[Command.link(ref('group_module_product_development_manager'))]"/>
        </record>

    </data>

    <!-- Reglas multi-company: LECTURA GLOBAL (sin restriccion de compania) y
         ESCRITURA solo de la compania duena. Asi los usuarios de Ventas
         (idetex) pueden leer los datos de produccion (fullpima) en las
         cotizaciones, pero solo la compania duena puede editarlos.
         perm_read=False => la regla no restringe lecturas (quedan abiertas).
         Fuera del bloque noupdate a proposito: el upgrade del modulo re-aplica
         estos valores aunque la regla ya exista. -->
    <data>
        <record id="product_analysis_company_rule" model="ir.rule">
            <field name="name">Product Analysis: escritura por compania (lectura global)</field>
            <field name="model_id" ref="model_product_analysis"/>
            <field name="global" eval="True"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="technical_sheet_company_rule" model="ir.rule">
            <field name="name">Technical Sheet: escritura por compania (lectura global)</field>
            <field name="model_id" ref="model_technical_sheet"/>
            <field name="global" eval="True"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <!-- Modelos estandar de mrp: quitamos la restriccion de compania SOLO
             en lectura (perm_read=False), conservando su dominio para
             escritura/creacion/borrado. -->
        <record id="mrp.mrp_bom_rule" model="ir.rule">
            <field name="perm_read" eval="False"/>
        </record>
        <record id="mrp.mrp_bom_line_rule" model="ir.rule">
            <field name="perm_read" eval="False"/>
        </record>
        <record id="mrp.mrp_workcenter_rule" model="ir.rule">
            <field name="perm_read" eval="False"/>
        </record>
        <record id="mrp.mrp_routing_workcenter_rule" model="ir.rule">
            <field name="perm_read" eval="False"/>
        </record>
        <record id="mrp.mrp_bom_byproduct_rule" model="ir.rule">
            <field name="perm_read" eval="False"/>
        </record>
    </data>
</odoo>
