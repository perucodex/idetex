<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="zk_device_view_form" model="ir.ui.view">
        <field name="name">zk.device.form</field>
        <field name="model">zk.device</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_test_connection" type="object"
                            string="Probar conexión" class="btn-secondary"/>
                    <button name="action_sync" type="object"
                            string="Sincronizar ahora" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="p. ej. Reloj Tejeduría"/></h1>
                    </div>
                    <group>
                        <group string="Conexión">
                            <field name="ip"/>
                            <field name="port"/>
                            <field name="timeout"/>
                            <field name="force_udp"/>
                            <field name="comm_password"/>
                        </group>
                        <group string="Sincronización">
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="lookback_days"/>
                            <field name="last_sync"/>
                        </group>
                    </group>
                    <div class="text-muted">
                        Mapeo: el <strong>User ID</strong> del reloj debe ser el
                        <strong>DNI</strong> del trabajador (campo de identificación del empleado).
                        Los usuarios cuyo DNI no exista en Odoo se omiten y se registran en el log.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="zk_device_view_list" model="ir.ui.view">
        <field name="name">zk.device.list</field>
        <field name="model">zk.device</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="ip"/>
                <field name="port"/>
                <field name="last_sync"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="zk_device_action" model="ir.actions.act_window">
        <field name="name">Dispositivos Biométricos</field>
        <field name="res_model">zk.device</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_zk_device"
              name="Biométrico ZKTeco"
              parent="hr_attendance.menu_hr_attendance_configuration"
              action="zk_device_action"
              sequence="90"/>

</odoo>
