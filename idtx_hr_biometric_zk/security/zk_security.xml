<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Aislamiento multi-compañía: cada usuario solo ve las revisiones y
             problemas de las compañías que tenga activas en el selector. -->
        <record id="zk_review_company_rule" model="ir.rule">
            <field name="name">Revisión de marcaciones: multi-compañía</field>
            <field name="model_id" ref="model_zk_attendance_review"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="zk_issue_company_rule" model="ir.rule">
            <field name="name">Problema de marcación: multi-compañía</field>
            <field name="model_id" ref="model_zk_attendance_issue"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

    </data>
</odoo>
