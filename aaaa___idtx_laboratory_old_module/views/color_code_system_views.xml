<?xml version="1.0" encoding="utf-8"?>
<odoo>

        <record id="color_process_type_tree_view" model="ir.ui.view">
            <field name="name">color.process.type.tree</field>
            <field name="model">color.process.type</field>
            <field name="arch" type="xml">
                <list string="Color Process Type" editable="top">
                    <field name="code"/>
                    <field name="name"/>
                    <field name="fiber_id"/>
                </list>
            </field>
        </record>

        <record id="color_range_tree_view" model="ir.ui.view">
            <field name="name">color.range.tree</field>
            <field name="model">color.range</field>
            <field name="arch" type="xml">
                <list string="Color Range" editable="top">
                    <field name="code"/>
                    <field name="name"/>
                </list>
            </field>
        </record>

        <record id="color_intensity_tree_view" model="ir.ui.view">
            <field name="name">color.intensity.tree</field>
            <field name="model">color.intensity</field>
            <field name="arch" type="xml">
                <list string="Color Intensity" editable="top">
                    <field name="code"/>
                    <field name="name"/>
                </list>
            </field>
        </record>

        <record id="color_fiber_tree_view" model="ir.ui.view">
            <field name="name">color.fiber.tree</field>
            <field name="model">color.fiber</field>
            <field name="arch" type="xml">
                <list string="Color Fiber" editable="top">
                    <!-- <field name="code"/> -->
                    <field name="name"/>
                </list>
            </field>
        </record>

        <record id="color_process_type_action" model="ir.actions.act_window">
            <field name="name">Color Process Type</field>
            <field name="res_model">color.process.type</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="color_process_type_tree_view"/>
        </record>

        <record id="color_range_action" model="ir.actions.act_window">
            <field name="name">Color Range</field>
            <field name="res_model">color.range</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="color_range_tree_view"/>
        </record>

        <record id="color_intensity_action" model="ir.actions.act_window">
            <field name="name">Color Intensity</field>
            <field name="res_model">color.intensity</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="color_intensity_tree_view"/>
        </record>

        <record id="color_fiber_action" model="ir.actions.act_window">
            <field name="name">Color Fiber</field>
            <field name="res_model">color.fiber</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="color_fiber_tree_view"/>
        </record>

</odoo>