<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="configurate_svg_example_view_form" model="ir.ui.view">
        <field name="name">configurate.svg.example.view.form</field>
        <field name="model">configurate.svg.example</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="svg_content"/>
                        <field name="svg_preview" widget="html"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="configurate_svg_example_action" model="ir.actions.act_window">
        <field name="name">Models SVG Configurate</field>
        <field name="res_model">configurate.svg.example</field>
        <field name="view_mode">list,form</field>
    </record>

    

</odoo>
