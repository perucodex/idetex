<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="hr_equipment_view_form_inherit" model="ir.ui.view">
            <field name="name">maintenance.equipment.form.inherit</field>
            <field name="model">maintenance.equipment</field>
            <field name="inherit_id" ref="maintenance.hr_equipment_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page string="Printer Information" name="printer_information">
                        <group>
                            <group>
                                <field name="equipment_ip" readonly="state == 'con'"/>
                            </group>
                            <group>
                                <field name="state" invisible="1"/>
                                <button name="connect" string="Connect" type="object" class="btn-primary" invisible="state == 'con'"/>
                                <button name="disconnect" string="Disconnect" type="object" class="btn-primary" invisible="state == 'not'"/>
                            </group>
                        </group>
                        <group colspan="2">
                            <field name="impresora_dashboard_dummy" widget="impresora_dashboard" nolabel="1" invisible="state == 'not'"/>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
