<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Laboratorio -->
        <record model="res.groups.privilege" id="module_laboratory_user">
            <field name="name">Laboratory</field>
            <field name="description">Set up laboratory</field>
            <field name="sequence">19</field>
        </record>
        <record id="group_module_laboratory_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="module_laboratory_user"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="group_module_laboratory_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="module_laboratory_user"/>
            <field name="implied_ids" eval="[(4, ref('group_module_laboratory_user'))]"/>
        </record>
        
        <record id="base.user_admin" model="res.users">
            <field name="groups_id" eval="[Command.link(ref('group_module_laboratory_manager'))]"/>
        </record>
        
        <!-- Desarrollo de Producto -->
        <record model="res.groups.privilege" id="module_product_development_user">
            <field name="name">Product Development</field>
            <field name="description">Set up product development</field>
            <field name="sequence">19</field>
        </record>
        <record id="group_module_product_development_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="module_product_development_user"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="group_module_product_development_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="module_product_development_user"/>
            <field name="implied_ids" eval="[(4, ref('group_module_product_development_user'))]"/>
        </record>
        
        <record id="base.user_admin" model="res.users">
            <field name="group_ids" eval="[Command.link(ref('group_module_product_development_manager'))]"/>
        </record>
        
        <!-- <record id="base.default_user" model="res.users">
            <field name="groups_id" eval="[(4,ref('idtx_laboratory.group_module_product_development_manager'))]"/>
        </record> -->
        
        <!-- Reglas para multi-company -->
        <record id="mrp_routing_workcenter_operation_company_rule" model="ir.rule">
            <field name="name">Workcenter Operation multi-company</field>
            <field name="model_id" ref="model_mrp_routing_workcenter_operation"/>
            <field name="domain_force">[('company_id', 'parent_of', company_ids)]</field>
        </record>

        <record id="product_analysis_company_rule" model="ir.rule">
            <field name="name">Product Analysis multi-company</field>
            <field name="model_id" ref="model_product_analysis"/>
            <field name="domain_force">[('company_id', 'parent_of', company_ids)]</field>
        </record>

        <record id="technical_sheet_company_rule" model="ir.rule">
            <field name="name">Technical Sheet multi-company</field>
            <field name="model_id" ref="model_technical_sheet"/>
            <field name="domain_force">[('company_id', 'parent_of', company_ids)]</field>
        </record>

        <record id="lab_dev_company_rule" model="ir.rule">
            <field name="name">LabDev multi-company</field>
            <field name="model_id" ref="model_lab_dev"/>
            <field name="domain_force">[('company_id', 'parent_of', company_ids)]</field>
        </record>

        <record id="color_recipe_company_rule" model="ir.rule">
            <field name="name">Color Recipe multi-company</field>
            <field name="model_id" ref="model_color_recipe"/>
            <field name="domain_force">[('company_id', 'parent_of', company_ids)]</field>
        </record>

    </data>
</odoo>
