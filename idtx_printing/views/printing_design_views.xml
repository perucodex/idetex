<odoo>

    <record id="view_printing_design_form" model="ir.ui.view">
        <field name="name">printing.design.form</field>
        <field name="model">printing.design</field>
        <field name="arch" type="xml">
            <form string="Printing Design">
                <header>
                    <button name="action_set_quoting" type="object" string="Set Quoting" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_set_development" type="object" string="Set Development" class="oe_highlight" invisible="state not in ('draft', 'quoting')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,quoting,development,done" readonly="1"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group col="3">
                        <group>
                            <field name="code" readonly="1" force_save="1"/>
                            <field name="printing_date" readonly="state != 'draft'" required="1"/>
                            <field name="partner_id" readonly="state != 'draft'" options="{'no_quick_create': True, 'no_create_edit': True}"/>
                            <field name="printing_type" readonly="state != 'draft'" required="1"/>
                            <field name="process_type_rotary" readonly="state != 'draft'" invisible="printing_type != 'rotary'" required="printing_type == 'rotary'"/>
                            <field name="process_type_digital" readonly="state != 'draft'" invisible="printing_type != 'digital'" required="printing_type == 'digital'"/>
                            <field name="fabric_base" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="cylinder_qty" readonly="state != 'draft'" invisible="printing_type != 'rotary'"/>
                            <field name="cylinder_size" readonly="state != 'draft'" invisible="printing_type != 'rotary'"/>
                            <field name="shrinkage" readonly="state != 'draft'" widget="percentage" invisible="printing_type != 'rotary'"/>
                            <!-- <field name="raport" invisible="printing_type != 'rotary'"/> -->
                            <label for="yield_meter"/>
                            <div name="yield_meter" class="o_row">
                                <field name="yield_meter" readonly="state != 'draft'"/>
                                <span class="ms-1 oe_inline">kg</span>
                            </div>
                            <field name="unit_price" readonly="state != 'draft'" invisible="printing_type != 'rotary'" groups="idtx_printing.group_module_print_manager"/>
                            <field name="bonding_price" readonly="state != 'draft'" invisible="printing_type != 'rotary'" groups="idtx_printing.group_module_print_manager"/>
                        </group>
                        <group>
                            <field name="file_desc" readonly="state != 'draft'"/>
                            <field name="design_image" readonly="state != 'draft'" filename="file_name" widget="binary"/>
                            <field name="preview_image" readonly="1" widget="image" options="{'preview_image': 'preview_image', 'size': [256, 256]}"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="prices" string="Prices" invisible="printing_type != 'digital'" groups="idtx_printing.group_module_print_manager">
                            <field name="digital_unit_price_ids" readonly="state != 'draft'">
                                <list create="0" delete="0" editable="top">
                                    <field name="range" readonly="1" force_save="1"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="unit_price"/>
                                    <field name="total_price"/>
                                </list>
                            </field>
                        </page>
                        <page name="prices" string="Prices" invisible="printing_type != 'rotary'" groups="idtx_printing.group_module_print_manager">
                            <field name="rotary_unit_price_ids" readonly="state != 'draft'">
                                <list create="0" delete="0" editable="top">
                                    <field name="raport" readonly="1" force_save="1"/>
                                    <field name="unit_price" readonly="1" force_save="1"/>
                                    <field name="color_qty" readonly="1" force_save="1"/>
                                    <field name="sample_min_qty" readonly="1" force_save="1"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="sample_price" readonly="1" force_save="1"/>
                                </list>
                            </field>
                        </page>
                        <page name="rotary_recipes" string="Rotary Recipes" invisible="printing_type != 'rotary' or state in ('draft', 'quoting')"  groups="idtx_printing.group_module_print_user">
                            <field name="rotary_recipe_line_ids" context="{'form_view_ref': 'idtx_printing.view_printing_design_rotary_line_form'}">
                                <list editable="top" open_form_view="True">
                                    <field name="name"/>
                                    <field name="version" readonly="1"/>
                                    <field name="recipe_date" readonly="1"/>
                                    <field name="state" readonly="1" widget="badge"
                                           decoration-success="state == 'approved'"
                                           decoration-danger="state == 'pending'"/>
                                    <!-- <field name="is_current_version" readonly="1"/> -->
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_printing_design_rotary_line_form" model="ir.ui.view">
        <field name="name">printing.design.rotary.line.form</field>
        <field name="model">printing.design.rotary.line</field>
        <field name="arch" type="xml">
            <form string="Rotary Recipe">
                <header>
                    <button name="action_open_recipe_sheet" type="object" string="Recipe Sheet"/>
                    <button name="action_approve" type="object" string="Approve" class="oe_highlight" invisible="state in ('approved', 'obsolete')" groups="idtx_printing.group_module_print_manager"/>
                    <button name="action_return_to_pending" type="object" string="Return to Pending" invisible="state in ('pending', 'obsolete')" groups="idtx_printing.group_module_print_manager"/>
                    <button name="action_new_version" type="object" string="New Version" invisible="state == 'obsolete'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="printing_design_id" readonly="1"/>
                            <field name="printing_design_code" readonly="1"/>
                            <field name="name" readonly="1"/>
                            <field name="version" readonly="1"/>
                            <field name="recipe_date" readonly="state in ('approved', 'obsolete')"/>
                            <!-- <field name="is_current_version" readonly="1"/> -->
                            <field name="previous_recipe_id" readonly="1"/>
                            <label for="production_percentage"/>
                            <div name="production_percentage" class="o_row o_row_readonly">
                                <field name="production_percentage" class="oe_inline o_input_6ch" style="max-width: 7ch;" required="1"/>
                                <span class="ms-1 oe_inline">%</span>
                            </div>
                        </group>
                        <group>
                            <field name="printing_design_preview_image" widget="image" readonly="1" options="{'preview_image': 'printing_design_preview_image', 'size': [256, 256]}"/>
                        </group>
                    </group>
                    <field name="color_line_ids" nolabel="1" readonly="state != 'pending'">
                        <list>
                            <field name="color_name"/>
                        </list>
                        <form string="Recipe Color">
                            <sheet>
                                <group>
                                    <field name="color_name" readonly="parent.state != 'pending'"/>
                                </group>
                                <field name="chemical_line_ids" nolabel="1" readonly="parent.state != 'pending'">
                                    <list editable="top">
                                        <field name="product_id" domain="[('is_chemical','=', True)]"/>
                                        <field name="quantity"/>
                                    </list>
                                </field>
                            </sheet>
                        </form>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_printing_design_rotary_line_list" model="ir.ui.view">
        <field name="name">printing.design.rotary.line.list</field>
        <field name="model">printing.design.rotary.line</field>
        <field name="arch" type="xml">
            <list string="Rotary Recipes">
                <field name="printing_design_id"/>
                <field name="printing_design_code" optional="show"/>
                <field name="name"/>
                <field name="version"/>
                <field name="recipe_date"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'approved'"
                       decoration-danger="state == 'pending'"/>
                <!-- <field name="is_current_version" optional="show"/> -->
            </list>
        </field>
    </record>

    <record id="view_printing_design_rotary_line_search" model="ir.ui.view">
        <field name="name">printing.design.rotary.line.search</field>
        <field name="model">printing.design.rotary.line</field>
        <field name="arch" type="xml">
            <search string="Rotary Recipes">
                <field name="printing_design_id"/>
                <field name="printing_design_code" string="Design Code"/>
                <field name="name"/>
                <field name="state"/>
                <filter name="pending" string="Pending" domain="[('state', '=', 'pending')]"/>
                <filter name="approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <filter name="current" string="Current" domain="[('is_current_version', '=', True)]"/>
                <separator/>
                <filter name="group_by_printing_design_id" string="Group by Design" context="{'group_by': 'printing_design_id'}"/>
                <filter name="group_by_state" string="Group by Status" context="{'group_by': 'state'}"/>
                <filter name="group_by_recipe_date" string="Group by Recipe Date" context="{'group_by': 'recipe_date'}"/>
            </search>
        </field>
    </record>

    <record id="view_printing_design_list" model="ir.ui.view">
        <field name="name">printing.design.list</field>
        <field name="model">printing.design</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="printing_type"/>
                <field name="code"/>
                <field name="file_desc"/>
                <field name="fabric_base"/>
                <field name="state" widget="badge"
                       decoration-muted="state == 'draft'"
                       decoration-info="state == 'quoting'"
                       decoration-warning="state == 'development'"
                       decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <record id="action_printing_design" model="ir.actions.act_window">
        <field name="name">Printing Design</field>
        <field name="res_model">printing.design</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_printing_design_list"/>
    </record>

    <record id="action_printing_design_rotary_line" model="ir.actions.act_window">
        <field name="name">Rotary Recipes</field>
        <field name="res_model">printing.design.rotary.line</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_printing_design_rotary_line_list"/>
        <field name="search_view_id" ref="view_printing_design_rotary_line_search"/>
        <field name="context">{'search_default_group_by_printing_design_id': 1}</field>
    </record>

</odoo>
