<odoo>
    <template id="printing_recipe_sheet_template" name="Printing Recipe Sheet">
        <t t-call="web.html_container">
            <div class="container py-4" style="max-width: 1100px; font-family: Arial, sans-serif; color: #1f2937;">
                <div class="mb-4" style="border-bottom: 2px solid #d1d5db; padding-bottom: 16px;">
                    <h1 style="margin: 0 0 12px; font-size: 30px;">
                        <t t-esc="recipe.name"/>
                    </h1>
                    <div class="row" style="display: flex; gap: 24px; align-items: flex-start;">
                        <div style="flex: 1; min-width: 320px;">
                            <table style="width: 100%; border-collapse: collapse;">
                                <tbody>
                                    <tr><td style="padding: 6px 0; font-weight: 700; width: 180px;">Design Code</td><td><t t-esc="recipe.printing_design_code or '-'"/></td></tr>
                                    <tr><td style="padding: 6px 0; font-weight: 700;">Design Name</td><td><t t-esc="recipe.printing_design_id.file_desc or '-'"/></td></tr>
                                    <tr><td style="padding: 6px 0; font-weight: 700;">Recipe Version</td><td><t t-esc="recipe.version"/></td></tr>
                                    <tr><td style="padding: 6px 0; font-weight: 700;">Recipe Date</td><td><t t-esc="recipe.recipe_date or '-'"/></td></tr>
                                    <tr><td style="padding: 6px 0; font-weight: 700;">Status</td><td><t t-esc="recipe.state or '-'"/></td></tr>
                                    <tr><td style="padding: 6px 0; font-weight: 700;">Customer</td><td><t t-esc="recipe.printing_design_id.partner_id.display_name or '-'"/></td></tr>
                                    <tr><td style="padding: 6px 0; font-weight: 700;">Printing Type</td><td><t t-esc="dict(recipe.printing_design_id._fields['printing_type'].selection).get(recipe.printing_design_id.printing_type, '-')"/></td></tr>
                                    <tr t-if="recipe.printing_design_id.printing_type == 'rotary'"><td style="padding: 6px 0; font-weight: 700;">Process</td><td><t t-esc="dict(recipe.printing_design_id._fields['process_type_rotary'].selection).get(recipe.printing_design_id.process_type_rotary, '-')"/></td></tr>
                                    <tr t-if="recipe.printing_design_id.printing_type == 'digital'"><td style="padding: 6px 0; font-weight: 700;">Process</td><td><t t-esc="dict(recipe.printing_design_id._fields['process_type_digital'].selection).get(recipe.printing_design_id.process_type_digital, '-')"/></td></tr>
                                    <tr><td style="padding: 6px 0; font-weight: 700;">Fabric Base</td><td><t t-esc="recipe.printing_design_id.fabric_base or '-'"/></td></tr>
                                </tbody>
                            </table>
                        </div>
                        <div style="width: 320px; text-align: center;">
                            <img t-if="recipe.printing_design_id.preview_image"
                                 t-att-src="'/web/image?model=printing.design&amp;id=%s&amp;field=preview_image' % recipe.printing_design_id.id"
                                 alt="Design Preview"
                                 style="max-width: 100%; max-height: 320px; border: 1px solid #d1d5db; border-radius: 8px;"/>
                            <div t-else="" style="border: 1px dashed #d1d5db; border-radius: 8px; padding: 48px 16px; color: #6b7280;">
                                No preview image
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mb-5">
                    <h2 style="font-size: 22px; margin-bottom: 16px;">Recipe</h2>
                    <table style="width: 100%; border-collapse: collapse; border: 1px solid #d1d5db;">
                        <thead style="background: #f3f4f6;">
                            <tr>
                                <th style="padding: 10px; text-align: left; border-bottom: 1px solid #d1d5db;">Chemical</th>
                                <th style="padding: 10px; text-align: right; border-bottom: 1px solid #d1d5db;">Quantity</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="recipe.color_line_ids" t-as="color" t-key="color.id">
                                <tr style="background: #f9fafb;">
                                    <td colspan="2" style="padding: 10px; border-bottom: 1px solid #d1d5db; font-weight: 700;">
                                        <t t-esc="color.color_name"/>
                                    </td>
                                </tr>
                                <t t-foreach="color.chemical_line_ids" t-as="chemical" t-key="chemical.id">
                                    <tr>
                                        <td style="padding: 10px; border-bottom: 1px solid #e5e7eb;"><t t-esc="chemical.product_id.display_name"/></td>
                                        <td style="padding: 10px; border-bottom: 1px solid #e5e7eb; text-align: right;"><t t-esc="'%.5f' % chemical.quantity"/></td>
                                    </tr>
                                </t>
                                <tr t-if="not color.chemical_line_ids">
                                    <td colspan="2" style="padding: 10px; border-bottom: 1px solid #e5e7eb; color: #6b7280;">No chemicals</td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>

                <div>
                    <h2 style="font-size: 22px; margin-bottom: 16px;">Recipe + {{ recipe.production_percentage * 100 }}%</h2>
                    <table style="width: 100%; border-collapse: collapse; border: 1px solid #d1d5db;">
                        <thead style="background: #ecfdf5;">
                            <tr>
                                <th style="padding: 10px; text-align: left; border-bottom: 1px solid #d1d5db;">Chemical</th>
                                <th style="padding: 10px; text-align: right; border-bottom: 1px solid #d1d5db;">Quantity + {{ recipe.production_percentage * 100 }}%</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="recipe.color_line_ids" t-as="color" t-key="'%s_plus' % color.id">
                                <tr style="background: #f0fdf4;">
                                    <td colspan="2" style="padding: 10px; border-bottom: 1px solid #d1d5db; font-weight: 700;">
                                        <t t-esc="color.color_name"/>
                                    </td>
                                </tr>
                                <t t-foreach="color.chemical_line_ids" t-as="chemical" t-key="'%s_plus' % chemical.id">
                                    <tr>
                                        <td style="padding: 10px; border-bottom: 1px solid #e5e7eb;"><t t-esc="chemical.product_id.display_name"/></td>
                                        <td style="padding: 10px; border-bottom: 1px solid #e5e7eb; text-align: right;"><t t-esc="'%.5f' % (chemical.quantity * (1 + recipe.production_percentage))"/></td>
                                    </tr>
                                </t>
                                <tr t-if="not color.chemical_line_ids">
                                    <td colspan="2" style="padding: 10px; border-bottom: 1px solid #e5e7eb; color: #6b7280;">No chemicals</td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </div>
        </t>
    </template>
</odoo>