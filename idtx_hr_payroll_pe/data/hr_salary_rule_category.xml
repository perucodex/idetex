<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">

        <!-- Categoría Gratificacion -->
        <record id="GRAT" model="hr.salary.rule.category">
            <field name="name">Gratificación</field>
            <field name="code">GRAT</field>
        </record>

        <!-- Categoría CTS-->
        <record id="CTS" model="hr.salary.rule.category">
            <field name="name">CTS</field>
            <field name="code">CTS</field>
        </record>
        
        <!-- Categoría Vacaciones -->
        <record id="VAC" model="hr.salary.rule.category">
            <field name="name">Vacaciones</field>
            <field name="code">VAC</field>
        </record>

        <!-- Ingresos NO remunerativos (inafectos a aportes y 5ta): condición de
             trabajo, movilidad supeditada a asistencia, prestación alimentaria.
             Entran al total de ingresos pero NO a la base de aportes. -->
        <record id="INAF" model="hr.salary.rule.category">
            <field name="name">Ingresos Inafectos</field>
            <field name="code">INAF</field>
        </record>

    </data>
</odoo>
