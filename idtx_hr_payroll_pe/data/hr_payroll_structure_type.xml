<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">
    
        <!-- Tipo de estructura para obreros Perú, pago mensual (como FULL PIMA:
             sueldo = jornal × días, boleta mensual). -->
        <record id="hr_structure_type_pe_obrero" model="hr.payroll.structure.type">
            <field name="name">Obrero Perú - Mensual</field>
            <field name="country_id" ref="base.pe"/>
            <field name="default_schedule_pay">monthly</field>
            <field name="default_resource_calendar_id" ref="calendar_pe_48h_lun_sab"/>
        </record>

        <!-- Tipo de estructura para jornaleros (pago semanal con dominical):
             lo usa la planilla agraria jornalero integral. -->
        <record id="hr_structure_type_pe_jornalero" model="hr.payroll.structure.type">
            <field name="name">Jornalero Perú - Semanal</field>
            <field name="country_id" ref="base.pe"/>
            <field name="default_schedule_pay">weekly</field>
            <field name="default_resource_calendar_id" ref="calendar_pe_48h_lun_sab"/>
        </record>

        <!-- Horario peruano (48h) por defecto también para el tipo "Worker". -->
        <record id="hr.structure_type_worker" model="hr.payroll.structure.type">
            <field name="default_resource_calendar_id" ref="calendar_pe_48h_lun_sab"/>
        </record>

    </data>
</odoo>
