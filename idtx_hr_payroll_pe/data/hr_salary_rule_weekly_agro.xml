        <!-- Regla Vacaciones -->

        <record id="rule_vacaciones" model="hr.salary.rule">
            <field name="name">Vacaciones</field>
            <field name="sequence">50</field>
            <field name="code">VAC_PAY</field>
            <field name="category_id" ref="VAC"/>
            <field name="condition_select">python</field>
            <field name="condition_python">
work_entries = employee.work_entry_ids.filtered(
    lambda w: w.date_start &gt;= payslip.date_from and
            w.date_end &lt;= payslip.date_to and
            w.work_entry_type_id.code == 'LEAVE105'
)
result = bool(work_entries)
            </field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
vac_days = sum(
    (we.date_end - we.date_start).days + 1
    for we in employee.work_entry_ids
    if we.work_entry_type_id.code == 'LEAVE105'
    and we.date_start &gt;= payslip.date_from
    and we.date_end &lt;= payslip.date_to
)
result = ((categories['BASIC'] + categories['ALW']) / 30) * vac_days if vac_days else 0
            </field>
            <field name="struct_id" ref="idtx_hr_payroll_pe.structure_pe_obrero_textil"/>
            <field name="appears_on_payslip" eval="True"/>
        </record>

