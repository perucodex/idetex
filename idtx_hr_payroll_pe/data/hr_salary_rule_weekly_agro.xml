data = pe_data
result = data.get('faltas', 0.0) &gt; 0
            </field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
data = pe_data
dias_trab = data.get('dias_trabajados', 0)
dias_laborables = data.get('dias_laborables', 6)
daily = version.wage / 30.0 if version and version.wage else 0.0
dom_teorico = daily
dom_real = (dias_trab / dias_laborables) * daily if dias_laborables else 0.0
result = dom_real - dom_teorico
            </field>
            <field name="appears_on_payslip" eval="True"/>
