    cts_end   = date(start.year, 11, 31)
real_start = max(start, cts_start)
real_end   = min(end, cts_end)
dias_cts = (real_end - real_start).days + 1 if real_start &lt;= real_end else 0
dias_trabajados = (cts_end - version.contract_date_start).days
dias_tra = min(dias_trabajados, 180)
daily = (version.wage / 30.0 / 180) if version and version.wage else 0.0
result = dias_cts * daily * dias_tra
            </field>
