        <!-- GRAT_PE: Regla Gratificación -->

        <record id="rule_gratificacion" model="hr.salary.rule">
            <field name="name">Gratificación Julio / Diciembre</field>
            <field name="sequence">30</field>
            <field name="code">GRAT_PE</field>
            <field name="category_id" ref="GRAT"/>
            <field name="condition_select">python</field>
            <field name="condition_python">result = payslip.date_to.month in (7, 12) or payslip.date_from.month in (7,12)</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
start = payslip.date_from
end = payslip.date_to
if start.month == 7 or end.month == 7:
    gra_start = date(start.year, 7, 1)
    gra_end   = date(start.year, 7, 31)
elif start.month == 12 or end.month == 12:
    gra_start = date(start.year, 12, 1)
    gra_end   = date(start.year, 12, 31)
real_start = max(start, gra_start)
real_end   = min(end, gra_end)
dias_gra = (real_end - real_start).days + 1 if real_start &lt;= real_end else 0
dias_trabajados = (gra_end - version.contract_date_start).days
dias_tra = min(dias_trabajados, 180)
daily = (version.wage / 30.0 / 180) if version and version.wage else 0.0
result = dias_gra * daily * dias_tra
            </field>
            <field name="struct_id" ref="idtx_hr_payroll_pe.structure_pe_obrero_textil"/>
            <field name="appears_on_payslip" eval="True"/>
        </record>

