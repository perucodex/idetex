        <!-- ASIG_FAM_PE: Asignación Familiar (10% RMV) prorrateada -->

        <record id="rule_pe_asig_fam" model="hr.salary.rule">
            <field name="name">Asignación Familiar PE</field>
            <field name="code">ASIG_FAM_PE</field>
            <field name="sequence">20</field>
            <field name="category_id" ref="hr_payroll.BASIC"/>
            <field name="struct_id" ref="idtx_hr_payroll_pe.structure_pe_obrero_textil"/>
            <field name="condition_select">python</field>
            <field name="condition_python">
result = bool(employee.children)
            </field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
rmv = float(payslip.env['ir.config_parameter'].sudo().get_param('idtx_hr_payroll_pe.minimum_living_wage', 0))
asig = rmv * 0.10
days = worked_days['WORK100'].number_of_days if 'WORK100' in worked_days else 0
result = (asig / 30.0) * days
            </field>
            <field name="appears_on_payslip" eval="True"/>
        </record>

        <!-- HE25_PE: Horas Extra 25% usando hr_attendance.overtime.line -->

        <record id="rule_pe_he_25" model="hr.salary.rule">
            <field name="name">Horas Extra 25% PE</field>
            <field name="code">HE25_PE</field>
            <field name="sequence">30</field>
            <field name="category_id" ref="hr_payroll.BASIC"/>
            <field name="struct_id" ref="idtx_hr_payroll_pe.structure_pe_obrero_textil"/>
            <field name="condition_select">python</field>
            <field name="condition_python">
result = he25 &gt; 0
            </field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
he25 = he25
horas_dia = horas_jornada or 8.0
wage_mensual = version.wage or 0.0
asig_mensual = 0.0
if employee.children:
    asig_mensual = rmv * 0.10 if rmv else 0.0
base_mensual = wage_mensual + asig_mensual
valor_hora = (base_mensual / 30.0 / horas_dia) if horas_dia else 0.0
result = he25 * valor_hora * 1.25
            </field>
            <field name="appears_on_payslip" eval="True"/>
        </record>

