        <!-- AFP_OBLIG_PE: Aporte AFP -->

        <record id="rule_pe_afp_oblig" model="hr.salary.rule">
            <field name="name">AFP - Aporte Obligatorio PE</field>
            <field name="code">AFP_OBLIG_PE</field>
            <field name="sequence">101</field>
            <field name="category_id" ref="hr_payroll.DED"/>
            <field name="struct_id" ref="idtx_hr_payroll_pe.structure_pe_obrero_textil"/>
            <field name="condition_select">python</field>
            <field name="condition_python">
employee = payslip.employee_id
result = (employee.pension_system == 'afp' and employee.afp_id)
            </field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
employee = payslip.employee_id
afp = employee.afp_id
# Base imponible: Básico + Asignaciones
base = categories['BASIC'] + categories['ALW'] + categories['DED']
if not (employee and afp) or not base:
    result = 0.0
else:
    max_base = afp.max_insurable or 0.0
    # Aplica tope máximo asegurable si está configurado
    if max_base and base > max_base:
        base = max_base
    aport = afp.afp_contribution or 0.0
    # Descuento → negativo
    result = -(base * aport)
            </field>
            <field name="appears_on_payslip" eval="True"/>
        </record>

        <!-- AFP_COM_PE: Comisión AFP -->

        <record id="rule_pe_afp_commission" model="hr.salary.rule">
            <field name="name">AFP - Comisión PE</field>
            <field name="code">AFP_COM_PE</field>
            <field name="sequence">102</field>
            <field name="category_id" ref="hr_payroll.DED"/>
            <field name="struct_id" ref="idtx_hr_payroll_pe.structure_pe_obrero_textil"/>
            <field name="condition_select">python</field>
            <field name="condition_python">
employee = payslip.employee_id
# Solo AFP y con AFP asignada
if not (employee.pension_system == 'afp' and employee.afp_id):
    result = False
else:
    # Si hay fecha de nacimiento, calculamos edad con la fecha de la planilla
    if employee.birthday and payslip.date_to:
        age_days = (payslip.date_to - employee.birthday).days
        age = age_days / 365.0
        # Exonerado de comisión si tiene 65 años o más
        result = age &lt; 65
    else:
        # Si no hay fecha de nacimiento, por seguridad aplicamos comisión
        result = True
            </field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
employee = payslip.employee_id
afp = employee.afp_id
ctype = employee.commission_type
# Base imponible: Básico + Asignaciones
base = categories['BASIC'] + categories['ALW'] + categories['DED']
if not (employee and afp) or not base:
    result = 0.0
else:
    max_base = afp.max_insurable or 0.0
    if max_base and base > max_base:
        base = max_base
    if ctype == 'flow':
        rate = afp.commission_flow or 0.0
    else:
        rate = afp.commission_balance or 0.0
    # Descuento → negativo
    result = -(base * rate)
            </field>
            <field name="appears_on_payslip" eval="True"/>
        </record>

