            <field name="struct_ids" eval="[(4, ref('idtx_hr_payroll_pe.structure_pe_obrero_textil'))]"/>
        </record>

        <!-- Prestación alimentaria - vales (monto, inafecto; se entrega y se
             descuenta, neto 0 en efectivo) -->
        <record id="input_type_pres_alim" model="hr.payslip.input.type">
            <field name="name">Prestación Alimentaria</field>
            <field name="code">PRES_ALIM</field>
            <field name="struct_ids" eval="[(4, ref('idtx_hr_payroll_pe.structure_pe_obrero_textil'))]"/>
        </record>

