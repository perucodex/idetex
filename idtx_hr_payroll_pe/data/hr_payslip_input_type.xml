            <field name="struct_ids" eval="[(4, ref('idtx_hr_payroll_pe.structure_pe_obrero_textil'))]"/>
        </record>

        <!-- Descuento de comedor (monto, descuento) -->
        <record id="input_type_dsct_comedor" model="hr.payslip.input.type">
            <field name="name">Descuento Comedor</field>
            <field name="code">DSCT_COMEDOR</field>
            <field name="struct_ids" eval="[(4, ref('idtx_hr_payroll_pe.structure_pe_obrero_textil'))]"/>
        </record>

        <!-- Otros descuentos (monto) -->
        <record id="input_type_otros_desc" model="hr.payslip.input.type">
            <field name="name">Otros Descuentos</field>
            <field name="code">OTROS_DESC</field>
            <field name="struct_ids" eval="[(4, ref('idtx_hr_payroll_pe.structure_pe_obrero_textil'))]"/>
        </record>

        <!-- Permiso por hora NO pagado (horas) -->
        <record id="input_type_perm_horas" model="hr.payslip.input.type">
            <field name="name">Permiso por Hora (no pagado)</field>
            <field name="code">PERM_HORAS</field>
            <field name="is_quantity" eval="True"/>
            <field name="struct_ids" eval="[(4, ref('idtx_hr_payroll_pe.structure_pe_obrero_textil'))]"/>
        </record>

    </data>
</odoo>
