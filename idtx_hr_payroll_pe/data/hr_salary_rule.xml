<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">

        <!-- Regla: Asignación Familiar -->
        <record id="rule_asignacion_familiar" model="hr.salary.rule">
            <field name="name">Asignación Familiar</field>
            <field name="sequence">2</field>
            <field name="code">FAM</field>
            <field name="category_id" ref="hr_payroll.ALW"/>
            <field name="condition_select">python</field>
            <field name="condition_python">result = employee.children &gt; 0</field>
            <field name="amount_select">fix</field>
            <field name="amount_fix">102.50</field>
            <field name="struct_id" ref="hr_payroll_structure_peru_general"/>
        </record>

        <!-- Regla: ONP 12.5% -->
        <record id="rule_onp" model="hr.salary.rule">
            <field name="name">Descuento ONP</field>
            <field name="sequence">10</field>
            <field name="code">ONP</field>
            <field name="category_id" ref="hr_payroll.DED"/>
            <field name="condition_select">python</field>
            <field name="condition_python">result = employee.pension_system == 'onp'</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = - (categories['BASIC'] + categories['ALW']) * 0.125</field>
            <field name="struct_id" ref="hr_payroll_structure_peru_general"/>
        </record>

        <!-- Regla: AFP Aporte 10% -->
        <record id="rule_afp_aporte" model="hr.salary.rule">
            <field name="name">AFP Aporte (10%)</field>
            <field name="sequence">11</field>
            <field name="code">AFP</field>
            <field name="category_id" ref="hr_payroll.DED"/>
            <field name="condition_select">python</field>
            <field name="condition_python">result = employee.pension_system == 'afp'</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = - (categories['BASIC'] + categories['ALW']) * employee.afp_id.afp_contribution</field>
            <field name="struct_id" ref="hr_payroll_structure_peru_general"/>
        </record>

        <!-- Regla: AFP Comisión -->
        <record id="rule_afp_comision" model="hr.salary.rule">
            <field name="name">AFP Comisión</field>
            <field name="sequence">12</field>
            <field name="code">AFPCOM</field>
            <field name="category_id" ref="hr_payroll.DED"/>
            <field name="condition_select">python</field>
            <field name="condition_python">result = employee.pension_system == 'afp' and employee.afp_id</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = - (categories['BASIC'] + categories['ALW']) * (employee.afp_id.commission_balance if employee.commission_type == 'balance' else employee.afp_id.commission_flow)</field>
            <field name="struct_id" ref="hr_payroll_structure_peru_general"/>
        </record>

        <!-- Regla: AFP Seguro -->
        <record id="rule_afp_seguro" model="hr.salary.rule">
            <field name="name">AFP Seguro</field>
            <field name="sequence">13</field>
            <field name="code">AFPSEG</field>
            <field name="category_id" ref="hr_payroll.DED"/>
            <field name="condition_select">python</field>
            <field name="condition_python">result = employee.pension_system == 'afp' and employee.afp_id</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = - (categories['BASIC'] + categories['ALW']) * employee.afp_id.insurance_rate</field>
            <field name="struct_id" ref="hr_payroll_structure_peru_general"/>
        </record>

        <!-- Regla: Essalud 9% (Empleador) -->
        <record id="rule_essalud" model="hr.salary.rule">
            <field name="name">EsSalud</field>
            <field name="sequence">20</field>
            <field name="code">ESSALUD</field>
            <field name="category_id" ref="hr_payroll.COMP"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = (categories['BASIC'] + categories['ALW']) * 0.09</field>
            <field name="struct_id" ref="hr_payroll_structure_peru_general"/>
        </record>

        <!-- Regla Gratificación -->
        <record id="rule_gratificacion" model="hr.salary.rule">
            <field name="name">Gratificación Julio / Diciembre</field>
            <field name="sequence">30</field>
            <field name="code">GRAT</field>
            <field name="category_id" ref="GRAT"/>
            <field name="condition_select">python</field>
            <field name="condition_python">result = payslip.date_to.month in (7, 12)</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">start = version.contract_date_start
end   = payslip.date_to
months = max(0, (end.year - start.year) * 12 + end.month - start.month)
months = min(months, 6)
result = ((categories['BASIC'] + categories['ALW']) / 6) * months
            </field>
            <field name="struct_id" ref="hr_payroll_structure_peru_general"/>
        </record>

        <!-- Regla CTS -->
        <record id="rule_cts" model="hr.salary.rule">
            <field name="name">CTS Mayo / Noviembre</field>
            <field name="sequence">40</field>
            <field name="code">CTS</field>
            <field name="category_id" ref="CTS"/>
            <field name="condition_select">python</field>
            <field name="condition_python">result = payslip.date_to.month in (5, 11)</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
start = version.contract_date_start
end   = payslip.date_to
months = max(0, (end.year - start.year) * 12 + end.month - start.month)
months = min(months, 6)
result = ((categories['BASIC'] + categories['ALW']) / 12) * months
            </field>
            <field name="struct_id" ref="hr_payroll_structure_peru_general"/>
        </record>

    </data>
</odoo>
