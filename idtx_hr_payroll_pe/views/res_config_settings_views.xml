<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_hr_pe" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.hr.contract.salary.pe</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr_payroll.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='hr_payroll']" position="inside">
                <block title="Peruvian Localization" name="peruvian_localization_div">
                    <setting string="Life Insurance Law" help="Vida Ley: prima a cargo del empleador (%).">
                        <field name="life_insurance_law" widget="percentage"/>
                    </setting>
                    <setting string="SENATI" help="La empresa aporta a SENATI (actividad industrial, 0.75%).">
                        <field name="l10n_pe_senati_affiliated"/>
                    </setting>
                    <setting string="SCTR" help="Seguro Complementario de Trabajo de Riesgo (actividad de riesgo). Las tasas varían por aseguradora.">
                        <field name="l10n_pe_sctr_affiliated"/>
                        <div invisible="not l10n_pe_sctr_affiliated" class="content-group mt-2">
                            <div class="row">
                                <label for="l10n_pe_sctr_salud_rate" string="SCTR Salud" class="col-lg-4 o_light_label"/>
                                <field name="l10n_pe_sctr_salud_rate" widget="percentage"/>
                            </div>
                            <div class="row">
                                <label for="l10n_pe_sctr_pension_rate" string="SCTR Pensión" class="col-lg-4 o_light_label"/>
                                <field name="l10n_pe_sctr_pension_rate" widget="percentage"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo> 
