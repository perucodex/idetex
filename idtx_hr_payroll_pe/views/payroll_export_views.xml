<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="l10n_pe_payroll_export_wizard_form" model="ir.ui.view">
        <field name="name">l10n.pe.payroll.export.wizard.form</field>
        <field name="model">l10n.pe.payroll.export.wizard</field>
        <field name="arch" type="xml">
            <form string="Exportar Planilla (PLAME / AFPNet)">
                <group>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="export_type"/>
                    </group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                </group>
                <group invisible="not file">
                    <field name="filename" invisible="1"/>
                    <field name="file" filename="filename" readonly="1"/>
                </group>
                <div class="text-muted">
                    Genera un CSV con los datos de planilla (conceptos por trabajador
                    o aportes AFP) para cargar/adaptar al PDT PLAME o AFPNet.
                </div>
                <footer>
                    <button name="action_generate" type="object" string="Generar" class="btn-primary"/>
                    <button string="Cerrar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="l10n_pe_payroll_export_action" model="ir.actions.act_window">
        <field name="name">Exportar Planilla (PLAME / AFPNet)</field>
        <field name="res_model">l10n.pe.payroll.export.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="l10n_pe_payroll_export_menu"
              name="Exportar PLAME / AFPNet"
              parent="hr_payroll_pe_menu"
              action="l10n_pe_payroll_export_action"
              sequence="20"/>

</odoo>
