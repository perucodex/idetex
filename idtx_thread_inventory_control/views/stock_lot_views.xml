<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_production_lot_form_inherit_thread_control" model="ir.ui.view">
        <field name="name">stock.lot.form.thread.control</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="idtx_lot_qualification.view_production_lot_form_inherit"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button type="object"
                        name="action_open_thread_controls"
                        class="oe_stat_button"
                        icon="fa-cubes"
                        invisible="not product_id.is_thread">
                    <field name="thread_control_count" string="Thread Controls" widget="statinfo"/>
                </button>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="Thread Control" invisible="not product_id.is_thread">
                    <group>
                        <group string="Main Warehouse Weight (kg)">
                            <field name="thread_in_weight" readonly="1"/>
                            <field name="thread_out_weight" readonly="1"/>
                            <field name="thread_balance_weight" readonly="1"/>
                        </group>
                        <group string="Second Quality Liquidation (kg)">
                            <field name="thread_second_quality_weight" readonly="1"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
