<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_thread_weaving_close_wizard_form" model="ir.ui.view">
        <field name="name">thread.weaving.close.wizard.form</field>
        <field name="model">thread.weaving.close.wizard</field>
        <field name="arch" type="xml">
            <form string="Cerrar tejido y liquidar hilo">
                <!-- force_save en los campos que se llenan al abrir: el cliente
                     NO reenvía los readonly y las líneas llegaban sin bolsa. -->
                <field name="workorder_id" invisible="1"/>
                <field name="available_lot_ids" invisible="1"/>
                <div class="alert alert-warning" role="alert"
                     invisible="not balance_warning">
                    <field name="balance_warning" readonly="1" nolabel="1"/>
                </div>
                <group>
                    <group string="Producción">
                        <field name="production_id" readonly="1"/>
                        <field name="roll_count" readonly="1" force_save="1"/>
                        <field name="woven_qty" readonly="1" force_save="1"/>
                    </group>
                    <group string="Hilo separado">
                        <field name="reserved_qty" readonly="1"/>
                        <field name="second_location_id"
                               required="returned_qty &gt; 0"/>
                    </group>
                </group>

                <notebook>
                    <page name="bags" string="Bolsas separadas">
                        <p class="text-muted">
                            Marca las bolsas que se abrieron en la tejedora: esas se
                            consumen completas. Las que no se abrieron solo pierden la
                            reserva y vuelven a estar disponibles.
                        </p>
                        <button name="action_mark_all_used" type="object"
                                string="Marcar todas" class="btn-link"
                                icon="fa-check-square-o"/>
                        <button name="action_mark_none_used" type="object"
                                string="Desmarcar todas" class="btn-link"
                                icon="fa-square-o"/>
                        <field name="bag_line_ids" nolabel="1">
                            <list editable="bottom" create="0" delete="0">
                                <field name="bag_id" column_invisible="1" force_save="1"/>
                                <field name="bag_name" readonly="1"/>
                                <field name="lot_id" readonly="1"/>
                                <field name="product_id" readonly="1" optional="hide"/>
                                <field name="location_id" readonly="1" optional="hide"/>
                                <field name="cone_qty" readonly="1"/>
                                <field name="net_weight" readonly="1" sum="Separado"/>
                                <field name="used" widget="boolean_toggle"/>
                            </list>
                        </field>
                    </page>
                    <page name="returns" string="Hilo bajado de máquina">
                        <p class="text-muted">
                            Una línea por bolsa que se bajó de la máquina, con su peso y
                            sus conos. Entran al almacén de 2da calidad.
                        </p>
                        <field name="return_line_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="lot_id"
                                       options="{'no_create': True, 'no_open': True}"/>
                                <field name="cone_qty"/>
                                <field name="weight" sum="Devuelto"/>
                                <field name="avg_cone_weight" readonly="1"/>
                            </list>
                        </field>
                    </page>
                </notebook>

                <group string="Balance del hilo">
                    <group string="Sale del almacén">
                        <field name="used_qty" readonly="1"/>
                        <field name="used_bags" readonly="1"/>
                        <field name="waste_qty" readonly="1"/>
                        <field name="waste_pct" readonly="1"/>
                    </group>
                    <group string="Vuelve o se libera">
                        <field name="returned_qty" readonly="1"/>
                        <field name="returned_bags" readonly="1"/>
                        <field name="returned_cones" readonly="1"/>
                        <field name="released_qty" readonly="1"/>
                        <field name="released_bags" readonly="1"/>
                    </group>
                </group>
                <div class="text-muted">
                    Bolsas usadas = tela tejida + hilo devuelto a 2da + merma.
                    La merma se registra como desecho desde Producción.
                </div>

                <footer>
                    <button name="action_confirm" type="object" class="btn-primary"
                            string="Confirmar y cerrar tejido"
                            confirm="Se consumirá el hilo de las bolsas usadas, entrará el hilo bajado a 2da calidad, se registrará la merma y se cerrará la orden de trabajo. ¿Continuar?"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Botón en la OT de tejido: abre la liquidación de hilo. Vive en este
         módulo porque es quien define action_open_weaving_close. -->
    <record id="mrp_workorder_form_weaving_close" model="ir.ui.view">
        <field name="name">mrp.workorder.form.weaving.close</field>
        <field name="model">mrp.workorder</field>
        <field name="inherit_id" ref="mrp.mrp_production_workorder_form_view_inherit"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_weaving_close" type="object"
                        string="Cerrar tejido y liquidar hilo" class="oe_highlight"
                        invisible="operation_type != 'weaving' or state in ('done', 'cancel')"/>
            </xpath>
            <xpath expr="//group[@name='idtx_produced_group']" position="inside">
                <field name="weaving_liquidated_qty"
                       invisible="operation_type != 'weaving' or not weaving_liquidated_qty"/>
            </xpath>
        </field>
    </record>

</odoo>
