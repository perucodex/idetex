<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_stock_picking_import_packing_wizard_form" model="ir.ui.view">
        <field name="name">stock.picking.import.packing.wizard.form</field>
        <field name="model">stock.picking.import.packing.wizard</field>
        <field name="arch" type="xml">
            <form string="Importar Packing List de Hilo">
                <field name="picking_id" invisible="1"/>
                <group>
                    <field name="packing_file"
                           string="Archivo Packing (Excel)"
                           filename="filename"
                           widget="binary"/>
                    <field name="filename" invisible="1"/>
                </group>
                <div class="text-muted small">
                    Se crean movimientos y operaciones detalladas por cada producto
                    encontrado en Odoo. Productos sin codigo registrado son omitidos.
                </div>
                <footer>
                    <button name="action_import_packing"
                            string="Importar"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
