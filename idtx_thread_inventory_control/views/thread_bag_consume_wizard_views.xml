<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_thread_bag_consume_wizard_form" model="ir.ui.view">
        <field name="name">thread.bag.consume.wizard.form</field>
        <field name="model">thread.bag.consume.wizard</field>
        <field name="arch" type="xml">
            <form string="Elegir bolsas de hilo">
                <field name="move_id" invisible="1"/>
                <field name="allowed_bag_ids" invisible="1"/>
                <field name="is_reception" invisible="1"/>
                <group>
                    <group>
                        <field name="product_id"/>
                        <field name="demand"/>
                    </group>
                    <group>
                        <field name="selected_count"/>
                        <field name="selected_net"/>
                        <field name="diff_net"
                               decoration-success="diff_net >= 0"
                               decoration-danger="diff_net &lt; 0"/>
                    </group>
                </group>
                <!-- Consumo / transferencia: escanear el correlativo -->
                <group invisible="is_reception">
                    <field name="scan_input" placeholder="Escanea aquí el correlativo de la bolsa…"
                           widget="char"/>
                </group>
                <!-- Packing (Excel). Recepción: llena las líneas de abajo (lotes y
                     bolsas se crean al VALIDAR). Consumo/entrega: SELECCIONA las
                     bolsas existentes por correlativo (no crea nada). -->
                <group string="Packing de hilo (Excel)">
                    <field name="import_file" filename="import_filename" string="Archivo"/>
                    <field name="import_filename" invisible="1"/>
                    <!-- Importar todo = todas las filas del producto.
                         Importar = solo hasta cubrir la demanda (incluye la bolsa
                         que cruza el umbral; nunca queda debajo si el Excel alcanza). -->
                    <!-- <div invisible="not import_file"> -->
                        <button name="action_import_packing" type="object"
                                string="Importar todo" class="btn-primary" invisible="not import_file"/>
                        <button name="action_import_packing_demand" type="object"
                                string="Importar" class="btn-secondary ms-2" invisible="not import_file"/>
                    <!-- </div> -->
                </group>
                <!-- Consumo / transferencia: bolsas existentes -->
                <separator string="Bolsas de la selección (agregar / quitar)" invisible="is_reception"/>
                <field name="bag_ids" widget="many2many" invisible="is_reception"
                       options="{'no_create': True, 'no_open': True}">
                    <list limit="1000">
                        <field name="name"/>
                        <field name="lot_id"/>
                        <field name="cone_qty"/>
                        <field name="net_weight" sum="Kg"/>
                        <field name="location_id"/>
                        <field name="cone_color" optional="hide"/>
                    </list>
                </field>
                <!-- Recepción: líneas del packing (los lotes/bolsas se crean al validar) -->
                <separator string="Bolsas del packing (los lotes y bolsas se crean al Validar)"
                           invisible="not is_reception"/>
                <field name="line_ids" invisible="not is_reception">
                    <list editable="bottom">
                        <field name="name"/>
                        <field name="lot_name"/>
                        <field name="cone_qty"/>
                        <field name="net_weight" sum="Kg"/>
                        <field name="gross_weight" optional="hide"/>
                        <field name="tare" optional="hide"/>
                        <field name="cone_color" optional="hide"/>
                        <field name="packaging_type" optional="hide"/>
                        <field name="yarn_color" optional="hide"/>
                    </list>
                </field>
                <footer>
                    <button name="action_confirm" type="object" string="Confirmar selección"
                            class="btn-primary"/>
                    <button name="action_clear_lines" type="object" string="Limpiar"
                            class="btn-secondary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
