<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_thread_second_quality_wizard_form" model="ir.ui.view">
        <field name="name">thread.second.quality.wizard.form</field>
        <field name="model">thread.second.quality.wizard</field>
        <field name="arch" type="xml">
            <form string="Liquidar Hilado">
                <sheet>
                    <group col="2">
                        <field name="source_location_id" readonly="1"/>
                        <field name="destination_location_id" domain="[('id', 'in', [main_location_id, second_location_id])]"/>
                    </group>
                    <field name="production_id" invisible="1"/>
                    <field name="main_location_id" invisible="1"/>
                    <field name="second_location_id" invisible="1"/>
                    <field name="line_ids" nolabel="1">
                        <list editable="bottom" create="0" delete="0">
                            <field name="product_id" readonly="1" force_save="1"/>
                            <field name="lot_id" readonly="1" force_save="1"/>
                            <field name="received_qty" readonly="1" force_save="1"/>
                            <field name="consumed_qty" readonly="1" force_save="1"/>
                            <field name="liquidated_qty" readonly="1" force_save="1"/>
                            <field name="balance_qty" readonly="1" force_save="1"/>
                            <field name="bag_qty"/>
                            <field name="cone_qty"/>
                            <field name="cone_weight"/>
                            <field name="transfer_qty" readonly="1" force_save="1"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button name="action_create_second_quality_transfer" type="object" string="Liquidar Hilado" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_mrp_production_form_thread_second_quality_button" model="ir.ui.view">
        <field name="name">mrp.production.form.thread.second.quality.button</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button"
                        type="object"
                        name="action_view_thread_liquidations"
                        icon="fa-random"
                        invisible="thread_liquidation_count == 0">
                    <field name="thread_liquidation_count" widget="statinfo" string="Liquidaciones"/>
                </button>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="action_open_thread_second_quality_wizard"
                        type="object"
                    string="Liquidar Hilado"
                        class="btn-secondary"
                        invisible="state != 'done' or not can_liquidate_thread"/>
            </xpath>
        </field>
    </record>
</odoo>
