<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_thread_lot_control_list" model="ir.ui.view">
        <field name="name">thread.lot.control.list</field>
        <field name="model">thread.lot.control</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date"/>
                <field name="movement_type"/>
                <field name="lot_id"/>
                <field name="product_id"/>
                <field name="source_location_id"/>
                <field name="dest_location_id"/>
                <field name="bag_count"/>
                <field name="cone_count"/>
                <field name="average_cone_weight"/>
                <field name="total_weight" sum="Total Weight"/>
            </list>
        </field>
    </record>

    <record id="view_thread_lot_control_form" model="ir.ui.view">
        <field name="name">thread.lot.control.form</field>
        <field name="model">thread.lot.control</field>
        <field name="arch" type="xml">
            <form string="Thread Lot Bag Control">
                <sheet>
                    <group string="Header">
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="date" readonly="1"/>
                            <field name="movement_type" readonly="1"/>
                            <field name="lot_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="product_id" readonly="1"/>
                            <field name="company_id" readonly="1"/>
                            <field name="source_location_id" readonly="1"/>
                            <field name="dest_location_id" readonly="1"/>
                        </group>
                    </group>
                    <group string="Summary">
                        <group>
                            <field name="bag_count" readonly="1"/>
                            <field name="cone_count" readonly="1"/>
                        </group>
                        <group>
                            <field name="total_weight" readonly="1"/>
                            <field name="average_cone_weight" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page name="bags" string="Bags">
                            <field name="line_ids" nolabel="1" readonly="1">
                                <list editable="bottom">
                                    <field name="bag_qty"/>
                                    <field name="cone_qty"/>
                                    <field name="cone_weight"/>
                                    <field name="total_weight" sum="Total Weight"/>
                                </list>
                            </field>
                        </page>
                        <page name="note" string="Notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_thread_lot_control_line_list" model="ir.ui.view">
        <field name="name">thread.lot.control.line.list</field>
        <field name="model">thread.lot.control.line</field>
        <field name="arch" type="xml">
            <list>
                <field name="date"/>
                <field name="movement_type"/>
                <field name="lot_id"/>
                <field name="product_id"/>
                <field name="source_location_id"/>
                <field name="dest_location_id"/>
                <field name="bag_qty"/>
                <field name="cone_qty"/>
                <field name="cone_weight"/>
                <field name="total_weight" sum="Total Weight"/>
            </list>
        </field>
    </record>

    <record id="view_thread_lot_control_line_search" model="ir.ui.view">
        <field name="name">thread.lot.control.line.search</field>
        <field name="model">thread.lot.control.line</field>
        <field name="arch" type="xml">
            <search string="Thread Control Detail">
                <filter name="group_by_source" string="Group by Source" context="{'group_by': 'source_location_id'}"/>
                <filter name="group_by_dest" string="Group by Destination" context="{'group_by': 'dest_location_id'}"/>
                <filter name="group_by_lot" string="Group by Lot" context="{'group_by': 'lot_id'}"/>
                <filter name="group_by_movement" string="Group by Movement" context="{'group_by': 'movement_type'}"/>
            </search>
        </field>
    </record>

    <record id="action_thread_lot_control" model="ir.actions.act_window">
        <field name="name">Thread Bag Controls</field>
        <field name="res_model">thread.lot.control</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_thread_lot_control_line" model="ir.actions.act_window">
        <field name="name">Thread Control Detail by Location</field>
        <field name="res_model">thread.lot.control.line</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_thread_lot_control_line_search"/>
        <field name="context">{'search_default_group_by_source': 1}</field>
    </record>

    <menuitem id="menu_thread_lot_control_root"
              name="Thread Control"
              parent="stock.menu_stock_root"
              sequence="70"/>

    <menuitem id="menu_thread_lot_control"
              name="Bags by Lot"
              parent="menu_thread_lot_control_root"
              action="action_thread_lot_control"
              sequence="10"/>

    <menuitem id="menu_thread_lot_control_line"
              name="Detail by Location"
              parent="menu_thread_lot_control_root"
              action="action_thread_lot_control_line"
              sequence="20"/>
</odoo>
