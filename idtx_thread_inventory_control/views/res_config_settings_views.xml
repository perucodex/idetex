<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Almacén de hilo de 2da: destino del hilo que se baja de la tejedora
         al cerrar el tejido. -->
    <record id="res_config_settings_view_form_thread" model="ir.ui.view">
        <field name="name">res.config.settings.form.thread.second</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="mrp.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <!-- El core cambio el ancla: antes id='operations_setting_container',
                 ahora name='process_operations_setting_container'. -->
            <xpath expr="//block[@name='process_operations_setting_container']" position="inside">
                <setting id="thread_second_location_setting"
                         string="Hilo de 2da Calidad"
                         help="Almacén donde entra el hilo bajado de la tejedora al cerrar el tejido.">
                    <field name="thread_second_location_id"
                           options="{'no_create': True}"/>
                </setting>
            </xpath>
        </field>
    </record>

</odoo>
