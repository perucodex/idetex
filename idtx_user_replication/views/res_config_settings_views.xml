<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_inherit_user_replication" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.idtx.user.replication</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="60"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='general_settings']//block[@name='users_setting_container']" position="after">
                <!-- Solo visible en modo desarrollador -->
                <block title="Réplica de usuarios a otras bases de datos"
                       name="idtx_user_repl_block" groups="base.group_no_one">
                    <setting id="idtx_user_repl_setting"
                             string="Replicar usuarios y claves"
                             help="Copia los usuarios internos (login, clave, activo, nombre y correo) a otras bases Odoo de este mismo servidor PostgreSQL cada vez que se crean, modifican o eliminan. Usa la misma conexión que Odoo y solo replica entre bases de la misma versión. Si una base falla, el error se muestra aquí.">
                        <field name="user_repl_enabled"/>
                        <field name="user_repl_current_major" invisible="1"/>
                        <div class="content-group mt16" invisible="not user_repl_enabled">
                            <div class="row">
                                <label for="user_repl_db_ids" class="col-lg-4 o_light_label"/>
                                <field name="user_repl_db_ids" widget="many2many_tags"
                                       options="{'no_create': True, 'no_open': True}"
                                       domain="[('version_major', '=', user_repl_current_major)]"
                                       placeholder="Selecciona las bases de datos destino..."/>
                            </div>
                            <div class="text-muted mt4">
                                Solo se muestran bases Odoo <b>versión <field name="user_repl_current_major" readonly="1" class="d-inline"/></b> de este servidor. Pulsa "Detectar bases de datos" si falta alguna.
                            </div>
                            <div class="text-muted mt4">
                                En "Administrar bases destino" puedes marcar <b>Crear usuarios como portal</b> para que los usuarios que no existan en esa base se creen sin acceso al backend (solo sitio web); los ya existentes solo sincronizan la clave.
                            </div>
                            <div class="mt8">
                                <button name="action_user_repl_discover" type="object"
                                        string="Detectar bases de datos" class="btn-link" icon="fa-refresh"/>
                                <button name="action_user_repl_test_connection" type="object"
                                        string="Probar conexión" class="btn-link" icon="oi-arrow-right"/>
                                <button name="action_user_repl_sync_all" type="object"
                                        string="Replicar todos los usuarios ahora" class="btn-link" icon="oi-arrow-right"
                                        confirm="Se copiarán TODOS los usuarios internos de esta base a las bases destino seleccionadas (se crean los que no existan y se actualizan los demás). ¿Continuar?"/>
                                <button name="action_user_repl_open_dbs" type="object"
                                        string="Administrar bases destino" class="btn-link" icon="oi-arrow-right"/>
                            </div>
                            <div class="text-muted mt8" invisible="not user_repl_last_sync">
                                Última réplica: <field name="user_repl_last_sync" readonly="1" class="d-inline"/>
                            </div>
                            <div class="alert alert-danger mt8" role="alert" invisible="not user_repl_last_error">
                                <strong>Avisos de la última réplica:</strong>
                                <field name="user_repl_last_error" readonly="1" nolabel="1"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
