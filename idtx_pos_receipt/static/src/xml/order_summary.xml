<?xml version="1.0" encoding="utf-8"?>
<templates id="template" xml:space="preserve">
    <t t-inherit="point_of_sale.OrderSummary" t-inherit-mode="extension">
        <xpath expr="//t[@t-set-slot='pack-lot-icon']" position="after">
            <t t-set-slot="paint-icon">
                <i t-if="line.getProduct()?.product_tmpl_id?.isTracked()" role="img"
                   t-attf-class="{{ line.hasValidProductLot() ? 'text-success' : 'text-danger'}} fa fa-paint-brush ms-1"
                   t-attf-title="{{ line.hasValidProductLot() ? 'Valid product lot' : 'Invalid product lot'}}" />
            </t>
        </xpath>
    </t>
</templates>