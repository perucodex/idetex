<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_workorder_batch_split_form" model="ir.ui.view">
        <field name="name">mrp.workorder.batch.split.form</field>
        <field name="model">mrp.workorder.batch.split</field>
        <field name="arch" type="xml">
            <form string="Dividir partida">
                <group>
                    <field name="batch_id" readonly="1"/>
                </group>
                <p class="text-muted">
                    Los rollos con el mismo <b>Grupo</b> forman una sub-partida
                    (se nombran <i>partida-A</i>, <i>partida-B</i>, ...). La
                    agrupación propuesta es por producto; puedes cambiar el grupo
                    de cada rollo. La partida original conserva su nombre como
                    registro del teñido.
                </p>
                <field name="line_ids">
                    <list editable="bottom" create="0" delete="0">
                        <field name="group_code"/>
                        <field name="roll_id" readonly="1" options="{'no_open': True}"/>
                        <field name="production_id" readonly="1"/>
                        <field name="workorder_id" readonly="1"/>
                        <field name="product_id" readonly="1"/>
                        <field name="gross_weight" sum="Total"/>
                    </list>
                </field>
                <footer>
                    <button name="action_split" type="object" string="Dividir"
                            class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
