<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mrp_workorder_batch_form" model="ir.ui.view">
        <field name="name">mrp.workorder.batch.form</field>
        <field name="model">mrp.workorder.batch</field>
        <field name="arch" type="xml">
            <form string="Batch">
                <header>
                    <button name="create_batch" class="oe_highlight" string="Create Batch" type="object" invisible="state != 'draft' or not wo_roll_ids"/>
                    <button name="clear_rolls" string="Clear Rolls" type="object" invisible="state != 'draft' or not wo_roll_ids"/>
                    <button name="unbuild_batch" class="oe_highlight" string="Unbuild Batch" type="object" invisible="state != 'batch'"/>
                    <button name="action_back_to_draft" string="Regresar a Borrador" type="object" invisible="state != 'batch'"
                            confirm="La partida volverá a borrador y sus rollos quedarán libres para corregir la composición. ¿Continuar?"/>
                    <button name="action_open_split_wizard" class="oe_highlight" string="Dividir Partida" type="object" invisible="state != 'batch'"/>
                    <button name="rebuild_batch" class="oe_highlight" string="Rebuild Batch" type="object" invisible="state != 'unbuild'" groups="mrp.group_mrp_manager"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_children" type="object" class="oe_stat_button"
                                icon="fa-sitemap" invisible="child_count == 0">
                            <field name="child_count" widget="statinfo" string="Sub-partidas"/>
                        </button>
                        <button name="action_view_parent" type="object" class="oe_stat_button"
                                icon="fa-level-up" invisible="not parent_batch_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Partida</span>
                                <span class="o_stat_text">Origen</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group name="batch_info">
                            <field name="batch_date" readonly="state != 'draft'"/>
                            <field name="mrwo_id" readonly="1"/>
                            <field name="parent_batch_id" invisible="not parent_batch_id"/>
                            <field name="split_code" invisible="not split_code"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="roll_page" string="Rolls">
                            <!-- Partida dividida: composición ORIGINAL reconstruida
                                 desde las sub-partidas (trazabilidad). -->
                            <field name="origin_roll_ids" readonly="1" invisible="state != 'split'">
                                <list create="0" delete="0">
                                    <field name="current_batch_id" string="Sub-partida"/>
                                    <field name="workorder_id"/>
                                    <field name="name"/>
                                    <field name="product_id"/>
                                    <field name="uom_id"/>
                                    <field name="quantity" sum="Total" optional="hide"/>
                                    <field name="net_weight" sum="Total"/>
                                    <field name="gross_weight" sum="Total" column_invisible="1"/>
                                </list>
                            </field>
                            <field name="wo_roll_ids" domain="[('in_batch','=',False), ('transfer_state','!=','transferido')]" context="{'search_default_group_workorder': 1, 'search_default_group_option': 2}" readonly="state != 'draft'" invisible="state == 'split'">
                                <list create="0" decoration-info="transfer_state == 'recibido'">
                                    <field name="transfer_state" column_invisible="1"/>
                                    <field name="workorder_id"/>
                                    <field name="name"/>
                                    <field name="product_id"/>
                                    <field name="uom_id"/>
                                    <field name="quantity" sum="Total" optional="hide"/>
                                    <field name="net_weight" sum="Total"/>
                                    <field name="gross_weight" sum="Total" column_invisible="1"/>
                                </list>
                                <form>
                                    <group>
                                        <field name="workorder_id" readonly="1"/>
                                        <group>
                                            <field name="name" readonly="1"/>
                                            <field name="uom_id" readonly="1"/>
                                        </group>
                                        <group>
                                            <field name="quantity" readonly="1"/>
                                            <field name="net_weight" readonly="1"/>
                                            <field name="gross_weight" readonly="1"/>
                                        </group>
                                    </group>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="wo_batch_tree_view" model="ir.ui.view">
        <field name="name">mrp.workorder.batch.list</field>
        <field name="model">mrp.workorder.batch</field>
        <field name="arch" type="xml">
            <!-- "Agregar en lote" se retiró: los rollos terminados ahora se
                 crean pesándolos en Operaciones → Pesado de rollos. -->
            <list string="Batchs" decoration-success="mrwo_id">
                <field name="name"/>
                <field name="batch_date"/>
                <field name="mrwo_id"/>
                <field name="state" widget="badge" decoration-info="state == 'batch'" decoration-danger="state == 'unbuild'"/>
            </list>
        </field>
    </record>

    <record id="mrp_workorder_batch_view_search" model="ir.ui.view">
        <field name="name">mrp.workorder.batch.view.search</field>
        <field name="model">mrp.workorder.batch</field>
        <field name="arch" type="xml">
            <search string="Search Batch">
                <field name="name"/>
                <field name="batch_date"/>
                <field name="mrwo_id"/>
                <filter name='draft' string="Draft" domain="[('state','=','draft')]"/>
                <filter name='batch' string="Batch" domain="[('state','=','batch')]"/>
                <filter name='unbuild' string="Unbuild" domain="[('state','=','unbuild')]"/>
            </search>
        </field>
    </record>

    <record id="wo_batch_action" model="ir.actions.act_window">
        <field name="name">Batchs</field>
        <field name="res_model">mrp.workorder.batch</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="wo_batch_tree_view"/>
        <field name="context">{'search_default_draft': True, 'search_default_batch': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
            Create a new Batchs
            </p><p>
            Batchs define that need to be done to group rolls for production.
            Each batch is done from weaving rolls.
            </p>
        </field>
    </record>
    
</odoo>