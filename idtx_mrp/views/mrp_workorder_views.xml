<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mrp_production_workorder_tree_editable_view_mrp_inherit" model="ir.ui.view">
        <field name="name">mrp.workorder.list.editable.mrp</field>
        <field name="model">mrp.workorder</field>
        <field name="inherit_id" ref="mrp.mrp_production_workorder_tree_editable_view"/>
        <field name="arch" type="xml">
            <xpath expr="//list/field[@name='name']" position="after">
                <field name="mrwo_id" required="1" readonly="state in ['cancel', 'done']"/>
            </xpath>
            <xpath expr="//list/field[@name='name']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="mrp_production_workorder_form_view_inherit_lab_form" model="ir.ui.view">
        <field name="name">mrp.work.order.form.lab</field>
        <field name="model">mrp.workorder</field>
        <field name="inherit_id" ref="mrp.mrp_production_workorder_form_view_inherit"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="mrwo_id" required="1"/>
            </xpath>
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='qty_remaining']" position="after">
                <field name="operation_type"/>
            </xpath>
            <xpath expr="//field[@name='employee_assigned_ids']" position="after">
                <field name="equipment_ids" widget="many2many_tags" domain="[('workcenter_id','=',workcenter_id)]"/>
            </xpath>
        </field>
    </record>
    
</odoo>