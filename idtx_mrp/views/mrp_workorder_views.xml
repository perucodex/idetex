<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mrp_production_workorder_tree_editable_view_mrp_inherit" model="ir.ui.view">
        <field name="name">mrp.workorder.list.editable.mrp</field>
        <field name="model">mrp.workorder</field>
        <field name="inherit_id" ref="mrp.mrp_production_workorder_tree_editable_view"/>
        <field name="arch" type="xml">
            <xpath expr="//list/field[@name='name']" position="after">
                <field name="mrwo_id" required="1" readonly="state in ['cancel', 'done']"/>
            </xpath>
            <xpath expr="//list/field[@name='name']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <xpath expr="//list/button[@name='button_start']" position="before">
                <button name="button_reopen" type="object" title="Open" class="btn-success px-2"
                  invisible="production_state in ('draft', 'done', 'cancel') or state not in ('done','cancel') or is_user_working" icon="fa-refresh"/>
            </xpath>
        </field>
    </record>

    <record id="mrp_production_workorder_form_view_inherit_mrp_form" model="ir.ui.view">
        <field name="name">mrp.work.order.form.lab</field>
        <field name="model">mrp.workorder</field>
        <field name="inherit_id" ref="mrp.mrp_production_workorder_form_view_inherit"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="mrwo_id" required="1"/>
            </xpath>
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <!-- Cantidad producida: siempre readonly y visible a todos (quita
                 la restricción group_no_one de la vista base). -->
            <xpath expr="//field[@name='qty_produced']" position="attributes">
                <attribute name="readonly">1</attribute>
                <attribute name="groups"></attribute>
            </xpath>
            <!-- No se usa serie/lote en textil: ocultar "Números de serie/lote"
                 (el del grupo superior; hay otro igual dentro de una lista de
                 la vista de calidad que no se debe tocar). -->
            <xpath expr="//group//field[@name='finished_lot_ids'][@widget='many2many_tags']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <!-- Junto a la Orden de fabricación: cuántos rollos cuentan como
                 producción de esta OT (avance; excluye transferidos). -->
            <xpath expr="//field[@name='production_id']" position="after">
                <field name="produced_roll_count" invisible="operation_type != 'weaving'"/>
            </xpath>
            <!-- Tipo de operación / estimaciones (izq) y cantidad producida +
                 planificación de rollos (der) bajan a su propio grupo, debajo
                 de fecha inicio / OF. -->
            <xpath expr="//field[@name='production_id']/../.." position="after">
                <group>
                    <group>
                        <field name="operation_type"/>
                        <field name="estimated_rate_kg_h" invisible="operation_type != 'weaving'"/>
                        <field name="estimated_roll_count" invisible="operation_type != 'weaving'"/>
                        <field name="weaving_estimate_warning" invisible="operation_type != 'weaving' or not weaving_estimate_warning"/>
                    </group>
                    <group name="idtx_produced_group">
                        <field name="estimated_weight_per_roll" invisible="operation_type != 'weaving'"/>
                        <field name="rolls_to_produce" invisible="operation_type != 'weaving'"/>
                    </group>
                </group>
            </xpath>
            <!-- Mover la cantidad producida (base) al grupo nuevo, encima del
                 peso estimado (move como hijo directo del xpath; anidado en
                 contenido nuevo NO se procesa). -->
            <xpath expr="//group[@name='idtx_produced_group']/field[@name='estimated_weight_per_roll']" position="before">
                <xpath expr="//field[@name='qty_produced']" position="move"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Options" name="options" invisible="operation_type != 'weaving'">
                    <field name="option_ids" readonly="state not in ('ready','progress')" context="{'default_workorder_id': id}">
                        <list>
                            <field name="name" readonly="1" force_save="1"/>
                            <field name="employee_ids" widget="many2many_tags"/>
                            <field name="available_equipment_ids" column_invisible="1"/>
                            <field name="equipment_ids" widget="many2many_tags" domain="[('id','in',available_equipment_ids)]"/>
                            <field name="estimated_rate_kg_h" readonly="1"/>
                            <!-- <field name="option_line_ids" widget="many2many_tags" readonly="1" force_save="1"/> -->
                        </list>
                    </field>
                </page>
                <page string="Rolls" name="rolls" invisible="operation_type != 'weaving'">
                    <field name="roll_ids" readonly="state != 'progress'">
                        <list editable="bottom" decoration-success="transfer_state == 'transferido'" decoration-info="transfer_state == 'recibido'">
                            <field name="sequence" widget="handle"/>
                            <field name="transfer_state" string="Transf." readonly="1" optional="show"/>
                            <field name="name"/>
                            <field name="option_id" required="1"/>
                            <field name="equipment_ids" column_invisible="1"/>
                            <field name="employee_ids" column_invisible="1"/>
                            <field name="equipment_id" domain="[('id','in',equipment_ids)]" required="1"/>
                            <field name="employee_id" domain="[('id','in',employee_ids)]" required="1"/>
                            <field name="uom_id"/>
                            <field name="quantity"/>
                            <field name="in_batch" column_invisible="1"/>
                            <field name="gross_weight" sum="Total" required="1" readonly="in_batch"/>
                            <field name="net_weight" sum="Total" required="1"/>
                            <field name="roll_start"/>
                            <field name="roll_end"/>
                            <!-- <button name="unlink" icon="fa-trash" type="object" invisible="gross_weight" title="Delete" id="unlink_button_weight"/>
                            <button name="unlink" icon="fa-trash" type="object" invisible="quantity" title="Delete" id="unlink_button_quantity"/> -->
                        </list>
                    </field>
                </page>
                <page string="Batchs" name="batchs" invisible="operation_type == 'weaving'">
                    <field name="batch_ids" readonly="state != 'progress'" domain="[('state','=','batch')]" create="0">
                        <list>
                            <field name="sequence" widget="handle"/>
                            <field name="name" readonly="1"/>
                            <field name="batch_date" readonly="1"/>
                            <field name="mrwo_id" readonly="1"/>
                            <field name="total_weight" sum="Total" readonly="1"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
    
</odoo>