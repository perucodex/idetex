<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mrp_workorder_roll_form" model="ir.ui.view">
        <field name="name">mrp.workorder.roll.form</field>
        <field name="model">mrp.workorder.roll</field>
        <field name="arch" type="xml">
            <form string="Roll">
                <sheet>
                    <widget name="web_ribbon" title="Transferido" bg_color="text-bg-success" invisible="transfer_state != 'transferido'"/>
                    <widget name="web_ribbon" title="Recibido" bg_color="text-bg-info" invisible="transfer_state != 'recibido'"/>
                    <group>
                        <group>
                            <field name="transfer_state" invisible="1"/>
                            <field name="workorder_id" readonly="1" string="OT (Tejido)"/>
                            <field name="dest_workorder_id" readonly="1" invisible="transfer_state != 'transferido'"/>
                            <field name="transfer_origin_roll_id" readonly="1" invisible="transfer_state != 'recibido'"/>
                            <field name="name" readonly="1"/>
                            <field name="product_id"/>
                            <field name="uom_id"/>
                        </group>
                        <group>
                            <field name="quantity" readonly="1" invisible="not quantity"/>
                            <field name="net_weight" readonly="1"/>
                            <field name="gross_weight" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    
    <record id="mrp_workorder_roll_view_search" model="ir.ui.view">
        <field name="name">mrp.workorder.roll.view.search</field>
        <field name="model">mrp.workorder.roll</field>
        <field name="arch" type="xml">
            <search string="Search Roll">
                <field name="workorder_id"/>
                <field name="name"/>
                <field name="product_id"/>
                <group>
                    <filter name="group_workorder" string="Orden de Trabajo" context="{'group_by': 'workorder_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="mrp_workorder_roll_view_tree" model="ir.ui.view">
        <field name="name">mrp.workorder.roll.view.tree</field>
        <field name="model">mrp.workorder.roll</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" decoration-success="transfer_state == 'transferido'" decoration-info="transfer_state == 'recibido'">
                <header>
                    <button name="reprint" string="Reprint" type="object"/>
                </header>
                <field name="transfer_state" string="Transf." optional="show"/>
                <field name="workorder_id"/>
                <field name="dest_workorder_id" string="Transferido a" optional="show"/>
                <field name="transfer_origin_roll_id" string="Rollo origen" optional="hide"/>
                <field name="name"/>
                <field name="product_id"/>
                <field name="uom_id"/>
                <field name="quantity" sum="Total"/>
                <field name="net_weight" sum="Total"/>
                <field name="gross_weight" sum="Total"/>
            </list>
        </field>
    </record>

    <record id="wo_rolls_action" model="ir.actions.act_window">
        <field name="name">Rolls</field>
        <field name="res_model">mrp.workorder.roll</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="mrp_workorder_roll_view_tree"/>
        <field name="context">{'search_default_group_workorder': 1}</field>
    </record>
    
</odoo>