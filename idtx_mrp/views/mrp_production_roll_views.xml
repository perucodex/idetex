<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_batch_add_wizard" model="ir.actions.act_window">
        <field name="name">Agregar registros</field>
        <field name="res_model">batch.add.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    
    <record id="mrp_production_roll_view_search" model="ir.ui.view">
        <field name="name">mrp.production.roll.view.search</field>
        <field name="model">mrp.production.roll</field>
        <field name="arch" type="xml">
            <search string="Search Roll">
                <field name="production_id"/>
                <field name="name"/>
                <field name="product_id"/>
                <field name="lot_id"/>
                <group>
                    <filter name="group_production" string="Orden de Fabricación" context="{'group_by': 'production_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Form de solo lectura: el peso/lote de un rollo pesado respaldan su
         quant; corregirlos a mano desincronizaría el stock. -->
    <record id="mrp_production_roll_form" model="ir.ui.view">
        <field name="name">mrp.production.roll.form</field>
        <field name="model">mrp.production.roll</field>
        <field name="arch" type="xml">
            <form string="Rollo Terminado">
                <header>
                    <button name="reprint" string="Reimprimir" type="object"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="production_id" readonly="1"/>
                            <field name="batch_id" readonly="1" string="Partida" invisible="not batch_id"/>
                            <field name="wo_roll_id" readonly="1" invisible="not wo_roll_id"/>
                            <field name="name" readonly="1"/>
                            <field name="lot_id" readonly="1" string="Lote"/>
                            <field name="product_id" readonly="1"/>
                            <field name="uom_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="quantity" readonly="1" invisible="not quantity"/>
                            <field name="net_weight" readonly="1"/>
                            <field name="gross_weight" readonly="1"/>
                            <field name="net_length" readonly="1" invisible="not net_length"/>
                            <field name="weighed_date" readonly="1" invisible="not weighed_date"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="mrp_production_roll_view_tree" model="ir.ui.view">
        <field name="name">mrp.production.roll.view.tree</field>
        <field name="model">mrp.production.roll</field>
        <field name="arch" type="xml">
            <list create="0" edit="0">
                <header>
                    <button name="reprint" string="Reprint" type="object"/>
                </header>
                <field name="production_id"/>
                <field name="name"/>
                <field name="product_id"/>
                <field name="uom_id"/>
                <field name="lot_id"/>
                <field name="quantity" sum="Total"/>
                <field name="net_weight" sum="Total"/>
                <field name="net_length" sum="Total"/>
                <field name="weighed_date" optional="show"/>
            </list>
        </field>
    </record>

    <record id="mrp_rolls_action" model="ir.actions.act_window">
        <field name="name">Production Rolls</field>
        <field name="res_model">mrp.production.roll</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="mrp_production_roll_view_tree"/>
        <field name="context">{'search_default_group_production': 1}</field>
    </record>
    
</odoo>