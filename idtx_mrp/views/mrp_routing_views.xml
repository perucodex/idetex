<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="mrp_routing_workcenter_operation_form_view" model="ir.ui.view">
            <field name="name">mrp.routing.workcenter.operation.form</field>
            <field name="model">mrp.routing.workcenter.operation</field>
            <field name="arch" type="xml">
                <form string="Routing Work Centers Operations">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="workcenter_id"/>
                                <field name="operation_type"/>
                                <field name="parent_operation_id"/>
                            </group>
                            <group>
                                <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                            </group>
                        </group>
                        <notebook>
                            <page name="parameter_page" string="Parameters">
                                <field name="parameter_ids">
                                    <list editable="bottom">
                                        <field name="name" />
                                    </list> 
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="mrp_routing_workcenter_operation_tree_view" model="ir.ui.view">
            <field name="name">mrp.routing.workcenter.list</field>
            <field name="model">mrp.routing.workcenter.operation</field>
            <field name="arch" type="xml">
                <list string="Routing Work Centers Operations" multi_edit="1" sample="1">
                    <field name="name"/>
                    <field name="fas_code"/>
                    <field name="workcenter_id"/>
                    <field name="operation_type"/>
                    <field name="parent_operation_id"/>
                    <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                </list>
            </field>
        </record>

        <record id="mrp_routing_workcenter_operation_view_search" model="ir.ui.view">
            <field name="name">mrp.routing.workcenter.operation.view.search</field>
            <field name="model">mrp.routing.workcenter.operation</field>
            <field name="arch" type="xml">
                <search string="">
                    <field name="name"/>
                    <field name="fas_code" string="Código MSSQL"/>
                    <field name="workcenter_id"/>
                    <field name="operation_type"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <group>
                        <filter string="Workcenter" name="group_by_workcenter" domain="[]" context="{'group_by': 'workcenter_id'}"/>
                        <filter string="Operation Type" name="group_by_operation_type" domain="[]" context="{'group_by': 'operation_type'}"/>
                        <filter string="Fase Padre" name="group_by_parent_operation" domain="[]" context="{'group_by': 'parent_operation_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="mrp_routing_workcenter_form_view_inherit" model="ir.ui.view">
            <field name="name">mrp.routing.workcenter.form.inherit</field>
            <field name="model">mrp.routing.workcenter</field>
            <field name="inherit_id" ref="mrp.mrp_routing_workcenter_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="after">
                    <field name="operation_id"/>
                </xpath>
                <xpath expr="//field[@name='name']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
            </field>
        </record>

        <record id="mrp_workcenter_view_inherit" model="ir.ui.view">
            <field name="name">mrp.workcenter.form.inherit</field>
            <field name="model">mrp.workcenter</field>
            <field name="inherit_id" ref="mrp.mrp_workcenter_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="after">
                    <field name="operation_type"/>
                </xpath>
                <xpath expr="//button[@name='action_show_operations']" position="after">
                    <button type="object" name="action_show_workcenter_operations" invisible="not has_routing_lines" context="{'default_workcenter_id': id}" class="oe_stat_button" icon="fa-cog">
                        <div class="o_stat_info">
                            <span class="o_stat_text">Workcenter Operations</span>
                        </div>
                    </button>
                </xpath>
            </field>
        </record>

        <record id="mrp_routing_operation_action" model="ir.actions.act_window">
            <field name="name">Workcenter Operations</field>
            <field name="res_model">mrp.routing.workcenter.operation</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="mrp_routing_workcenter_operation_tree_view"/>
            <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                Create a new operation
              </p><p>
                Operation define that need to be done to realize a Work Order.
                Each operation is done at a specific Work Center and has a specific price.
              </p>
            </field>
        </record>

    </data>
</odoo>
