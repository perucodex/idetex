<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View para mrp.workorder.option -->
    <record id="mrp_workorder_option_form" model="ir.ui.view">
        <field name="name">mrp.workorder.option.form</field>
        <field name="model">mrp.workorder.option</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" required="1"/>
                        <field name="workorder_id" readonly="1"/>
                        <field name="employee_ids" widget="many2many_tags" required="1"/>
                        <field name="workcenter_id" invisible="1"/>
                        <field name="available_equipment_ids" invisible="1"/>
                        <field name="equipment_ids" widget="many2many_tags" required="1" domain="[('id','in',available_equipment_ids)]"/>
                        <field name="available_thread_product_ids" invisible="1"/>
                        <field name="notes"/>
                        <field name="weight_per_rev_g" readonly="1"/>
                        <field name="estimated_rate_kg_h" readonly="1"/>
                        <field name="weaving_estimate_warning" readonly="1" invisible="not weaving_estimate_warning"/>
                    </group>
                    <separator string="Option Lines"/>
                    <field name="option_line_ids">
                        <list editable="bottom">
                            <field name="product_id" required="1" domain="[('id', 'in', parent.available_thread_product_ids)]"/>
                            <field name="lot_id" required="1" domain="[('product_id', '=', product_id), ('id', 'in', available_lot_ids)]" options="{'no_create': True}"/>
                        </list>
                    </field>
                    <div class="alert alert-info" role="alert">
                        <p><strong>Nota:</strong> Los hilados se cargan automáticamente desde la orden de producción. Todos los hilos deben estar presentes en la opción.</p>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="mrp_workorder_option_tree" model="ir.ui.view">
        <field name="name">mrp.workorder.option.tree</field>
        <field name="model">mrp.workorder.option</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="workorder_id"/>
                <field name="employee_ids" widget="many2many_tags"/>
                <field name="equipment_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <!-- Action para abrir mrp.workorder.option -->
    <record id="mrp_workorder_option_action" model="ir.actions.act_window">
        <field name="name">Workorder Options</field>
        <field name="res_model">mrp.workorder.option</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
