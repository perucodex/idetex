<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="seq_mrp_workorder_batch" model="ir.sequence">
        <field name="name">Batch</field>
        <field name="code">mrp.workorder.batch</field>
        <field name="prefix">WB</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_mrp_workorder_roll" model="ir.sequence">
        <field name="name">Roll</field>
        <field name="code">mrp.workorder.roll</field>
        <field name="prefix">%(y)s%(month)s</field>
        <field name="padding">6</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>
