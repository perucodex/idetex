<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="idtx_report_invoice_document" inherit_id="l10n_pe_edi.report_invoice_document">
        <xpath expr="//t[@t-call='web.external_layout']" position="replace">
            <t t-call="web.html_container">
                <t t-set="o" t-value="o.with_context(lang=lang)" />
                <t t-set="extra_edi_vals" t-value="o._l10n_pe_edi_get_extra_report_values()"/>
                
                <div class="header">
                    <div class="row" style="margin-bottom: 0px; font-family: sans-serif;">
                        <!-- Logo -->
                        <div class="col-4 text-start">
                            <img t-if="o.company_id.logo" t-att-src="image_data_uri(o.company_id.logo)" style="max-height: 80px;" alt="Logo"/>
                            <div style="font-size: 8px; font-weight: bold; margin-top: 5px;">
                                <t t-esc="o.company_id.name.upper()"/>
                            </div>
                        </div>
                        
                        <!-- Company Address -->
                        <div class="col-4 text-center" style="font-size: 10px;">
                            <div t-esc="o.company_id.street"/>
                            <div t-esc="o.company_id.street2"/>
                            <div><t t-esc="o.company_id.city"/> <t t-if="o.company_id.state_id" t-esc="'- ' + o.company_id.state_id.name"/></div>
                            <div>TELF : <t t-esc="o.company_id.phone"/></div>
                        </div>
                        
                        <!-- RUC and Document Info Box -->
                        <div class="col-4">
                            <div style="border: 2px solid black; padding: 10px; text-align: center; border-radius: 0px;">
                                <h5 style="font-weight: bold; margin-bottom: 5px; font-size: 16px;">R.U.C. <t t-esc="o.company_id.vat"/></h5>
                                <h5 style="font-weight: bold; margin-bottom: 5px; font-size: 16px;">
                                    <t t-if="o.move_type == 'out_invoice'">FACTURA ELECTRONICA</t>
                                    <t t-elif="o.move_type == 'out_refund'">NOTA DE CREDITO ELECTRONICA</t>
                                    <t t-else="">COMPROBANTE</t>
                                </h5>
                                <h5 style="font-weight: bold; margin-bottom: 0px; font-size: 16px;">
                                    <t t-esc="o.name.replace('-', '  N° ') if '-' in o.name else o.name"/>
                                </h5>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="article" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')">
                    <style>
                        @media print {
                            .web-only-spacer {
                                display: none !important;
                            }
                        }
                    </style>
                    <div class="page" style="font-family: sans-serif; font-size: 11px;">
                    <!-- Customer Information Block -->
                    <table class="table-borderless" style="width: 100%; margin-bottom: 5px; border-collapse: collapse;">
                        <tr>
                            <td style="width: 12%; font-weight: bold; border: none; padding: 2px;">SEÑORES</td>
                            <td style="width: 2%; border: none; padding: 2px;">:</td>
                            <td style="width: 50%; border: none; padding: 2px;"><t t-esc="o.partner_id.name"/></td>
                            <td style="width: 15%; font-weight: bold; border: none; padding: 2px;">F.EMISION</td>
                            <td style="width: 2%; border: none; padding: 2px;">:</td>
                            <td style="width: 19%; border: none; padding: 2px;"><t t-esc="o.invoice_date.strftime('%d/%m/%Y') if o.invoice_date else ''"/></td>
                        </tr>
                        <tr>
                            <td style="font-weight: bold; border: none; padding: 2px;">DIRECCION</td>
                            <td style="border: none; padding: 2px;">:</td>
                            <td style="border: none; padding: 2px;"><t t-esc="o.partner_id.street"/> <t t-esc="o.partner_id.city"/></td>
                            <td style="font-weight: bold; border: none; padding: 2px;">GUIA REMISION</td>
                            <td style="border: none; padding: 2px;">:</td>
                            <td style="border: none; padding: 2px;">-</td>
                        </tr>
                        <tr>
                            <td style="font-weight: bold; border: none; padding: 2px;">RUC</td>
                            <td style="border: none; padding: 2px;">:</td>
                            <td style="border: none; padding: 2px;"><t t-esc="o.partner_id.vat"/></td>
                            <td style="font-weight: bold; border: none; padding: 2px;">N°O.COMPRA</td>
                            <td style="border: none; padding: 2px;">:</td>
                            <td style="border: none; padding: 2px;"><t t-esc="o.idtx_oc_ref"/></td>
                        </tr>
                        <tr>
                            <td style="font-weight: bold; border: none; padding: 2px;">PROCESO</td>
                            <td style="border: none; padding: 2px;">:</td>
                            <td style="border: none; padding: 2px;"><!-- Custom process field if any --></td>
                            <td style="font-weight: bold; border: none; padding: 2px;">T.C.</td>
                            <td style="border: none; padding: 2px;">:</td>
                            <td style="border: none; padding: 2px;"><t t-esc="abs(o.amount_total_signed / o.amount_total) if o.amount_total and o.currency_id != o.company_id.currency_id else 1.000" t-options='{"widget": "float", "precision": 3}'/></td>
                        </tr>
                        <tr>
                            <td style="font-weight: bold; border: none; padding: 2px;">MONEDA</td>
                            <td style="border: none; padding: 2px;">:</td>
                            <td style="border: none; padding: 2px;"><t t-esc="o.currency_id.name"/></td>
                            <td style="font-weight: bold; border: none; padding: 2px;">C/PAGO</td>
                            <td style="border: none; padding: 2px;">:</td>
                            <td style="border: none; padding: 2px;"><t t-esc="o.invoice_payment_term_id.name if o.invoice_payment_term_id else 'CONTADO'"/></td>
                        </tr>
                    </table>

                    <!-- Lines Table -->
                    <table class="table table-sm table-borderless" style="border: 2px solid black; margin-bottom: 5px;">
                        <thead>
                            <tr style="border-bottom: 2px solid black;">
                                <th class="text-center" style="border-right: 1px solid black; width: 8%;">CANTID.</th>
                                <th class="text-center" style="border-right: 1px solid black; width: 8%;">U.M.</th>
                                <th class="text-center" style="border-right: 1px solid black; width: 38%;">DESCRIPCIÓN</th>
                                <th class="text-center" style="border-right: 1px solid black; width: 12%;">COLOR</th>
                                <th class="text-center" style="border-right: 1px solid black; width: 10%;">COD</th>
                                <th class="text-center" style="border-right: 1px solid black; width: 12%;">VALOR UNITARIO</th>
                                <th class="text-center" style="width: 12%;">V. VENTA</th>
                            </tr>
                        </thead>
                        <tbody style="min-height: 200px;">
                            <t t-foreach="o.invoice_line_ids" t-as="line">
                                <tr>
                                    <t t-if="line.display_type not in ('line_note', 'line_section')">
                                        <td class="text-end" style="border-right: 1px solid black;"><t t-esc="line.quantity" t-options='{"widget": "float", "precision": 2}'/></td>
                                        <td class="text-center" style="border-right: 1px solid black;"><t t-esc="line.product_uom_id.name"/></td>
                                        <td style="border-right: 1px solid black;"><t t-esc="line.name"/></td>
                                        <td style="border-right: 1px solid black;"><t t-esc="line.idtx_get_color_name()"/></td>
                                        <td style="border-right: 1px solid black;"><t t-esc="line.product_id.default_code"/></td>
                                        <td class="text-end" style="border-right: 1px solid black;"><t t-esc="line.price_unit" t-options='{"widget": "float", "precision": 2}'/></td>
                                        <td class="text-end"><t t-esc="line.price_subtotal" t-options='{"widget": "float", "precision": 2}'/></td>
                                    </t>
                                    <t t-else="">
                                        <td style="border-right: 1px solid black;"></td>
                                        <td style="border-right: 1px solid black;"></td>
                                        <td style="border-right: 1px solid black;">
                                            <span t-if="line.display_type == 'line_section'" style="font-weight: bold;"><t t-esc="line.name"/></span>
                                            <span t-if="line.display_type == 'line_note'" style="font-style: italic;"><t t-esc="line.name"/></span>
                                        </td>
                                        <td style="border-right: 1px solid black;"></td>
                                        <td style="border-right: 1px solid black;"></td>
                                        <td style="border-right: 1px solid black;"></td>
                                        <td></td>
                                    </t>
                                </tr>
                            </t>
                            <!-- Dynamic filler row height -->
                            <t t-set="is_credit" t-value="o.invoice_payment_term_id and 'contado' not in o.invoice_payment_term_id.name.lower()"/>
                            <t t-set="filler_height" t-value="450"/>
                            <tr t-attf-style="height: {{filler_height}}px;">
                                <td t-attf-style="border-right: 1px solid black; border-left: 1px solid black; color: transparent; height: {{filler_height}}px;">-</td>
                                <td style="border-right: 1px solid black; color: transparent;">-</td>
                                <td style="border-right: 1px solid black; color: transparent;">-</td>
                                <td style="border-right: 1px solid black; color: transparent;">-</td>
                                <td style="border-right: 1px solid black; color: transparent;">-</td>
                                <td style="border-right: 1px solid black; color: transparent;">-</td>
                                <td style="border-right: 1px solid black; color: transparent;">-</td>
                            </tr>
                            <tr style="border-top: 1px solid black; border-bottom: 1px solid black;">
                                <td colspan="7" class="text-center" style="font-size: 9px; padding: 4px; border-left: 1px solid black; border-right: 1px solid black;">
                                    OPERACION SUJETA AL SPOT CON EL GOBIERNO CENTRAL CTA CTE 00019002705 BANCO DE LA NACION.
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <!-- Totals and SPOT Block -->
                    <div style="page-break-inside: avoid;">
                        <div style="border: 1px solid black; padding: 4px; font-size: 11px; font-weight: bold; margin-bottom: 5px;">
                            SON: <t t-esc="extra_edi_vals.get('amount_to_text', '').upper() if extra_edi_vals and extra_edi_vals.get('amount_to_text') else (o.amount_total_words or '').upper()"/>
                        </div>

                    <!-- Footer Blocks -->
                    <div style="border: 1px solid black; margin-top: 5px;">
                        <div class="row m-0">
                            <!-- Legal and QR block -->
                            <div class="col-8 p-1" style="font-size: 9px; border-right: 1px solid black;">
                                <div>AGENTES DE RETENCION R.S. No 037-2002/SUNAT Y R.S. no 174-2005/SUNAT</div>
                                <br/>
                                <br/>
                                <div>REPRESENTACION IMPRESA DEL DOCUMENTO ELECTRONICO</div>
                                <div>R. Superintendencia Nº 0180050002244-SUNAT</div>
                                <div>Consultar el documento en http://www.comprobante-digital.com/?ruc=<t t-esc="o.company_id.vat"/></div>
                            </div>
                            <!-- Amounts block -->
                            <div class="col-4 p-1" style="font-size: 11px;">
                                <table class="table-borderless" style="width: 100%; border-collapse: collapse;">
                                    <tr>
                                        <td style="font-weight: bold; border: none; padding: 2px;">TOTAL VENTA</td>
                                        <td style="border: none; padding: 2px;"><t t-esc="o.currency_id.symbol"/></td>
                                        <td class="text-end" style="border: none; padding: 2px;"><t t-esc="o.amount_untaxed" t-options='{"widget": "float", "precision": 2}'/></td>
                                    </tr>
                                    <tr>
                                        <td style="font-weight: bold; border: none; padding: 2px;">DESCUENTO</td>
                                        <td style="border: none; padding: 2px;"><t t-esc="o.currency_id.symbol"/></td>
                                        <td class="text-end" style="border: none; padding: 2px;">0.00</td>
                                    </tr>
                                    <tr>
                                        <td style="font-weight: bold; border: none; padding: 2px;">IGV</td>
                                        <td style="border: none; padding: 2px;"><t t-esc="o.currency_id.symbol"/></td>
                                        <td class="text-end" style="border: none; padding: 2px;"><t t-esc="o.amount_tax" t-options='{"widget": "float", "precision": 2}'/></td>
                                    </tr>
                                    <tr>
                                        <td style="font-weight: bold; border: none; padding: 2px;">IMPORTE TOTAL</td>
                                        <td style="border: none; padding: 2px;"><t t-esc="o.currency_id.symbol"/></td>
                                        <td class="text-end" style="border: none; padding: 2px;"><t t-esc="o.amount_total" t-options='{"widget": "float", "precision": 2}'/></td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </div>

                    <div class="row" style="font-size: 9px; margin-top: 5px;">
                        <div class="col-4">
                            <img t-if="extra_edi_vals and extra_edi_vals.get('qr_str')" t-att-src="'https://api.qrserver.com/v1/create-qr-code/?size=100x100&amp;data=%s' % extra_edi_vals['qr_str'].strip()" style="max-height: 80px; max-width: 80px;"/>
                        </div>
                        <div class="col-8 text-end">
                            <t t-if="o.invoice_payment_term_id">
                                <table class="table table-sm table-bordered text-center" style="font-size: 10px; border: 1px solid black; margin-bottom: 0px;">
                                    <tr>
                                        <td style="border: 1px solid black; font-weight: bold;">Forma de Pago:</td>
                                        <td colspan="3" style="border: 1px solid black;"><t t-esc="o.invoice_payment_term_id.name"/></td>
                                    </tr>
                                    <tr>
                                        <td style="border: 1px solid black;">Detracción:</td>
                                        <t t-set="spot" t-value="o._l10n_pe_edi_get_spot()"/>
                                        <td style="border: 1px solid black;"><t t-if="spot and 'amount' in spot">S/ <t t-esc="spot['amount']"/></t></td>
                                        <td style="border: 1px solid black;">Importe a Cobrar:</td>
                                        <td style="border: 1px solid black;"><t t-esc="o.amount_total"/></td>
                                    </tr>
                                    <tr style="font-weight: bold;">
                                        <td style="border: 1px solid black;">Cuota</td>
                                        <td style="border: 1px solid black;">F.Vencimiento</td>
                                        <td style="border: 1px solid black;">Moneda</td>
                                        <td style="border: 1px solid black;">Monto</td>
                                    </tr>
                                    <!-- Only show installments if there are multiple receivables -->
                                    <t t-set="cuota_idx" t-value="1"/>
                                    <t t-foreach="o.line_ids.filtered(lambda l: l.account_id.account_type == 'asset_receivable')" t-as="term">
                                        <tr>
                                            <td style="border: 1px solid black;"><t t-esc="cuota_idx"/></td>
                                            <td style="border: 1px solid black;"><t t-esc="term.date_maturity.strftime('%d/%m/%Y') if term.date_maturity else ''"/></td>
                                            <td style="border: 1px solid black;"><t t-esc="o.currency_id.name"/></td>
                                            <td style="border: 1px solid black;"><t t-esc="abs(term.amount_currency)" t-options='{"widget": "float", "precision": 2}'/></td>
                                        </tr>
                                        <t t-set="cuota_idx" t-value="cuota_idx + 1"/>
                                    </t>
                                </table>
                            </t>
                        </div>
                    </div>
                    <div style="height: 90px; clear: both; display: block;" class="web-only-spacer">&amp;nbsp;</div>
                    </div> <!-- End of page-break-inside avoid -->
                </div>
                </div>
            </t>
        </xpath>
    </template>
</odoo>
