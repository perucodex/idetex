<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="idtx_view_out_invoice_tree_edi_badge" model="ir.ui.view">
        <field name="name">account.move.tree.edi.badge</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='edi_state']" position="attributes">
                <attribute name="string">Sunat</attribute>
                <attribute name="widget">badge</attribute>
                <attribute name="decoration-success">edi_state == 'sent'</attribute>
                <attribute name="decoration-warning">edi_state in ('to_send', 'to_cancel')</attribute>
                <attribute name="decoration-danger">edi_state == 'cancelled'</attribute>
                <attribute name="decoration-info">edi_state == False</attribute>
            </xpath>
            <xpath expr="//field[@name='move_sent_values']" position="attributes">
                <attribute name="string">Env.Cliente</attribute>
            </xpath>
        </field>
    </record>

    <record id="idtx_view_move_form_inherit" model="ir.ui.view">
        <field name="name">account.move.form.inherit.idetex</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_shipping_id']" position="after">
                <field name="idtx_oc_ref" string="N° O. Compra" invisible="move_type not in ('out_invoice', 'out_refund')" readonly="state != 'draft'"/>
                <field name="proceso" invisible="move_type not in ('out_invoice', 'out_refund')" readonly="state != 'draft'"/>
            </xpath>
        </field>
    </record>
</odoo>
