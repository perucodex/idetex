<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_payment_term_form_inherit_idtx" model="ir.ui.view">
        <field name="name">account.payment.term.form.inherit.idtx</field>
        <field name="model">account.payment.term</field>
        <field name="inherit_id" ref="account.view_payment_term_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='sitpro_code']" position="after">
                <field name="idtx_installments_count"/>
            </xpath>
        </field>
    </record>
</odoo>
