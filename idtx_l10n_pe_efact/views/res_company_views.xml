<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Flag "Alquiler / suscripciones": habilita N° O. Compra y Proceso en
         las facturas (y Proceso en pedidos/suscripciones) de la empresa. -->
    <record id="view_company_form_rental" model="ir.ui.view">
        <field name="name">res.company.form.rental.efact</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='vat']" position="after">
                <field name="idtx_rental_subscriptions"/>
            </xpath>
        </field>
    </record>
</odoo>
