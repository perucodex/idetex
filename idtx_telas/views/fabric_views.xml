<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Search View -->
    <record id="view_idtx_fabric_search" model="ir.ui.view">
        <field name="name">idtx.fabric.search</field>
        <field name="model">idtx.fabric</field>
        <field name="arch" type="xml">
            <search string="Buscar Telas">
                <field name="name"/>
                <field name="code"/>
            </search>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_idtx_fabric_form" model="ir.ui.view">
        <field name="name">idtx.fabric.form</field>
        <field name="model">idtx.fabric</field>
        <field name="arch" type="xml">
            <form string="Tela">
                <header>
                    <field name="state" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'image_128'}"/>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" placeholder="Ej. Algodón Jersey 200gsm"/></h1>
                        <h3><field name="code" placeholder="Referencia Interna"/></h3>
                        <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}" placeholder="Etiquetas..."/>
                        <div class="o_row">
                            <field name="priority" widget="priority"/>
                        </div>
                    </div>
                    <group>
                        <group name="group_general">
                            <field name="barcode"/>
                            <field name="active" invisible="1"/>
                            <field name="uom_name"/>
                            <field name="is_sustainable" widget="boolean_toggle"/>
                            <field name="video_url" widget="url"/>
                        </group>
                        <group name="group_stock">
                            <field name="stock_qty"/>
                            <field name="fabric_grade"/>
                            <field name="kanban_color" widget="color_picker"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Información Técnica" name="technical_info">
                            <group>
                                <group string="Especificaciones">
                                    <field name="composition_id" placeholder="Seleccionar o Crear..."/>
                                    <field name="gsm"/>
                                    <field name="width"/>
                                    <field name="weaving_type"/>
                                </group>
                                <group string="Visual y Detalles">
                                    <field name="color"/>
                                    <field name="pattern"/>
                                    <field name="thread_count"/>
                                    <field name="datasheet_file" filename="datasheet_filename"/>
                                    <field name="datasheet_filename" invisible="1"/>
                                </group>
                            </group>
                        </page>
                        <page string="Comercial" name="commercial_info">
                            <group>
                                <group string="Compras">
                                    <field name="partner_id"/>
                                    <field name="cost_price" widget="monetary"/>
                                    <field name="date_receipt"/>
                                </group>
                                <group string="Ventas">
                                    <field name="list_price" widget="monetary"/>
                                    <field name="currency_id" invisible="1"/>
                                </group>
                                <group string="Validez">
                                    <field name="validity_start"/>
                                    <field name="validity_end"/>
                                </group>
                            </group>
                        </page>
                        <page string="Cuidados y Notas" name="care_page">
                            <group>
                                <field name="last_inspection"/>
                                <field name="date_validation"/>
                            </group>
                            <separator string="Instrucciones de Cuidado"/>
                            <field name="care_instructions" placeholder="Ingrese instrucciones HTML aquí..."/>
                            <separator string="Notas Internas"/>
                            <field name="description" placeholder="Añadir notas..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="view_idtx_fabric_kanban" model="ir.ui.view">
        <field name="name">idtx.fabric.kanban</field>
        <field name="model">idtx.fabric</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="id"/>
                <field name="name"/>
                <field name="image_128"/>
                <field name="code"/>
                <field name="stock_qty"/>
                <field name="kanban_color"/>
                <field name="priority"/>
                <field name="tag_ids"/>
                <field name="uom_name"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_global_click p-0 mb-0 shadow-sm border-0 rounded overflow-hidden d-flex oe_kanban_color_#{record.kanban_color.raw_value}" style="height: 100px;">
                            <!-- Left: Square Image -->
                            <div class="flex-shrink-0 position-relative" style="width: 100px; height: 100px;">
                                <field name="image_128" widget="image" options="{'img_class': 'w-100 h-100 object-fit-cover'}" style="width: 100%; height: 100%; object-fit: cover;"/>
                            </div>

                            <!-- Right: Compact Content -->
                            <div class="flex-grow-1 p-2 d-flex flex-column justify-content-between overflow-hidden bg-white">
                                <div>
                                    <div class="d-flex justify-content-between align-items-start">
                                        <strong class="o_kanban_record_title d-block text-truncate text-dark" style="font-size: 0.95rem;">
                                            <field name="name"/>
                                        </strong>
                                        <div class="ms-1">
                                            <field name="priority" widget="priority"/>
                                        </div>
                                    </div>
                                    <small class="text-muted d-block text-truncate"><field name="code"/></small>
                                </div>

                                <div class="d-flex justify-content-between align-items-end mt-1">
                                    <div class="text-truncate">
                                        <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}" class="d-inline-block"/>
                                    </div>
                                    <div class="text-end flex-shrink-0 ps-1">
                                        <span t-if="record.stock_qty.raw_value > 0" class="badge bg-light text-success border border-success-subtle">
                                            <field name="stock_qty"/> <field name="uom_name"/>
                                        </span>
                                        <span t-else="" class="badge bg-light text-danger border border-danger-subtle">0</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- List View -->
    <record id="view_idtx_fabric_list" model="ir.ui.view">
        <field name="name">idtx.fabric.list</field>
        <field name="model">idtx.fabric</field>
        <field name="arch" type="xml">
            <list string="Telas" decoration-info="state == 'draft'" decoration-warning="state == 'development'" decoration-primary="state == 'sampling'" decoration-success="state == 'validated'" decoration-muted="state == 'obsolete'">
                <field name="priority" widget="priority" optional="show"/>
                <field name="code" optional="show"/>
                <field name="name"/>
                <field name="tag_ids" widget="many2many_tags" optional="show"/>
                <field name="composition_id" optional="show"/>
                <field name="gsm" optional="hide"/>
                <field name="width" optional="hide"/>
                <field name="stock_qty" sum="Total"/>
                <field name="uom_name"/>
                <field name="list_price" widget="monetary" optional="show"/>
                <field name="state" widget="badge" decoration-success="state == 'validated'"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_idtx_fabric" model="ir.actions.act_window">
        <field name="name">Telas</field>
        <field name="res_model">idtx.fabric</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea tu primera Tela
            </p>
            <p>
                Gestiona todos tus textiles técnicos aquí.
            </p>
        </field>
    </record>

    <!-- Menus -->
    <menuitem id="menu_idtx_fabric_root" 
              name="Telas"
              web_icon="idtx_telas,static/description/icon.png"
              sequence="10"/>

    <menuitem id="menu_idtx_fabric_main"
              name="Datos Maestros"
              parent="menu_idtx_fabric_root"
              sequence="1"/>

    <menuitem id="menu_idtx_fabric_action"
              name="Telas"
              parent="menu_idtx_fabric_main"
              action="action_idtx_fabric"
              sequence="1"/>

</odoo>
