<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- 🌿 MENÚ RAÍZ -->
    <menuitem id="menu_idtx_root" name="Telas" sequence="10"/>

    <!-- 🧵 SUBMENÚ 1: Catálogo con dos páginas -->
    <menuitem id="menu_idtx_catalogo_root"
              name="Catálogo"
              parent="menu_idtx_root"
              sequence="20"/>

    <!-- 📄 Página 1: Catálogo de Telas -->
    <record id="action_idtx_telas" model="ir.actions.act_window">
        <field name="name">Catálogo de Telas</field>
        <field name="res_model">idtx.tela</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_idtx_telas"
              name="Catálogo de Telas"
              parent="menu_idtx_catalogo_root"
              action="action_idtx_telas"
              sequence="10"/>

    <!-- 📄 Página 2: Fichas Técnicas -->
    <record id="action_idtx_fichas" model="ir.actions.act_window">
        <field name="name">Fichas Técnicas</field>
        <field name="res_model">idtx.tela</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('file', '!=', False)]</field>
    </record>

    <menuitem id="menu_idtx_fichas"
              name="Fichas Técnicas"
              parent="menu_idtx_catalogo_root"
              action="action_idtx_fichas"
              sequence="20"/>

    <!-- 🪡 SUBMENÚ 2: Lista de Productos (product.template) -->
    <record id="action_idtx_productos" model="ir.actions.act_window">
        <field name="name">Lista de Productos</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_idtx_productos"
              name="Lista de Productos"
              parent="menu_idtx_root"
              action="action_idtx_productos"
              sequence="30"/>

    <!-- ✅ FORMULARIO CORRECTAMENTE DEFINIDO COMO VISTA -->
    <record id="view_idtx_tela_form" model="ir.ui.view">
        <field name="name">idtx.tela.form</field>
        <field name="model">idtx.tela</field>
        <field name="arch" type="xml">
            <form string="Tela">
                <sheet>
                    <notebook>
                        <page string="Detalles">
                            <group>
                                <field name="name"/>
                                <field name="description"/>
                                <field name="color"/>
                            </group>
                        </page>
                        <page string="Ficha Técnica">
                            <group>
                                <field name="file" filename="file_name"/>
                                <field name="file_name" invisible="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
