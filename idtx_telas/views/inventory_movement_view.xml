<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- LIST VIEW -->
    <record id="view_inventory_movement_tree" model="ir.ui.view">
        <field name="name">inventory.movement.tree</field>
        <field name="model">inventory.movement</field>
        <field name="arch" type="xml">
            <list string="Movimientos de Inventario">
                <field name="name"/>
                <field name="date"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_inventory_movement_form" model="ir.ui.view">
        <field name="name">inventory.movement.form</field>
        <field name="model">inventory.movement</field>
        <field name="arch" type="xml">
            <form string="Movimiento de Inventario">

                <header>
                    <button name="action_confirm" type="object"
                            string="Confirmar" states="draft" class="oe_highlight"/>
                    <button name="action_reset" type="object"
                            string="Volver a borrador" states="done"/>
                    <field name="state" widget="statusbar"/>
                </header>

                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="date"/>
                        <field name="product_ids" widget="many2many_tags"/>
                        <field name="notes"/>
                    </group>
                </sheet>

            </form>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_inventory_movement" model="ir.actions.act_window">
        <field name="name">Movimientos de Inventario</field>
        <field name="res_model">inventory.movement</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- MENÚ -->
    <menuitem id="menu_inventory_root"
              name="Inventario Personalizado"
              sequence="10"/>

    <menuitem id="menu_inventory_movement"
              name="Movimientos"
              parent="menu_inventory_root"
              action="action_inventory_movement"
              sequence="10"/>

</odoo>
