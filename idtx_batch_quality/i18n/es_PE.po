#. module: idtx_batch_quality
#: model:mail.template,body_html:idtx_batch_quality.mail_template_laboratorio_summary_front
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"        Hello,\n"
"        <br/><br/>\n"
"        Please find attached the laboratory summary report for batch\n"
"        <span style=\"font-weight: bold;\" t-out=\"object.batch or ''\">C377961</span>.\n"
"        <br/><br/>\n"
"        </p><table role=\"presentation\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\" style=\"border-collapse:separate;\">\n"
"            <tr>\n"
