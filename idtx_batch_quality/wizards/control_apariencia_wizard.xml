<odoo>
    <record id="view_control_apariencia_wizard_form" model="ir.ui.view">
        <field name="name">control.apariencia.wizard.form</field>
        <field name="model">control.apariencia.wizard</field>
        <field name="arch" type="xml">
            <form string="Registrar Apariencia">
                <sheet>
                    <field name="pedido_line_id" invisible="1"/>

                    <group>
                        <group>
                            <field name="cliente" readonly="1"/>
                            <field name="articulo" readonly="1"/>
                            <field name="pedido" readonly="1"/>
                            <field name="partida" readonly="1"/>
                        </group>
                        <group>
                            <field name="hdr" readonly="1"/>
                            <field name="color_code" readonly="1"/>
                            <field name="color_name" readonly="1"/>
                            <field name="kilos" readonly="1"/>
                        </group>
                    </group>

                    <group>
                        <field name="rollo_num"/>
                    </group>

                    <field name="defecto_line_ids" nolabel="1">
                        <list create="0" delete="0">
                            <field name="defecto_id"/>
                            <field name="cantidad"/>
                        </list>
                    </field>

                </sheet>
                <footer>
                    <button string="Guardar" name="action_guardar" type="object" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary ms-auto"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_control_apariencia_wizard_tamano_defecto" model="ir.ui.view">
        <field name="name">control.apariencia.wizard.line.form</field>
        <field name="model">control.apariencia.wizard.line</field>
        <field name="arch" type="xml">
            <form string="Registrar Apariencia - Detalle Defecto">
                <sheet>
                    <group>
                        <field name="defecto_id" readonly="1"/>
                        <field name="cantidad" readonly="1"/>
                        <field name="is_hueco" invisible="1"/>
                    </group>
                    <group>
                        <field name="tamano_defecto_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="tamano" column_invisible="parent.is_hueco"/>
                                <field name="tamano_hueco" column_invisible="not parent.is_hueco"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>