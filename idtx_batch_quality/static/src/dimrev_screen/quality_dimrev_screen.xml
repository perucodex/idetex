<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="idtx_batch_quality.QualityDimrevScreen">
        <div class="o_qdr_root container-fluid">
            <header class="o_qdr_header">
                <div>
                    <h3 class="o_qdr_title">Evaluar Estabilidad y Revirado</h3>
                    <div class="o_qdr_subtitle text-muted" t-if="state.selectedPartidaData and !state.inEvaluation">
                        Partida: <b t-esc="state.selectedPartidaData.batch || '-'"/> ·
                        Cliente: <b t-esc="state.selectedPartidaData.customer || '-'"/>
                    </div>
                </div>
                <div class="dropdown">
                    <button class="btn btn-outline-secondary" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="fa fa-bars"/>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <t t-if="state.inEvaluation or state.selectedPartidaId">
                            <li>
                                <button class="dropdown-item" t-on-click="onBackToSearch">
                                    <i class="fa fa-arrow-left me-2"/>Volver a buscar partida
                                </button>
                            </li>
                            <li><hr class="dropdown-divider"/></li>
                        </t>
                        <li>
                            <button class="dropdown-item" t-on-click="close">
                                <i class="fa fa-sign-out me-2"/>Cerrar
                            </button>
                        </li>
                    </ul>
                </div>
            </header>

            <t t-if="state.error">
                <div class="alert alert-danger" t-esc="state.error"/>
            </t>

            <div class="row g-3">
                <div t-if="!state.inEvaluation" class="col-12 col-lg-4">
                    <div class="card o_qdr_card">
                        <div class="card-body">
                            <label class="form-label fw-bold">Partida</label>
                            <div class="o_qdr_autocomplete">
                                <input class="form-control form-control-lg o_qdr_input"
                                       type="text"
                                       placeholder="Buscar partida..."
                                       t-att-value="state.partidaQuery"
                                       t-on-input="onPartidaQueryInput"
                                       t-on-focus="onPartidaInputFocus"/>
                                <button t-if="state.selectedPartidaId"
                                        type="button"
                                        class="btn btn-sm btn-outline-secondary o_qdr_clear_btn"
                                        t-on-click="clearPartida">
                                    <i class="fa fa-times"/>
                                </button>
                                <t t-if="state.showPartidaDropdown and !state.selectedPartidaId">
                                    <div class="o_qdr_dropdown">
                                        <div class="o_qdr_dropdown_body">
                                            <t t-if="state.isSearchingPartida">
                                                <div class="o_qdr_dropdown_item text-muted">Buscando...</div>
                                            </t>
                                            <t t-elif="!filteredPartidas.length">
                                                <div class="o_qdr_dropdown_item text-muted">Sin resultados</div>
                                            </t>
                                            <t t-else="">
                                                <t t-foreach="filteredPartidas" t-as="partida" t-key="partida.id">
                                                    <button type="button"
                                                            class="o_qdr_dropdown_item o_qdr_dropdown_btn"
                                                            t-on-click="() => this.selectPartida(partida.id)">
                                                        <div class="o_qdr_dropdown_main" t-esc="partida.batch || '-'"/>
                                                        <div class="o_qdr_dropdown_sub">
                                                            <span t-esc="partida.customer || '-'"/> ·
                                                            <span t-esc="(partida.kilograms || 0) + ' kg'"/>
                                                        </div>
                                                    </button>
                                                </t>
                                            </t>
                                        </div>
                                    </div>
                                </t>
                            </div>

                            <div t-if="state.selectedPartidaData" class="mt-3">
                                <div><b>Cliente:</b> <span t-esc="state.selectedPartidaData.customer || '-'"/></div>
                                <div><b>Articulo:</b> <span t-esc="state.selectedPartidaData.article || '-'"/></div>
                                <div><b>Color:</b> <span t-esc="state.selectedPartidaData.color_name || '-'"/></div>
                                <div class="o_qdr_order_info mt-2 pt-2 border-top">
                                    <div><b>O/C Cliente:</b> <span t-esc="state.selectedPartidaData.oc_cliente || '-'"/></div>
                                    <div><b>Observaciones:</b> <span style="white-space: pre-wrap;" t-esc="state.selectedPartidaData.observaciones || '-'"/></div>
                                </div>
                                <div class="mt-2">
                                    <label class="form-label fw-bold">Tipo de Muestra</label>
                                    <select class="form-select"
                                            t-att-value="state.sampleType"
                                            t-on-change="onSampleTypeChange">
                                        <t t-foreach="SAMPLE_TYPE_OPTIONS" t-as="opt" t-key="opt.value">
                                            <option t-att-value="opt.value"
                                                    t-att-disabled="opt.value === '' and !!state.sampleType"
                                                    t-esc="opt.label"/>
                                        </t>
                                    </select>
                                </div>
                                <div class="mt-3 d-grid">
                                    <button class="btn btn-primary"
                                            t-att-disabled="!state.sampleType"
                                            t-on-click="startEvaluation">Comenzar evaluacion</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div t-att-class="state.inEvaluation ? 'col-12' : 'col-12 col-lg-8'">
                    <div t-if="!state.inEvaluation" class="card o_qdr_card">
                        <div class="card-body">
                            <h5 class="mb-2">Flujo de evaluacion</h5>
                            <div class="text-muted">1. Busca y selecciona la partida.</div>
                            <div class="text-muted">2. Pulsa <b>Comenzar evaluacion</b>.</div>
                            <div class="text-muted">3. En registros posteriores, selecciona 3er/5to/N.</div>
                            <div class="text-muted">4. Registra datos y pulsa <b>Finalizar</b> para guardar.</div>
                        </div>
                    </div>

                    <div t-if="state.inEvaluation" class="card o_qdr_card o_qdr_eval_card">
                        <div class="card-body o_qdr_eval_body">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h5 class="mb-0 d-flex align-items-center gap-2">
                                    <span>Captura manual / revision</span>
                                    <span t-if="state.repeatKind === 'reproceso'" class="badge text-bg-info">Reproceso</span>
                                    <span t-if="state.repeatKind === 'test'" class="badge text-bg-secondary">Test</span>
                                    <span t-if="state.pendingRepeatMode === 'editar'" class="badge text-bg-warning">Editando</span>
                                </h5>
                                <div class="btn-group">
                                    <button class="btn btn-dark btn-sm"
                                            t-att-class="state.voiceActive ? 'btn-danger btn-sm' : 'btn-dark btn-sm'"
                                            t-on-click="toggleVoiceInput">
                                        <i class="fa fa-microphone me-1"/>
                                        <t t-esc="state.voiceActive ? 'Escuchando' : 'Dictado'"/>
                                    </button>
                                    <button class="btn btn-outline-secondary btn-sm"
                                            t-if="!state.needsModeSelection and !state.repeatDecision.active"
                                            t-on-click="previousStep">Anterior</button>
                                    <button class="btn btn-outline-secondary btn-sm"
                                            t-if="!state.needsModeSelection and !state.repeatDecision.active and !state.reviewing and !isLastStep"
                                            t-on-click="nextStep">Siguiente</button>
                                        <button class="btn btn-primary btn-sm"
                                            t-if="canShowSaveProgress and !state.reviewing"
                                            t-att-disabled="!canFinalizeEvaluation"
                                            t-on-click="saveProgressEvaluation">Guardar avance</button>
                                    <button class="btn btn-success btn-sm"
                                            t-if="!state.needsModeSelection and !state.repeatDecision.active and !state.reviewing and isLastStep"
                                            t-att-disabled="!canFinalizeEvaluation"
                                            t-on-click="finalizeEvaluation">Revisar y Finalizar</button>
                                </div>
                            </div>

                            <div t-if="state.repeatDecision.active" class="o_qdr_voice_box mb-3">
                                <div class="small"><b>Ya existe una evaluacion completa de este lavado.</b></div>
                                <div class="small text-muted">Elija que desea hacer:</div>
                                <div class="mt-2 d-flex flex-wrap gap-2">
                                    <button class="btn btn-outline-warning btn-sm" t-on-click="chooseRepeatEdit">Editar (corregir)</button>
                                    <button class="btn btn-outline-info btn-sm" t-on-click="chooseRepeatReproceso">Reproceso</button>
                                    <button class="btn btn-outline-secondary btn-sm" t-on-click="chooseRepeatTest">Test</button>
                                    <button class="btn btn-link btn-sm text-muted" t-on-click="cancelRepeatDecision">Cancelar</button>
                                </div>
                                <div class="small text-muted mt-2">
                                    <b>Editar</b>: corrige el ultimo registro. <b>Reproceso</b>: repeticion oficial (reemplaza el resultado). <b>Test</b>: repeticion no oficial (no afecta el resultado).
                                </div>
                            </div>

                            <div t-if="state.needsModeSelection and !state.repeatDecision.active" class="o_qdr_voice_box mb-3">
                                <div t-if="state.requiresFirstWashDecision">
                                    <div class="small"><b>El 1er lavado esta en FAIL.</b></div>
                                    <div class="small text-muted">Puede editar, repetir el 1er lavado o continuar bajo criterio para habilitar 3er/5to/N.</div>
                                    <div class="mt-2 d-flex flex-wrap gap-2">
                                        <button class="btn btn-outline-warning btn-sm" t-if="state.editableFirstEval" t-on-click="chooseEditFirstWash">Editar 1er Lavado</button>
                                        <button class="btn btn-outline-primary btn-sm" t-on-click="chooseRepeatFirstWash">Repetir 1er Lavado</button>
                                        <button class="btn btn-outline-primary btn-sm" t-on-click="chooseContinueByCriteria">Continuar Bajo Criterio</button>
                                    </div>
                                </div>
                                <div t-else="">
                                    <div class="small"><b>Seleccione el lavado a evaluar:</b></div>
                                    <div class="mt-2 d-flex flex-wrap gap-2">
                                        <button class="btn btn-outline-primary btn-sm" t-on-click="() => this.selectEvaluationMode('l3')">3er Lavado</button>
                                        <button class="btn btn-outline-primary btn-sm" t-on-click="() => this.selectEvaluationMode('l5')">5to Lavado</button>
                                        <button class="btn btn-outline-primary btn-sm" t-on-click="() => this.selectEvaluationMode('ln')">Lavado N</button>
                                    </div>
                                    <div class="mt-3" t-if="state.modeSelectionTarget === 'ln'">
                                        <label class="form-label small">Numero de Lavado N (mayor a 1)</label>
                                        <div class="d-flex gap-2">
                                            <input class="form-control"
                                                   type="number"
                                                   min="2"
                                                   step="1"
                                                   placeholder="Ingrese N"
                                                   t-att-value="state.selectedLavadoN"
                                                   t-on-input="onSelectedLavadoNInput"/>
                                            <button class="btn btn-primary" t-on-click="confirmLavadoNMode">Continuar</button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="row g-3 mb-3" t-if="!state.needsModeSelection and !state.repeatDecision.active and !state.reviewing">
                                <div class="col-12">
                                    <div class="o_qdr_summary_block">
                                        <h6>Estandares de Evaluacion</h6>
                                        <div class="row g-2">
                                            <div class="col-12 col-md-4">
                                                <div>Densidad estandar: <b t-esc="standards.density_standard.toFixed(1)"/></div>
                                                <div>Tolerancia densidad: <b t-esc="standards.density_tolerance.toFixed(1)"/></div>
                                            </div>
                                            <div class="col-12 col-md-4">
                                                <div>Ancho estandar: <b t-esc="standards.width_standard.toFixed(1)"/></div>
                                                <div>Tolerancia ancho: <b t-esc="standards.width_tolerance.toFixed(1)"/></div>
                                            </div>
                                            <div class="col-12 col-md-4">
                                                <div>Inclinacion estandar: <b t-esc="standards.tilt_standard.toFixed(1)"/></div>
                                                <div>Tolerancia inclinacion: <b t-esc="standards.tilt_wash_tolerance.toFixed(1)"/></div>
                                            </div>
                                            <div class="col-12 col-md-4">
                                                <div>% Ancho permitido: <b t-esc="standards.width_shrinkage_from.toFixed(1)"/> a <b t-esc="standards.width_shrinkage_to.toFixed(1)"/></div>
                                            </div>
                                            <div class="col-12 col-md-4">
                                                <div>% Largo permitido: <b t-esc="standards.length_shrinkage_from.toFixed(1)"/> a <b t-esc="standards.length_shrinkage_to.toFixed(1)"/></div>
                                            </div>
                                            <div class="col-12 col-md-4">
                                                <div>Limite revirado: <b t-esc="standards.twist_limit.toFixed(1)"/></div>
                                            </div>
                                        </div>
                                        <div class="small text-muted mt-2" t-if="!standards.has_thresholds">
                                            El producto no tiene configurados criterios en density_stability_twisting_id.
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="row g-2" t-if="!state.needsModeSelection and !state.repeatDecision.active and !state.reviewing and !(activeStep and (activeStep.key === 'inclinacion' or activeStep.key === 'inclinacion_after'))">
                                <t t-foreach="activeStep.fields" t-as="fieldName" t-key="fieldName">
                                    <div class="col-12 col-md-4" t-if="!(state.evalMode === 'ln' and fieldName === 'rvn_n')">
                                        <label class="form-label small" t-esc="getStepFieldLabel(fieldName)"/>
                                        <input class="form-control"
                                               type="text"
                                               inputmode="decimal"
                                               pattern="-?[0-9]+([\\.,][0-9]+)?"
                                               t-att-value="state.values[fieldName]"
                                               t-on-input="(ev) => this.onFieldChange(fieldName, ev)"/>
                                    </div>
                                </t>
                            </div>

                            <div class="row g-2" t-if="!state.needsModeSelection and !state.repeatDecision.active and !state.reviewing and activeStep and (activeStep.key === 'inclinacion' or activeStep.key === 'inclinacion_after')">
                                <t t-foreach="activeStep.fields" t-as="fieldName" t-key="fieldName">
                                    <div class="col-12 col-md-6">
                                        <label class="form-label small" t-esc="getStepFieldLabel(fieldName)"/>
                                        <div class="d-flex gap-2 align-items-center">
                                            <input class="form-control"
                                                   type="text"
                                                   inputmode="decimal"
                                                   pattern="-?[0-9]+([\\.,][0-9]+)?"
                                                   t-att-value="state.values[fieldName]"
                                                   t-on-input="(ev) => this.onFieldChange(fieldName, ev)"/>
                                            <button type="button"
                                                    class="btn"
                                                    t-att-class="this.getTiltDirection(fieldName) === 'z' ? 'btn-primary' : 'btn-outline-primary'"
                                                    t-on-click="() => this.setTiltDirection(fieldName, 'z')">Z</button>
                                            <button type="button"
                                                    class="btn"
                                                    t-att-class="this.getTiltDirection(fieldName) === 's' ? 'btn-primary' : 'btn-outline-primary'"
                                                    t-on-click="() => this.setTiltDirection(fieldName, 's')">S</button>
                                        </div>
                                    </div>
                                </t>
                            </div>

                            <div class="o_qdr_history_block mt-3"
                                 t-if="!state.needsModeSelection and !state.repeatDecision.active and !state.reviewing and state.evalMode === 'l1' and activeStep and activeStep.key === 'ancho'">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <h6 class="mb-0">Ultimas 10 mediciones (mismo articulo y color)</h6>
                                    <span class="small text-muted" t-esc="state.recentDensityWidth.length + ' registros'"/>
                                </div>
                                <div t-if="!state.recentDensityWidth.length" class="small text-muted">
                                    No hay registros previos para este articulo y color.
                                </div>
                                <div t-else="" class="o_qdr_history_table_wrap">
                                    <table class="table table-sm o_qdr_history_table mb-0">
                                        <thead>
                                            <tr>
                                                <th>Fecha</th>
                                                <th>Partida</th>
                                                <th>Dens. Prom</th>
                                                <th>Ancho Prom</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="state.recentDensityWidth" t-as="row" t-key="row.eval_id">
                                                <tr>
                                                    <td t-esc="row.fecha_eval || '-'"/>
                                                    <td t-esc="row.batch || '-'"/>
                                                    <td t-esc="row.densidad_promedio != null ? row.densidad_promedio.toFixed(1) : '-'"/>
                                                    <td t-esc="row.ancho_promedio != null ? row.ancho_promedio.toFixed(1) : '-'"/>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <div class="o_qdr_voice_box mt-3" t-if="!state.needsModeSelection and !state.repeatDecision.active and !state.reviewing">
                                <div class="small"><b>Paso actual:</b> <span t-esc="activeStep.label"/></div>
                                <div class="small text-danger" t-if="state.voiceError" t-esc="state.voiceError"/>
                                <div class="small text-muted">Resultados mostrados para el lavado actual.</div>
                                <div class="small text-muted">Comandos: "limpiar", "limpiar todo", "siguiente".</div>
                                <div class="small text-muted" t-if="state.voiceTranscript">
                                    Ultimo dictado: <span t-esc="state.voiceTranscript"/>
                                </div>
                            </div>

                            <hr t-if="!state.needsModeSelection and !state.repeatDecision.active and !state.reviewing"/>

                            <div class="row g-3" t-if="state.evalMode === 'l1' and !state.reviewing and !state.repeatDecision.active">
                                <div class="col-12 col-md-4">
                                    <div class="o_qdr_summary_block">
                                        <h6>% Ancho</h6>
                                        <div>1er Lavado: <b t-esc="estAnchoAvgL1.toFixed(1)"/></div>
                                    </div>
                                </div>
                                <div class="col-12 col-md-4">
                                    <div class="o_qdr_summary_block">
                                        <h6>% Largo</h6>
                                        <div>1er Lavado: <b t-esc="estLargoAvgL1.toFixed(1)"/></div>
                                    </div>
                                </div>
                                <div class="col-12 col-md-4">
                                    <div class="o_qdr_summary_block">
                                        <h6>Revirado 1er</h6>
                                        <div>1er Lavado M1: <b t-esc="reviradoM1.toFixed(1)"/></div>
                                        <div>1er Lavado M2: <b t-esc="reviradoM2.toFixed(1)"/></div>
                                        <div>1er Lavado Promedio: <b t-esc="reviradoPromedio.toFixed(1)"/></div>
                                    </div>
                                </div>
                                <div class="col-12 col-md-6">
                                    <div class="o_qdr_summary_block">
                                        <h6>Densidad y Ancho</h6>
                                        <div>Densidad promedio: <b t-esc="densidadPromedio.toFixed(1)"/></div>
                                        <div>Ancho promedio: <b t-esc="anchoPromedio.toFixed(1)"/></div>
                                    </div>
                                </div>
                            </div>

                            <div class="row g-3" t-if="state.evalMode === 'l3' and !state.reviewing and !state.repeatDecision.active">
                                <div class="col-12 col-md-4">
                                    <div class="o_qdr_summary_block">
                                        <h6>% Ancho</h6>
                                        <div>3er Lavado: <b t-esc="estAnchoAvgL3.toFixed(1)"/></div>
                                    </div>
                                </div>
                                <div class="col-12 col-md-4">
                                    <div class="o_qdr_summary_block">
                                        <h6>% Largo</h6>
                                        <div>3er Lavado: <b t-esc="estLargoAvgL3.toFixed(1)"/></div>
                                    </div>
                                </div>
                                <div class="col-12 col-md-4">
                                    <div class="o_qdr_summary_block">
                                        <h6>Revirado 3er</h6>
                                        <div>M1: <b t-esc="revirado3M1.toFixed(1)"/></div>
                                        <div>M2: <b t-esc="revirado3M2.toFixed(1)"/></div>
                                        <div>Promedio: <b t-esc="revirado3Promedio.toFixed(1)"/></div>
                                    </div>
                                </div>
                            </div>

                            <div class="row g-3" t-if="state.evalMode === 'l5' and !state.reviewing and !state.repeatDecision.active">
                                <div class="col-12 col-md-4">
                                    <div class="o_qdr_summary_block">
                                        <h6>% Ancho</h6>
                                        <div>5to Lavado: <b t-esc="estAnchoAvgL5.toFixed(1)"/></div>
                                    </div>
                                </div>
                                <div class="col-12 col-md-4">
                                    <div class="o_qdr_summary_block">
                                        <h6>% Largo</h6>
                                        <div>5to Lavado: <b t-esc="estLargoAvgL5.toFixed(1)"/></div>
                                    </div>
                                </div>
                                <div class="col-12 col-md-4">
                                    <div class="o_qdr_summary_block">
                                        <h6>Revirado 5to</h6>
                                        <div>M1: <b t-esc="revirado5M1.toFixed(1)"/></div>
                                        <div>M2: <b t-esc="revirado5M2.toFixed(1)"/></div>
                                        <div>Promedio: <b t-esc="revirado5Promedio.toFixed(1)"/></div>
                                    </div>
                                </div>
                            </div>

                            <div class="row g-3" t-if="state.evalMode === 'ln' and !state.reviewing and !state.repeatDecision.active">
                                <div class="col-12 col-md-4">
                                    <div class="o_qdr_summary_block">
                                        <h6>% Ancho</h6>
                                        <div>Lavado N: <b t-esc="estAnchoAvgLN.toFixed(1)"/></div>
                                    </div>
                                </div>
                                <div class="col-12 col-md-4">
                                    <div class="o_qdr_summary_block">
                                        <h6>% Largo</h6>
                                        <div>Lavado N: <b t-esc="estLargoAvgLN.toFixed(1)"/></div>
                                    </div>
                                </div>
                                <div class="col-12 col-md-4">
                                    <div class="o_qdr_summary_block">
                                        <h6>Revirado N</h6>
                                        <div>Lavado N: <b t-esc="reviradoNLavado || 0"/></div>
                                        <div>M1: <b t-esc="reviradoNM1.toFixed(1)"/></div>
                                        <div>M2: <b t-esc="reviradoNM2.toFixed(1)"/></div>
                                        <div>Promedio: <b t-esc="reviradoNPromedio.toFixed(1)"/></div>
                                    </div>
                                </div>
                            </div>

                            <!-- Pantalla de revision (Req 5): resumen con puntos verde/rojo antes de finalizar -->
                            <div t-if="state.reviewing" class="o_qdr_review">
                                <div class="alert" t-att-class="reviewAllPass ? 'alert-success' : 'alert-warning'">
                                    <b>Revise los datos antes de finalizar.</b>
                                    <span t-if="state.repeatKind === 'reproceso'" class="badge text-bg-info ms-2">Reproceso</span>
                                    <span t-if="state.repeatKind === 'test'" class="badge text-bg-secondary ms-2">Test</span>
                                    <div class="small text-muted">Verde: cumple el estandar. Rojo: no cumple. Gris: sin estandar (dato capturado, no validado).</div>
                                </div>
                                <div class="row g-2">
                                    <t t-foreach="reviewMetrics" t-as="metric" t-key="metric.key">
                                        <div class="col-12 col-md-6">
                                            <div class="o_qdr_summary_block d-flex justify-content-between align-items-center">
                                                <span t-esc="metric.label"/>
                                                <span class="d-inline-flex align-items-center gap-2">
                                                    <b t-esc="metric.value.toFixed(1)"/>
                                                    <i class="fa fa-circle" t-att-class="metric.ok === true ? 'text-success' : (metric.ok === false ? 'text-danger' : 'text-muted')"/>
                                                </span>
                                            </div>
                                        </div>
                                    </t>
                                </div>
                                <div class="mt-3 d-flex gap-2">
                                    <button class="btn btn-outline-secondary" t-on-click="backToEdit">
                                        <i class="fa fa-pencil me-1"/>Volver a editar
                                    </button>
                                    <button class="btn btn-success"
                                            t-att-disabled="state.submitting"
                                            t-on-click="confirmFinalize">
                                        <i class="fa fa-check me-1"/>Confirmar y Finalizar
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
