<odoo>
    <record id="view_control_tono_acabado_log_form" model="ir.ui.view">
        <field name="name">control.tono.acabado.log.form</field>
        <field name="model">control.tono.acabado.log</field>
        <field name="arch" type="xml">
            <form string="Detalle Evaluación Tono Acabado">
                <sheet>
                    <group>
                        <group>
                            <field name="fecha_eval" readonly="1"/>
                            <field name="user_id" readonly="1"/>
                            <field name="tono" readonly="1"/>
                            <field name="motivo" readonly="1"/>
                            <field name="resultado" readonly="1"/>
                        </group>
                        <group>
                            <field name="receta_tacho" readonly="1"/>
                            <field name="receta" readonly="1"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button string="Cerrar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_control_tono_acabado_wizard_form" model="ir.ui.view">
        <field name="name">control.tono.acabado.wizard.form</field>
        <field name="model">control.tono.acabado.wizard</field>
        <field name="arch" type="xml">
            <form string="Evaluar Tono Acabado">
                <sheet>
                    <field name="pedido_line_id" invisible="1"/>
                    <field name="is_concesionado" invisible="1"/>
                    <field name="can_show_decision_buttons" invisible="1"/>

                    <group>
                        <group>
                            <field name="cliente" readonly="1"/>
                            <field name="tela" readonly="1"/>
                            <field name="pedido" readonly="1"/>
                            <field name="partida" readonly="1"/>
                            <field name="hdr" readonly="1"/>
                        </group>
                        <group>
                            <field name="color_code" readonly="1"/>
                            <field name="color_name" readonly="1"/>
                            <field name="kilos" readonly="1"/>
                        </group>
                    </group>

                    <group string="Comparación de Recetas">
                        <group>
                            <field name="receta_tacho" readonly="1"/>
                        </group>
                        <group>
                            <field name="receta" placeholder="Receta Acabado"/>
                        </group>
                    </group>

                    <group>
                        <field name="motivo" required="1"/>
                    </group>
                </sheet>

                <footer>
                    <button string="Aprobar"
                            name="action_aprobar"
                            type="object"
                            class="btn-primary"
                            invisible="not can_show_decision_buttons or is_concesionado"/>

                    <button string="Concesionado"
                            name="action_aprobar"
                            type="object"
                            class="btn-primary"
                            invisible="not can_show_decision_buttons or not is_concesionado"/>

                    <button string="Rechazar"
                            name="action_rechazar"
                            type="object"
                            class="btn-danger"
                            invisible="not can_show_decision_buttons"/>

                    <button string="Cancelar"
                            special="cancel"
                            class="btn-secondary ms-auto"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_control_pedido_line_form_inherit_tono_acabado" model="ir.ui.view">
        <field name="name">control.pedido.line.form.inherit.tono.acabado</field>
        <field name="model">control.pedido.line</field>
        <field name="inherit_id" ref="idtx_batch_control.view_control_pedido_line_form"/>
        <field name="priority">110</field>
        <field name="arch" type="xml">

            <xpath expr="//form/header" position="inside">
                <button name="action_evaluar_tono_acabado"
                        type="object"
                        string="Evaluar Tono Acabado"
                        class="btn-primary"
                        invisible="not can_eval_tono_acabado"/>
            </xpath>

        </field>
    </record>
</odoo>