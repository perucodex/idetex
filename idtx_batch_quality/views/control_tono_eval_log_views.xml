<odoo>
    <record id="view_control_tono_log_form" model="ir.ui.view">
        <field name="name">control.tono.eval.log.form</field>
        <field name="model">control.tono.eval.log</field>
        <field name="arch" type="xml">
            <form string="Detalle Evaluación Tono">
                <sheet>
                    <group>
                        <group>
                            <field name="fecha_eval" readonly="1"/>
                            <field name="user_id" readonly="1"/>
                            <field name="tono" readonly="1"/>
                        </group>
                        <group>
                            <field name="motivo" readonly="1" invisible="tono == 'tacho'"/>
                            <field name="receta" readonly="1"/>
                            <field name="receta_tono" readonly="1"/>
                            <field name="resultado" readonly="1"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button string="Cerrar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>