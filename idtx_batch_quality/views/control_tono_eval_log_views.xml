<odoo>
    <record id="view_control_tono_log_list_tacho_acabado" model="ir.ui.view">
        <field name="name">control.tono.eval.log.list.tacho.acabado</field>
        <field name="model">control.tono.eval.log</field>
        <field name="arch" type="xml">
            <list>
                <field name="fecha_eval"/>
                <field name="user_id"/>
                <field name="partida" string="Partida"/>
                <field name="cliente" string="Cliente"/>
                <field name="color" string="Color"/>
                <field name="tono" string="Tipo de Tono"/>
                <field name="motivo_tono" string="Motivo Tono"/>
                <field name="motivo_tacto" string="Motivo Tacto"/>
                <field name="motivo_apariencia" string="Motivo Apariencia"/>
                <field name="resultado" widget="badge"
                       decoration-success="resultado == 'aprobado'"
                       decoration-warning="resultado == 'concesionado'"
                       decoration-danger="resultado == 'rechazado'"/>
                <field name="receta_tono" string="Receta"/>
            </list>
        </field>
    </record>

    <record id="view_control_tono_log_form" model="ir.ui.view">
        <field name="name">control.tono.eval.log.form</field>
        <field name="model">control.tono.eval.log</field>
        <field name="arch" type="xml">
            <form string="Detalle Evaluación Tono">
                <header>
                    <button name="action_approve" type="object" string="Aprobar" class="btn-success" invisible="resultado == 'aprobado'" groups="sales_team.group_sale_salesman_all_leads,quality.group_quality_manager"/>
                   <button name="action_conciliate" type="object" string="Concesionar" class="btn-warning" invisible="resultado == 'concesionado'" groups="sales_team.group_sale_salesman_all_leads,quality.group_quality_manager"/>
                    <button name="action_reject" type="object" string="Rechazar" class="btn-danger" invisible="resultado == 'rechazado'" groups="sales_team.group_sale_salesman_all_leads,quality.group_quality_manager"/>
                    <field name="resultado" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="fecha_eval" readonly="1"/>
                            <field name="user_id" readonly="1"/>
                            <field name="tono" readonly="1"/>
                            <field name="user_has_group_quality_manager" invisible="1"/>
                        </group>
                        <group invisible="tono != 'tacho'">
                            <field name="receta" string="Receta Laboratorio" readonly="1"/>
                            <field name="receta_tono" string="Receta Tacho" readonly="not user_has_group_quality_manager"/>
                            <field name="resultado" readonly="1"/>
                        </group>
                        <group invisible="tono != 'acabado'">
                            <field name="motivo_tono" string="Tono" readonly="not user_has_group_quality_manager or resultado != 'concesionado'"/>
                            <field name="motivo_tacto" string="Tacto" readonly="not user_has_group_quality_manager or resultado != 'concesionado'"/>
                            <field name="motivo_apariencia" string="Apariencia" readonly="not user_has_group_quality_manager or resultado != 'concesionado'"/>
                            <field name="receta" string="Receta Acabado" readonly="1"/>
                            <field name="receta_tono" string="Receta Tacho" readonly="not user_has_group_quality_manager"/>
                            <field name="resultado" readonly="1"/>
                        </group>
                        <group invisible="tono != 'secado'">
                            <field name="receta" string="Receta Secado" readonly="1"/>
                            <field name="receta_tono" string="Receta Tacho" readonly="not user_has_group_quality_manager"/>
                            <field name="resultado" readonly="1"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_control_tono_log_search_tacho_acabado" model="ir.ui.view">
        <field name="name">control.tono.eval.log.search.tacho.acabado</field>
        <field name="model">control.tono.eval.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="partida" string="Partida" filter_domain="[('pedido_line_id.batch', 'ilike', self)]"/>
                <field name="cliente" string="Cliente" filter_domain="[('pedido_line_id.pedido_id.customer', 'ilike', self)]"/>
                <field name="color" string="Color" filter_domain="[('pedido_line_id.colorname', 'ilike', self)]"/>
                <separator/>
                <filter name="group_by_fecha_dia" string="Fecha" context="{'group_by': 'fecha_eval:day'}"/>
                <filter name="group_by_tipo" string="Tipo" context="{'group_by': 'tono'}"/>
                <filter name="group_by_estado" string="Estado" context="{'group_by': 'resultado'}"/>
            </search>
        </field>
    </record>

    <record id="action_control_tono_eval_log_tacho_acabado" model="ir.actions.act_window">
        <field name="name">Evaluaciones Tono Tacho/Acabado</field>
        <field name="res_model">control.tono.eval.log</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[("tono", "in", ["tacho", "acabado"])]</field>
        <field name="search_view_id" ref="view_control_tono_log_search_tacho_acabado"/>
        <field name="context">{'search_default_group_by_fecha_dia': 1}</field>
    </record>
    
</odoo>