<odoo>
    <record id="view_control_apariencia_line_form" model="ir.ui.view">
        <field name="name">control.apariencia.line.form</field>
        <field name="model">control.apariencia.line</field>
        <field name="arch" type="xml">
            <form string="Detalle Apariencia">
                <sheet>
                    <group>
                        <group>
                            <field name="create_date" string="Fecha" readonly="1"/>
                            <field name="create_uid" string="Usuario" readonly="1"/>
                        </group>
                        <group>
                            <field name="pedido_line_id" readonly="1"/>
                            <field name="rollo_num" readonly="1"/>
                            <field name="defect_count" readonly="1"/>
                            <field name="defect_total" readonly="1"/>
                        </group>
                    </group>

                    <group string="Defectos">
                        <group>
                            <field name="lineas_aceite" readonly="1"/>
                            <field name="cont_polipropileno" readonly="1"/>
                            <field name="anillado" readonly="1"/>
                            <field name="barraduras" readonly="1"/>
                            <field name="caida_tela" readonly="1"/>
                            <field name="huecos" readonly="1"/>
                            <field name="falla_aguja" readonly="1"/>
                            <field name="manchas_colorante" readonly="1"/>
                            <field name="puntos_oxido" readonly="1"/>
                        </group>
                        <group>
                            <field name="manchas_blancas" readonly="1"/>
                            <field name="jaladuras" readonly="1"/>
                            <field name="raspaduras" readonly="1"/>
                            <field name="migracion" readonly="1"/>
                            <field name="quebraduras" readonly="1"/>
                            <field name="manchas_suciedad" readonly="1"/>
                            <field name="mancha_grasa" readonly="1"/>
                            <field name="remalles" readonly="1"/>
                            <field name="ancho_variado" readonly="1"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button string="Cerrar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>