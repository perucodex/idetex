<odoo>
    <record id="view_control_tono_eval_log_form" model="ir.ui.view">
        <field name="name">control.tono.eval.log.form</field>
        <field name="model">control.tono.eval.log</field>
        <field name="arch" type="xml">
            <form string="Detalle Evaluación de Tono">
                <sheet>
                    <group>
                        <group>
                            <field name="fecha_eval" readonly="1"/>
                            <field name="user_id" readonly="1"/>
                            <field name="tono" readonly="1"/>
                            <field name="resultado" readonly="1"/>
                        </group>
                        <group>
                            <field name="receta" readonly="1"/>
                            <field name="receta_rutero" readonly="1"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button string="Cerrar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_control_tono_eval_wizard_form" model="ir.ui.view">
        <field name="name">control.tono.eval.wizard.form</field>
        <field name="model">control.tono.eval.wizard</field>
        <field name="arch" type="xml">
            <form string="Evaluar Tono Tacho">
                <sheet>
                    <field name="pedido_line_id" invisible="1"/>
                    <field name="is_concesionado" invisible="1"/>
                    <field name="can_show_decision_buttons" invisible="1"/>
                    <group>
                        <group>
                            <field name="cliente" readonly="1"/>
                            <field name="tela" readonly="1"/>
                            <field name="pedido" readonly="1"/>
                            <field name="partida" readonly="1"/>
                            <field name="hdr" readonly="1"/>
                        </group>
                        <group>
                            <field name="color_code" readonly="1"/>
                            <field name="color_name" readonly="1"/>
                            <field name="kilos" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group><field name="receta"/></group>
                        <group><field name="receta_rutero"/></group>
                    </group>
                </sheet>
                <footer>
                    <button string="Aprobar" name="action_aprobar" type="object" class="btn-primary"
                            invisible="not can_show_decision_buttons or is_concesionado"/>
                    <button string="Concesionado" name="action_aprobar" type="object" class="btn-primary"
                            invisible="not can_show_decision_buttons or not is_concesionado"/>
                    <button string="Rechazar" name="action_rechazar" type="object" class="btn-danger"
                            invisible="not can_show_decision_buttons"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary ms-auto"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_control_pedido_line_form_inherit_eval_tono" model="ir.ui.view">
        <field name="name">control.pedido.line.form.inherit.eval.tono</field>
        <field name="model">control.pedido.line</field>
        <field name="inherit_id" ref="idtx_batch_control.view_control_pedido_line_form"/>
        <field name="priority">100</field>
        <field name="arch" type="xml">

            <xpath expr="//form/sheet" position="before">
                <header>
                    <button name="action_evaluar_tono"
                            type="object"
                            string="Evaluar Tono Tacho"
                            class="btn-primary"
                            invisible="not can_eval_tono"/>
                </header>
            </xpath>

            <xpath expr="//notebook/page[field[@name='proceso_ids']]" position="after">
                <page string="Evaluaciones" invisible="not has_tono_eval_logs and not has_tono_acabado_logs">

                    <group string="Evaluaciones Tono Tacho" invisible="not has_tono_eval_logs">
                        <field name="tono_eval_log_ids"
                               nolabel="1"
                               colspan="2"
                               context="{'form_view_ref': 'idtx_batch_quality.view_control_tono_eval_log_form'}">
                            <list delete="1" edit="0" create="0">
                                <field name="fecha_eval"/>
                                <field name="user_id"/>
                                <field name="tono"/>
                                <field name="resultado" widget="badge"
                                       decoration-success="resultado == 'aprobado'"
                                       decoration-danger="resultado == 'rechazado'"
                                       decoration-warning="resultado == 'concesionado'"/>
                            </list>
                        </field>
                    </group>

                    <group string="Evaluaciones Tono Acabado" invisible="not has_tono_acabado_logs">
                        <field name="tono_acabado_log_ids"
                               nolabel="1"
                               colspan="2"
                               context="{'form_view_ref': 'idtx_batch_quality.view_control_tono_acabado_log_form'}">
                            <list delete="1" edit="0" create="0">
                                <field name="fecha_eval"/>
                                <field name="user_id"/>
                                <field name="motivo"/>
                                <field name="tono"/>
                                <field name="resultado" widget="badge"
                                       decoration-success="resultado == 'aprobado'"
                                       decoration-danger="resultado == 'rechazado'"
                                       decoration-warning="resultado == 'concesionado'"/>
                            </list>
                        </field>
                    </group>

                </page>
            </xpath>

        </field>
    </record>
</odoo>