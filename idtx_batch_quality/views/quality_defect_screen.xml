<odoo>
    <record id="action_quality_defect_screen" model="ir.actions.client">
        <field name="name">Auditoría de Apariencia</field>
        <field name="tag">idtx_quality.defect_screen</field>
        <field name="target">fullscreen</field>
    </record>

    <record id="action_quality_partida" model="ir.actions.act_window">
        <field name="name">Partidas</field>
        <field name="res_model">control.pedido.line</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_quality_partida"
              name="Partidas"
              parent="quality_control.menu_quality_control"
              action="action_quality_partida"
              sequence="900"/>

    <menuitem id="menu_quality_defect_screen"
              name="Auditoría de Apariencia"
              parent="quality_control.menu_quality_control"
              action="action_quality_defect_screen"
              sequence="910"/>

</odoo>