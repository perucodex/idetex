<odoo>
    <record id="view_control_apariencia_defecto_tree" model="ir.ui.view">
        <field name="name">control.apariencia.defecto.tree</field>
        <field name="model">control.apariencia.defecto</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="is_hueco"/>
                <field name="is_active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_control_apariencia_defecto_form" model="ir.ui.view">
        <field name="name">control.apariencia.defecto.form</field>
        <field name="model">control.apariencia.defecto</field>
        <field name="arch" type="xml">
            <form string="Defecto Apariencia">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="is_hueco"/>
                        <field name="is_active" widget="boolean_toggle"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_control_apariencia_defecto" model="ir.actions.act_window">
        <field name="name">Defectos Apariencia</field>
        <field name="res_model">control.apariencia.defecto</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_control_apariencia_defecto"
              name="Defectos Apariencia"
              parent="mrp.menu_mrp_configuration"
              action="action_control_apariencia_defecto"
              sequence="90"/>
</odoo>