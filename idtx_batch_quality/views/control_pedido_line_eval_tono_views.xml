<odoo>
    <record id="view_control_pedido_line_form_inherit_eval_tono" model="ir.ui.view">
        <field name="name">control.pedido.line.form.inherit.eval.tono</field>
        <field name="model">control.pedido.line</field>
        <field name="inherit_id" ref="idtx_batch_control.view_control_pedido_line_form"/>
        <field name="priority">100</field>

        <field name="arch" type="xml">

            <!-- Header en la forma de Partida -->
            <xpath expr="//form/sheet" position="before">
                <header>
                    <button name="action_evaluar_tono"
                            type="object"
                            string="Evaluar Tono"
                            class="btn-primary"
                            invisible="not can_eval_tono"/>

                    <button name="action_retroceder_tono"
                            type="object"
                            string="Retroceder"
                            class="btn-secondary"
                            invisible="tono_state != 'evaluado'"/>

                    <field name="tono_state" widget="statusbar"/>
                </header>
            </xpath>

            <!-- Pestaña Evaluaciones solo si tiene datos -->
            <xpath expr="//notebook/page[field[@name='proceso_ids']]" position="after">
                <page string="Evaluaciones" invisible="not has_tono_eval_logs">
                    <field name="tono_eval_log_ids" readonly="1">
                        <list create="0" delete="0">
                            <field name="fecha_eval"/>
                            <field name="user_id"/>
                            <field name="resultado"/>
                            <field name="receta"/>
                            <field name="receta_rutero"/>

                            <!-- Icono eliminar al final -->
                            <button name="action_delete_log"
                                    type="object"
                                    icon="fa-trash"
                                    string=""
                                    class="btn-link text-danger"
                                    confirm="¿Eliminar esta evaluación de tono?"/>
                        </list>
                    </field>
                </page>
            </xpath>

        </field>
    </record>
</odoo>