<odoo>
    <record id="view_control_tono_eval_wizard_form" model="ir.ui.view">
        <field name="name">control.tono.eval.wizard.form</field>
        <field name="model">control.tono.eval.wizard</field>
        <field name="arch" type="xml">
            <form string="Evaluar Tono">
                <sheet>
                    <field name="pedido_line_id" invisible="1"/>
                    <field name="is_concesionado" invisible="1"/>

                    <!-- ✅ Datos en dos columnas -->
                    <group>
                        <!-- Columna izquierda -->
                        <group>
                            <field name="cliente" readonly="1"/>
                            <field name="tela" readonly="1"/>
                            <field name="pedido" readonly="1"/>
                            <field name="partida" readonly="1"/>
                            <field name="hdr" readonly="1"/>
                        </group>

                        <!-- Columna derecha -->
                        <group>
                            <field name="color_code" readonly="1"/>
                            <field name="color_name" readonly="1"/>
                            <field name="kilos" readonly="1"/>
                        </group>
                    </group>

                    <!-- ✅ Campos editables -->
                    <group>
                        <group>
                            <field name="receta" placeholder="Ej: 100"/>
                        </group>
                        <group>
                            <field name="receta_rutero" placeholder="Ej: 101" required="1"/>
                        </group>
                    </group>
                </sheet>

                <footer>
                    <!-- Botón normal -->
                    <button string="Aprobar"
                            name="action_aprobar"
                            type="object"
                            class="btn-primary"
                            invisible="is_concesionado or not receta_rutero"/>

                    <!-- Botón cuando receta != receta_rutero -->
                    <button string="Concesionado"
                            name="action_aprobar"
                            type="object"
                            class="btn-primary"
                            invisible="not is_concesionado or not receta_rutero"/>

                    <button string="Rechazar"
                            name="action_rechazar"
                            type="object"
                            class="btn-danger"
                            invisible="not receta_rutero"/>

                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>