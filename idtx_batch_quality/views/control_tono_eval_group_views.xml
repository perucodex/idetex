<odoo>
    <record id="view_control_tono_eval_group_list" model="ir.ui.view">
        <field name="name">control.tono.eval.group.list</field>
        <field name="model">control.tono.eval.group</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="fecha_eval"/>
                <field name="user_id"/>
                <field name="tono"/>
                <field name="resultado"/>
                <field name="total_count"/>
            </list>
        </field>
    </record>

    <record id="view_control_tono_eval_group_form" model="ir.ui.view">
        <field name="name">control.tono.eval.group.form</field>
        <field name="model">control.tono.eval.group</field>
        <field name="arch" type="xml">
            <form string="Evaluacion Grupal de Tono">
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="fecha_eval" readonly="1"/>
                            <field name="user_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="tono" readonly="1"/>
                            <field name="resultado" readonly="1"/>
                            <field name="total_count" readonly="1"/>
                        </group>
                    </group>

                    <field name="line_ids" nolabel="1" readonly="1">
                        <list>
                            <field name="pedido_line_id"/>
                            <field name="customer"/>
                            <field name="article"/>
                            <field name="kilograms"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_control_tono_eval_group" model="ir.actions.act_window">
        <field name="name">Agrupaciones de Evaluacion Tono</field>
        <field name="res_model">control.tono.eval.group</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
