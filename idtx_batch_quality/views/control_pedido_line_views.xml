<odoo>
    <record id="view_control_pedido_line_form_inherit_eval_tono" model="ir.ui.view">
        <field name="name">control.pedido.line.form.inherit.eval.tono</field>
        <field name="model">control.pedido.line</field>
        <field name="inherit_id" ref="idtx_batch_control.view_control_pedido_line_form"/>
        <field name="priority">100</field>
        <field name="arch" type="xml">

            <xpath expr="//form/header" position="inside">
                <button name="action_print_laboratorio_summary_report"
                        type="object"
                    string="Enviar"
                    class="btn-secondary"/>

                <button name="action_view_laboratorio_public"
                        type="object"
                    string="Ver"
                    class="btn-secondary"/>

                <button name="action_evaluar_tono"
                        type="object"
                        string="Evaluar Tono Tacho"
                    class="btn-primary"
                    invisible="not can_eval_tono"/>

                <button name="action_evaluar_tono_secado"
                    type="object"
                    string="Evaluar Tono Secado"
                    class="btn-primary"
                    invisible="not can_eval_tono_secado"/>

                <button name="action_evaluar_tono_acabado"
                        type="object"
                        string="Evaluar Tono Acabado"
                    class="btn-primary"
                    invisible="not can_eval_tono_acabado"/>
            </xpath>

            <xpath expr="//notebook/page[field[@name='proceso_ids']]" position="after">

                <page string="Evaluaciones" invisible="not has_tono_eval_logs">
                    <field name="tono_eval_log_ids" nolabel="1"
                           context="{'form_view_ref': 'idtx_batch_quality.view_control_tono_log_form'}">
                        <list delete="1" edit="0" create="0">
                            <field name="fecha_eval"/>
                            <field name="user_id"/>
                            <field name="motivo_tono"/>
                            <field name="motivo_tacto"/>
                            <field name="motivo_apariencia"/>
                            <field name="tono"/>
                            <field name="resultado" widget="badge"
                                   decoration-success="resultado == 'aprobado'"
                                   decoration-danger="resultado == 'rechazado'"
                                   decoration-warning="resultado == 'concesionado'"/>
                        </list>
                    </field>
                </page>

                <page string="Auditoria" id="audit_page" invisible="not (can_apariencia or has_apariencia_lines)">
                    <field name="apariencia_eval_ids" nolabel="1"
                           context="{'default_pedido_line_id': id}"
                           mode="list,form">
                        <list>
                            <field name="name"/>
                            <field name="create_date" string="Fecha"/>
                            <field name="create_uid" string="Usuario"/>
                            <field name="apariencia_id" string="Apariencia"/>
                            <field name="line_count" string="Rollos"/>
                            <field name="quality_point" string="Quality Point"/>
                        </list>
                    </field>
                </page>

                <page string="Laboratorio">
                    <field name="laboratorio_record_ids" nolabel="1" context="{'default_pedido_line_id': id}" mode="list,form">
                        <list>
                            <field name="eval_number" string="Nro Evaluacion"/>
                            <field name="fecha_eval"/>
                            <field name="user_ids" widget="many2many_tags"/>
                            <field name="numero_lavado"/>
                            <field name="sample_type" string="Tipo de Muestra"/>
                            <field name="test_type" string="Tipo de Prueba"/>
                            <field name="result_state" string="Estado" widget="badge"
                                   decoration-success="result_state == 'pasa'"
                                   decoration-danger="result_state == 'falla'"/>
                        </list>
                        <form string="Registro de Laboratorio">
                            <header>
                                <button name="action_print_report"
                                        type="object"
                                    string="Imprimir"
                                        class="btn-secondary"
                                    invisible="test_type not in ('solidez_lavado', 'dimrev')"/>
                                <field name="result_state" widget="statusbar" decoration-success="result_state == 'pasa'" decoration-danger="result_state == 'falla'"/>
                            </header>
                            <sheet>
                                <group>
                                    <group>
                                        <field name="eval_number" readonly="1"/>
                                        <field name="fecha_eval" readonly="1"/>
                                        <field name="user_ids" widget="many2many_tags" readonly="1"/>
                                    </group>
                                    <group>
                                        <field name="pedido_line_id" readonly="1"/>
                                        <field name="test_type" readonly="1"/>
                                        <field name="sample_type" readonly="1"/>
                                        <field name="numero_lavado" readonly="1"/>
                                    </group>
                                </group>
                                <group string="Detalle Dimensional/Revirado" invisible="test_type != 'dimrev'">
                                    <field name="est_revirado_eval_id" readonly="1"/>
                                </group>
                                <group string="Detalle Solidez del Color al Lavado" invisible="test_type != 'solidez_lavado'">
                                    <field name="solidez_lavado_eval_id" readonly="1"/>
                                </group>
                                <notebook>
                                    <page string="Resultados">
                                        <field name="result_line_ids" nolabel="1" readonly="0">
                                            <list default_order="sequence asc">
                                                <field name="tipo"/>
                                                <field name="resultado"/>
                                            </list>
                                        </field>
                                    </page>
                                </notebook>
                                <group >
                                </group>
                            </sheet>
                        </form>
                    </field>
                </page>

            </xpath>
        </field>
    </record>

    <record id="action_quality_partida" model="ir.actions.act_window">
        <field name="name">Partidas</field>
        <field name="res_model">control.pedido.line</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
