<odoo>
    <record id="view_control_pedido_line_form_inherit_eval_tono" model="ir.ui.view">
        <field name="name">control.pedido.line.form.inherit.eval.tono</field>
        <field name="model">control.pedido.line</field>
        <field name="inherit_id" ref="idtx_batch_control.view_control_pedido_line_form"/>
        <field name="priority">100</field>
        <field name="arch" type="xml">

            <xpath expr="//form/header" position="inside">
                <button name="action_evaluar_tono"
                        type="object"
                        string="Evaluar Tono Tacho"
                        class="btn-primary"
                        invisible="not can_eval_tono"/>

                <button name="action_evaluar_tono_acabado"
                        type="object"
                        string="Evaluar Tono Acabado"
                        class="btn-primary"
                        invisible="not can_eval_tono_acabado"/>
            </xpath>

            <field name="colorname" position="after">
                <field name="quality_point"/>
            </field>

            <xpath expr="//notebook/page[field[@name='proceso_ids']]" position="after">

                <page string="Evaluaciones" invisible="not has_tono_eval_logs">
                    <field name="tono_eval_log_ids" nolabel="1"
                           context="{'form_view_ref': 'idtx_batch_quality.view_control_tono_log_form'}">
                        <list delete="1" edit="0" create="0">
                            <field name="fecha_eval"/>
                            <field name="user_id"/>
                            <field name="motivo_tono"/>
                            <field name="motivo_tacto"/>
                            <field name="motivo_apariencia"/>
                            <field name="tono"/>
                            <field name="resultado" widget="badge"
                                   decoration-success="resultado == 'aprobado'"
                                   decoration-danger="resultado == 'rechazado'"
                                   decoration-warning="resultado == 'concesionado'"/>
                        </list>
                    </field>
                </page>

                <page string="Auditoria" id="audit_page" invisible="not (can_apariencia or has_apariencia_lines)">
                    <field name="apariencia_line_ids" nolabel="1">
                        <list>
                            <field name="create_date" string="Fecha"/>
                            <field name="create_uid" string="Usuario"/>
                            <field name="apariencia_id" string="Apariencia"/>
                            <field name="rollo_num" string="N° Rollo"/>
                            <field name="width" string="Ancho"/>
                            <field name="meters" string="Metros"/>
                            <field name="defect_count" string="Cantidad Defectos"/>
                        </list>
                    </field>
                </page>

            </xpath>
        </field>
    </record>

    <record id="control_apariencia_line_view_list" model="ir.ui.view">
        <field name="name">control.apariencia.line.view.list</field>
        <field name="model">control.apariencia.line</field>
        <field name="arch" type="xml">
            <form string="">
                <sheet>
                    <group>
                        <group>
                            <field name="create_date" string="Fecha" readonly="1"/>
                            <field name="create_uid" string="Usuario" readonly="1"/>
                            <field name="pedido_line_id" readonly="1"/>
                            <field name="apariencia_id"/>
                        </group>
                        <group>
                            <field name="rollo_num"/>
                            <field name="width"/>
                            <field name="meters"/>
                            <field name="defect_count" readonly="1"/>
                        </group>
                    </group>
                    <field name="defecto_line_ids" nolabel="1"/>
                </sheet>
            </form>
        </field>
    </record>
    
    <record id="view_control_apariencia_defecto_list" model="ir.ui.view">
        <field name="name">control.apariencia.defecto.line.list</field>
        <field name="model">control.apariencia.defecto.line</field>
        <field name="arch" type="xml">
            <list>
                <field name="defecto_id" readonly="1"/>
                <field name="cantidad"/>
            </list>
        </field>
    </record>

    <record id="control_apariencia_defecto_line_view_form" model="ir.ui.view">
        <field name="name">control.apariencia.defecto.line.view.form</field>
        <field name="model">control.apariencia.defecto.line</field>
        <field name="arch" type="xml">
            <form string="">
                <sheet>
                    <group>
                        <group>
                            <field name="defecto_id" domain="[('apariencia_id', '=', parent.apariencia_id)]"/>
                            <field name="is_hueco" invisible="1"/>
                            <field name="cantidad"/>
                        </group>
                        <field name="tamano_defecto_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="tamano" column_invisible="parent.is_hueco"/>
                                <field name="tamano_hueco" column_invisible="not parent.is_hueco"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


</odoo>
