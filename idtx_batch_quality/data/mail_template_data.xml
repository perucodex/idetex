<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data noupdate="0">

        <record id="mail_template_laboratorio_summary_front" model="mail.template">
            <field name="name">Laboratory: Send Batch Summary</field>
            <field name="model_id" ref="idtx_batch_control.model_control_pedido_line"/>
			<field name="subject">IDETEX S.A.C. - Laboratory Summary {{ object.batch or '' }}</field>
            <field name="lang">{{ object._get_mail_recipient_partner().lang or 'en_US' }}</field>
            <field name="email_from">{{ (object.user_id.email_formatted or object.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="partner_to" eval="False"/>
            <field name="use_default_to" eval="True"/>
            <field name="description">Used by quality team when they send laboratory summary to recipients</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px;">
    <p style="margin: 0px; padding: 0px; font-size: 13px;">
        Hello,
        <br/><br/>
        Please find attached the laboratory summary report for batch
        <span style="font-weight: bold;" t-out="object.batch or ''">C377961</span>.
        <br/><br/>
        <table role="presentation" border="0" cellspacing="0" cellpadding="0" style="border-collapse:separate;">
            <tr>
                <td bgcolor="#1f6f78" style="border-radius:4px; background-color:#1f6f78; border:1px solid #1f6f78;">
                    <a t-att-href="object.get_laboratorio_public_url()"
                       style="display:inline-block; padding:10px 14px; font-weight:700; font-size:13px; text-decoration:none; color:#ffffff; background-color:#1f6f78; border-radius:4px;">
                        View Summary
                    </a>
                </td>
            </tr>
        </table>
        <br/><br/>
        If the button is not visible, use this link:
        <a t-att-href="object.get_laboratorio_public_url()">Open summary</a>
        <br/><br/>
        Regards.
        <t t-if="not is_html_empty(object.user_id.signature)">
            <div>--<br/><t t-out="object.user_id.signature or ''">Mercedes Carrion</t></div>
        </t>
    </p>
</div>
            </field>
            <field name="report_template_ids" eval="[(4, ref('idtx_batch_quality.action_report_laboratorio_summary_pedido_line'))]"/>
            <field name="auto_delete" eval="True"/>
        </record>

        <record id="mail_template_tono_eval_pending" model="mail.template">
            <field name="name">Quality Tone Evaluation Pending</field>
            <field name="model_id" ref="idtx_batch_quality.model_control_tono_eval_log"/>
            <field name="subject">IDETEX S.A.C. - Partida {{ object.partida or '' }} enviada al cliente para evaluacion</field>
            <field name="email_from">{{ (object.user_id.email_formatted or user.email_formatted or object.create_uid.email_formatted) }}</field>
            <field name="email_to">{{ object._get_internal_notification_emails() }}</field>
            <field name="description">Notify quality managers and salesperson when a tone evaluation is sent to the client.</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px; font-size: 13px;">
    <p style="margin: 0px; padding: 0px;">
        Se ha enviado la partida para evaluacion del cliente.<br/><br/>
        <strong>Partida:</strong> <t t-out="object.partida or ''"/><br/>
        <strong>Cliente:</strong> <t t-out="object.cliente or ''"/><br/>
        <strong>Color:</strong> <t t-out="object.color or ''"/><br/>
        <strong>Tipo de tono:</strong> <t t-out="object.tono or ''"/><br/>
        <strong>Resultado actual:</strong> <t t-out="object._get_resultado_label()"/><br/>
        <strong>Vendedor:</strong> <t t-out="object.pedido_line_id.pedido_id.user_id.name or ''"/><br/>
    </p>
</div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>

        <record id="mail_template_tono_eval_client_response" model="mail.template">
            <field name="name">Quality Tone Evaluation Client Response</field>
            <field name="model_id" ref="idtx_batch_quality.model_control_tono_eval_log"/>
            <field name="subject">IDETEX S.A.C. - Respuesta del cliente para partida {{ object.partida or '' }}: {{ object._get_resultado_label() }}</field>
            <field name="email_from">{{ (object.user_id.email_formatted or user.email_formatted or object.create_uid.email_formatted) }}</field>
            <field name="email_to">{{ object._get_quality_manager_notification_emails() }}</field>
            <field name="description">Notify quality managers when the client approves or rejects a tone evaluation.</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px; font-size: 13px;">
    <p style="margin: 0px; padding: 0px;">
        El cliente ha respondido la evaluacion de tono.<br/><br/>
        <strong>Partida:</strong> <t t-out="object.partida or ''"/><br/>
        <strong>Cliente:</strong> <t t-out="object.cliente or ''"/><br/>
        <strong>Color:</strong> <t t-out="object.color or ''"/><br/>
        <strong>Tipo de tono:</strong> <t t-out="object.tono or ''"/><br/>
        <strong>Respuesta del cliente:</strong> <t t-out="object._get_resultado_label()"/><br/>
        <strong>Vendedor:</strong> <t t-out="object.pedido_line_id.pedido_id.user_id.name or ''"/><br/>
    </p>
</div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>

	</data>
</odoo>
