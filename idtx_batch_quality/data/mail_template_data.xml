<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data noupdate="0">

        <record id="mail_template_laboratorio_summary_front" model="mail.template">
            <field name="name">Laboratorio: Enviar Resumen por Partida</field>
            <field name="model_id" ref="idtx_batch_control.model_control_pedido_line"/>
			<field name="subject">IDETEX S.A.C. - Resumen de Laboratorio {{ object.batch or '' }}</field>
            <field name="email_from">{{ (object.user_id.email_formatted or object.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="partner_to" eval="False"/>
            <field name="use_default_to" eval="True"/>
            <field name="description">Used by quality team when they send laboratory summary to recipients</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px;">
    <p style="margin: 0px; padding: 0px; font-size: 13px;">
        Hello,
        <br/><br/>
        Your laboratory summary for batch <span style="font-weight: bold;"  t-out="object.batch or ''">C377961</span>
        <br/><br/>
        Do not hesitate to contact us if you have any questions.
        <t t-if="not is_html_empty(object.user_id.signature)">
            <div>--<br/><t t-out="object.user_id.signature or ''">Mercedes Carrion</t></div>
        </t>
    </p>
</div>
            </field>
            <field name="report_template_ids" eval="[(4, ref('idtx_batch_quality.action_report_laboratorio_summary_pedido_line'))]"/>
            <field name="auto_delete" eval="True"/>
        </record>

	</data>
</odoo>
