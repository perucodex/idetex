<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_laboratorio_summary_compact" model="report.paperformat">
        <field name="name">Laboratorio Summary Compact</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">20</field>
        <field name="margin_bottom">6</field>
        <field name="margin_left">6</field>
        <field name="margin_right">6</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_laboratorio_summary_pedido_line" model="ir.actions.report">
        <field name="name">Laboratory Summary by Batch</field>
        <field name="model">control.pedido.line</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">idtx_batch_quality.report_laboratorio_summary_pedido_line</field>
        <field name="report_file">idtx_batch_quality.report_laboratorio_summary_pedido_line</field>
        <field name="binding_model_id" ref="idtx_batch_control.model_control_pedido_line"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="idtx_batch_quality.paperformat_laboratorio_summary_compact"/>
        <field name="print_report_name">'Laboratory_Summary_%s' % (object.batch or 'Batch')</field>
    </record>

    <template id="report_laboratorio_summary_pedido_line">
        <t t-call="idtx_batch_quality.report_laboratorio_summary_pedido_line_raw"/>
    </template>

    <template id="report_laboratorio_summary_pedido_line_raw">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="line">
                <t t-set="report_lang" t-value="line.env.context.get('lab_lang') or line._get_mail_recipient_partner().lang or line.env.context.get('lang') or 'en_US'"/>
                <t t-call="idtx_batch_quality.report_laboratorio_summary_pedido_line_document" t-lang="report_lang">
                    <t t-set="line" t-value="line.with_context(lang=report_lang)"/>
                </t>
            </t>
        </t>
    </template>

    <template id="report_laboratorio_summary_pedido_line_document">
        <t t-set="company" t-value="line.env.company"/>
        <t t-set="base_url" t-value="line.env['ir.config_parameter'].sudo().get_param('web.base.url')"/>
        <t t-set="payload" t-value="line._laboratorio_summary_report_payload()"/>
        <t t-set="dim_h" t-value="payload.get('dimrev_highest', {})"/>
        <t t-set="dim_l1" t-value="payload.get('dimrev_l1', {})"/>
        <t t-set="sol" t-value="payload.get('solidez', {})"/>
        <div class="page">
            <link rel="stylesheet" t-att-href="'%s/idtx_batch_quality/static/src/css/laboratorio_summary_report.css' % (base_url or '')"/>
                <meta charset="utf-8"/>
                <div class="lab-wrap">
                            <table class="lab-top">
                                <tr>
                                    <td class="lab-top-logo-cell lab-top-col-main">
                                        <div class="lab-brand-wrap">
                                            <div class="lab-brand-main">
                                                <img t-if="company.logo" t-att-src="'%s/web/image/res.company/%s/logo' % (base_url or '', company.id)" class="lab-brand-logo" alt="Logo"/>
                                                <span t-if="not company.logo" class="lab-brand-fallback">IDETEX</span>
                                            </div>
                                            <div class="lab-brand-certs">
                                                <span class="lab-cert-link">
                                                    <img class="lab-cert-logo" t-att-src="'%s/idtx_batch_quality/static/src/img/certs/iso_logo.png' % (base_url or '')" alt="ISO"/>
                                                </span>
                                                <span class="lab-cert-link">
                                                    <img class="lab-cert-logo" t-att-src="'%s/idtx_batch_quality/static/src/img/certs/iaf_logo.svg' % (base_url or '')" alt="IAF"/>
                                                </span>
                                                <span class="lab-cert-snas-box">
                                                    <img class="lab-cert-logo-snas" t-att-src="'%s/idtx_batch_quality/static/src/img/certs/snas_inacal.jpg' % (base_url or '')" alt="SNAS"/>
                                                    <span class="lab-cert-caption-snas">Reg. No. 391/Q-058</span>
                                                </span>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="lab-top-logo-cell lab-contact lab-top-col-contact">
                                        <div t-esc="company.street or ''"/>
                                        <div>
                                            <span t-esc="company.city or ''"/>
                                            <span t-if="company.city and company.country_id">, </span>
                                            <span t-esc="company.country_id.name or ''"/>
                                        </div>
                                        <div t-esc="company.website or ''"/>
                                    </td>
                                </tr>
                            </table>

                            <table class="lab-main-title">
                                <tr>
                                    <td>
                                        <div class="title" t-esc="payload.get('report_title') or '-'"/>
                                        <div class="subtitle">Consolidated quality evaluation record</div>
                                    </td>
                                </tr>
                            </table>

                            <table class="lab-sample">
                                <tr>
                                    <th colspan="4">Sample Information</th>
                                </tr>
                                <tr>
                                    <td class="lab-col-16"><b>Client</b></td>
                                    <td class="lab-col-34" t-esc="line.pedido_id.customer or '-'"/>
                                    <td class="lab-col-16"><b>Final Result</b></td>
                                    <td class="lab-col-34" t-attf-class="lab-status-final {{ 'lab-status-ok' if payload.get('overall_status') == 'Pass' else 'lab-status-fail' }}" t-esc="payload.get('overall_result_label') or '-'"/>
                                </tr>
                                <tr>
                                    <td><b>Description</b></td>
                                    <td t-esc="line.description or '-'"/>
                                    <td><b>Print Date</b></td>
                                    <td t-esc="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y')"/>
                                </tr>
                                <tr>
                                    <td><b>Batch</b></td>
                                    <td t-esc="line.batch or '-'"/>
                                    <td><b>Order</b></td>
                                    <td t-esc="line.pedido_id.numordped or '-'"/>
                                </tr>
                                <tr>
                                    <td><b>Color Code</b></td>
                                    <td t-esc="line.colorcode or '-'"/>
                                    <td><b>Roll Count</b></td>
                                    <td class="lab-num" t-esc="'%s' % (line.rollos or 0)"/>
                                </tr>
                                <tr>
                                    <td><b>Color</b></td>
                                    <td t-esc="line.colorname or '-'"/>
                                    <td><b>Kilograms</b></td>
                                    <td class="lab-num" t-esc="'%.2f' % (line.kilograms or 0.0)"/>
                                </tr>
                            </table>

                            <div class="lab-sec">
                                <div class="lab-sec-head">Care Instructions</div>
                                <div class="lab-sec-body">
                                    <div class="lab-care-icons-cell">
                                        <table class="lab-care-icons-table">
                                            <tr>
                                                <td class="lab-care-icon-cell" t-if="payload.get('care_wash_icon_url')">
                                                    <img class="lab-care-icon" t-att-src="payload.get('care_wash_icon_url')" alt="Wash"/>
                                                </td>
                                                <td class="lab-care-icon-cell" t-if="payload.get('care_dry_icon_url')">
                                                    <img class="lab-care-icon" t-att-src="payload.get('care_dry_icon_url')" alt="Dry"/>
                                                </td>
                                                <td class="lab-care-icon-cell" t-if="payload.get('care_bleaching_icon_url')">
                                                    <img class="lab-care-icon" t-att-src="payload.get('care_bleaching_icon_url')" alt="Bleach"/>
                                                </td>
                                                <td class="lab-care-icon-cell" t-if="payload.get('care_ironing_icon_url')">
                                                    <img class="lab-care-icon" t-att-src="payload.get('care_ironing_icon_url')" alt="Iron"/>
                                                </td>
                                                <td class="lab-care-icon-cell" t-if="payload.get('care_iron_steam_icon_url')">
                                                    <img class="lab-care-icon" t-att-src="payload.get('care_iron_steam_icon_url')" alt="No Steam"/>
                                                </td>
                                                <td class="lab-care-icon-cell" t-if="payload.get('care_profesional_dry_icon_url')">
                                                    <img class="lab-care-icon" t-att-src="payload.get('care_profesional_dry_icon_url')" alt="Professional Dry"/>
                                                </td>
                                                <td class="lab-care-icon-cell" t-if="payload.get('care_profesional_wet_icon_url')">
                                                    <img class="lab-care-icon" t-att-src="payload.get('care_profesional_wet_icon_url')" alt="Professional Wet"/>
                                                </td>
                                                <td class="lab-care-icon-cell" t-if="payload.get('care_do_not_wring_icon_url')">
                                                    <img class="lab-care-icon" t-att-src="payload.get('care_do_not_wring_icon_url')" alt="Do Not Wring"/>
                                                </td>
                                            </tr>
                                        </table>
                                    </div>
                                    <div class="lab-care-text-cell" t-esc="payload.get('care_instruction') or '-'"/>
                                </div>
                            </div>

                            <div class="lab-sec">
                                <div class="lab-sec-head">Status Summary</div>
                                <div class="lab-sec-body">
                                    <table class="lab-grid lab-grid-no-margin">
                                        <tr>
                                            <th>Evaluation</th>
                                            <th class="lab-center">Status</th>
                                        </tr>
                                        <tr t-foreach="payload.get('summary_rows', [])" t-as="row">
                                            <td t-esc="row.get('item')"/>
                                            <td t-attf-class="lab-center {{ 'lab-ok' if row.get('status') == 'Pass' else 'lab-fail' }}" t-esc="row.get('status_label') or row.get('status')"/>
                                        </tr>
                                    </table>
                                </div>
                            </div>

                            <div class="lab-sec">
                                <div class="lab-sec-head">Test Results</div>
                                <div class="lab-sec-body">
                                    <table class="lab-grid">
                                        <tr>
                                            <th>Test</th>
                                            <th class="lab-center">Requirement</th>
                                            <th>Result
                                                <div class="lab-method">
                                                    <span>Evaluated Wash:</span>
                                                    <span t-esc="' ' + ((dim_h.get('wash_label') if dim_h else '-') or '-')"/>
                                                </div>
                                            </th>
                                            <th class="lab-center">Pass / Fail</th>
                                        </tr>
                                        <tr t-foreach="payload.get('test_rows', [])" t-as="row">
                                            <td>
                                                <b t-esc="row.get('test')"/>
                                                <span class="lab-method" t-esc="row.get('method') or '-'"/>
                                                <div class="lab-note-wrap" t-if="row.get('notes')">
                                                    <div class="lab-note-row" t-foreach="row.get('notes') or []" t-as="note">
                                                        <span class="lab-note lab-note-key" t-esc="note.get('label') or '-'"/>
                                                        <span class="lab-note lab-note-sep">:</span>
                                                        <span class="lab-note lab-note-value" t-out="note.get('value') or '-'"/>
                                                    </div>
                                                </div>
                                            </td>
                                            <td t-attf-class="lab-center {{ 'lab-vtop' if row.get('requirement_pairs') else '' }}">
                                                <t t-if="row.get('requirement_pairs')">
                                                    <div class="lab-req-wrap">
                                                        <table class="lab-req-inner">
                                                            <tr t-foreach="row.get('requirement_pairs') or []" t-as="pair">
                                                                <td class="lab-req-label" t-esc="pair.get('label') or '-'"/>
                                                                <td class="lab-req-value" t-out="pair.get('value') or '-'"/>
                                                            </tr>
                                                        </table>
                                                    </div>
                                                </t>
                                                <t t-if="not row.get('requirement_pairs') and row.get('requirement_lines')">
                                                    <span class="lab-req-line"
                                                          t-foreach="row.get('requirement_lines') or []"
                                                          t-as="req_line"
                                                          t-out="req_line"/>
                                                </t>
                                                <t t-if="not row.get('requirement_pairs') and not row.get('requirement_lines')">
                                                    <span t-out="row.get('requirement') or '-'"/>
                                                </t>
                                            </td>
                                            <td t-attf-class="lab-num {{ 'lab-vtop' if row.get('result_lines') else '' }}">
                                                <t t-if="row.get('result_lines')">
                                                    <span class="lab-res-line"
                                                          t-foreach="row.get('result_lines') or []"
                                                          t-as="res_line"
                                                          t-esc="res_line"/>
                                                </t>
                                                <t t-if="not row.get('result_lines')">
                                                    <span t-esc="'%.2f' % (row.get('result') or 0.0)"/>
                                                </t>
                                            </td>
                                            <td t-attf-class="lab-center {{ 'lab-ok' if row.get('status') == 'Pass' else 'lab-fail' }}" t-esc="row.get('status_label') or row.get('status')"/>
                                        </tr>
                                    </table>
                                </div>
                            </div>

                            <div class="lab-sec">
                                <div class="lab-sec-head">Scoring</div>
                                <div class="lab-sec-body">
                                    <table class="lab-score-wrap">
                                        <tr>
                                            <td class="lab-score-col-legend">
                                                <table class="lab-legend-grid">
                                                    <tr>
                                                        <td t-foreach="payload.get('score_legend') or []" t-as="legend">
                                                            <div class="lab-legend-title" t-esc="legend.get('title') or '-'"/>
                                                            <div t-foreach="legend.get('lines') or []" t-as="legend_line" t-esc="legend_line"/>
                                                        </td>
                                                    </tr>
                                                </table>
                                            </td>
                                            <td class="lab-sign-box lab-score-col-sign">
                                                <img t-if="payload.get('emitter_signature_url')" t-att-src="payload.get('emitter_signature_url')" alt="Digital Signature" class="lab-sign-image"/>
                                                <div t-if="not payload.get('emitter_signature_url')" class="lab-sign-empty">No digital signature</div>
                                                <div class="lab-sign-line"/>
                                                <div class="lab-sign-name" t-esc="payload.get('emitter_name') or '-'"/>
                                                <div class="lab-sign-role" t-esc="payload.get('emitter_role') or '-'"/>
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                </div>
        </div>
        
    </template>
</odoo>
