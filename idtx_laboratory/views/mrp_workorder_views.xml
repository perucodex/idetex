<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mrp_production_workorder_tree_editable_view_mo_form_lab_form" model="ir.ui.view">
        <field name="name">mrp.workorder.list.editable.lab</field>
        <field name="model">mrp.workorder</field>
        <field name="inherit_id" ref="mrp.mrp_production_workorder_tree_editable_view_mo_form"/>
        <field name="arch" type="xml">
            <xpath expr="//list/field[@name='name']" position="after">
                <field name="mrwo_id" required="1"/>
            </xpath>
            <xpath expr="//list/field[@name='name']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="mrp_production_workorder_form_view_inherit_lab_form" model="ir.ui.view">
        <field name="name">mrp.work.order.form.lab</field>
        <field name="model">mrp.workorder</field>
        <field name="inherit_id" ref="mrp.mrp_production_workorder_form_view_inherit"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='employee_assigned_ids']" position="after">
                <field name="equipment_ids" widget="many2many_tags" domain="[('workcenter_id','=',workcenter_id)]"/>
            </xpath>
            <xpath expr="//field[@name='qty_remaining']" position="after">
                <field name="roll_weight" invisible="1"/>
                <field name="progress" widget="progressbar"/>
                <field name="weave_type"/>
            </xpath>
            <xpath expr="//notebook/page[@name='workorder_page_work_instruction']" position="after">
                <page string="Rolls" name="rolls" invisible="not weaving_wo">
                    <field name="weave_type" invisible="1"/>
                    <field name="roll_ids" readonly="state != 'progress'">
                        <list editable="bottom" delete="0">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="equipment_id"/>
                            <field name="employee_id"/>
                            <field name="uom_id"/>
                            <field name="technical_id" column_invisible="1"/>
                            <field name="size_id" column_invisible="parent.weave_type != 'rect'" required="parent.weave_type == 'rect'" domain="[('technical_id','=', technical_id)]" options="{'no_create': True, 'no_open': True}"/>
                            <field name="quantity" column_invisible="parent.weave_type != 'rect'" required="parent.weave_type == 'rect'"/>
                            <field name="in_batch" column_invisible="1"/>
                            <field name="gross_weight" sum="Total" required="1" column_invisible="parent.weave_type == 'rect'" readonly="in_batch"/>
                            <field name="net_weight" sum="Total" required="1" column_invisible="parent.weave_type == 'rect'"/>
                            <button name="unlink" icon="fa-trash" type="object" invisible="parent.weave_type == 'rect' or gross_weight" title="Delete"/>
                            <button name="unlink" icon="fa-trash" type="object" invisible="parent.weave_type != 'rect' or quantity" title="Delete"/>
                        </list>
                    </field>
                </page>
            </xpath>
            <!-- Insertamos weave_type en el formulario, aunque sea invisible -->
            <xpath expr="//field[@name='duration_expected']" position="after">
                <field name="weave_type" invisible="1"/>
            </xpath>
        </field>
    </record>
    
</odoo>