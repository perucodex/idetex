<?xml version="1.0" encoding="utf-8"?>
<odoo>

        <record id="base_process_form_view" model="ir.ui.view">
            <field name="name">base.process.form</field>
            <field name="model">base.process</field>
            <field name="arch" type="xml">
                <form string="Base Process">
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="code"/>
                                <field name="time" widget="float_time"/>
                                <field name="program"/>
                            </group>
                            <group>
                                <field name="nc"/>
                                <field name="lin_maq"/>
                                <field name="codmaq"/>
                            </group>
                        </group>
                        <notebook>
                            <page name="lines_page" string="Lines">
                                <field name="base_process_line_ids" nolabel="1">
                                    <!-- Sin edicion en linea: la fila abre el form en MODAL (framework). -->
                                    <list decoration-info="has_table" decoration-primary="line_type == 'colorants'">
                                        <field name="sequence" widget="handle"/>
                                        <field name="line_type"/>
                                        <field name="product_id" required="line_type != 'colorants'" readonly="line_type == 'colorants'"/>
                                        <field name="order_number"/>
                                        <field name="factor" readonly="line_type != 'product'"/>
                                        <field name="uom" readonly="line_type == 'colorants'"/>
                                        <field name="has_table" column_invisible="1"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="base_process_tree_view" model="ir.ui.view">
            <field name="name">base.process.tree</field>
            <field name="model">base.process</field>
            <field name="arch" type="xml">
                <list string="Base Process">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="time" widget="float_time"/>
                    <field name="program"/>
                    <field name="nc"/>
                    <field name="lin_maq"/>
                    <field name="codmaq"/>
                </list>
            </field>
        </record>

        <record id="base_process_search_view" model="ir.ui.view">
            <field name="name">base.process.search</field>
            <field name="model">base.process</field>
            <field name="arch" type="xml">
                <search string="Proceso base">
                    <field name="name" string="Proceso" filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"/>
                    <field name="code"/>
                    <field name="program"/>
                </search>
            </field>
        </record>

        <record id="base_process_line_form_view" model="ir.ui.view">
            <field name="name">base.process.line.form</field>
            <field name="model">base.process.line</field>
            <field name="arch" type="xml">
                <form string="Línea de Proceso">
                    <sheet>
                        <div class="oe_title">
                            <h1 invisible="line_type == 'colorants'"><field name="product_id" options="{'no_create': True, 'no_open': True}" required="line_type != 'colorants'"/></h1>
                            <h1 invisible="line_type != 'colorants'">COLORANTES</h1>
                        </div>
                        <group>
                            <group>
                                <field name="base_process_id" readonly="1"/>
                                <field name="line_type"/>
                                <field name="order_number"/>
                            </group>
                            <group invisible="line_type == 'colorants'">
                                <field name="factor" readonly="line_type != 'product'"/>
                                <field name="uom"/>
                                <field name="has_table" invisible="1"/>
                            </group>
                        </group>
                        <div invisible="line_type != 'colorants'" class="alert alert-info" role="alert">
                            Hueco de COLORANTES: los productos reales (marca concreta) y sus porcentajes
                            los elige el laboratorio al crear la receta, como sub-líneas de esta línea.
                        </div>
                        <separator string="Tabla de Rangos (suma % de colorantes del proceso → cantidad)" invisible="line_type != 'range'"/>
                        <field name="range_ids" nolabel="1" invisible="line_type != 'range'">
                            <list editable="bottom">
                                <field name="percent_from"/>
                                <field name="percent_to"/>
                                <field name="factor"/>
                            </list>
                        </field>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="base_process_line_tree_view" model="ir.ui.view">
            <field name="name">base.process.line.tree</field>
            <field name="model">base.process.line</field>
            <field name="arch" type="xml">
                <list string="Base Process Line" edit="0" create="0">
                    <field name="base_process_id"/>
                    <field name="product_id"/>
                    <field name="order_number"/>
                                            <field name="factor"/>
                    <field name="uom"/>
                </list>
            </field>
        </record>
        
        <record id="base_process_line_search_view" model="ir.ui.view">
            <field name="name">base.process.line.search</field>
            <field name="model">base.process.line</field>
            <field name="arch" type="xml">
                <search string="Search Base Process Line">
                    <field name="base_process_id"/>
                    <field name="product_id"/>
                    <group>
                        <filter string="Base Process" name="group_by_process" domain="[]" context="{'group_by': 'base_process_id'}"/>
                        <filter string="Product" name="group_by_product" domain="[]" context="{'group_by': 'product_id'}"/>
                        <filter string="Factor" name="group_by_factor" domain="[]" context="{'group_by': 'factor'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="base_process_action" model="ir.actions.act_window">
            <field name="name">Base Process</field>
            <field name="res_model">base.process</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="base_process_tree_view"/>
        </record>

        <record id="base_process_line_action" model="ir.actions.act_window">
            <field name="name">Base Process Line</field>
            <field name="res_model">base.process.line</field>
            <field name="view_mode">list</field>
            <field name="view_id" ref="base_process_line_tree_view"/>
            <field name="context">{'search_default_group_by_process': 1}</field>
        </record>

</odoo>
