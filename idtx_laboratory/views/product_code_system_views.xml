<?xml version="1.0" encoding="utf-8"?>
<odoo>

        <record id="product_appearance_tree_view" model="ir.ui.view">
            <field name="name">product.appearance.tree</field>
            <field name="model">product.appearance</field>
            <field name="arch" type="xml">
                <list string="Product Appearance" editable="top">
                    <field name="code"/>
                    <field name="name"/>
                </list>
            </field>
        </record>

        <record id="product_family_tree_view" model="ir.ui.view">
            <field name="name">product.family.tree</field>
            <field name="model">product.family</field>
            <field name="arch" type="xml">
                <list string="Product Family" editable="top">
                    <field name="code"/>
                    <field name="name"/>
                </list>
            </field>
        </record>

        <record id="product_gauge_tree_view" model="ir.ui.view">
            <field name="name">product.gauge.tree</field>
            <field name="model">product.gauge</field>
            <field name="arch" type="xml">
                <list string="Product Gauge" editable="top">
                    <field name="code"/>
                    <field name="name"/>
                </list>
            </field>
        </record>

        <record id="product_fiber_tree_view" model="ir.ui.view">
            <field name="name">product.fiber.tree</field>
            <field name="model">product.fiber</field>
            <field name="arch" type="xml">
                <list string="Product Fiber" editable="top">
                    <field name="code"/>
                    <field name="name"/>
                </list>
            </field>
        </record>

        <record id="product_title_tree_view" model="ir.ui.view">
            <field name="name">product.title.tree</field>
            <field name="model">product.title</field>
            <field name="arch" type="xml">
                <list string="Product Title" editable="top">
                    <field name="code"/>
                    <field name="name"/>
                </list>
            </field>
        </record>

        <record id="product_appearance_action" model="ir.actions.act_window">
            <field name="name">Product Appearance</field>
            <field name="res_model">product.appearance</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="product_appearance_tree_view"/>
        </record>

        <record id="product_family_action" model="ir.actions.act_window">
            <field name="name">Product Family</field>
            <field name="res_model">product.family</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="product_family_tree_view"/>
        </record>

        <record id="product_gauge_action" model="ir.actions.act_window">
            <field name="name">Product Gauge</field>
            <field name="res_model">product.gauge</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="product_gauge_tree_view"/>
        </record>

        <record id="product_fiber_action" model="ir.actions.act_window">
            <field name="name">Product Fiber</field>
            <field name="res_model">product.fiber</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="product_fiber_tree_view"/>
        </record>

        <record id="product_title_action" model="ir.actions.act_window">
            <field name="name">Product Title</field>
            <field name="res_model">product.title</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="product_title_tree_view"/>
        </record>

</odoo>