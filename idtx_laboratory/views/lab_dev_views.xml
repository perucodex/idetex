<?xml version="1.0" encoding="utf-8"?>
<odoo>

        <record id="lab_dev_form_view" model="ir.ui.view">
            <field name="name">lab.dev.form</field>
            <field name="model">lab.dev</field>
            <field name="arch" type="xml">
                <form string="Lab Dev">
                    <header>
                        <button name="action_development" type="object" string="Develop" class="oe_highlight" invisible="state != 'draft'" confirm="Are you sure you want to develop this colors ?"/>
                        <button name="action_done" type="object" string="Done" class="oe_highlight" invisible="state != 'dev'"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div name="button_box" class="oe_button_box">
                            <button name="open_recipes"
                                    class="oe_stat_button"
                                    icon="fa-flask"
                                    type="object"
                                    invisible="not color_recipe_ids">
                                    <field name="recipe_count" string="Recipes" widget="statinfo"/>
                            </button>
                        </div>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="lab_dev_date" readonly="sale_order_id"/>
                                <field name="sale_order_id" readonly="1" invisible="not sale_order_id"/>                              
                            </group>
                            <group>
                                <field name="partner_id" readonly="sale_order_id" force_save="1" required="not sale_order_id"/>  
                                <field name="company_id" readonly="1" groups="base.group_multi_company"/>                          
                            </group>
                        </group>
                        <notebook>
                            <page name="color_page" string="Colors" invisible="state == 'draft'">
                                <field name="lab_dev_line_ids" context="{'form_view_ref': 'idtx_laboratory.lab_dev_line_view_form'}">
                                    <list editable="top" open_form_view="True" delete="0" create="0">
                                        <!-- <field name="product_id" readonly="1"/>   -->
                                        <field name="color_name" readonly="1"/>
                                        <field name="color_code" readonly="1"/>
                                        <field name="color" widget="color" readonly="1"/>
                                        <field name="color" string="Hex" readonly="1"/>
                                        <field name="color_recipe_ids"/>
                                        <field name="state" widget="badge" decoration-success="state == 'approved'"/>
                                    </list>
                                </field>
                            </page>
                            <page name="color_page_edit" string="Colors" invisible="state != 'draft'">
                                <field name="lab_dev_line_ids" context="{'form_view_ref': 'idtx_laboratory.lab_dev_line_view_form'}">
                                    <list editable="bottom">
                                        <!-- <field name="product_id"/>   -->
                                        <field name="color_name"/>
                                        <field name="color_code" readonly="1"/>
                                        <field name="color" widget="color" readonly="1"/>
                                        <field name="color" string="Hex" readonly="1"/>
                                        <field name="color_recipe_ids"/>
                                        <field name="state" widget="badge" decoration-success="state == 'approved'"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="lab_dev_tree_view" model="ir.ui.view">
            <field name="name">lab.dev.tree</field>
            <field name="model">lab.dev</field>
            <field name="arch" type="xml">
                <list string="Lab Dev">
                    <field name="name"/>
                    <field name="lab_dev_date"/>
                    <field name="sale_order_id"/>
                    <field name="partner_id"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="lab_dev_line_ids"/>
                    <field name="state" widget="badge" decoration-success="state == 'done'" decoration-warning="state == 'dev'"/>
                </list>
            </field>
        </record>

        <record id="lab_dev_view_search" model="ir.ui.view">
            <field name="name">lab.dev.view.search</field>
            <field name="model">lab.dev</field>
            <field name="arch" type="xml">
                <search string="">
                    <field name="name"/>
                    <field name="lab_dev_date"/>
                    <field name="sale_order_id"/>
                    <field name="partner_id"/>
                    <field name="lab_dev_line_ids" string="Product" filter_domain="[('lab_dev_line_ids.product_id', 'ilike', self)]"/>
                    <field name="lab_dev_line_ids" string="Color Code" filter_domain="[('lab_dev_line_ids.color_code', 'ilike', self)]"/>
                    <field name="lab_dev_line_ids" string="Color Name" filter_domain="[('lab_dev_line_ids.color_name', 'ilike', self)]"/>
                    <filter name="approved" string="Approved" domain="[('state','=','approved')]"/>
                    <filter name="test" string="Test" domain="[('state','=','test')]"/>
                    <filter name="progress" string="In Progress" domain="[('state', 'in', ('draft', 'dev'))]"/>
                    <group>
                        <filter string="Lav Dev Date" name="group_by_lab_dev_date" domain="[]" context="{'group_by': 'lab_dev_date'}"/>
                        <filter string="Sale Order" name="group_by_sale_order" domain="[]" context="{'group_by': 'sale_order_id'}"/>
                        <filter string="Customer" name="group_by_partner" domain="[]" context="{'group_by': 'partner_id'}"/>
                        <!-- <filter string="Color Code" name="group_by_color_code" domain="[]" context="{'group_by': 'color_code'}"/>
                        <filter string="Color Name" name="group_by_color_name" domain="[]" context="{'group_by': 'color_name'}"/> -->
                    </group>
                </search>
            </field>
        </record>

        <record id="lab_dev_line_view_form" model="ir.ui.view">
            <field name="name">lab.dev.line.view.form</field>
            <field name="model">lab.dev.line</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <!-- <field name="available_product_ids" invisible="1"/>  -->
                                <field name="sale_order_id" invisible="1"/> 
                                <!-- <field name="product_id" required="1" readonly="sale_order_id or color_recipe_ids" domain="[('id', 'in', available_product_ids)]" force_save="1"/>   -->
                                <field name="color_name" required="1" readonly="sale_order_id or color_recipe_ids" force_save="1"/>
                                <field name="color_code" readonly="1" force_save="1"/>
                            </group>   
                            <group>
                                <field name="color" widget="color" readonly="color_recipe_ids" force_save="1"/>
                                <field name="color" string="Hex" readonly="color_recipe_ids" force_save="1"/>
                                <!-- <field name="bath_ratio" readonly="color_recipe_ids" force_save="1"/> -->
                            </group>   
                            <group colspan="2" string="Color Code Composition">
                                <group>
                                    <field name="color_process_type_id" options="{'no_create': True, 'no_open': True}" readonly="color_recipe_ids" force_save="1"/>
                                    <field name="fiber_id" options="{'no_create': True, 'no_open': True}" readonly="color_recipe_ids"/>
                                </group>   
                                <group>
                                    <field name="color_range_id" options="{'no_create': True, 'no_open': True}" readonly="color_recipe_ids" force_save="1"/>
                                    <field name="color_intensity_id" options="{'no_create': True, 'no_open': True}" readonly="color_recipe_ids" force_save="1"/>
                                </group>   
                            </group>                                            
                        </group>
                        <notebook>
                            <page name="recipe_page" string="Recipes">
                                <field name="color_recipe_ids" readonly="state == 'approved' or not color_code" context="{'form_view_ref': 'idtx_laboratory.color_recipe_form_view'}">
                                    <list editable="top" open_form_view="True">
                                        <field name="name" readonly="1"/>
                                        <field name="recipe_date" readonly="1"/>
                                        <!-- <field name="product_id"/> -->
                                        <field name="color_name"/>
                                        <field name="recipe_color_code" readonly="1"/>
                                        <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                                        <field name="state" widget="badge" decoration-success="state == 'approved'"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="lab_dev_line_tree_view" model="ir.ui.view">
            <field name="name">lab.dev.line.tree</field>
            <field name="model">lab.dev.line</field>
            <field name="arch" type="xml">
                <list string="Lab Dev Line">
                    <field name="lab_dev_id"/>
                    <field name="color_code" optional="hide"/>
                    <field name="display_name"/>
                    <field name="color" widget="color"/>
                    <field name="color" string="Hex"/>
                    <field name="state" widget="badge" decoration-success="state == 'approved'"/>
                </list>
            </field>
        </record>

        <record id="lab_dev_line_search_view" model="ir.ui.view">
            <field name="name">lab.dev.line.search</field>
            <field name="model">lab.dev.line</field>
            <field name="arch" type="xml">
                <search string="Lab Dev Line">
                    <field name="color_code"/>
                    <field name="color_name"/>
                    <group>
                        <filter string="Lab Dev" name="group_by_lab_dev" domain="[]" context="{'group_by': 'lab_dev_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="lab_dev_action" model="ir.actions.act_window">
            <field name="name">Lab Dev</field>
            <field name="res_model">lab.dev</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="lab_dev_tree_view"/>
            <field name="context">{'search_default_progress': 1}</field>
            <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                Create a new lab dev
              </p>
            </field>
        </record>

</odoo>
