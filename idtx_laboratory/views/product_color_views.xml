<?xml version="1.0" encoding="utf-8"?>
<odoo>

        <record id="product_color_form_view" model="ir.ui.view">
            <field name="name">product.color.form</field>
            <field name="model">product.color</field>
            <field name="arch" type="xml">
                <form string="Product Color">
                    <sheet>
                        <div name="button_box" class="oe_button_box">
                            <!-- <button name="open_recipes"
                                    class="oe_stat_button"
                                    icon="fa-flask"
                                    type="object"
                                    invisible="not recipe_ids">
                                    <field name="recipe_count" string="Recipes" widget="statinfo"/>
                            </button> -->
                        </div>
                        <div class="oe_title">
                            <h1>
                                <field name="name"/>
                            </h1>
                        </div>
                        <group>
                            <group> 
                                <field name="currency_id"/>
                                <field name="unit_price"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>                            
                        </group>
                        <!-- <notebook>
                            <page name="labdev_page" string="Lab Dev">
                                <field name="lab_dev_ids" readonly="1"/>
                            </page>
                        </notebook> -->
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="product_color_tree_view" model="ir.ui.view">
            <field name="name">product.color.tree</field>
            <field name="model">product.color</field>
            <field name="arch" type="xml">
                <list string="Product Color">
                    <field name="name"/>
                    <field name="currency_id"/>
                    <field name="unit_price"/>
                    <field name="company_id" groups="base.group_multi_company" optional="hide" readonly="1"/>
                    <!-- <field name="recipe_ids"/> -->
                </list>
            </field>
        </record>

        <record id="product_color_action" model="ir.actions.act_window">
            <field name="name">Product Color</field>
            <field name="res_model">product.color</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="product_color_tree_view"/>
            <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                Create a new product color
              </p>
            </field>
        </record>

</odoo>
