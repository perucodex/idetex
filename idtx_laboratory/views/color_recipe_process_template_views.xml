<?xml version="1.0" encoding="utf-8"?>
<odoo>

        <record id="color_recipe_process_template_form_view" model="ir.ui.view">
            <field name="name">color.recipe.process.template.form</field>
            <field name="model">color.recipe.process.template</field>
            <field name="arch" type="xml">
                <form string="Color Recipe Process Template">
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="code"/>
                                <field name="nc"/>
                                <field name="lin_maq"/>
                                <field name="codmaq"/>
                            </group>
                        </group>
                        <notebook>
                            <page name="lines_page" string="Lines">
                                <field name="color_recipe_process_template_line_ids" nolabel="1">
                                    <list editable="bottom">
                                        <field name="product_id"/>
                                        <field name="factor"/>
                                        <field name="uom"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="color_recipe_process_template_tree_view" model="ir.ui.view">
            <field name="name">color.recipe.process.template.tree</field>
            <field name="model">color.recipe.process.template</field>
            <field name="arch" type="xml">
                <list string="Color Recipe">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="nc"/>
                    <field name="lin_maq"/>
                    <field name="codmaq"/>
                </list>
            </field>
        </record>

        <record id="color_recipe_process_template_action" model="ir.actions.act_window">
            <field name="name">Color Recipe</field>
            <field name="res_model">color.recipe.process.template</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="color_recipe_process_template_tree_view"/>
        </record>

</odoo>
