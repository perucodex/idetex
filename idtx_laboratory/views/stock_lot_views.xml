<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_production_lot_form_inherit_lab" model="ir.ui.view">
        <field name="name">stock.lot.form.inherit.lab</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="is_weaving" invisible="1"/>
                <field name="color_recipe_id" invisible="not is_weaving"/>
                <field name="color_code" invisible="1"/>
                <field name="color_name" invisible="1"/>
            </xpath>
            <!-- Calificación de lotes de insumos del lab: SOLO para el perfil
                 Validador de Lotes y solo si el producto es químico/colorante/
                 auxiliar. -->
            <xpath expr="//group[@name='description']" position="after">
                <field name="is_lab_supply" invisible="1"/>
                <notebook groups="idtx_laboratory.group_lab_lot_validator" invisible="not is_lab_supply">
                    <page name="lab_qualification_page" string="Calificación">
                        <group>
                            <group>
                                <field name="lab_state" widget="badge" readonly="1"
                                       decoration-success="lab_state == 'validated'"
                                       decoration-warning="lab_state == 'pending'"/>
                                <field name="lab_validated_date"/>
                                <field name="lab_validated_by_id"/>
                            </group>
                            <group>
                                <div colspan="2">
                                    <button name="action_lab_validate" type="object" string="Validar Lote"
                                            class="btn btn-primary" invisible="lab_state == 'validated'"/>
                                    <button name="action_lab_reset" type="object" string="Reabrir"
                                            class="btn btn-secondary" invisible="lab_state != 'validated'"/>
                                </div>
                            </group>
                        </group>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>

    <record id="view_stock_lot_recipe_custom_form" model="ir.ui.view">
        <field name="name">stock.lot.recipe.custom.form</field>
        <field name="model">stock.lot</field>
        <field name="arch" type="xml">
            <form string="Receta de Lote">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="recipe_lot_title" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <field name="colorfastness_washing_id"/>
                    </group>
                    <notebook>
                        <page name="recipe_page" string="Receta">
                            <field name="color_recipe_process_ids" nolabel="1">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="base_process_id"/>
                                    <field name="colorfastness_washing_id"/>
                                </list>
                                <form>
                                    <group>
                                        <field name="base_process_id"/>
                                        <field name="colorfastness_washing_id"/>
                                    </group>
                                    <notebook>
                                        <page name="lines_page" string="Lines">
                                            <field name="color_recipe_process_line_ids" nolabel="1">
                                                <list editable="bottom">
                                                    <field name="product_id"/>
                                                    <field name="factor"/>
                                                    <field name="uom"/>
                                                </list>
                                            </field>
                                        </page>
                                        <page name="colorfastness_tab" string="Solidez al Lavado">
                                            <group col="2">
                                                <group string="SOLIDEZ AL LAVADO">
                                                    <field name="color_change_degree"/>
                                                    <field name="migration_acetate"/>
                                                    <field name="migration_cotton"/>
                                                    <field name="migration_nylon"/>
                                                    <field name="migration_polyester"/>
                                                    <field name="migration_acrylic"/>
                                                    <field name="migration_wool"/>
                                                </group>
                                                <group>
                                                    <group string="SOLIDEZ AL FROTE">
                                                        <field name="colorfastness_to_dry_rubbing" string="Seco"/>
                                                        <field name="colorfastness_to_wet_rubbing" string="Húmedo"/>
                                                    </group>
                                                    <group string="SOLIDEZ A LA LUZ">
                                                        <field name="light_fastness_light"/>
                                                    </group>
                                                </group>
                                            </group>
                                        </page>
                                    </notebook>
                                </form>
                            </field>
                        </page>
                        <page name="colorfastness_tab" string="Solidez al Lavado">
                            <group col="2">
                                <group string="SOLIDEZ AL LAVADO">
                                    <field name="color_change_degree"/>
                                    <field name="migration_acetate"/>
                                    <field name="migration_cotton"/>
                                    <field name="migration_nylon"/>
                                    <field name="migration_polyester"/>
                                    <field name="migration_acrylic"/>
                                    <field name="migration_wool"/>
                                </group>
                                <group>
                                    <group string="SOLIDEZ AL FROTE">
                                        <field name="colorfastness_to_dry_rubbing" string="Seco"/>
                                        <field name="colorfastness_to_wet_rubbing" string="Húmedo"/>
                                    </group>
                                    <group string="SOLIDEZ A LA LUZ">
                                        <field name="light_fastness_light"/>
                                    </group>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
