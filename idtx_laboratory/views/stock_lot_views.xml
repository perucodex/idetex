<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_production_lot_form_inherit_lab" model="ir.ui.view">
        <field name="name">stock.lot.form.inherit.lab</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="color_recipe_id"/>
                <field name="color_code" invisible="1"/>
                <field name="color_name" invisible="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_stock_lot_recipe_custom_form" model="ir.ui.view">
        <field name="name">stock.lot.recipe.custom.form</field>
        <field name="model">stock.lot</field>
        <field name="arch" type="xml">
            <form string="Receta de Lote">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="recipe_lot_title" readonly="1"/>
                        </h1>
                    </div>
                    <notebook>
                        <page name="recipe_page" string="Receta">
                            <field name="color_recipe_process_ids" nolabel="1">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="base_process_id"/>
                                </list>
                                <form>
                                    <group>
                                        <field name="base_process_id"/>
                                    </group>
                                    <field name="color_recipe_process_line_ids" nolabel="1">
                                        <list editable="bottom">
                                            <field name="product_id"/>
                                            <field name="factor"/>
                                            <field name="uom"/>
                                        </list>
                                    </field>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
