<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="mrp_routing_workcenter_operation_form_view" model="ir.ui.view">
            <field name="name">mrp.routing.workcenter.operation.form</field>
            <field name="model">mrp.routing.workcenter.operation</field>
            <field name="inherit_id" ref="idtx_mrp.mrp_routing_workcenter_operation_form_view"/>
            <field name="arch" type="xml">
                <field name="company_id" position="after">
                    <field name="use_lab_recipe" widget="boolean_toggle"/>
                </field>
            </field>
        </record>

        <record id="mrp_routing_workcenter_operation_tree_view" model="ir.ui.view">
            <field name="name">mrp.routing.workcenter.list</field>
            <field name="model">mrp.routing.workcenter.operation</field>
            <field name="inherit_id" ref="idtx_mrp.mrp_routing_workcenter_operation_tree_view"/>
            <field name="arch" type="xml">
                <field name="company_id" position="after">
                    <field name="use_lab_recipe" widget="boolean_toggle"/>
                </field>
            </field>
        </record>

    </data>
</odoo>
