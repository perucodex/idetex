<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_view_list_inherit" model="ir.ui.view">
        <field name="name">sale.order.view.list.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook/page/field[@name='order_line']/list/field[@name='product_template_id']" position="after">
                <field name="product_color_id" options="{'no_create': True, 'no_open': True}"/>
                <!-- <field name="lab_dev_id" column_invisible="parent.state not in ('sale','cancel')" readonly="1"/> -->
            </xpath>
        </field>
    </record>
</odoo>
