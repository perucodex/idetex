<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Pantalla kiosco de registro de ubicaciones (OWL) -->
    <record id="action_lab_location_kiosk" model="ir.actions.client">
        <field name="name">Ubicación de LabDips</field>
        <field name="tag">idtx_laboratory.location_kiosk</field>
        <field name="target">fullscreen</field>
    </record>

    <record id="view_color_recipe_location_list" model="ir.ui.view">
        <field name="name">color.recipe.location.list</field>
        <field name="model">color.recipe.location</field>
        <field name="arch" type="xml">
            <list create="0">
                <field name="recipe_name" string="Receta"/>
                <field name="recipe_color_code" string="Código"/>
                <field name="color_name"/>
                <field name="area"/>
                <field name="drawer" string="Cajón"/>
                <field name="partner_id" optional="show"/>
                <field name="user_id" readonly="1"/>
                <field name="write_date" string="Actualizado"/>
            </list>
        </field>
    </record>

    <record id="view_color_recipe_location_form" model="ir.ui.view">
        <field name="name">color.recipe.location.form</field>
        <field name="model">color.recipe.location</field>
        <field name="arch" type="xml">
            <form string="Ubicación de LabDip">
                <sheet>
                    <group>
                        <group>
                            <field name="recipe_id"/>
                            <field name="area"/>
                            <field name="drawer" string="Cajón"/>
                        </group>
                        <group>
                            <field name="color_name" readonly="1"/>
                            <field name="recipe_color_code" readonly="1"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="user_id" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_color_recipe_location_search" model="ir.ui.view">
        <field name="name">color.recipe.location.search</field>
        <field name="model">color.recipe.location</field>
        <field name="arch" type="xml">
            <search>
                <field name="recipe_name" string="Receta"/>
                <field name="recipe_color_code" string="Código"/>
                <field name="color_name"/>
                <field name="drawer" string="Cajón"/>
                <field name="partner_id"/>
                <filter name="group_by_area" string="Área" context="{'group_by': 'area'}"/>
                <filter name="group_by_drawer" string="Cajón" context="{'group_by': 'drawer'}"/>
                <filter name="group_by_recipe" string="Receta" context="{'group_by': 'recipe_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_color_recipe_location" model="ir.actions.act_window">
        <field name="name">Ubicaciones de LabDips</field>
        <field name="res_model">color.recipe.location</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_color_recipe_location_search"/>
    </record>

    <!-- Menús bajo Operaciones -->
    <menuitem id="lab_location_kiosk_menu"
              name="Ubicación de LabDips"
              parent="lab_operations_menu"
              action="action_lab_location_kiosk"
              sequence="40"/>
    <menuitem id="lab_location_list_menu"
              name="Ubicaciones registradas"
              parent="lab_operations_menu"
              action="action_color_recipe_location"
              sequence="50"/>

</odoo>
