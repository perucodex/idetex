<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mixing_group_recipe_custom_form" model="ir.ui.view">
        <field name="name">color.recipe.mixing.group.recipe.form</field>
        <field name="model">color.recipe.mixing.group</field>
        <field name="arch" type="xml">
            <form string="Receta de Grupo">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="lot_summary" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="recipe_page" string="Receta">
                            <field name="mixing_group_process_ids" nolabel="1">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="base_process_id"/>
                                </list>
                                <form>
                                    <sheet>
                                        <group>
                                            <group>
                                                <field name="base_process_id" options="{'no_create': True, 'no_open': True}"/>
                                            </group>
                                        </group>
                                        <notebook>
                                            <page name="lines_page" string="Líneas">
                                                <field name="color_recipe_process_line_ids" nolabel="1">
                                                    <list editable="bottom">
                                                        <field name="product_id" domain="[('is_chemical','=', True)]"/>
                                                        <field name="factor"/>
                                                        <field name="uom"/>
                                                    </list>
                                                </field>
                                            </page>
                                        </notebook>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                        <page name="colorfastness_tab" string="Solidez al Lavado">
                            <group col="2">
                                <group string="SOLIDEZ AL LAVADO">
                                    <field name="color_change_degree"/>
                                    <field name="migration_acetate"/>
                                    <field name="migration_cotton"/>
                                    <field name="migration_nylon"/>
                                    <field name="migration_polyester"/>
                                    <field name="migration_acrylic"/>
                                    <field name="migration_wool"/>
                                </group>
                                <group>
                                    <group string="SOLIDEZ AL FROTE">
                                        <field name="colorfastness_to_dry_rubbing" string="Seco"/>
                                        <field name="colorfastness_to_wet_rubbing" string="Húmedo"/>
                                    </group>
                                    <group string="SOLIDEZ A LA LUZ">
                                        <field name="light_fastness_light"/>
                                    </group>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
