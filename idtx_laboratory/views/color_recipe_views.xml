<?xml version="1.0" encoding="utf-8"?>
<odoo>

        <record id="color_recipe_form_view" model="ir.ui.view">
            <field name="name">color.recipe.form</field>
            <field name="model">color.recipe</field>
            <field name="arch" type="xml">
                <form string="Product Color">
                    <header>
                        <button name="action_approve" type="object" string="Approve" class="oe_highlight" invisible="state != 'test'" groups="sales_team.group_sale_salesman"/>
                        <button name="action_return" type="object" string="Return" invisible="state == 'test'"/>
                        <button name="action_adjust_recipe" type="object" string="Adjust Recipe"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="recipe_date" readonly="state == 'approved'"/>
                                <field name="product_ids" invisible="1"/>
                                <field name="product_id" domain="[('id', 'in', product_ids)]" readonly="state == 'approved'" required="1"/>
                                <field name="color_name"/>
                                <field name="recipe_color_code"/>
                                <field name="colorfastness_washing_id"/>
                            </group>
                            <group>
                                <field name="lab_dev_id"/>
                                <field name="partner_id" readonly="1"/>
                                <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                            </group>
                        </group>
                        <notebook>
                            <page name="recipe_page" string="Recipe">
                                <field name="color_recipe_process_ids" nolabel="1" readonly="state == 'approved'">
                                    <list>
                                        <field name="sequence" widget="handle"/>
                                        <field name="base_process_id"/>
                                        <field name="colorfastness_washing_id"/>
                                    </list>
                                    <form>
                                        <sheet>
                                            <group>
                                                <group>
                                                    <field name="base_process_id" options="{'no_create': True, 'no_open': True}"/>
                                                    <field name="colorfastness_washing_id"/>
                                                </group>
                                            </group>
                                            <notebook>
                                                <page name="lines_page" string="Lines">
                                                    <field name="color_recipe_process_line_ids" nolabel="1">
                                                        <list editable="bottom">
                                                            <field name="product_id" domain="[('is_chemical','=', True)]"/>
                                                            <field name="factor"/>
                                                            <field name="uom"/>
                                                        </list>
                                                    </field>
                                                </page>
                                                <page name="colorfastness_tab" string="Solidez al Lavado">
                                                    <group col="2">
                                                        <group string="SOLIDEZ AL LAVADO">
                                                            <field name="color_change_degree"/>
                                                            <field name="migration_acetate"/>
                                                            <field name="migration_cotton"/>
                                                            <field name="migration_nylon"/>
                                                            <field name="migration_polyester"/>
                                                            <field name="migration_acrylic"/>
                                                            <field name="migration_wool"/>
                                                        </group>
                                                        <group>
                                                            <group string="SOLIDEZ AL FROTE">
                                                                <field name="colorfastness_to_dry_rubbing" string="Seco"/>
                                                                <field name="colorfastness_to_wet_rubbing" string="Húmedo"/>
                                                            </group>
                                                            <group string="SOLIDEZ A LA LUZ">
                                                                <field name="light_fastness_light"/>
                                                            </group>
                                                        </group>
                                                    </group>
                                                </page>
                                            </notebook>
                                        </sheet>
                                    </form>
                                </field>
                            </page>
                            <page name="colorfastness_tab" string="Solidez al Lavado">
                                <group col="2">
                                    <group string="SOLIDEZ AL LAVADO">
                                        <field name="color_change_degree"/>
                                        <field name="migration_acetate"/>
                                        <field name="migration_cotton"/>
                                        <field name="migration_nylon"/>
                                        <field name="migration_polyester"/>
                                        <field name="migration_acrylic"/>
                                        <field name="migration_wool"/>
                                    </group>
                                    <group>
                                        <group string="SOLIDEZ AL FROTE">
                                            <field name="colorfastness_to_dry_rubbing" string="Seco"/>
                                            <field name="colorfastness_to_wet_rubbing" string="Húmedo"/>
                                        </group>
                                        <group string="SOLIDEZ A LA LUZ">
                                            <field name="light_fastness_light"/>
                                        </group>
                                    </group>
                                </group>
                            </page>
                            <page name="observations_page" string="Observaciones">
                                <field name="observations" nolabel="1" placeholder="Ingrese observaciones aquí..."/>
                            </page>
                            <page name="lot_page" string="Recetas x Lote">
                                <field name="mixing_group_ids" nolabel="1">
                                    <list>
                                        <field name="name"/>
                                        <field name="lot_summary"/>
                                        <button name="action_view_group_recipe" type="object" string="Vista" class="btn btn-link"/>
                                    </list>
                                    <form>
                                        <header>
                                            <button name="action_view_group_recipe" type="object" string="Vista de Receta" class="oe_highlight"/>
                                        </header>
                                        <group>
                                            <field name="name"/>
                                        </group>
                                        <field name="mixing_line_ids">
                                            <list editable="bottom">
                                                <field name="lot_id" domain="[('product_id.product_tmpl_id.is_thread', '=', True)]"/>
                                                <field name="product_id"/>
                                                <field name="color_code"/>
                                                <field name="color_name"/>
                                                <field name="percentage"/>
                                            </list>
                                        </field>
                                    </form>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="color_recipe_tree_view" model="ir.ui.view">
            <field name="name">color.recipe.tree</field>
            <field name="model">color.recipe</field>
            <field name="arch" type="xml">
                <list string="Color Recipe">
                    <field name="name"/>
                    <field name="recipe_date"/>
                    <field name="product_id"/>
                    <field name="color_name"/>
                    <field name="recipe_color_code"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="state" widget="badge" decoration-success="state == 'approved'"/>
                </list>
            </field>
        </record>

        <record id="color_recipe_view_search" model="ir.ui.view">
            <field name="name">color.recipe.view.search</field>
            <field name="model">color.recipe</field>
            <field name="arch" type="xml">
                <search string="Color Recipe">
                    <field name="name"/>
                    <field name="product_id"/>
                    <field name="color_name"/>
                    <field name="recipe_color_code"/>
                    <filter name="approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                    <group>
                        <filter string="Color Name" name="group_by_color_name" domain="[]" context="{'group_by': 'color_name'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="color_recipe_action" model="ir.actions.act_window">
            <field name="name">Color Recipe</field>
            <field name="res_model">color.recipe</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="color_recipe_tree_view"/>
            <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                Create a new color recipe
              </p>
            </field>
        </record>

</odoo>
