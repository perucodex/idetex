<?xml version="1.0" encoding="utf-8"?>
<odoo>

        <record id="color_recipe_form_view" model="ir.ui.view">
            <field name="name">color.recipe.form</field>
            <field name="model">color.recipe</field>
            <field name="arch" type="xml">
                <form string="Product Color">
                    <header>
                        <button name="action_approve" type="object" string="Approve" class="oe_highlight" invisible="state != 'test'" groups="sales_team.group_sale_salesman"/>
                        <button name="action_return" type="object" string="Return"
                                confirm="Esta opción volverá a Prueba y dejará de estar aprobada para producción. ¿Continuar?"
                                invisible="state == 'test'"/>
                        <button name="action_adjust_recipe" type="object" string="Adjust Recipe" invisible="state == 'approved'"/>
                        <button name="action_print_labels" type="object" string="Imprimir etiquetas" icon="fa-print" invisible="state != 'approved'"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="recipe_date" readonly="state == 'approved'"/>
                                <field name="available_product_ids" invisible="1"/>
                                <field name="product_ids" widget="many2many_tags" domain="[('id', 'in', available_product_ids)]" readonly="state == 'approved'" required="1" options="{'no_create': True}"/>
                                <field name="color_name"/>
                                <field name="recipe_color_code"/>
                            </group>
                            <group>
                                <field name="lab_dev_id"/>
                                <field name="partner_id" readonly="1"/>
                                <field name="absorption_factor" readonly="state == 'approved'"/>
                                <field name="bath_ratio" readonly="state == 'approved'"/>
                                <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                            </group>
                        </group>
                        <notebook>
                            <page name="recipe_page" string="Receta Desarrollo">
                                <field name="color_recipe_process_ids" nolabel="1" readonly="state == 'approved'">
                                    <list>
                                        <field name="sequence" widget="handle"/>
                                        <field name="base_process_id"/>
                                    </list>
                                    <form>
                                        <sheet>
                                            <group>
                                                <group>
                                                    <field name="base_process_id" options="{'no_create': True}"/>
                                                </group>
                                            </group>
                                            <notebook>
                                                <page name="lines_page" string="Lines">
                                                    <field name="color_recipe_process_line_ids" nolabel="1">
                                                        <!-- Edición EN LÍNEA (sep-2026); open_form_view agrega el
                                                             botón por fila para abrir el form (línea COLORANTES:
                                                             ahí se eligen los colorantes reales como sub-líneas). -->
                                                        <list editable="bottom" open_form_view="1" decoration-info="has_table" decoration-primary="line_type == 'colorants'">
                                                            <field name="sequence" widget="handle"/>
                                                            <!-- base_line_id en el spec: sin él, el onchange de la
                                                                 plantilla crea las líneas SIN enlace a la línea base
                                                                 (se filtra de la respuesta) y las tablas CF no operan. -->
                                                            <field name="base_line_id" column_invisible="1"/>
                                                            <field name="line_type" string="Tipo"/>
                                                            <field name="product_id" domain="['|', '|', ('is_chemical', '=', True), ('is_colorant', '=', True), ('is_helper', '=', True)]" required="line_type != 'colorants'" readonly="line_type == 'colorants'"/>
                                                            <field name="order_number"/>
                                                            <field name="factor" readonly="line_type == 'colorants'"/>
                                                            <field name="uom" readonly="line_type == 'colorants'"/>
                                                            <field name="has_table" column_invisible="1"/>
                                                            <field name="factor_manual" string="Manual" optional="hide" invisible="not has_table"/>
                                                            <field name="recipe_lot_state" column_invisible="1"/>
                                                            <button name="action_reset_table_factor" type="object" icon="fa-undo" title="Volver al valor de la tabla" invisible="not factor_manual or recipe_lot_state in ('validated', 'obsolete')"/>
                                                        </list>
                                                    </field>
                                                </page>
                                            </notebook>
                                        </sheet>
                                    </form>
                                </field>
                            </page>
                            <page name="lot_page" string="Recetas Producción" invisible="state != 'approved'">
                                <field name="recipe_lot_ids" nolabel="1">
                                    <list editable="bottom" decoration-success="state == 'validated'" decoration-warning="state == 'pending'" decoration-muted="state == 'obsolete'">
                                        <field name="available_production_ids" column_invisible="1"/>
                                        <field name="available_option_ids" column_invisible="1"/>
                                        <field name="available_thread_lot_ids" column_invisible="1"/>
                                        <field name="production_id" options="{'no_create': True}" domain="[('id', 'in', available_production_ids)]" readonly="state in ('validated', 'obsolete')"/>
                                        <field name="workorder_option_id" options="{'no_create': True}" domain="[('id', 'in', available_option_ids)]" readonly="state in ('validated', 'obsolete') or not production_id"/>
                                        <!-- force_save: los lotes los escribe el onchange de la opción
                                             estando el campo readonly; sin él, el cliente los descarta. -->
                                        <field name="lot_ids" widget="many2many_tags" options="{'no_create': True}" domain="[('id', 'in', available_thread_lot_ids)]" context="{'display_thread_product': True}" readonly="state in ('validated', 'obsolete') or workorder_option_id" force_save="1"/>
                                        <field name="version" readonly="1"/>
                                        <field name="validated_date" optional="show" readonly="1"/>
                                        <field name="validated_by_id" optional="hide"/>
                                        <field name="state" widget="badge" decoration-success="state == 'validated'" decoration-warning="state == 'pending'"/>
                                        <button name="action_open_subrecipe" type="object" string="Vista" class="btn btn-link" title="Abrir sub-receta (procesos y factores por hilado)"/>
                                        <button name="action_validate" type="object" string="Validar" icon="fa-check" invisible="state != 'pending'"/>
                                        <button name="action_reset" type="object" string="Reabrir" icon="fa-undo" invisible="state != 'validated'" groups="idtx_laboratory.group_module_laboratory_manager"/>
                                    </list>
                                </field>
                            </page>
                            <page name="observations_page" string="Observaciones">
                                <field name="observations" nolabel="1" placeholder="Ingrese observaciones aquí..."/>
                            </page>
                            <page name="locations_page" string="Ubicaciones">
                                <field name="location_ids" readonly="1">
                                    <list create="0" delete="0" edit="0">
                                        <field name="area"/>
                                        <field name="drawer" string="Cajón"/>
                                        <field name="user_id" optional="show"/>
                                        <field name="write_date" string="Actualizado" optional="show"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- Lista independiente: la usa el diálogo "Buscar más" del m2o de
             sub-receta (p.ej. en la partida). Sin ella Odoo genera una lista
             con solo el rec_name (los lotes) y no se distinguen OF/opción/versión. -->
        <record id="color_recipe_lot_list_view" model="ir.ui.view">
            <field name="name">color.recipe.lot.list</field>
            <field name="model">color.recipe.lot</field>
            <field name="arch" type="xml">
                <list decoration-success="state == 'validated'" decoration-warning="state == 'pending'" decoration-muted="state == 'obsolete'">
                    <field name="color_recipe_id" optional="show"/>
                    <field name="color_name" optional="show"/>
                    <field name="recipe_color_code" optional="hide"/>
                    <field name="partner_id" optional="show"/>
                    <field name="production_id"/>
                    <field name="workorder_option_id"/>
                    <field name="lot_ids" widget="many2many_tags"/>
                    <field name="version"/>
                    <field name="validated_date" optional="show"/>
                    <field name="validated_by_id" optional="hide"/>
                    <field name="company_id" optional="hide" groups="base.group_multi_company"/>
                    <field name="state" widget="badge" decoration-success="state == 'validated'" decoration-warning="state == 'pending'"/>
                </list>
            </field>
        </record>

        <record id="color_recipe_lot_search_view" model="ir.ui.view">
            <field name="name">color.recipe.lot.search</field>
            <field name="model">color.recipe.lot</field>
            <field name="arch" type="xml">
                <search>
                    <field name="production_id"/>
                    <field name="workorder_option_id"/>
                    <field name="lot_ids"/>
                    <field name="lot_summary"/>
                    <field name="color_recipe_id"/>
                    <field name="color_name"/>
                    <field name="recipe_color_code"/>
                    <field name="partner_id"/>
                    <filter name="filter_validated" string="Validadas" domain="[('state', '=', 'validated')]"/>
                    <filter name="filter_pending" string="Pendientes" domain="[('state', '=', 'pending')]"/>
                    <filter name="filter_obsolete" string="Obsoletas" domain="[('state', '=', 'obsolete')]"/>
                    <separator/>
                    <filter name="filter_validated_date" string="Fecha Validación"
                            date="validated_date"/>
                    <group>
                        <filter name="group_state" string="Estado"
                                context="{'group_by': 'state'}"/>
                        <filter name="group_recipe" string="Receta de Color"
                                context="{'group_by': 'color_recipe_id'}"/>
                        <filter name="group_partner" string="Cliente"
                                context="{'group_by': 'partner_id'}"/>
                        <filter name="group_color" string="Color"
                                context="{'group_by': 'color_name'}"/>
                        <filter name="group_production" string="Orden de Fabricación"
                                context="{'group_by': 'production_id'}"/>
                        <filter name="group_validated_date" string="Mes de Validación"
                                context="{'group_by': 'validated_date:month'}"/>
                        <filter name="group_validated_by" string="Validada por"
                                context="{'group_by': 'validated_by_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="color_recipe_lot_form_view" model="ir.ui.view">
            <field name="name">color.recipe.lot.form</field>
            <field name="model">color.recipe.lot</field>
            <field name="arch" type="xml">
                <form string="Sub-receta por Lote">
                    <header>
                        <button name="action_validate" type="object" string="Validar" class="oe_highlight" invisible="state != 'pending'"/>
                        <button name="action_reset" type="object" string="Reabrir" invisible="state != 'validated'" groups="idtx_laboratory.group_module_laboratory_manager"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <!-- button_box: idtx_mrp_shop agrega aquí el botón de
                             Partidas (el campo recipe_lot_id vive allá). -->
                        <div class="oe_button_box" name="button_box"/>
                        <group>
                            <group>
                                <field name="color_recipe_id" readonly="1" force_save="1"/>
                                <field name="available_production_ids" invisible="1"/>
                                <field name="available_option_ids" invisible="1"/>
                                <field name="available_thread_lot_ids" invisible="1"/>
                                <field name="production_id" options="{'no_create': True}" domain="[('id', 'in', available_production_ids)]" readonly="state in ('validated', 'obsolete')"/>
                                <field name="workorder_option_id" options="{'no_create': True}" domain="[('id', 'in', available_option_ids)]" readonly="state in ('validated', 'obsolete') or not production_id"/>
                                <!-- force_save: los lotes los escribe el onchange de la opción
                                     estando el campo readonly; sin él, el cliente los descarta. -->
                                <field name="lot_ids" widget="many2many_tags" options="{'no_create': True}" readonly="state in ('validated', 'obsolete') or workorder_option_id" force_save="1" domain="[('id', 'in', available_thread_lot_ids)]" context="{'display_thread_product': True}"/>
                                <field name="version" readonly="1"/>
                                <field name="absorption_factor" readonly="state in ('validated', 'obsolete')"/>
                                <field name="bath_ratio" readonly="state in ('validated', 'obsolete')"/>
                                <field name="tipo_proceso" readonly="state in ('validated', 'obsolete')"/>
                            </group>
                            <group>
                                <field name="validated_date" readonly="1"/>
                                <field name="validated_by_id" readonly="1"/>
                                <field name="imagen_proceso" widget="image" nolabel="1" invisible="not tipo_proceso" options="{'size': [300, 200]}"/>
                            </group>
                        </group>
                        <notebook>
                            <page name="process_page" string="Receta">
                                <!-- Los procesos vienen copiados de la receta madre y aquí
                                     se ajustan los factores por hilado; también se pueden
                                     AGREGAR procesos nuevos si la combinación lo requiere
                                     (la plantilla solo se elige al crear; en los existentes
                                     no se muestra ni se cambia). -->
                                <field name="process_ids" nolabel="1" readonly="state in ('validated', 'obsolete')">
                                    <list>
                                        <field name="sequence" widget="handle"/>
                                        <!-- force_save: sin él, el cliente descarta al guardar el valor
                                             elegido en el modal (readonly en la lista gana al form). -->
                                        <field name="base_process_id" readonly="1" force_save="1"/>
                                    </list>
                                    <form>
                                        <sheet>
                                            <group invisible="id">
                                                <group>
                                                    <field name="base_process_id" options="{'no_create': True}" required="1"/>
                                                </group>
                                            </group>
                                            <field name="color_recipe_process_line_ids" nolabel="1">
                                                <!-- Edición EN LÍNEA (pedido de JP, sep-2026): el clic en la fila edita
                                                     directo. open_form_view agrega el botón por fila para abrir el form,
                                                     necesario en la línea COLORANTES para elegir los colorantes reales
                                                     (sub-líneas) y en productos con seguimiento para ver el lote. -->
                                                <list editable="bottom" open_form_view="1" decoration-info="has_table" decoration-primary="line_type == 'colorants'">
                                                    <field name="sequence" widget="handle"/>
                                                    <!-- base_line_id en el spec: sin él, el onchange de la
                                                         plantilla crea las líneas SIN enlace a la línea base
                                                         (se filtra de la respuesta) y las tablas CF no operan. -->
                                                    <field name="base_line_id" column_invisible="1"/>
                                                    <field name="line_type" string="Tipo"/>
                                                    <field name="product_id" domain="['|', '|', ('is_chemical', '=', True), ('is_colorant', '=', True), ('is_helper', '=', True)]" required="line_type != 'colorants'" readonly="line_type == 'colorants'"/>
                                                    <!-- force_save: el lote se elige en el MODAL estando la
                                                         columna readonly para productos sin seguimiento;
                                                         sin él, el cliente descarta lo editado. -->
                                                    <field name="product_tracking" column_invisible="1"/>
                                                    <field name="lot_id" string="Lote" options="{'no_create': True}" readonly="product_tracking == 'none' or line_type == 'colorants'" force_save="1"/>
                                                    <field name="lot_qualification" widget="state_selection" readonly="1" invisible="not lot_id"/>
                                                    <field name="order_number"/>
                                                    <field name="factor" readonly="line_type == 'colorants'"/>
                                                    <field name="uom" readonly="line_type == 'colorants'"/>
                                                    <field name="has_table" column_invisible="1"/>
                                                    <field name="factor_manual" string="Manual" invisible="not has_table"/>
                                                    <field name="recipe_lot_state" column_invisible="1"/>
                                                    <button name="action_reset_table_factor" type="object" icon="fa-undo" title="Volver al valor de la tabla" invisible="not factor_manual or recipe_lot_state in ('validated', 'obsolete')"/>
                                                </list>
                                            </field>
                                        </sheet>
                                    </form>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <!-- Bitácora: seguimiento de cabecera (tracking) + nota por
                         guardado con los cambios de procesos/líneas (ver
                         color_recipe_process.py, _queue_recipe_lot_log). -->
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="color_recipe_process_line_form_view" model="ir.ui.view">
            <field name="name">color.recipe.process.line.form</field>
            <field name="model">color.recipe.process.line</field>
            <field name="arch" type="xml">
                <form string="Línea de Receta">
                    <sheet>
                        <div class="oe_title">
                            <h1 invisible="line_type == 'colorants'"><field name="product_id" domain="['|', '|', ('is_chemical', '=', True), ('is_colorant', '=', True), ('is_helper', '=', True)]" options="{'no_create': True, 'no_open': True}" required="line_type == 'product'"/></h1>
                            <h1 invisible="line_type != 'colorants'">COLORANTES</h1>
                        </div>
                        <group>
                            <group>
                                <field name="line_type"/>
                                <field name="order_number"/>
                                <!-- El lote solo aplica en las sub-recetas de producción
                                     y para productos con seguimiento por lote/serie. -->
                                <field name="is_subrecipe_line" invisible="1"/>
                                <field name="product_tracking" invisible="1"/>
                                <field name="lot_id" string="Lote" options="{'no_create': True}" invisible="not is_subrecipe_line or line_type == 'colorants' or product_tracking == 'none'"/>
                                <field name="lot_qualification" widget="state_selection" readonly="1" invisible="not lot_id"/>
                            </group>
                            <group invisible="line_type == 'colorants'">
                                <field name="factor" readonly="has_table and not factor_manual"/>
                                <field name="uom"/>
                                <field name="has_table" invisible="1"/>
                                <field name="factor_manual" invisible="not has_table"/>
                            </group>
                        </group>
                        <separator string="Colorantes utilizados (producto real y porcentaje)" invisible="line_type != 'colorants'"/>
                        <field name="child_ids" nolabel="1" invisible="line_type != 'colorants'" context="{'default_uom': 'por'}">
                            <!-- Sin edicion en linea: la fila abre el modal nativo del
                                 framework (readonly si la sub-receta esta validada). -->
                            <list>
                                <field name="sequence" widget="handle"/>
                                <field name="product_id" domain="[('is_colorant','=', True)]" required="1" options="{'no_create': True}"/>
                                <field name="is_subrecipe_line" column_invisible="1"/>
                                <field name="product_tracking" column_invisible="1"/>
                                <field name="lot_id" string="Lote" options="{'no_create': True}" column_invisible="not parent.is_subrecipe_line" readonly="product_tracking == 'none'" force_save="1"/>
                                <field name="lot_qualification" widget="state_selection" readonly="1" column_invisible="not parent.is_subrecipe_line" invisible="not lot_id"/>
                                <field name="factor"/>
                                <field name="uom"/>
                            </list>
                            <form>
                                <group>
                                    <group>
                                        <field name="product_id" domain="[('is_colorant','=', True)]" required="1" options="{'no_create': True}"/>
                                        <field name="is_subrecipe_line" invisible="1"/>
                                        <field name="product_tracking" invisible="1"/>
                                        <field name="lot_id" string="Lote" options="{'no_create': True}" invisible="not is_subrecipe_line or product_tracking == 'none'"/>
                                        <field name="lot_qualification" widget="state_selection" readonly="1" invisible="not lot_id"/>
                                    </group>
                                    <group>
                                        <field name="factor"/>
                                        <field name="uom"/>
                                    </group>
                                </group>
                            </form>
                        </field>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="color_recipe_tree_view" model="ir.ui.view">
            <field name="name">color.recipe.tree</field>
            <field name="model">color.recipe</field>
            <field name="arch" type="xml">
                <list string="Color Recipe">
                    <field name="name"/>
                    <field name="recipe_date"/>
                    <field name="product_ids" widget="many2many_tags"/>
                    <field name="color_name"/>
                    <field name="recipe_color_code"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="state" widget="badge" decoration-success="state == 'approved'"/>
                </list>
            </field>
        </record>

        <record id="color_recipe_view_search" model="ir.ui.view">
            <field name="name">color.recipe.view.search</field>
            <field name="model">color.recipe</field>
            <field name="arch" type="xml">
                <search string="Color Recipe">
                    <field name="name"/>
                    <field name="product_ids" options="{'no_create': True}"/>
                    <field name="color_name"/>
                    <field name="recipe_color_code"/>
                    <filter name="approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                    <group>
                        <filter string="Color Name" name="group_by_color_name" domain="[]" context="{'group_by': 'color_name'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="color_recipe_action" model="ir.actions.act_window">
            <field name="name">Color Recipe</field>
            <field name="res_model">color.recipe</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="color_recipe_tree_view"/>
            <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                Create a new color recipe
              </p>
            </field>
        </record>

        <!-- Menú Recetas Producción: las sub-recetas por lote sueltas, con
             el filtro Validadas activo por defecto (quitable). -->
        <record id="color_recipe_lot_action" model="ir.actions.act_window">
            <field name="name">Recetas Producción</field>
            <field name="res_model">color.recipe.lot</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="color_recipe_lot_list_view"/>
            <field name="search_view_id" ref="color_recipe_lot_search_view"/>
            <field name="context">{'search_default_filter_validated': 1}</field>
            <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                Aún no hay recetas de producción (sub-recetas por lote)
              </p>
            </field>
        </record>

</odoo>
