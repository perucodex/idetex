<?xml version="1.0" encoding="utf-8"?>
<odoo>

        <record id="color_recipe_form_view" model="ir.ui.view">
            <field name="name">color.recipe.form</field>
            <field name="model">color.recipe</field>
            <field name="arch" type="xml">
                <form string="Product Color">
                    <header>
                        <button name="action_test" type="object" string="Test" class="oe_highlight" invisible="state != 'draft'"/>
                        <button name="action_approve" type="object" string="Approve" class="oe_highlight" invisible="state != 'test'"/>
                        <button name="action_return" type="object" string="Return" invisible="state == 'draft'"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="partner_id" readonly="1"/>
                                <field name="product_color_id" readonly="1"/>
                                <field name="recipe_date"/>
                                <field name="color_code"/>
                            </group>
                            <group>
                                <field name="color_process_type_id" readonly="state == 'approved'" options="{'no_create': True, 'no_open': True}"/>
                                <field name="fiber_id" options="{'no_create': True, 'no_open': True}"/>
                                <field name="color_range_id" readonly="state == 'approved'" options="{'no_create': True, 'no_open': True}"/>
                                <field name="color_intensity_id" readonly="state == 'approved'" options="{'no_create': True, 'no_open': True}"/>
                            </group>
                        </group>
                        <notebook>
                            <page name="recipe_page" string="Recipe">
                                <!-- <field name="fiber_ids" nolabel="1">
                                    <list>
                                        <field name="system_type"/>
                                        <field name="length"/>
                                        <field name="weight"/>
                                        <field name="thread_title"/>
                                        <field name="comercial_thread_title"/>
                                        <field name="percentage" widget="percentage"/>
                                    </list>
                                </field> -->
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="color_recipe_tree_view" model="ir.ui.view">
            <field name="name">color.recipe.tree</field>
            <field name="model">color.recipe</field>
            <field name="arch" type="xml">
                <list string="Color Recipe">
                    <field name="name"/>
                    <field name="recipe_date"/>
                    <field name="color" widget="color"/>
                    <field name="color" string="Hex"/>
                    <field name="state"/>
                </list>
            </field>
        </record>

        <record id="color_recipe_action" model="ir.actions.act_window">
            <field name="name">Color Recipe</field>
            <field name="res_model">color.recipe</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="color_recipe_tree_view"/>
            <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                Create a new color recipe
              </p>
            </field>
        </record>

</odoo>
