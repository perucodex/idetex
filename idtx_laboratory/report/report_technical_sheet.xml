<odoo>

  <!-- QWeb Template -->
  <template id="report_technical_sheet_document">
    <t t-call="web.internal_layout">
      <t t-set="doc" t-value="doc.with_context(lang=doc.analysis_id.partner_id.lang)"/>
      <div class="page">
        <meta http-equiv="content-type" content="text/html; charset=utf-8"/>
        <!-- Header -->
        <div>
            <div class="row mb8">
                <div class="col-4">
                    <img t-if="doc.company_id.logo" class="o_company_logo_big" t-att-src="image_data_uri(doc.company_id.logo)" alt="Logo"/>
                </div>
                <div class="col-8 text-end mb4">
                    <div name="company_address" class="float-end mb4">
                        <ul class="list-unstyled" name="company_address_list">
                            <li>
                              <span>
                                <!-- <div class="bg-light border-1 rounded h-100 d-flex flex-column align-items-center justify-content-center p-4 w-100 opacity-75 text-muted text-center"> -->
                                  <h4>Product Technical Sheet</h4>
                                  <h6><t t-esc="doc.name"/></h6>
                                <!-- </div> -->
                              </span>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
        <!-- <span>Technical Sheet:</span> <t t-esc="doc.name"/> -->
        <table class="table o_main_table">
          <tbody style="font-size: 0.8rem">
            <tr>
              <td style="background-color: #c2c2c2;"><span>Technical Date:</span> <t t-esc="doc.technical_date.strftime('%m/%d/%Y')"/></td>
              <td style="background-color: #c2c2c2;"><span>Customer:</span> <t t-esc="doc.analysis_id.partner_id.name"/></td>
            </tr>
            <tr>
              <td style="background-color: #c2c2c2;"><span>Code:</span> <t t-esc="doc.product_id.default_code"/></td>
              <td style="background-color: #c2c2c2;"><span>Fabric:</span> <t t-esc="doc.product_id.name"/></td>
            </tr>
          </tbody>
        </table>
        <table class="table o_main_table">
          <tbody style="font-size: 0.7rem">
            <tr>
              <td style="padding: 2px;">Program</td>
              <td style="padding: 2px;"><t t-esc="doc.program"/></td>
              <td style="padding: 2px;">Composition</td>
              <td style="padding: 2px;"><t t-esc="doc.fabric_composition"/></td>
              <td style="padding: 2px;">ATX</td>
              <td style="padding: 2px;"><t t-esc="doc.atx"/></td>
            </tr>
            <tr>
              <td style="padding: 2px;">Density</td>
              <td style="padding: 2px;"><t t-esc="doc.density"/></td>
              <td style="padding: 2px;">Width</td>
              <td style="padding: 2px;"><t t-esc="'{:.2f}'.format(doc.width)"/></td>
              <td style="padding: 2px;">Gauge</td>
              <td style="padding: 2px;"><t t-esc="doc.gauge_id.name"/></td>
            </tr>
            <tr>
              <td style="padding: 2px;">First wash shrinkage</td>
              <td style="padding: 2px;"><t t-esc="doc.first_wash_shrinkage"/></td>
              <td style="padding: 2px;">First wash twist</td>
              <td style="padding: 2px;"><t t-esc="doc.first_wash_twist"/></td>
              <td style="padding: 2px;">Yield</td>
              <td style="padding: 2px;"><t t-raw="'{:.2f} %'.format(doc.yield_meter * 100)"/></td>
            </tr>
            <tr>
              <td style="padding: 2px;">Scrap</td>
              <td style="padding: 2px;"><t t-esc="'{:.2f} %'.format(doc.scrap)"/></td>
              <td style="padding: 2px;">Weave type</td>
              <td style="padding: 2px;"><t t-esc="doc.weave_type"/></td>
              <td style="padding: 2px;">Batch</td>
              <td style="padding: 2px;"><t t-esc="doc.batch"/></td>
            </tr>
          </tbody>
        </table>
        <!-- Descripción del hilo -->
        <div class="row mb-4" id="informations">
          <div class="col text-center" name="process">
              <strong>Pocess</strong>
          </div>
        </div>
        <!-- Tabla principal de cabos -->
        <table class="table o_main_table">
          <t t-foreach="doc.route_line_ids" t-as="p" t-key="p.id">
            <thead style="font-size: 0.7rem">
                <tr>
                  <td colspan="10" style="background-color: #c2c2c2;"><t t-esc="p.operation_id.name"/></td>
                </tr>
            </thead>
            <tbody style="font-size: 0.7rem">
              <t t-set="lines" t-value="p.line_parameter_ids"/>
              <t t-foreach="range(0, len(lines), 4)" t-as="i">
                <tr>
                  <t t-foreach="lines[i:i+4]" t-as="line">
                    <td style="padding: 2px;"><strong><t t-esc="line.name"/></strong></td>
                    <td style="padding: 2px;"><t t-esc="line.value"/></td>
                  </t>
                  <!-- Completa con celdas vacías si faltan -->
                  <t t-set="faltan" t-value="4 - len(lines[i:i+4])"/>
                  <t t-if="faltan > 0">
                    <t t-foreach="range(faltan)" t-as="j">
                      <td style="padding: 2px;"></td><td style="padding: 2px;"></td>
                    </t>
                  </t>
                </tr>
              </t>
            </tbody>
          </t>
        </table>
        
        <div class="row" style="page-break-inside: avoid; break-inside: avoid;">
          <!-- Columna de Notas: ocupa todo el espacio sobrante y parte el texto -->
          <div class="col text-break pe-4">
            <h4>Notes</h4>
            <p t-esc="doc.analysis_id.notes"/>
          </div>
          <!-- Columna de Ligamentos: ancho automático -->
          <t t-set="grid" t-value="doc.analysis_id.get_svg_grid()"/>
          <t t-call="idtx_laboratory.fabric_ligaments_table"/>
        </div>

        <br/>

        <p>
          <strong><t t-esc="doc.analysis_id.user_id.name"/></strong> -
          <t t-esc="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y %H:%M:%S')"/>
        </p>
      </div>
    </t>
  </template>

  <template id="report_technical_sheet_raw">
      <t t-call="web.html_container">
          <t t-foreach="docs" t-as="doc">
              <t t-call="idtx_laboratory.report_technical_sheet_document" t-lang="doc.analysis_id.partner_id.lang"/>
          </t>
      </t>
  </template>

  <template id="report_technical_sheet">
      <t t-call="idtx_laboratory.report_technical_sheet_raw"/>
  </template>

</odoo>
