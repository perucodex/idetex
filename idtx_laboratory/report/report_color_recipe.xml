<odoo>

  <!-- QWeb Template -->
  <template id="report_color_recipe_document">
    <t t-call="web.internal_layout">
      <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)"/>
      <div class="page">
        <meta http-equiv="content-type" content="text/html; charset=utf-8"/>
        <!-- Header -->
        <h2 class="text-center">Color Recipe</h2>
        <h3 class="text-center"><t t-esc="doc.name"/></h3>

        <!-- Datos generales -->
        <div class="row mb-4" id="informations">
          <div class="col border border-black p-2" name="informations_reference">
              <strong>Customer:</strong>
              <div t-field="doc.partner_id.name"></div>
          </div>
          <div class="col border border-black p-2" name="informations_reference">
              <strong>Recipe Date:</strong>
              <div t-esc="doc.recipe_date.strftime('%m/%d/%Y')"></div>
          </div>
          <div class="col border border-black p-2" name="informations_reference">
              <strong>Product:</strong>
              <div t-field="doc.lab_dev_line_id.product_id.name"></div>
          </div>
          <div class="col border border-black p-2" name="informations_reference">
              <strong>Color Code:</strong>
              <div t-field="doc.color_code"></div>
          </div>
          <div class="col border border-black p-2" name="informations_reference">
              <strong>Color:</strong>
              <div t-field="doc.lab_dev_line_id.color_name"></div>
          </div>
          <div class="col border border-black p-2" name="informations_reference">
              <strong>Bath Ratio:</strong>
              <div t-field="doc.lab_dev_line_id.bath_ratio"></div>
          </div>
        </div>
        <!-- Tabla principal de cabos -->
        <!-- <table class="table o_main_table table-borderless"> -->
        <table class="table o_main_table">
          <thead style="background-color: #333333;">
            <tr>
                <th style="color: #FFFFFF;">Product Code</th>
                <th style="color: #FFFFFF;">Description</th>
                <th style="color: #FFFFFF;">Factor</th>
                <th style="color: #FFFFFF;">Uom</th>
            </tr>
          </thead>
          <tbody>
            <t t-foreach="doc.color_recipe_process_ids" t-as="line" t-key="line.id">  
                <tr>
                    <td style="background-color: #C4C4C4;"><t t-esc="line.base_process_id.code"/></td>
                    <td style="background-color: #C4C4C4;"><t t-esc="line.base_process_id.name"/></td>
                    <t t-if="line.base_process_id.time">
                        <td style="background-color: #C4C4C4;">Time: <t t-esc="line.base_process_id.time" t-options="{'widget': 'float_time'}"/></td>
                    </t>
                    <t t-else="">
                        <td style="background-color: #C4C4C4;"><span>Time:</span></td>
                    </t>
                    <td style="background-color: #C4C4C4;">Program: <t t-esc="line.base_process_id.program"/></td>
                </tr>

                <t t-foreach="line.color_recipe_process_line_ids" t-as="l" t-key="l.id">
                    <tr>
                        <td><t t-esc="l.product_id.default_code"/></td>
                        <td><t t-esc="l.product_id.name"/></td>
                        <td class="text-end"><t t-esc="('%.5f' % l.factor)"/></td>
                        <td><span t-field="l.uom"/></td>
                    </tr>
                </t>
            </t>
          </tbody>
        </table>

        <!-- Observaciones -->
        <!-- <h4>Observaciones</h4>
        <p t-esc="doc.notes"/>

        <br/> -->

        <!-- Imagen de estructura -->
        <!-- <div style="text-align:right;">
          <img t-if="doc.diagram_image" t-att-src="'data:image/png;base64,%s' % doc.diagram_image.decode('utf-8')" style="width:300px;"/>
        </div> -->

        <p>
          <!-- <strong><t t-esc="doc.user_id.name"/></strong> - -->
          <t t-esc="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y %H:%M:%S')"/>
        </p>
      </div>
    </t>
  </template>

  <template id="report_color_recipe_raw">
      <t t-call="web.html_container">
          <t t-foreach="docs" t-as="doc">
              <t t-call="idtx_laboratory.report_color_recipe_document" t-lang="doc.partner_id.lang"/>
          </t>
      </t>
  </template>

  <template id="report_color_recipe">
      <t t-call="idtx_laboratory.report_color_recipe_raw"/>
  </template>

</odoo>
