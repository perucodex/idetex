<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="SVGSelectionPopup">
        <Dialog title.translate="Seleccionar SVG" size="'md'" >
            <div class="p-4">
                <t t-if="state.loading">
                    <p class="text-center text-gray-500">Loading SVGs...</p>
                </t>
                <t t-elif="state.svgs.length === 0">
                    <p class="text-center text-gray-500">No have SVGs available. Please, add records.</p>
                </t>
                <t t-else="">
                    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
                        <t t-foreach="state.svgs" t-as="svg" t-key="svg.id">
                            <div class="svg-item-card rounded-lg shadow-md p-3 flex flex-col items-center justify-center cursor-pointer hover:bg-blue-50 transition-colors duration-200"
                                 t-on-click="() => this._onSelectSVG(svg)">
                                <div class="svg-preview-large" t-out="svg.svg_content"/>
                                <span class="mt-2 text-sm font-medium text-center text-gray-700" t-esc="svg.name"/>
                            </div>
                        </t>
                    </div>
                </t>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-secondary" t-on-click="_onClosePopup">Close</button>
            </t>
        </Dialog>
    </t>
</templates>

