<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="idtx_laboratory.SelectScaleDialog">
        <Dialog size="'md'" title="props.title" modalRef="modalRef">
            <div class="mt-4">
                <h5 class="fw-bold">Employee</h5>
                <select class="form-select fs-4" t-model="state.selectedEmployee">
                    <option value="">-- Select an employee --</option>
                    <t t-foreach="employees" t-as="emp" t-key="emp.id">
                        <option t-att-value="emp.id" t-esc="emp.name"/>
                    </t>
                </select>
            </div>
            <div class="o_select_scale_dialog w-100">
                <t t-foreach="scales" t-as="scale" t-key="scale.id">
                    <div class="form-check py-2 fs-3 pointer-cursor" t-on-click="() => this.selectScale(scale)">
                        <input t-att-type="props.radioMode ? 'radio' : 'checkbox'" t-att-name="scale.name" class="form-check-input" t-att-checked="active"/>
                        <label class="form-check-label">
                            <t t-out="scale.name"/>
                        </label>
                    </div>
                </t>
                <t t-set-slot="footer">
                    <button class="btn btn-primary" t-att-class="{'disabled': props.radioMode &amp;&amp; !state.activeScales.length}" t-on-click="confirm">Confirm</button>
                    <a t-if="!isDisplayStandalone &amp;&amp; !props.radioMode" class="btn btn-secondary" t-attf-href="/scoped_app?app_id=mrp_shop_floor&amp;path=scoped_app/shop-floor&amp;app_name={{appName}}" target="_blank">Install App</a>
                </t>
            </div>
        </Dialog>
    </t>
</templates>