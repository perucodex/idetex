<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-inherit="mrp_workorder.MrpDisplayRecord" t-inherit-mode="extension">
        <xpath expr="//li[@t-if='this.displayRegisterProduction']" position="after">
            <li class="o_mrp_record_line list-group-item">
                <t t-set="rawProgress" t-value="props.record.data.progress"/>
                <t t-set="pct" t-value="rawProgress > 1 ? rawProgress : Math.round(rawProgress * 100)"/>
                <div class="d-flex justify-content-between align-items-center">
                    <span class="fw-bold">Progress</span>
                    <span t-esc="pct + '%'"/>
                </div>
                <div class="progress mt-2" role="progressbar" aria-valuemin="0" aria-valuemax="100" t-att-aria-valuenow="pct">
                    <div
                        class="progress-bar"
                        role="progressbar"
                        t-att-style="'width: ' + pct + '%'"
                        t-att-class="{
                            'bg-success': pct >= 80,
                            'bg-warning': pct >= 50 &amp;&amp; pct &lt; 80,
                            'bg-danger': pct &lt; 50
                        }"
                        t-att-aria-valuenow="pct"
                    />
                </div>
            </li>
        </xpath>
    </t>
    <t t-inherit="mrp_workorder.MrpDisplayMenuDialog" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('button_list')]/button[@name='displayInstructionsMenu']" position="after">
            <button t-if="props.record.resModel == 'mrp.workorder' and props.record.data.weave_type != 'rect'"
                    class="btn btn-success d-flex justify-content-between align-items-center p-3 fs-3"
                    t-on-click="() => this.readScaleWithClientIP(props.record.resId)">
                Add Roll <i class="oi oi-chevron-right"/>
            </button>
            <button t-if="props.record.resModel == 'mrp.workorder' and props.record.data.weave_type == 'rect'"
                    class="btn btn-success d-flex justify-content-between align-items-center p-3 fs-3"
                    t-on-click="() => this.createSizeRecord(props.record.resId)">
                Add Size <i class="oi oi-chevron-right"/>
            </button>
        </xpath>
    </t>
</templates>