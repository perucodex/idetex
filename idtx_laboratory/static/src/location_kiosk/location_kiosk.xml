<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="idtx_laboratory.LabLocationKiosk">
        <div class="o_lab_loc_root container-fluid py-3">
            <header class="o_lab_loc_header d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h3 class="mb-0"><i class="fa fa-map-marker me-2"/>Ubicación de LabDips</h3>
                    <small class="text-muted">Escanee el código de barras y luego el cajón.</small>
                </div>
                <button class="btn btn-outline-secondary" type="button" t-on-click="close">
                    <i class="fa fa-sign-out me-1"/>Cerrar
                </button>
            </header>

            <!-- Selector de área -->
            <div class="o_lab_loc_areas mb-3">
                <label class="form-label fw-bold d-block mb-2">Área</label>
                <div class="btn-group" role="group">
                    <t t-foreach="AREAS" t-as="a" t-key="a.value">
                        <button type="button"
                                class="btn btn-lg"
                                t-att-class="state.area === a.value ? 'btn-primary' : 'btn-outline-primary'"
                                t-on-click="() => this.selectArea(a.value)">
                            <t t-esc="a.label"/>
                        </button>
                    </t>
                </div>
                <span t-if="!state.area" class="text-danger ms-3">
                    <i class="fa fa-arrow-left me-1"/>Seleccione el área para empezar
                </span>
            </div>

            <div class="row g-3">
                <!-- Columna de escaneo -->
                <div class="col-12 col-lg-7">
                    <div class="card">
                        <div class="card-body">
                            <label class="form-label fw-bold">Código de barras</label>
                            <input t-ref="barcode"
                                   class="form-control form-control-lg o_lab_loc_input"
                                   type="text"
                                   placeholder="Escanee el código..."
                                   t-att-disabled="!state.area || state.resolving"
                                   t-att-value="state.barcode"
                                   t-on-input="onBarcodeInput"
                                   t-on-keydown="onBarcodeKeydown"/>

                            <t t-if="state.error">
                                <div class="alert alert-danger mt-3 mb-0" t-esc="state.error"/>
                            </t>

                            <!-- Ficha de la receta resuelta -->
                            <t t-if="state.recipe">
                                <div class="o_lab_loc_recipe card bg-light mt-3">
                                    <div class="card-body">
                                        <h4 class="mb-1">
                                            <t t-esc="state.recipe.name"/>
                                            <small class="text-muted ms-2" t-esc="state.recipe.code"/>
                                        </h4>
                                        <div class="row">
                                            <div class="col-6"><b>Color:</b> <t t-esc="state.recipe.color_name || '-'"/></div>
                                            <div class="col-6"><b>N° LD:</b> <t t-esc="state.recipe.lab_dev || '-'"/></div>
                                            <div class="col-12"><b>Cliente:</b> <t t-esc="state.recipe.partner || '-'"/></div>
                                        </div>
                                        <div t-if="currentAreaDrawer" class="alert alert-warning mt-2 mb-0 py-2">
                                            Ya estaba en <b><t t-esc="currentAreaLabel"/></b>, cajón
                                            <b><t t-esc="currentAreaDrawer"/></b> — se reemplazará.
                                        </div>
                                    </div>
                                </div>

                                <div class="mt-3">
                                    <label class="form-label fw-bold">
                                        Cajón <span class="text-muted">(<t t-esc="currentAreaLabel"/>)</span>
                                    </label>
                                    <div class="d-flex gap-2">
                                        <input t-ref="drawer"
                                               class="form-control form-control-lg o_lab_loc_input o_lab_loc_drawer"
                                               type="text"
                                               placeholder="Escanee o escriba el cajón..."
                                               t-att-value="state.drawer"
                                               t-att-disabled="state.saving"
                                               t-on-input="onDrawerInput"
                                               t-on-keydown="onDrawerKeydown"/>
                                        <button class="btn btn-success btn-lg"
                                                type="button"
                                                t-att-disabled="state.saving"
                                                t-on-click="register">
                                            <i class="fa fa-check me-1"/>Guardar
                                        </button>
                                        <button class="btn btn-outline-secondary btn-lg"
                                                type="button"
                                                t-on-click="clearRecipe">
                                            Cancelar
                                        </button>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>
                </div>

                <!-- Columna de últimos registros -->
                <div class="col-12 col-lg-5">
                    <div class="card h-100">
                        <div class="card-header fw-bold">Últimos registrados</div>
                        <div class="card-body p-0">
                            <t t-if="!state.recent.length">
                                <div class="text-muted p-3">Aún no hay registros en esta sesión.</div>
                            </t>
                            <ul class="list-group list-group-flush" t-if="state.recent.length">
                                <t t-foreach="state.recent" t-as="r" t-key="r.key">
                                    <li class="list-group-item">
                                        <div class="d-flex justify-content-between">
                                            <span>
                                                <b t-esc="r.recipe_name"/>
                                                <small class="text-muted ms-1" t-esc="r.code"/>
                                            </span>
                                            <span class="badge bg-primary align-self-center" t-esc="r.area_label"/>
                                        </div>
                                        <div>
                                            <small class="text-muted" t-esc="r.color_name"/> ·
                                            Cajón <b t-esc="r.drawer"/>
                                            <small t-if="r.replaced" class="text-warning ms-1">
                                                (antes <t t-esc="r.previous_drawer"/>)
                                            </small>
                                        </div>
                                    </li>
                                </t>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
