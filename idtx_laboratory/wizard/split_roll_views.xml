<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="split_roll_form" model="ir.ui.view">
        <field name="name">split.roll.form</field>
        <field name="model">split.roll</field>
        <field name="arch" type="xml">
            <form string="Split Roll">
                <group>
                    <group>
                        <field name="old_weight" readonly="1" invisible="old_quantity &gt; 0"/>
                        <field name="new_weight" invisible="old_quantity &gt; 0"/>
                        <field name="old_quantity" readonly="1" invisible="old_quantity == 0"/>
                        <field name="new_quantity" invisible="old_quantity == 0"/>
                    </group>
                </group>
                <footer>
                    <button string="Split" name="split_roll" type="object" default_focus="1" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
    
</odoo>