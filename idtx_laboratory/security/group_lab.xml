<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Laboratorio -->
        <record model="res.groups.privilege" id="module_laboratory_user">
            <field name="name">Laboratory</field>
            <field name="description">Set up laboratory</field>
            <field name="sequence">19</field>
        </record>
        <record id="group_module_laboratory_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="module_laboratory_user"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="group_module_laboratory_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="module_laboratory_user"/>
            <field name="implied_ids" eval="[(4, ref('group_module_laboratory_user'))]"/>
        </record>
        
        
        <record id="base.user_admin" model="res.users">
            <field name="group_ids" eval="[Command.link(ref('group_module_laboratory_manager'))]"/>
        </record>
        
    </data>

    <!-- Reglas multi-company: LECTURA GLOBAL (sin restriccion de compania) y
         ESCRITURA solo de la compania duena. perm_read=False => no restringe
         lecturas. Fuera del bloque noupdate para que el upgrade re-aplique. -->
    <data>
        <record id="lab_dev_company_rule" model="ir.rule">
            <field name="name">LabDev: escritura por compania (lectura global)</field>
            <field name="model_id" ref="model_lab_dev"/>
            <field name="global" eval="True"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="color_recipe_company_rule" model="ir.rule">
            <field name="name">Color Recipe: escritura por compania (lectura global)</field>
            <field name="model_id" ref="model_color_recipe"/>
            <field name="global" eval="True"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
