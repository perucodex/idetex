<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="mrp_production_form_view_inherit_lot" model="ir.ui.view">
            <field name="name">mrp.production.form.inherit.lot</field>
            <field name="model">mrp.production</field>
            <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//header" position="after">
                    <div class="alert alert-danger" role="alert"
                        invisible="not lot_warning or not is_company_produce">
                        <field name="lot_warning" readonly="1"/>
                    </div>
                    <field name="is_company_produce" invisible="1"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>